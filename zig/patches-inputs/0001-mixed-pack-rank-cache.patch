+    var tmp = std.testing.tmpDir(.{ .iterate = true });
+    defer tmp.cleanup();
+    // One BF16 [4, 8] linear where an EXL3 pack would hold layers.0.attn.wq_a's trellis/suh/svh.
+    const json = "{\"layers.0.attn.wq_a.weight\":{\"dtype\":\"BF16\",\"shape\":[4,8],\"data_offsets\":[0,64]}}";
+    var body: [64]u8 = @splat(0);
+    var file: std.ArrayList(u8) = .empty;
+    defer file.deinit(a);
+    var len: [8]u8 = undefined;
+    std.mem.writeInt(u64, &len, json.len, .little);
+    try file.appendSlice(a, &len);
+    try file.appendSlice(a, json);
+    try file.appendSlice(a, &body);
+    try tmp.dir.writeFile(io, .{ .sub_path = "model-00001-of-00001.safetensors", .data = file.items });
+    const dir = try std.fs.path.join(a, &.{ ".zig-cache", "tmp", &tmp.sub_path });
+    defer a.free(dir);
+    var sh = try checkpoint.Shards.open(a, io, dir);
+    defer sh.close(io);
+    var why: @import("config.zig").Why = .{};
+    const c = try @import("config.zig").parse(a, @import("config.zig").test_config, &why);
+    const w = try wantsShards(a, c, .{ .rank = 1, .world = 2 }, true, &sh);
+    var seen = false;
+    for (w) |x| {
+        if (std.mem.eql(u8, x.key, "layers.0.attn.wq_a.weight|None")) {
+            seen = true;
+            try std.testing.expect(x.plain and x.n == 4 and x.k == 8);
+        }
+        try std.testing.expect(!std.mem.startsWith(u8, x.key, "layers.0.attn.wq_a|"));
+    }
+    try std.testing.expect(seen);
+}
