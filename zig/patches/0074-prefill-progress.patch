--- a/zig/src/core/lane_host.zig
+++ b/zig/src/core/lane_host.zig
@@ -95,6 +95,9 @@ pub const LaneHost = struct {
     /// published as `pool_tele`.
     kv_pool: ?lanes.pool.Source = null,
     pool_tele: ?api.PoolStats = null,
+    /// A backend's prompt-token counter (monotone), read on the status path (an atomic on the backend's side):
+    /// a reader's delta is the pass speed while the engine thread may be inside the pass.
+    prefill: ?lanes.prefill.Source = null,
     // -- a broken rank pair (the backend's policy, set before start; null: off, nothing below runs) ---------------
     pair: ?PairPolicy = null,
     pair_state: std.atomic.Value(u8) = .init(0), // 0 whole, 1 a cause being recorded, 2 broken (why/drain/since set)
@@ -410,6 +413,21 @@ pub const LaneHost = struct {
         }
         const n = @min(stream_tokens.len, h.live_tokens.items.len);
         @memcpy(stream_tokens[0..n], h.live_tokens.items[0..n]);
+        var prefilling: u32 = 0;
+        var oldest: i96 = 0;
+        for (h.admitted.items) |job| {
+            // `started` means admitted and being worked (set before the pass); a pass is over when
+            // `prefilled` names its end. No `prefilled` yet = its prompt pass is running now.
+            if (!job.started or job.prefilled != null or job.began == 0) continue;
+            prefilling += 1;
+            if (oldest == 0 or job.began < oldest) oldest = job.began;
+        }
+        var prefill_tokens: ?u64 = null;
+        if (h.prefill) |src| {
+            var ps: lanes.prefill.Stats = .{};
+            src.read(src.ctx, &ps);
+            prefill_tokens = ps.tokens;
+        }
         out.* = .{
             .running = @intCast(h.admitted.items.len),
             .waiting = @intCast(h.queued.items.len + h.waitingCount()),
@@ -421,6 +439,9 @@ pub const LaneHost = struct {
             .cache = h.tele,
             .kv_parts = h.kv_tele,
             .pool = h.pool_tele,
+            .prefill_tokens = prefill_tokens,
+            .prefilling = prefilling,
+            .prefill_ms = if (prefilling > 0 and oldest != 0) @intCast(@divTrunc(@max(now - oldest, 0), std.time.ns_per_ms)) else 0,
             .pair = h.pairStatus(now),
         };
     }
