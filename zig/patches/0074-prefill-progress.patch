@@ -0,0 +1,21 @@
+//! A backend's prompt-pass progress for /health and /metrics (family-neutral): how many prompt
+//! tokens it has computed (monotone, so a reader takes a delta and sees the pass's speed while it
+//! runs) and, through Status, how many passes are open and how old the oldest is.
+//! A backend hands the host a `Source`; the host reads it on the status path (an atomic, so a
+//! 1 s scrape never touches the engine thread's lists).
+const std = @import("std");
+
+pub const Stats = struct {
+    tokens: u64 = 0, // prompt tokens computed since the process started (monotone)
+};
+
+pub const Source = struct {
+    ctx: *anyopaque,
+    read: *const fn (ctx: *anyopaque, out: *Stats) void,
+};
+
+test "a prompt-token counter is a number a delta can be taken from" {
+    const a: Stats = .{ .tokens = 1000 };
+    const b: Stats = .{ .tokens = 2800 };
+    try std.testing.expectEqual(@as(u64, 1800), b.tokens - a.tokens);
+}
