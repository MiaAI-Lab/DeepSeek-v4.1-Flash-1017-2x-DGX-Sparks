@@ -475,6 +475,9 @@ pub const Lanes = struct {
     kv_stats_at: u64 = 0, //   iteration: rebuilt at most each kv_stats_ns, Model.now; 0: never built)
     pool_stats: lanes.pool.Stats = .{}, // the last pool snapshot poolFn built (the same loop and cadence; the pool
     pool_stats_at: u64 = 0, //   replicated, TF_DS_KV_SHARD=0: the parts above have nothing to say then)
+    /// Prompt tokens this process has computed, monotone: the live prefill rate's counter. Written by the lane
+    /// thread as each chunk lands, read by the status path, so a pass's speed is visible while it runs.
+    prompt_tokens: std.atomic.Value(u64) = std.atomic.Value(u64).init(0),
     /// The pair's one rank_wire Leader (native.openPair: agreed with rank_identity's full fingerprint before anything
     /// spill- or shard-related crosses), shared by the spill tier and the KV parts; owned here (null: neither is on).
     rw: ?*rank_wire.Leader = null,
@@ -819,6 +822,12 @@ pub const Lanes = struct {
         return s;
     }
 
+    /// The prompt tokens computed since start (monotone): the host's status reads it on the HTTP thread (an
+    /// atomic), so a reader's delta is the live prefill rate even while the engine thread is inside the pass.
+    pub fn prefillTokensFn(ptr: *anyopaque, out: *lanes.prefill.Stats) void {
+        out.tokens = of(ptr).prompt_tokens.load(.monotonic);
+    }
+
     /// How stale /health's parts' stats may be (kvPartsFn).
     const kv_stats_ns: u64 = 250 * std.time.ns_per_ms;
 
@@ -883,6 +892,11 @@ pub const Lanes = struct {
                 break :blk try m.fillChunk(seq[0 .. start + n], start, n, f.replay);
             };
             f.start += n;
+            // the live prefill rate's counter: the rows this chunk COMPUTED. A kept state's restored
+            // prefix (stream.cached) is cache, not work; the replay before the sliding window is
+            // encoder work and counts, exactly as prefilled()'s (prompt.len - cached) does.
+            const fresh = if (start >= s.cached) n else if (start + n > s.cached) start + n - s.cached else 0;
+            if (fresh > 0) _ = self.prompt_tokens.fetchAdd(@intCast(fresh), .monotonic);
             if (s.reuse.hook) |k| if (f.start < len and f.start <= f.replay and (f.start == f.last_end or markEnds(s.reuse.marks, f.start))) k.at(k.ptr, s, @intCast(f.start));
             // the host's work between this pass's chunks (Stream.between: the prefill interleave's rounds, parked work's
             // service): the read-ahead joined and the prompt's ids gone first, as at a piece's end and on rank 1, which
