+
+test "prefill progress: a monotone token counter, the passes open and the oldest one's age" {
+    const gpa = std.testing.allocator;
+    var m: Metrics = .{ .gpa = gpa };
+    var stub: RenderStub = .{};
+    var plain: std.Io.Writer.Allocating = .init(gpa);
+    defer plain.deinit();
+    try m.render(std.testing.io, &plain.writer, stub.engine(), 4096);
+    try std.testing.expect(std.mem.indexOf(u8, plain.written(), "prompt_tokens_computed") == null);
+    stub.status_value.prefill_tokens = 5000;
+    stub.status_value.prefilling = 1;
+    stub.status_value.prefill_ms = 1234;
+    var out: std.Io.Writer.Allocating = .init(gpa);
+    defer out.deinit();
+    try m.render(std.testing.io, &out.writer, stub.engine(), 4096);
+    const body = out.written();
+    for ([_][]const u8{
+        "# TYPE tensorfold:prompt_tokens_computed_total counter\n",
+        "tensorfold:prompt_tokens_computed_total 5000\n",
+        "# TYPE tensorfold:prefill_streams gauge\n",
+        "tensorfold:prefill_streams 1\n",
+        "tensorfold:prefill_age_ms 1234\n",
+    }) |line| try std.testing.expect(std.mem.indexOf(u8, body, line) != null);
+}
