--- a/zig/src/core/lane_host.zig
+++ b/zig/src/core/lane_host.zig
@@ -12,7 +12,10 @@
 //!   process exits with a distinct code for its supervisor to restart both ranks; a deadline thread enforces the exit
 //!   even when a round is blocked on a dead peer.
 //! - Restores the tier refuses for capacity are deferred briefly and asked again (bounded), keeping the best memory
-//!   state meanwhile, instead of a prefill from 0 (`restores_deferred`).
+//!   state meanwhile, instead of a prefill from 0 (`restores_deferred`). A restore the backend's KV pool has no room
+//!   for while streams run (error.ContextFull) waits as a prompt pass refused for room waits, at the queue's front
+//!   until a stream ends, and asks again (`restores_room_waits`), load_wait_ns at most: then it is admitted on what
+//!   memory holds, as before (`restores_room_wait_expired`).
 //! - The service fence: parked work's service and the lone driver's pump never run inside a round, inside a prompt
 //!   pass except between its chunks (Stream.between), or while the backend reports a CUDA graph capture (`quiet`).
 const std = @import("std");
@@ -197,6 +200,8 @@ pub const LaneHost = struct {
         computed_tokens: u64 = 0, // and computed
         restores_deferred: u64 = 0, // requests whose restore was refused for capacity and asked again
         restores_deferred_expired: u64 = 0, // of them, admitted on memory at defer_ns
+        restores_room_waits: u64 = 0, // requests whose restore the pool had no room for while streams ran: they waited
+        restores_room_wait_expired: u64 = 0, // of them, admitted on memory at load_wait_ns
     };
 
     const Job = struct {
@@ -216,6 +221,7 @@ pub const LaneHost = struct {
         kept0: u64 = 0, // the store's kept count when the job looked it up
         tried_disk: bool = false, // it waited for a restore once: a later lookup takes what memory has
         deferred_since: ?i96 = null, // its restore was first refused for capacity then (asked again until defer_ns)
+        room_since: ?i96 = null, // its restore first found no room in the pool then (asked again until load_wait_ns)
         join: pc.Join = .{}, // its conversation (0111)
         parent: ?u64 = null, // the durable point its pass resumes from, and where
         fork: u32 = 0,
@@ -499,6 +505,9 @@ pub const LaneHost = struct {
         var unloaded: std.ArrayList(*pc.Restore) = .empty; // restores a cancelled job waited for
         for (ids) |id| {
             for (h.queued.items, 0..) |job, i| if (job.id == id) {
+                // the queue's front waits for room (requeue, waitRoom: full_wait holds every admission meanwhile);
+                // cancelled, nothing waits for it any more
+                if (i == 0) h.full_wait = null;
                 dropped.append(h.gpa, h.queued.orderedRemove(i)) catch {};
                 break;
             };
@@ -1111,6 +1120,7 @@ pub const LaneHost = struct {
                 } else |err| {
                     const left = store.find(key, r.chunks); // (the room may have evicted probe.memory: never read it now)
                     if (h.deferRestore(job, p, left, err, now)) return true;
+                    if (h.waitRoom(job, p, err, now)) return true;
                     if (left) |e| {
                         note("reading {d} kept tokens from disk did not start ({s}); resuming the {d} memory holds", .{ p.at, @errorName(err), e.at });
                     } else note("reading {d} kept tokens from disk did not start ({s}); prefilling", .{ p.at, @errorName(err) });
@@ -1120,6 +1130,39 @@ pub const LaneHost = struct {
         return false;
     }
 
+    /// A restore of `p` the backend's KV pool has no room for (`err` error.ContextFull: its destination needs rows the
+    /// live streams hold) while streams run waits as a prompt pass refused for room waits (requeue): back at the queue's
+    /// front, holding no lane, admitted again once fewer streams are active or after full_retry_ns, when it asks for
+    /// the restore again; true then. The wait holds the queue, so it is bounded as a parked restore is: load_wait_ns
+    /// (TF_SPILL_LOAD_WAIT_MS) from its first refusal it stops (`restores_room_wait_expired`). The room it waits for
+    /// is in the point's recorded part only, while a prefill may take any part. With no stream active nothing would
+    /// free the room, or once the bound passed: false, and it is admitted on what memory holds, as before.
+    fn waitRoom(h: *LaneHost, job: *Job, p: pc.Point, err: anyerror, now: i96) bool {
+        const active = h.core.activeCount();
+        if (err != error.ContextFull or active == 0) return false;
+        const first = job.room_since orelse now;
+        if (now - first >= h.tier.load_wait_ns) {
+            h.host_counts.restores_room_wait_expired += 1;
+            note("reading {d} kept tokens from disk waited {d} ms for room in the pool ({d} streams hold it); it waits no longer", .{ p.at, @divTrunc(now - first, std.time.ns_per_ms), active });
+            return false;
+        }
+        h.lock();
+        h.queued.insert(h.gpa, 0, job) catch {
+            h.unlock();
+            return false;
+        };
+        h.full_wait = active;
+        h.full_retry = @min(now + full_retry_ns, first + h.tier.load_wait_ns);
+        h.unlock();
+        job.tried_disk = false; // (it asks for the restore again at its next admission)
+        if (job.room_since == null) {
+            job.room_since = first;
+            h.host_counts.restores_room_waits += 1;
+            note("reading {d} kept tokens from disk waits for room in the pool ({d} streams hold it)", .{ p.at, active });
+        }
+        return true;
+    }
+
     /// A restore of `p` the tier or the budget refused with `err`: when that may change shortly (Store.deferrable)
     /// and the point saves at least defer_min tokens over `have` (the best memory state), `job` waits on the deferred
     /// list (holding no lane) and asks again every defer_retry_ns or when a restore in flight ends, defer_ns at most
@@ -1537,6 +1580,8 @@ pub const LaneHost = struct {
         t.restore_wait_max_ns = hc.restore_wait_max_ns;
         t.restores_deferred = hc.restores_deferred;
         t.restores_deferred_expired = hc.restores_deferred_expired;
+        t.restores_room_waits = hc.restores_room_waits;
+        t.restores_room_wait_expired = hc.restores_room_wait_expired;
         t.cached_tokens = hc.cached_tokens;
         t.computed_tokens = hc.computed_tokens;
         t.parked = h.loading.items.len + h.deferred.items.len;
diff --git a/zig/src/core/lane_host_robust_test.zig b/zig/src/core/lane_host_robust_test.zig
index edd7ebb..d059522 100644
--- a/zig/src/core/lane_host_robust_test.zig
+++ b/zig/src/core/lane_host_robust_test.zig
@@ -108,6 +108,230 @@ test "with the deferral off a refused restore resumes what memory holds at once"
     try std.testing.expectEqual(@as(u64, 1), r.tier.refused);
 }
 
+/// The engine's prompt pass in pieces with cut-ins (TF_FILL_CHUNKS=1, TF_FILL_CUT_IN=8192; fbbc971's
+/// prefill_part): a pass of the fake's 3 chunks runs one a piece, and a short prompt cuts in between them. The service
+/// fence refuses parked work's service while a pass stands between its pieces (LaneHost.filling), and the run loop
+/// asks for it there; that refusal is counted and skipped as in a release build, not this patch's to change.
+fn pieces(r: *Rig) void {
+    r.core.fill_chunks = 1;
+    r.core.cut_in = 8192;
+    r.target.prefill_chunks = 3;
+    r.host.fence_panic = false;
+}
+
+/// The fake tier's refusal for the pool's room (dsv41: error.ContextFull while streams hold it): only while a stream
+/// of the rig's core is active.
+const Live = struct {
+    fn check(ctx: *anyopaque) bool {
+        const core: *lanes.Engine = @ptrCast(@alignCast(ctx));
+        return core.activeCount() > 0;
+    }
+};
+
+fn cachedNow(b: *Box) ?u32 {
+    b.mutex.lockUncancelable(io);
+    defer b.mutex.unlock(io);
+    return b.cached;
+}
+
+fn roomWaits(pre: ?*const fn (*Rig) void) !void {
+    const r = try Rig.createWith(.{ .load_ms = 5 }, pre);
+    defer r.destroy();
+    const e = r.host.engine();
+    const along = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4, 4, 4 };
+    var a: Box = .{};
+    defer a.deinit();
+    const areq: Request = .{ .prompt = &along, .max_tokens = 100000 };
+    try e.submit(1, &areq, a.sink());
+    while (a.count() == 0) std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    r.tier.refuse_if = .{ .ctx = &r.core, .check = Live.check };
+    r.tier.refuse_err = error.ContextFull;
+    r.tier.refuse = 1 << 20;
+    _ = try r.point(&t2, 8);
+    var b: Box = .{};
+    defer b.deinit();
+    const req: Request = .{ .prompt = &t2, .max_tokens = 6, .history_len = 14 };
+    try e.submit(2, &req, b.sink());
+    // refused while the stream decodes: asked again (at most each second, or when a stream ends), never prefilled
+    var asked = false;
+    for (0..5000) |_| {
+        if (@atomicLoad(u64, &r.tier.refused, .monotonic) >= 2) {
+            asked = true;
+            break;
+        }
+        std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try std.testing.expect(asked);
+    try std.testing.expect(b.finished() == null and cachedNow(&b) == null);
+    try std.testing.expect(a.finished() == null);
+    try std.testing.expectEqual(@as(u64, 1), r.stats().restores_room_waits);
+    e.cancel(1); // the stream ends: its room is free, the restore starts
+    try std.testing.expectEqual(Reason.cancelled, a.wait());
+    try std.testing.expectEqual(Reason.length, b.wait());
+    try std.testing.expectEqual(@as(?u32, 8), b.cached);
+    try b.exact(&t2);
+    const s = r.stats();
+    try std.testing.expectEqual(@as(u64, 1), s.disk_hits_committed);
+    try std.testing.expectEqual(@as(u64, 1), s.restores_room_waits); // once a request, however often it asked
+    try std.testing.expectEqual(@as(u64, 0), s.restores_deferred);
+    try std.testing.expectEqual(@as(u64, 0), s.parked);
+}
+
+test "a restore the pool has no room for while a stream decodes waits as a prompt pass does, then resumes its point exactly" {
+    try roomWaits(null);
+}
+
+test "a restore the pool has no room for while a stream decodes waits as a prompt pass does, then resumes its point exactly (prompt pass in pieces, cut-ins)" {
+    try roomWaits(pieces);
+}
+
+fn roomIdle(pre: ?*const fn (*Rig) void) !void {
+    const r = try Rig.createWith(.{ .load_ms = 5 }, pre);
+    defer r.destroy();
+    try shortThenPoint(r);
+    r.tier.refuse = 1;
+    r.tier.refuse_err = error.ContextFull;
+    var b: Box = .{};
+    defer b.deinit();
+    const req: Request = .{ .prompt = &t2, .max_tokens = 6, .history_len = 14 };
+    try r.host.engine().submit(2, &req, b.sink());
+    try std.testing.expectEqual(Reason.length, b.wait());
+    try std.testing.expectEqual(@as(?u32, 4), b.cached);
+    try b.exact(&t2);
+    try std.testing.expectEqual(@as(u64, 0), r.stats().restores_room_waits);
+    try std.testing.expectEqual(@as(u64, 1), r.tier.refused);
+}
+
+test "with no stream active a restore the pool has no room for resumes what memory holds at once, as before" {
+    try roomIdle(null);
+}
+
+test "with no stream active a restore the pool has no room for resumes what memory holds at once, as before (prompt pass in pieces, cut-ins)" {
+    try roomIdle(pieces);
+}
+
+fn roomCancel(pre: ?*const fn (*Rig) void) !void {
+    const r = try Rig.createWith(.{ .load_ms = 5 }, pre);
+    defer r.destroy();
+    const e = r.host.engine();
+    const along = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4, 4, 4 };
+    var a: Box = .{};
+    defer a.deinit();
+    const areq: Request = .{ .prompt = &along, .max_tokens = 100000 };
+    try e.submit(1, &areq, a.sink());
+    errdefer {
+        e.cancel(1);
+        _ = a.wait();
+    }
+    while (a.count() == 0) std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    r.tier.refuse_if = .{ .ctx = &r.core, .check = Live.check };
+    r.tier.refuse_err = error.ContextFull;
+    r.tier.refuse = 1 << 20;
+    _ = try r.point(&t2, 8);
+    var b: Box = .{};
+    defer b.deinit();
+    const req: Request = .{ .prompt = &t2, .max_tokens = 6, .history_len = 14 };
+    try e.submit(2, &req, b.sink());
+    try r.until(struct {
+        fn ok(s: api.CacheStats) bool {
+            return s.restores_room_waits == 1;
+        }
+    }.ok);
+    e.cancel(2);
+    try std.testing.expectEqual(Reason.cancelled, b.wait());
+    // the cancelled waiter no longer holds the queue (full_wait) for what is left of its retry second
+    r.host.mutex.lockUncancelable(io);
+    const holds = r.host.full_wait != null;
+    r.host.mutex.unlock(io);
+    try std.testing.expect(!holds);
+    const n = a.count();
+    var grew = false;
+    for (0..5000) |_| {
+        if (a.count() > n + 16) {
+            grew = true;
+            break;
+        }
+        std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try std.testing.expect(grew and a.finished() == null);
+    e.cancel(1);
+    try std.testing.expectEqual(Reason.cancelled, a.wait());
+    try std.testing.expectEqual(@as(u64, 0), r.stats().disk_hits_committed);
+}
+
+test "a request waiting for room for its restore is cancelled from the queue; the stream that held the room goes on" {
+    try roomCancel(null);
+}
+
+test "a request waiting for room for its restore is cancelled from the queue; the stream that held the room goes on (prompt pass in pieces, cut-ins)" {
+    try roomCancel(pieces);
+}
+
+fn roomBound(pre: ?*const fn (*Rig) void) !void {
+    const r = try Rig.createWith(.{ .load_ms = 5, .load_wait_ms = 300 }, pre);
+    defer r.destroy();
+    const e = r.host.engine();
+    const along = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4, 4, 4 };
+    var a: Box = .{};
+    defer a.deinit();
+    const areq: Request = .{ .prompt = &along, .max_tokens = 100000 };
+    try e.submit(1, &areq, a.sink());
+    errdefer {
+        e.cancel(1);
+        _ = a.wait();
+    }
+    while (a.count() == 0) std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    r.tier.refuse_if = .{ .ctx = &r.core, .check = Live.check };
+    r.tier.refuse_err = error.ContextFull;
+    r.tier.refuse = 1 << 20;
+    _ = try r.point(&t2, 8);
+    var b: Box = .{};
+    defer b.deinit();
+    const req: Request = .{ .prompt = &t2, .max_tokens = 6, .history_len = 14 };
+    try e.submit(2, &req, b.sink());
+    try r.until(struct {
+        fn ok(s: api.CacheStats) bool {
+            return s.restores_room_waits == 1;
+        }
+    }.ok);
+    // a short request with no kept state, behind the waiting restore
+    const other = [_]u32{ 2, 3, 5, 7, 1, 1 };
+    var c: Box = .{};
+    defer c.deinit();
+    const creq: Request = .{ .prompt = &other, .max_tokens = 3 };
+    try e.submit(3, &creq, c.sink());
+    var served = false; // (without the bound both wait until stream 1 ends, which here is never)
+    for (0..10000) |_| {
+        if (b.finished() != null and c.finished() != null) {
+            served = true;
+            break;
+        }
+        std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    }
+    try std.testing.expect(served);
+    try std.testing.expect(a.finished() == null); // served while the stream that held the room still decodes
+    try std.testing.expectEqual(Reason.length, b.wait());
+    try std.testing.expectEqual(@as(u32, 0), b.cached orelse 0); // (no memory state: it prefilled from 0, as before)
+    try b.exact(&t2);
+    try std.testing.expectEqual(Reason.length, c.wait());
+    const s = r.stats();
+    try std.testing.expectEqual(@as(u64, 1), s.restores_room_waits);
+    try std.testing.expectEqual(@as(u64, 1), s.restores_room_wait_expired);
+    try std.testing.expectEqual(@as(u64, 0), s.disk_hits_committed);
+    try std.testing.expectEqual(@as(u64, 0), s.restores_deferred); // (ContextFull is no capacity refusal: never deferred)
+    e.cancel(1);
+    try std.testing.expectEqual(Reason.cancelled, a.wait());
+    try std.testing.expectEqual(@as(u64, 0), r.stats().parked);
+}
+
+test "a restore waiting for room stops at TF_SPILL_LOAD_WAIT_MS: it prefills, and the request behind it is served while the stream decodes" {
+    try roomBound(null);
+}
+
+test "a restore waiting for room stops at TF_SPILL_LOAD_WAIT_MS: it prefills, and the request behind it is served while the stream decodes (prompt pass in pieces, cut-ins)" {
+    try roomBound(pieces);
+}
+
 test "a refusal that waiting cannot cure is not deferred; a deferred request cancelled leaves every list once" {
     const r = try Rig.create(.{ .load_ms = 5 });
     defer r.destroy();
diff --git a/zig/src/core/prompt_cache_fake_tier.zig b/zig/src/core/prompt_cache_fake_tier.zig
index 094d83c..83f7b0f 100644
--- a/zig/src/core/prompt_cache_fake_tier.zig
+++ b/zig/src/core/prompt_cache_fake_tier.zig
@@ -27,6 +27,9 @@ pub const FakeTier = struct {
     /// dsv41's TooManyRestores, the store's TooMany/NoSlot); `refused` counts them.
     refuse: u32 = 0,
     refuse_err: anyerror = error.TooManyRestores,
