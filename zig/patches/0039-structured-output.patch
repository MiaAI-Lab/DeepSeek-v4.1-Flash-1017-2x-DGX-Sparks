+    try std.testing.expect(target.redraws > 0);
+}
+
+/// The schema reply with the long pass behind it commits the tokens it commits alone, greedy and sampled.
+fn sameAlone(between: Between) !void {
+    const gpa = std.testing.allocator;
+    for ([_]?api.Sampling{ null, .{ .seed = 11, .temperature = 0.8 } }) |sampling| {
+        var alone: Reply = .{};
+        defer alone.tokens.deinit(gpa);
+        var unused: [6]usize = @splat(0);
+        try interleaved(between, sampling, false, &alone, &unused);
+        var mixed: Reply = .{};
+        defer mixed.tokens.deinit(gpa);
+        var seen: [6]usize = @splat(0);
+        try interleaved(between, sampling, true, &mixed, &seen);
+        // its rounds ran inside the long pass (between chunks 0 and 5), and they committed the same tokens
+        try std.testing.expect(seen[5] > seen[0]);
+        try std.testing.expect(seen[0] < alone.tokens.items.len);
+        try std.testing.expectEqualSlices(u32, alone.tokens.items, mixed.tokens.items);
+        try std.testing.expectEqual(alone.done.?, mixed.done.?);
+        try std.testing.expectEqual(Reason.stop, mixed.done.?);
+    }
+}
+
+test "a schema reply that decodes between another prompt's pieces equals its reply alone (TF_FILL_CHUNKS)" {
+    try sameAlone(.pieces);
+}
+
+test "kit 0005: a schema reply that decodes between another prompt's chunks equals its reply alone" {
+    try sameAlone(.interleave);
+}
