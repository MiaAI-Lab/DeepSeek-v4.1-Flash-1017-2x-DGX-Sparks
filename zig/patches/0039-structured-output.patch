+{
+  "$defs": {
+    "RecommendedAction": {
+      "description": "One action the report recommends.",
+      "properties": {
+        "tool_name": {
+          "description": "The tool to run.",
+          "enum": [
+            "ack_alert",
+            "escalate_to_case",
+            "add_case_comment"
+          ],
