diff --git a/zig/src/core/grammar/vocab.zig b/zig/src/core/grammar/vocab.zig
new file mode 100644
index 00000000..b72916f6
--- /dev/null
+++ b/zig/src/core/grammar/vocab.zig
@@ -0,0 +1,115 @@
+//! Each logits column's token as the bytes it adds to a reply, so a grammar can test a token by its bytes.
+const std = @import("std");
+const json = @import("json.zig");
+const Allocator = std.mem.Allocator;
+
+/// How a token meets a grammar: text by its bytes, eos once the grammar is complete, special and none never.
+pub const Kind = enum(u8) { none, text, eos, special };
+
+pub const Vocab = struct {
+    /// Token id i's bytes are bytes[offsets[i]..offsets[i + 1]] (empty unless its kind is text).
+    offsets: []u32,
+    bytes: []u8,
+    kinds: []Kind,
+
+    /// The table for logits `columns` wide; `source` is a tokenizer.Tokenizer (its `tokenBytes` and `added`).
+    pub fn build(a: Allocator, columns: usize, source: anytype, eos: []const u32) !Vocab {
+        const kinds = try a.alloc(Kind, columns);
+        errdefer a.free(kinds);
+        @memset(kinds, .text);
+        // An added token is control markup decided by its id, though its text may decode to plain bytes.
+        for (source.added) |t| {
+            if (t.id < columns) kinds[t.id] = .special;
+        }
+        for (eos) |id| {
+            if (id < columns) kinds[id] = .eos;
+        }
+        const offsets = try a.alloc(u32, columns + 1);
+        errdefer a.free(offsets);
+        var bytes: std.ArrayList(u8) = .empty;
+        errdefer bytes.deinit(a);
+        var scratch = std.heap.ArenaAllocator.init(a);
+        defer scratch.deinit();
+        for (kinds, 0..) |*k, id| {
+            offsets[id] = @intCast(bytes.items.len);
+            if (k.* != .text) continue;
+            _ = scratch.reset(.retain_capacity);
+            const got = try source.tokenBytes(scratch.allocator(), @intCast(id)) orelse "";
+            if (got.len == 0) k.* = .none;
+            try bytes.appendSlice(a, got);
+        }
+        offsets[columns] = @intCast(bytes.items.len);
+        return .{ .offsets = offsets, .bytes = try bytes.toOwnedSlice(a), .kinds = kinds };
+    }
+
+    pub fn deinit(v: *Vocab, a: Allocator) void {
+        a.free(v.offsets);
+        a.free(v.bytes);
+        a.free(v.kinds);
+        v.* = undefined;
+    }
+
+    /// The logits' width the table covers.
+    pub fn width(v: *const Vocab) usize {
+        return v.kinds.len;
+    }
+
+    pub fn kind(v: *const Vocab, id: u32) Kind {
+        return if (id < v.kinds.len) v.kinds[id] else .none;
+    }
+
+    pub fn piece(v: *const Vocab, id: u32) []const u8 {
+        if (id >= v.kinds.len) return "";
+        return v.bytes[v.offsets[id]..v.offsets[id + 1]];
+    }
+
+    /// Whether token `id` may come next after the reply that brought matcher `m` (or the one it points to) here.
+    pub fn allows(v: *const Vocab, m: anytype, id: u32) bool {
+        return switch (v.kind(id)) {
+            .text => m.accepts(v.piece(id)),
+            .eos => m.complete(),
+            .special, .none => false,
+        };
+    }
+};
+
+/// A stand-in tokenizer: token i is `pieces[i]` (null: no token), plus the ids of its added tokens.
+const Fake = struct {
+    pieces: []const ?[]const u8,
+    added: []const struct { id: u32 },
+
+    fn tokenBytes(f: *const Fake, a: Allocator, id: u32) !?[]u8 {
+        if (id >= f.pieces.len) return null;
+        return try a.dupe(u8, f.pieces[id] orelse return null);
+    }
+};
+
+test "a vocab table keeps each token's bytes and decides added tokens and eos by id" {
+    const a = std.testing.allocator;
+    const pieces = [_]?[]const u8{ "{", "}", "\"", "a", ":", " ", "1", "</think>", "", null, "\xe4\xb8", "\xad", "<eos>" };
+    const fake = Fake{ .pieces = &pieces, .added = &.{ .{ .id = 7 }, .{ .id = 12 } } };
+    var v = try Vocab.build(a, pieces.len + 3, &fake, &.{12});
+    defer v.deinit(a);
+    try std.testing.expectEqual(@as(usize, pieces.len + 3), v.width());
+    try std.testing.expectEqualStrings("\xe4\xb8", v.piece(10));
+    try std.testing.expectEqual(Kind.text, v.kind(10));
+    try std.testing.expectEqual(Kind.special, v.kind(7));
+    try std.testing.expectEqualStrings("", v.piece(7));
+    try std.testing.expectEqual(Kind.none, v.kind(8));
+    try std.testing.expectEqual(Kind.none, v.kind(9));
+    try std.testing.expectEqual(Kind.eos, v.kind(12));
+    try std.testing.expectEqual(Kind.none, v.kind(@intCast(pieces.len + 2)));
+    try std.testing.expectEqual(Kind.none, v.kind(1 << 20));
+    var m: json.Matcher = .{};
+    try std.testing.expect(v.allows(m, 0) and !v.allows(m, 5) and !v.allows(m, 12));
+    try std.testing.expect(m.advance("{\""));
+    // "</think>" is valid string text by its bytes; only its id keeps it out.
+    try std.testing.expect(m.accepts("</think>") and !v.allows(m, 7));
+    try std.testing.expect(v.allows(m, 10) and !v.allows(m, 11));
+    try std.testing.expect(m.advance("\xe4\xb8"));
+    try std.testing.expect(v.allows(m, 11) and !v.allows(m, 2));
+    try std.testing.expect(m.advance("\xad\":1"));
+    try std.testing.expect(!v.allows(m, 12) and v.allows(m, 1));
+    try std.testing.expect(m.advance("}"));
+    for (0..pieces.len) |id| try std.testing.expectEqual(id == 12, v.allows(m, @intCast(id)));
+}
diff --git a/zig/src/core/grammar/vocab_tokenizer_test.zig b/zig/src/core/grammar/vocab_tokenizer_test.zig
new file mode 100644
index 00000000..fadd8421
--- /dev/null
+++ b/zig/src/core/grammar/vocab_tokenizer_test.zig
@@ -0,0 +1,152 @@
+//! tokenizer.tokenBytes and grammar.Vocab over a real byte-level BPE tokenizer, as a server would build the table.
+const std = @import("std");
+const grammar = @import("grammar");
+const tokenizer = @import("tokenizer");
+const Vocab = grammar.Vocab;
+
+const eos_text = "<｜end▁of▁sentence｜>";
+const think_close = "</think>";
+const dsml = "｜DSML｜";
+/// Ids: bytes 0..255, the half character E4 B8 (256), `{"` (257), then the added eos, </think> and DSML markers.
+const half = 256;
+const brace_quote = 257;
+const eos = 258;
+const think = 259;
+const marker = 260;
+const width = 264;
+
+/// GPT-2's byte-to-character map that ByteLevel uses.
+fn byteChar(b: u8) u21 {
+    if ((b >= 33 and b <= 126) or (b >= 161 and b <= 172) or b >= 174) return b;
+    var n: u21 = 0;
+    for (0..b) |c| {
+        if (!((c >= 33 and c <= 126) or (c >= 161 and c <= 172) or c >= 174)) n += 1;
+    }
+    return 256 + n;
+}
+
+fn appendToken(out: *std.ArrayList(u8), a: std.mem.Allocator, bytes: []const u8) !void {
+    try out.append(a, '"');
+    for (bytes) |b| {
+        const c = byteChar(b);
+        if (c == '"' or c == '\\') try out.append(a, '\\');
+        var buf: [4]u8 = undefined;
+        try out.appendSlice(a, buf[0..try std.unicode.utf8Encode(c, &buf)]);
+    }
+    try out.append(a, '"');
+}
+
+/// A ByteLevel BPE tokenizer: every byte, two merges, and three added tokens (the eos is special).
+fn fixture(a: std.mem.Allocator) !tokenizer.Tokenizer {
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(a);
+    try out.print(a,
+        \\{{"added_tokens":[{{"id":{d},"content":"{s}","special":true,"lstrip":false,"rstrip":false,"normalized":false,"single_word":false}},
+        \\ {{"id":{d},"content":"{s}","special":false,"lstrip":false,"rstrip":false,"normalized":false,"single_word":false}},
+        \\ {{"id":{d},"content":"{s}","special":false,"lstrip":false,"rstrip":false,"normalized":true,"single_word":false}}],
+        \\ "normalizer":null,
+        \\ "pre_tokenizer":{{"type":"ByteLevel","add_prefix_space":false,"trim_offsets":false,"use_regex":false}},
+        \\ "decoder":{{"type":"ByteLevel"}},
+        \\ "model":{{"type":"BPE","dropout":null,"unk_token":null,"fuse_unk":false,"byte_fallback":false,"ignore_merges":false,"vocab":{{
+    , .{ eos, eos_text, think, think_close, marker, dsml });
+    for (0..256) |b| {
+        try appendToken(&out, a, &.{@intCast(b)});
+        try out.print(a, ":{d},", .{b});
+    }
+    try appendToken(&out, a, "\xe4\xb8");
+    try out.print(a, ":{d},", .{half});
+    try appendToken(&out, a, "{\"");
+    try out.print(a, ":{d}}},\"merges\":[", .{brace_quote});
+    for ([_][2]u8{ .{ 0xe4, 0xb8 }, .{ '{', '"' } }, 0..) |m, i| {
+        if (i > 0) try out.append(a, ',');
+        try out.append(a, '[');
+        try appendToken(&out, a, &.{m[0]});
+        try out.append(a, ',');
+        try appendToken(&out, a, &.{m[1]});
+        try out.append(a, ']');
+    }
+    try out.appendSlice(a, "]}}");
+    return tokenizer.parse(a, out.items);
+}
+
+fn bytesOf(t: *const tokenizer.Tokenizer, id: u32) !?[]u8 {
+    return t.tokenBytes(std.testing.allocator, id);
+}
+
+test "tokenBytes: each id's bytes as the ByteLevel decoder joins them, half characters kept" {
+    const a = std.testing.allocator;
+    var t = try fixture(a);
+    defer t.deinit();
+    for (0..256) |b| {
+        const got = (try bytesOf(&t, @intCast(b))).?;
+        defer a.free(got);
+        try std.testing.expectEqualSlices(u8, &.{@intCast(b)}, got);
+    }
+    const cases = [_]struct { u32, []const u8 }{
+        .{ half, "\xe4\xb8" }, .{ brace_quote, "{\"" }, .{ eos, eos_text }, .{ think, think_close }, .{ marker, dsml },
+    };
+    for (cases) |c| {
+        const got = (try bytesOf(&t, c[0])).?;
+        defer a.free(got);
+        try std.testing.expectEqualStrings(c[1], got);
+        const text = try t.decode(a, &.{c[0]}, false);
+        defer a.free(text);
+        if (c[0] != half) try std.testing.expectEqualStrings(text, got);
+    }
+    try std.testing.expectEqual(@as(?[]u8, null), try bytesOf(&t, width + 5));
+    // The decoder repairs a half character to U+FFFD on its own, and joins it whole beside its other half.
+    const alone = try t.decode(a, &.{half}, false);
+    defer a.free(alone);
+    try std.testing.expectEqualStrings("\u{FFFD}", alone);
+    const joined = try t.decode(a, &.{ half, 0xad }, false);
+    defer a.free(joined);
+    try std.testing.expectEqualStrings("中", joined);
+}
+
+test "tokenBytes refuses a decoder whose pieces depend on their neighbours" {
+    const json =
+        \\{"added_tokens":[],"normalizer":{"type":"Replace","pattern":{"String":" "},"content":"▁"},
+        \\ "pre_tokenizer":{"type":"Split","pattern":{"String":" "},"behavior":"MergedWithPrevious","invert":false},
+        \\ "decoder":{"type":"Sequence","decoders":[{"type":"Replace","pattern":{"String":"▁"},"content":" "},{"type":"ByteFallback"},{"type":"Fuse"}]},
+        \\ "model":{"type":"BPE","unk_token":"<unk>","fuse_unk":true,"byte_fallback":true,
+        \\  "vocab":{"<unk>":0,"<0xC3>":1,"<0xA9>":2,"h":3,"i":4,"▁":5,"hi":6,"▁h":7},"merges":["h i","▁ h"]}}
+    ;
+    var t = try tokenizer.parse(std.testing.allocator, json);
+    defer t.deinit();
+    try std.testing.expectError(error.UnsupportedDecoder, bytesOf(&t, 3));
+}
+
+test "a vocab table from the tokenizer: added tokens by id, eos, padded columns, and a reply walked token by token" {
+    const a = std.testing.allocator;
+    var t = try fixture(a);
+    defer t.deinit();
+    var v = try Vocab.build(a, width, &t, &.{eos});
+    defer v.deinit(a);
+    try std.testing.expectEqual(@as(usize, width), v.width());
+    try std.testing.expectEqual(grammar.vocab.Kind.eos, v.kind(eos));
+    try std.testing.expectEqual(grammar.vocab.Kind.special, v.kind(think));
+    try std.testing.expectEqual(grammar.vocab.Kind.special, v.kind(marker));
+    for (marker + 1..width) |id| try std.testing.expectEqual(grammar.vocab.Kind.none, v.kind(@intCast(id)));
+    try std.testing.expectEqualStrings("\xe4\xb8", v.piece(half));
+    const reply = "{\"中\":[1, \"x\"]}";
+    const ids = try t.encode(a, reply);
+    defer a.free(ids);
+    try std.testing.expect(std.mem.indexOfScalar(u32, ids, half) != null and ids[0] == brace_quote);
+    var m: grammar.json.Matcher = .{};
+    var text: std.ArrayList(u8) = .empty;
+    defer text.deinit(a);
+    for (ids) |id| {
+        try std.testing.expect(!v.allows(m, eos));
+        try std.testing.expect(v.allows(m, id));
+        try std.testing.expect(m.advance(v.piece(id)));
+        try text.appendSlice(a, v.piece(id));
+    }
+    try std.testing.expectEqualStrings(reply, text.items);
+    try std.testing.expect(m.complete() and v.allows(m, eos));
+    // "</think>" inside a key is valid JSON by its bytes, but its token is markup and never allowed.
+    const marked = try t.encode(a, "{\"</think>");
+    defer a.free(marked);
+    try std.testing.expectEqualSlices(u32, &.{ brace_quote, think }, marked);
+    var k: grammar.json.Matcher = .{};
+    try std.testing.expect(k.advance("{\"") and k.accepts(think_close) and !v.allows(k, think));
+}
diff --git a/zig/src/core/grammar/xgrammar_schema_test.zig b/zig/src/core/grammar/xgrammar_schema_test.zig
new file mode 100644
index 00000000..2152cd5b
--- /dev/null
+++ b/zig/src/core/grammar/xgrammar_schema_test.zig
@@ -0,0 +1,57 @@
+//! Schemas and choice lists against xgrammar's verdicts on a frozen corpus (tools/zig/xgrammar_schema_corpus.py).
+const std = @import("std");
+const schema = @import("schema.zig");
+const Matcher = @import("schema_match.zig").Matcher;
+const xgrammar_test = @import("xgrammar_test.zig");
+
+const corpus = @embedFile("testdata/xgrammar_schema.txt");
+
+fn verdict(buf: []u8, p: *const schema.Program, bytes: []const u8) []const u8 {
+    var m: Matcher = .init(p);
+    for (bytes, 0..) |b, i| if (!m.step(b)) return std.fmt.bufPrint(buf, "{d}", .{i}) catch unreachable;
+    return if (m.complete()) "c" else "p";
+}
+
+/// The program a section header names: "= schema <json>" or "= choice <json list>".
+fn program(a: std.mem.Allocator, header: []const u8) !schema.Program {
+    var why: []const u8 = "";
+    if (std.mem.startsWith(u8, header, "= schema ")) return schema.compile(a, header["= schema ".len..], &why) catch |e| {
+        std.debug.print("{s}: {s}\n", .{ header, why });
+        return e;
+    };
+    const list = try std.json.parseFromSliceLeaky([][]const u8, a, header["= choice ".len..], .{});
+    return schema.choice(a, list);
+}
+
+test "every verdict equals xgrammar 0.2.8's on the frozen schema and choice corpus" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var lines = std.mem.splitScalar(u8, corpus, '\n');
+    var p: ?schema.Program = null;
+    var sections: usize = 0;
+    var cases: usize = 0;
+    var kinds = [3]usize{ 0, 0, 0 };
+    var bytes: [1024]u8 = undefined;
+    var got: [16]u8 = undefined;
+    while (lines.next()) |line| {
+        if (line.len == 0 or line[0] == '#') continue;
+        if (line[0] == '=') {
+            p = try program(arena.allocator(), line);
+            sections += 1;
+            continue;
+        }
+        const space = std.mem.indexOfScalar(u8, line, ' ') orelse line.len;
+        const want = line[0..space];
+        const input = try xgrammar_test.decode(&bytes, if (space < line.len) line[space + 1 ..] else "");
+        const mine = verdict(&got, &p.?, input);
+        if (!std.mem.eql(u8, want, mine)) {
+            std.debug.print("xgrammar {s}, matcher {s}: {f}\n", .{ want, mine, std.ascii.hexEscape(input, .lower) });
+            return error.TestUnexpectedResult;
+        }
+        cases += 1;
+        kinds[if (want[0] == 'c') 0 else if (want[0] == 'p') 1 else 2] += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 93), sections);
+    try std.testing.expect(cases > 10_000);
+    for (kinds) |k| try std.testing.expect(k >= 300);
+}
diff --git a/zig/src/core/grammar/xgrammar_test.zig b/zig/src/core/grammar/xgrammar_test.zig
new file mode 100644
index 00000000..f51a24ea
--- /dev/null
+++ b/zig/src/core/grammar/xgrammar_test.zig
@@ -0,0 +1,60 @@
+//! The matcher against xgrammar's own verdicts on a frozen corpus (tools/zig/xgrammar_json_corpus.py writes it).
+const std = @import("std");
+const json = @import("json.zig");
+
+const corpus = @embedFile("testdata/xgrammar_json_object.txt");
+
+/// A corpus line's bytes (none when the line has no space): `_` is a space, %XX a byte, any other character itself.
+pub fn decode(buf: []u8, text: []const u8) ![]u8 {
+    var n: usize = 0;
+    var i: usize = 0;
+    while (i < text.len) : (n += 1) {
+        if (n == buf.len) return error.LineTooLong;
+        switch (text[i]) {
+            '%' => {
+                if (i + 3 > text.len) return error.BadEscape;
+                buf[n] = try std.fmt.parseInt(u8, text[i + 1 .. i + 3], 16);
+                i += 3;
+            },
+            '_' => {
+                buf[n] = ' ';
+                i += 1;
+            },
+            else => |c| {
+                buf[n] = c;
+                i += 1;
+            },
+        }
+    }
+    return buf[0..n];
+}
+
+/// xgrammar's verdict form: the first rejected byte's index, else c (complete) or p (an unfinished prefix).
+fn verdict(buf: []u8, bytes: []const u8) []const u8 {
+    var m: json.Matcher = .{};
+    for (bytes, 0..) |b, i| if (!m.step(b)) return std.fmt.bufPrint(buf, "{d}", .{i}) catch unreachable;
+    return if (m.complete()) "c" else "p";
+}
+
+test "every verdict equals xgrammar 0.2.8's on the frozen corpus" {
+    var lines = std.mem.splitScalar(u8, corpus, '\n');
+    var cases: usize = 0;
+    var kinds = [3]usize{ 0, 0, 0 };
+    var bytes: [512]u8 = undefined;
+    var got: [16]u8 = undefined;
+    while (lines.next()) |line| {
+        if (line.len == 0 or line[0] == '#') continue;
+        const space = std.mem.indexOfScalar(u8, line, ' ') orelse line.len;
+        const want = line[0..space];
+        const input = try decode(&bytes, if (space < line.len) line[space + 1 ..] else "");
+        const mine = verdict(&got, input);
+        if (!std.mem.eql(u8, want, mine)) {
+            std.debug.print("xgrammar {s}, matcher {s}: {f}\n", .{ want, mine, std.ascii.hexEscape(input, .lower) });
+            return error.TestUnexpectedResult;
+        }
+        cases += 1;
+        kinds[if (want[0] == 'c') 0 else if (want[0] == 'p') 1 else 2] += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 3000), cases);
+    for (kinds) |k| try std.testing.expect(k >= 100);
+}
diff --git a/zig/src/core/lane_host.zig b/zig/src/core/lane_host.zig
index a90d26a5..1893a23a 100644
--- a/zig/src/core/lane_host.zig
+++ b/zig/src/core/lane_host.zig
@@ -274,6 +274,7 @@ pub const LaneHost = struct {
 
     pub fn init(gpa: Allocator, io: std.Io, core: *lanes.Engine, info_: Info) LaneHost {
         var enforced = info_;
+        enforced.structures = lanes.structure.served(core.backend, core.cfg); // the backend redraws rows under a grammar
         enforced.loop_guard = true;
