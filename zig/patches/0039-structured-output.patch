+    defer host.stop();
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    var why: []const u8 = "";
+    // many items, so the reply is still decoding when the long prompt's pass starts
+    const program = try api.grammar.schema.compile(arena.allocator(), "{\"type\": \"array\", \"items\": {\"type\": \"integer\"}, \"minItems\": 40}", &why);
+    const prompt = [_]u32{ 2, 7, 1, 8 };
+    const request: Request = .{ .prompt = &prompt, .max_tokens = 1500, .eos = &.{words.eos}, .sampling = sampling, .structure = .{ .kind = .json_schema, .vocab = &vocab, .program = &program } };
+    const long_prompt = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4 };
+    const long: Request = .{ .prompt = &long_prompt, .max_tokens = 4, .eos = &.{words.eos} };
+    var other: Reply = .{};
+    defer other.tokens.deinit(gpa);
+    const Watch = struct {
+        engine: api.Engine,
+        long: ?*const Request,
+        other: *Reply,
+        reply: *Reply,
+        seen: *[6]usize,
+
+        fn call(ctx: *anyopaque, s: *lanes.Stream, chunk: usize) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            const l = w.long orelse return;
+            if (s.prompt_len == l.prompt.len) {
