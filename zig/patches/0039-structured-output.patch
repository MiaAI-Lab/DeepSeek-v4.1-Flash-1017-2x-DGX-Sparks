+/// A schema reply alone, or with a 6-chunk prompt pass behind it that runs the reply's rounds `between` its chunks.
+fn interleaved(between: Between, sampling: ?api.Sampling, with_long: bool, out: *Reply, seen: *[6]usize) !void {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 6, .mtp = true, .speculate = true, .speculate_early = false, .drafts = 4, .hidden_rows = true, .draft_streams = true }, 6, 5);
