+
+test "the first token is drawn again when the grammar refuses the prompt row's pick" {
+    var vocab = try table();
+    defer vocab.deinit(gpa);
+    const sc: fake.Scored = .{ .score = score };
+    for ([_][]const u32{ &p1, &p2, &p3 }) |p| {
