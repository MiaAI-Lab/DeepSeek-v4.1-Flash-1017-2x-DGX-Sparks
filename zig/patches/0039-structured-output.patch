+//! Bounded numbers in the program matcher, against xgrammar 0.2.8's verdicts (more in the frozen corpus).
+const std = @import("std");
+const schema = @import("schema.zig");
+const Matcher = @import("schema_match.zig").Matcher;
+
+const Want = union(enum) { complete, prefix, reject: usize };
+
+fn expectRun(p: *const schema.Program, want: Want, bytes: []const u8) !void {
+    var m: Matcher = .init(p);
+    const got: Want = for (bytes, 0..) |b, i| {
+        if (!m.step(b)) break .{ .reject = i };
+    } else if (m.complete()) .complete else .prefix;
+    if (!std.meta.eql(want, got)) {
+        std.debug.print("{s}: want {any}, got {any}\n", .{ bytes, want, got });
+        return error.TestUnexpectedResult;
+    }
+}
+
+fn at(i: usize) Want {
+    return .{ .reject = i };
+}
+
+fn compile(a: std.mem.Allocator, text: []const u8) !schema.Program {
+    var why: []const u8 = "";
+    return schema.compile(a, text, &why) catch |e| {
+        std.debug.print("{s}: {s}\n", .{ text, why });
+        return e;
+    };
+}
+
+test "bounded numbers: canonical, at most 6 decimals, in range, no exponent (xgrammar 0.2.8 verdicts)" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const unit = try compile(a, "{\"type\": \"number\", \"minimum\": 0, \"maximum\": 1}");
+    for ([_][]const u8{ "0", "0.0", "0.85", "1", "1.0", "1.000000" }) |t| try expectRun(&unit, .complete, t);
+    for ([_][]const u8{ "0.", "1." }) |t| try expectRun(&unit, .prefix, t);
+    for ([_]struct { []const u8, usize }{ .{ "1.0000000", 8 }, .{ "1.000001", 7 }, .{ "1.01", 3 }, .{ "0.0000001", 8 }, .{ "-0", 0 }, .{ "-0.0", 0 }, .{ "00", 1 }, .{ "1e0", 1 }, .{ ".5", 0 }, .{ "2", 0 } }) |c|
+        try expectRun(&unit, at(c[1]), c[0]);
+    // a negative lower bound takes -0.0 but never -0; an exclusive bound wins a tie with an inclusive one
+    const span = try compile(a, "{\"type\": \"number\", \"minimum\": -2.5, \"exclusiveMaximum\": 10}");
+    for ([_][]const u8{ "-2.5", "-2.50", "-2.4", "-0.0", "-0.000000", "9.999999" }) |t| try expectRun(&span, .complete, t);
+    try expectRun(&span, .prefix, "-0");
+    try expectRun(&span, at(8), "-2.500001");
+    try expectRun(&span, at(1), "10.0");
+    try expectRun(&span, at(1), "-3");
+    const tie = try compile(a, "{\"type\": \"number\", \"minimum\": 5, \"exclusiveMinimum\": 5}");
+    try expectRun(&tie, .prefix, "5.0");
+    try expectRun(&tie, .complete, "5.000001");
+    // a bound off the 6-decimal grid moves inside it; past int64 xgrammar caps the whole part, so this takes no more
+    const grid = try compile(a, "{\"type\": \"number\", \"minimum\": 0.0078125}");
+    try expectRun(&grid, at(7), "0.007812");
+    try expectRun(&grid, .complete, "0.007813");
+    const huge = try compile(a, "{\"type\": \"number\", \"minimum\": 1e20}");
+    try expectRun(&huge, .complete, "100000000000000000000.5");
+    try expectRun(&huge, at(20), "100000000000000000001");
+    try expectRun(&huge, at(0), "200000000000000000000");
+    const capped = try compile(a, "{\"type\": \"number\", \"minimum\": 9.2e18, \"maximum\": 1e19}");
+    try expectRun(&capped, .complete, "9223372036854775806");
+    try expectRun(&capped, at(18), "9223372036854775807");
+    try expectRun(&capped, .complete, "10000000000000000000.0");
+    const ints = try compile(a, "{\"type\": \"integer\", \"minimum\": -9223372036854775808, \"maximum\": -9223372036854775000}");
+    try expectRun(&ints, .complete, "-9223372036854775808");
+    try expectRun(&ints, at(19), "-9223372036854775809");
+    try expectRun(&ints, at(16), "-9223372036854774999");
+    const percent = try compile(a, "{\"type\": \"integer\", \"minimum\": 0, \"maximum\": 100}");
+    try expectRun(&percent, .complete, "100");
+    for ([_]struct { []const u8, usize }{ .{ "101", 2 }, .{ "1000", 3 }, .{ "-0", 0 }, .{ "00", 1 }, .{ "1.0", 1 }, .{ "1e2", 1 } }) |c|
+        try expectRun(&percent, at(c[1]), c[0]);
+    // a union of ranges takes what any branch takes
+    const either = try compile(a, "{\"anyOf\": [{\"type\": \"integer\", \"minimum\": 10}, {\"type\": \"number\", \"maximum\": -1.5}, {\"type\": \"null\"}]}");
+    for ([_][]const u8{ "10", "-1.5", "-2", "null" }) |t| try expectRun(&either, .complete, t);
+    for ([_][]const u8{ "9", "-1" }) |t| try expectRun(&either, .prefix, t);
+    try expectRun(&either, at(3), "-1.4");
+    try expectRun(&either, at(2), "10.5");
+    const mixed = try compile(a, "{\"type\": [\"integer\", \"number\"], \"minimum\": 0, \"maximum\": 2}");
+    try expectRun(&mixed, .complete, "1.5");
+    try expectRun(&mixed, at(2), "2.5");
+    try expectRun(&mixed, at(0), "-0.0");
+}
diff --git a/zig/src/core/grammar/bytetrie.zig b/zig/src/core/grammar/bytetrie.zig
new file mode 100644
index 00000000..32ab3cb3
--- /dev/null
+++ b/zig/src/core/grammar/bytetrie.zig
@@ -0,0 +1,57 @@
+//! Byte tries for a schema program (its literals and each object's keys), built without recursion.
+const std = @import("std");
+const schema = @import("schema.zig");
+const Allocator = std.mem.Allocator;
+
+/// Each node's texts by index, in order, for a trie of keys.
+pub const Below = struct { spans: std.ArrayList(schema.Span) = .empty, members: std.ArrayList(u16) = .empty };
+
+/// The lists a program's tries live in.
+pub const Lists = struct { a: Allocator, tries: *std.ArrayList(schema.Trie), edges: *std.ArrayList(schema.Edge) };
+
+/// A trie of `texts` appended to the lists, and its root; with `below`, each node records the texts under it.
+pub fn build(l: Lists, texts: []const []const u8, below: ?*Below) Allocator.Error!u32 {
+    const order = try l.a.alloc(u32, texts.len);
+    for (order, 0..) |*o, i| o.* = @intCast(i);
+    std.mem.sort(u32, order, texts, struct {
+        fn less(t: []const []const u8, x: u32, y: u32) bool {
+            return std.mem.order(u8, t[x], t[y]) == .lt;
+        }
+    }.less);
+    const Todo = struct { node: u32, lo: usize, hi: usize, depth: usize };
+    var todo: std.ArrayList(Todo) = .empty;
+    const root = try node(l, order[0..], below);
+    try todo.append(l.a, .{ .node = root, .lo = 0, .hi = order.len, .depth = 0 });
+    while (todo.pop()) |span| {
+        var i = span.lo;
+        // sorted, so the text that ends here (and its repeats) comes first
+        while (i < span.hi and texts[order[i]].len == span.depth) : (i += 1) l.tries.items[span.node].end = true;
+        const first: u32 = @intCast(l.edges.items.len);
+        var j = i;
+        while (j < span.hi) {
+            const b = texts[order[j]][span.depth];
+            var e = j;
+            while (e < span.hi and texts[order[e]][span.depth] == b) e += 1;
+            const to = try node(l, order[j..e], below);
+            try l.edges.append(l.a, .{ .byte = b, .to = to });
+            try todo.append(l.a, .{ .node = to, .lo = j, .hi = e, .depth = span.depth + 1 });
+            j = e;
+        }
+        l.tries.items[span.node].first = first;
+        l.tries.items[span.node].len = @intCast(l.edges.items.len - first);
+    }
+    return root;
+}
+
+/// A new trie node for the texts `order` names; with `below`, it records them in index order.
+fn node(l: Lists, order: []const u32, below: ?*Below) Allocator.Error!u32 {
+    const id: u32 = @intCast(l.tries.items.len);
+    try l.tries.append(l.a, .{ .first = 0, .len = 0, .end = false });
+    if (below) |w| {
+        const first: u32 = @intCast(w.members.items.len);
+        for (order) |i| try w.members.append(l.a, @intCast(i));
+        std.mem.sort(u16, w.members.items[first..], {}, std.sort.asc(u16));
+        try w.spans.append(l.a, .{ .first = first, .len = @intCast(order.len) });
+    }
+    return id;
+}
diff --git a/zig/src/core/grammar/formats.zig b/zig/src/core/grammar/formats.zig
new file mode 100644
index 00000000..444c1d09
--- /dev/null
+++ b/zig/src/core/grammar/formats.zig
@@ -0,0 +1,304 @@
+//! The string formats a schema may name and this engine enforces, from xgrammar 0.2.8's own patterns.
+const std = @import("std");
+
+pub const Format = enum(u8) { date_time, date, time, uuid, ipv4, email };
+
+/// Formats xgrammar 0.2.8 enforces and this engine refuses; any other unknown format is a plain string, as in xgrammar.
+pub const unsupported = [_][]const u8{ "duration", "ipv6", "hostname", "uri", "uri-reference", "uri-template", "json-pointer", "relative-json-pointer" };
+
+const names = [_][]const u8{ "date-time", "date", "time", "uuid", "ipv4", "email" };
+
+/// The format a schema's `format` names, when this engine enforces it.
+pub fn named(text: []const u8) ?Format {
+    for (names, 0..) |n, i| if (std.mem.eql(u8, n, text)) return @fromBackingInt(@intCast(i));
+    return null;
+}
+
+pub fn name(f: Format) []const u8 {
+    return names[@backingInt(f)];
+}
+
+// xgrammar 0.2.8 JSONFormatToRegexPattern without anchors, matched by a string's text; xgrammar's \w is [A-Za-z0-9_].
+const date = "\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2]\\d|3[01])";
+const time = "([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)";
+const decbyte = "(25[0-5]|2[0-4]\\d|[0-1]?\\d?\\d)";
+const atext = "[\\w!#$%&'*+/=?^`{|}~-]";
+const patterns = [_][]const u8{
+    "(" ++ date ++ ")T" ++ time,
+    date,
+    time,
+    "[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}",
+    "(" ++ decbyte ++ "\\.){3}" ++ decbyte,
+    "((" ++ atext ++ "+(\\." ++ atext ++ "+)*)|\\\\\"(\\\\[\\x20-\\x7E]|[\\x20\\x21\\x23-\\x5B\\x5D-\\x7E])*\\\\\")@" ++
+        "([A-Za-z0-9]([\\-A-Za-z0-9]*[A-Za-z0-9])?)((\\.[A-Za-z0-9][\\-A-Za-z0-9]*[A-Za-z0-9])*)",
+};
+
+const tables = blk: {
+    var all: [patterns.len]Nfa = undefined;
+    for (patterns, &all) |p, *n| n.* = compile(p);
+    break :blk all;
+};
+
+/// The automaton of format `f`.
+pub fn nfa(f: Format) *const Nfa {
+    return &tables[@backingInt(f)];
+}
+
+/// A pattern's automaton (Glushkov's): a state is the set of positions the text so far can end on.
+pub const Nfa = struct {
+    /// follow[p]: the positions that may come after position p; follow[63] holds the first positions.
+    follow: [64]u64,
+    /// by_byte[b]: the positions whose character class holds byte b.
+    by_byte: [256]u64,
+    /// The positions a whole match may end on, and `start` when the empty text matches.
+    last: u64,
+
+    /// The state before any byte.
+    pub const start: u64 = 1 << 63;
+
+    /// The state after byte `b`; 0 when no match can go on.
+    pub fn step(n: *const Nfa, state: u64, b: u8) u64 {
+        var next: u64 = 0;
+        var it = state;
+        while (it != 0) : (it &= it - 1) next |= n.follow[@ctz(it)];
+        return next & n.by_byte[b];
+    }
+
+    /// The text so far matches the whole pattern.
+    pub fn accepting(n: *const Nfa, state: u64) bool {
+        return state & n.last != 0;
+    }
+};
+
+const Frag = struct { first: u64 = 0, last: u64 = 0, nullable: bool = true };
+
+/// A pattern of characters, classes, groups, `|`, `?`, `*`, `+` and `{n}` as an automaton, at compile time.
+fn compile(comptime pattern: []const u8) Nfa {
+    @setEvalBranchQuota(1_000_000);
+    var c: Compiler = .{ .text = pattern };
+    const whole = c.alt();
+    if (c.i != pattern.len) @compileError("unexpected ')' in a format pattern");
+    var n: Nfa = .{ .follow = c.follow, .by_byte = c.by_byte, .last = whole.last };
+    n.follow[63] = whole.first;
+    if (whole.nullable) n.last |= Nfa.start;
+    return n;
+}
+
+const Compiler = struct {
+    text: []const u8,
+    i: usize = 0,
+    count: u7 = 0,
+    follow: [64]u64 = @splat(0),
+    by_byte: [256]u64 = @splat(0),
+
+    fn peek(c: *Compiler) u8 {
+        return if (c.i < c.text.len) c.text[c.i] else 0;
+    }
+
+    fn next(c: *Compiler) u8 {
+        const b = c.peek();
+        c.i += 1;
+        return b;
+    }
+
+    fn alt(c: *Compiler) Frag {
+        var f = c.seq();
+        while (c.peek() == '|') {
+            c.i += 1;
+            const g = c.seq();
+            f = .{ .first = f.first | g.first, .last = f.last | g.last, .nullable = f.nullable or g.nullable };
+        }
+        return f;
+    }
+
+    fn seq(c: *Compiler) Frag {
+        var f: Frag = .{};
+        while (c.i < c.text.len and c.peek() != '|' and c.peek() != ')') f = c.concat(f, c.repeat());
+        return f;
+    }
+
+    fn concat(c: *Compiler, f: Frag, g: Frag) Frag {
+        c.link(f.last, g.first);
+        return .{
+            .first = f.first | (if (f.nullable) g.first else 0),
+            .last = g.last | (if (g.nullable) f.last else 0),
+            .nullable = f.nullable and g.nullable,
+        };
+    }
+
+    fn link(c: *Compiler, from: u64, to: u64) void {
+        var it = from;
+        while (it != 0) : (it &= it - 1) c.follow[@ctz(it)] |= to;
+    }
+
+    fn repeat(c: *Compiler) Frag {
+        const at = c.i;
+        var f = c.atom();
+        switch (c.peek()) {
+            '?' => {
+                c.i += 1;
+                f.nullable = true;
+            },
+            '*', '+' => {
+                f.nullable = f.nullable or c.next() == '*';
+                c.link(f.last, f.first);
+            },
+            '{' => {
+                c.i += 1;
+                var times: usize = 0;
+                while (std.ascii.isDigit(c.peek())) times = times * 10 + (c.next() - '0');
+                if (c.next() != '}' or times == 0) @compileError("a format pattern repeats only as {n}");
+                const after = c.i;
+                for (1..times) |_| {
+                    c.i = at; // each copy gets its own positions
+                    f = c.concat(f, c.atom());
+                }
+                c.i = after;
+            },
+            else => {},
+        }
+        return f;
+    }
+
+    fn atom(c: *Compiler) Frag {
+        var set: [256]bool = @splat(false);
+        switch (c.next()) {
+            '(' => {
+                const f = c.alt();
+                if (c.next() != ')') @compileError("a format pattern has an unclosed group");
+                return f;
+            },
+            '[' => {
+                if (c.peek() == '^') @compileError("format patterns have no negated class");
+                while (c.peek() != ']') {
+                    const lo = c.member(&set);
+                    if (lo != null and c.peek() == '-' and c.text[c.i + 1] != ']') {
+                        c.i += 1;
+                        const hi = c.member(&set) orelse @compileError("a class range ends in a class");
+                        for (lo.?..@as(usize, hi) + 1) |b| set[b] = true;
+                    }
+                }
+                c.i += 1;
+            },
+            '\\' => _ = c.escape(&set),
+            else => |b| set[b] = true,
+        }
+        if (c.count == 63) @compileError("a format pattern has more than 63 positions");
+        const bit = @as(u64, 1) << @intCast(c.count);
+        c.count += 1;
+        for (set, 0..) |in, b| if (in) {
+            c.by_byte[b] |= bit;
+        };
+        return .{ .first = bit, .last = bit, .nullable = false };
+    }
+
+    /// A class member: its byte (null for \d and \w, which add a set).
+    fn member(c: *Compiler, set: *[256]bool) ?u8 {
+        const b = c.next();
+        if (b != '\\') {
+            set[b] = true;
+            return b;
+        }
+        return c.escape(set);
+    }
+
+    fn escape(c: *Compiler, set: *[256]bool) ?u8 {
+        switch (c.next()) {
+            'd' => for ('0'..'9' + 1) |b| {
+                set[b] = true;
+            },
+            'w' => for (0..256) |b| {
+                set[b] = std.ascii.isAlphanumeric(@intCast(b)) or b == '_' or set[b];
+            },
+            'x' => {
+                const b = std.fmt.parseInt(u8, c.text[c.i .. c.i + 2], 16) catch @compileError("bad \\x escape");
+                c.i += 2;
+                set[b] = true;
+                return b;
+            },
+            else => |b| {
+                set[b] = true;
+                return b;
+            },
+        }
+        return null;
+    }
+};
+
+fn matches(f: Format, text: []const u8) bool {
+    const n = nfa(f);
+    var s = Nfa.start;
+    for (text) |b| {
+        s = n.step(s, b);
+        if (s == 0) return false;
+    }
+    return n.accepting(s);
+}
+
+test "each format takes its own shapes and refuses near misses" {
+    const cases = [_]struct { Format, []const u8, bool }{
+        .{ .date, "2026-10-26", true },
+        .{ .date, "2026-13-01", false },
+        .{ .date, "2026-02-31", true }, // the pattern does not know month lengths
+        .{ .date, "2026-1-01", false },
+        .{ .date, "02026-10-26", false },
+        .{ .time, "23:59:60Z", true },
+        .{ .time, "23:59:60.123+05:30", true },
+        .{ .time, "24:00:00Z", false },
+        .{ .time, "12:00:00", false },
+        .{ .time, "12:00:00.Z", false },
+        .{ .date_time, "2026-10-26T08:47:00Z", true },
+        .{ .date_time, "2026-10-26T08:47:00.5-07:00", true },
+        .{ .date_time, "2026-10-26 08:47:00Z", false },
+        .{ .date_time, "2026-10-26t08:47:00Z", false },
+        .{ .uuid, "123e4567-E89B-12d3-a456-426614174000", true },
+        .{ .uuid, "123e4567-e89b-12d3-a456-42661417400", false },
+        .{ .uuid, "123e4567e89b12d3a456426614174000", false },
+        .{ .ipv4, "255.255.255.255", true },
+        .{ .ipv4, "0.01.001.9", true },
+        .{ .ipv4, "256.1.1.1", false },
+        .{ .ipv4, "1.1.1", false },
+        .{ .ipv4, "1.1.1.1.", false },
+        .{ .email, "a.b+c@example.com", true },
+        .{ .email, "a@b", true },
+        .{ .email, "a@b.c", false }, // each label after a dot needs two characters
+        .{ .email, "a@b.co", true },
+        .{ .email, "\\\"x y\\\\z\\\"@host", true },
+        .{ .email, "a..b@host", false },
+        .{ .email, "@host", false },
+        .{ .email, "a@-host", false },
+        .{ .email, "a@host-", false },
+    };
+    for (cases) |c| {
+        if (matches(c[0], c[1]) != c[2]) {
+            std.debug.print("{s} {s}: want {}\n", .{ name(c[0]), c[1], c[2] });
+            return error.TestUnexpectedResult;
+        }
+    }
+}
+
+test "no reachable format state may both end and go on with a quote, so a closing quote is never in doubt" {
+    const a = std.testing.allocator;
+    for (0..patterns.len) |i| {
+        const n = nfa(@fromBackingInt(@intCast(i)));
+        var seen: std.AutoArrayHashMapUnmanaged(u64, void) = .empty;
+        defer seen.deinit(a);
+        try seen.put(a, Nfa.start, {});
+        var k: usize = 0;
+        while (k < seen.count()) : (k += 1) {
+            const s = seen.keys()[k];
+            try std.testing.expect(!(n.accepting(s) and n.step(s, '"') != 0));
+            for (0..256) |b| {
+                const t = n.step(s, @intCast(b));
+                if (t != 0) try seen.put(a, t, {});
+            }
+        }
+        try std.testing.expect(seen.count() < 10_000);
+    }
+}
+
+test "format names" {
+    try std.testing.expectEqual(Format.date_time, named("date-time").?);
+    try std.testing.expectEqual(@as(?Format, null), named("ipv6"));
+    try std.testing.expectEqualStrings("email", name(.email));
+}
diff --git a/zig/src/core/grammar/grammar.zig b/zig/src/core/grammar/grammar.zig
new file mode 100644
index 00000000..132a1980
--- /dev/null
+++ b/zig/src/core/grammar/grammar.zig
@@ -0,0 +1,60 @@
+//! Structured output's grammars as byte matchers, and the token table that tests a logits column against one.
+pub const json = @import("json.zig");
+pub const vocab = @import("vocab.zig");
+pub const Vocab = vocab.Vocab;
+pub const schema = @import("schema.zig");
+pub const Program = schema.Program;
+pub const formats = @import("formats.zig");
+pub const schema_match = @import("schema_match.zig");
+
+/// A reply's grammar at its bytes so far: the json_object matcher, or a compiled program's (json_schema, choice).
+pub const Matcher = union(enum) {
+    object: json.Matcher,
+    program: schema_match.Matcher,
+
+    /// json_object without a program.
+    pub fn init(program: ?*const Program) Matcher {
+        return if (program) |p| .{ .program = .init(p) } else .{ .object = .{} };
+    }
+
+    /// Whether `bytes` may come next, without taking them.
+    pub fn accepts(m: *const Matcher, bytes: []const u8) bool {
+        return switch (m.*) {
+            .object => |*o| o.accepts(bytes),
+            .program => |*s| s.accepts(bytes),
+        };
+    }
+
+    /// Takes all of `bytes` and returns true, or takes none of them and returns false.
+    pub fn advance(m: *Matcher, bytes: []const u8) bool {
+        return switch (m.*) {
+            .object => |*o| o.advance(bytes),
+            .program => |*s| s.advance(bytes),
+        };
+    }
+
+    /// The reply may end here.
+    pub fn complete(m: *const Matcher) bool {
+        return switch (m.*) {
+            .object => |*o| o.complete(),
+            .program => |*s| s.complete(),
+        };
+    }
+};
+
+test {
+    _ = json;
+    _ = vocab;
+    _ = formats;
+    _ = @import("bounds.zig");
+    _ = @import("bytetrie.zig");
+    _ = @import("schema_keys.zig");
+    _ = schema;
+    _ = schema_match;
+    _ = @import("schema_test.zig");
+    _ = @import("schema_match_test.zig");
+    _ = @import("bounds_test.zig");
+    _ = @import("json_test.zig");
+    _ = @import("xgrammar_test.zig");
+    _ = @import("xgrammar_schema_test.zig");
+}
diff --git a/zig/src/core/grammar/json.zig b/zig/src/core/grammar/json.zig
new file mode 100644
index 00000000..f953ee59
--- /dev/null
+++ b/zig/src/core/grammar/json.zig
@@ -0,0 +1,276 @@
+//! A byte matcher for xgrammar's json_object grammar: one object, no blank before or after it, at most 32 blanks a run.
+const std = @import("std");
+
+/// Containers nest at most this deep; xgrammar has no limit, and a deeper reply is refused here.
+pub const max_depth = 128;
+/// The most blanks (space, tab, CR, LF) in a row: xgrammar's max_whitespace_cnt as Python 0.6 set it.
+pub const max_blanks = 32;
+
+const words = [_][]const u8{ "true", "false", "null" };
+
+const Lex = enum(u8) {
+    start, // before the object: only its '{'
+    first_key, // after '{': a key or '}'
+    key, // after an object's ',': a key
+    colon, // after a key: ':'
+    value, // after ':' or an array's ',': a value
+    first_item, // after '[': a value or ']'
+    after, // after a value inside a container: ',' or the container's closer
+    string, // inside a string
+    escape, // after a string's backslash
+    hex, // inside a \u escape's four hex digits
+    minus, // a number's '-'
+    zero, // a number's leading 0
+    int, // a number's integer digits after a nonzero first one
+    dot, // a number's '.'
+    frac, // a number's fraction digits
+    exp, // a number's e or E
+    exp_sign, // the exponent's sign
+    exp_digits, // the exponent's digits
+    literal, // inside true, false or null
+    done, // the object has closed: only the end of the reply may follow
+};
+
+/// The state after some bytes of a reply: a small value that callers copy to try bytes without taking them.
+pub const Matcher = struct {
+    lex: Lex = .start,
+    /// The open string is an object's key.
+    key: bool = false,
+    /// Open containers; bit d of `arrays` is set when the container at depth d + 1 is an array.
+    depth: u8 = 0,
+    arrays: u128 = 0,
+    /// Blanks in the current run.
+    blanks: u6 = 0,
+    /// UTF-8 continuation bytes still due in a string, and the range the next one must fall in.
+    need: u2 = 0,
+    lo: u8 = 0x80,
+    hi: u8 = 0xBF,
+    /// A \u escape's digits taken, or bytes of a literal taken.
+    count: u3 = 0,
+    word: u2 = 0,
+
+    /// Takes `b` and returns true, or returns false and leaves the matcher as it was.
+    pub fn step(m: *Matcher, b: u8) bool {
+        var trial = m.*;
+        if (!trial.take(b)) return false;
+        m.* = trial;
+        return true;
+    }
+
+    /// Takes all of `bytes` and returns true, or takes none of them and returns false.
+    pub fn advance(m: *Matcher, bytes: []const u8) bool {
+        var trial = m.*;
+        for (bytes) |b| if (!trial.take(b)) return false;
+        m.* = trial;
+        return true;
+    }
+
+    /// Whether `bytes` may come next, without taking them.
+    pub fn accepts(m: Matcher, bytes: []const u8) bool {
+        var trial = m;
+        for (bytes) |b| if (!trial.take(b)) return false;
+        return true;
+    }
+
+    /// The object has closed: the reply may end here, and no byte may follow.
+    pub fn complete(m: Matcher) bool {
+        return m.lex == .done;
+    }
+
+    fn take(m: *Matcher, b: u8) bool {
+        if (blankable(m.lex) and blank(b)) {
+            if (m.blanks == max_blanks) return false;
+            m.blanks += 1;
+            return true;
+        }
+        m.blanks = 0;
+        return switch (m.lex) {
+            .start => b == '{' and m.open(false),
+            .first_key => if (b == '}') m.close() else m.quote(b),
+            .key => m.quote(b),
+            .colon => m.to(b == ':', .value),
+            .value => m.begin(b),
+            .first_item => if (b == ']') m.close() else m.begin(b),
+            .after => m.next(b),
+            .string => m.char(b),
+            .escape => if (b == 'u') m.hexStart() else m.to(escaped(b), .string),
+            .hex => m.hexDigit(b),
+            .minus, .zero, .int, .dot, .frac, .exp, .exp_sign, .exp_digits => m.number(b),
+            .literal => m.letter(b),
+            .done => false,
+        };
+    }
+
+    fn to(m: *Matcher, ok: bool, lex: Lex) bool {
+        if (ok) m.lex = lex;
+        return ok;
+    }
+
+    /// The innermost open container is an array.
+    fn inArray(m: Matcher) bool {
+        return (m.arrays >> @intCast(m.depth - 1)) & 1 == 1;
+    }
+
+    fn open(m: *Matcher, array: bool) bool {
+        if (m.depth == max_depth) return false;
+        const bit = @as(u128, 1) << @intCast(m.depth);
+        m.arrays = if (array) m.arrays | bit else m.arrays & ~bit;
+        m.depth += 1;
+        m.lex = if (array) .first_item else .first_key;
+        return true;
+    }
+
+    fn close(m: *Matcher) bool {
+        m.depth -= 1;
+        m.lex = if (m.depth == 0) .done else .after;
+        return true;
+    }
+
+    fn quote(m: *Matcher, b: u8) bool {
+        if (b != '"') return false;
+        m.key = true;
+        m.lex = .string;
+        return true;
+    }
+
+    /// A value's first byte.
+    fn begin(m: *Matcher, b: u8) bool {
+        switch (b) {
+            '{' => return m.open(false),
+            '[' => return m.open(true),
+            '"' => {
+                m.key = false;
+                m.lex = .string;
+            },
+            '-' => m.lex = .minus,
+            '0' => m.lex = .zero,
+            '1'...'9' => m.lex = .int,
+            't' => m.literal(0),
+            'f' => m.literal(1),
+            'n' => m.literal(2),
+            else => return false,
+        }
+        return true;
+    }
+
+    /// After a value: a comma, or the innermost container's closer.
+    fn next(m: *Matcher, b: u8) bool {
+        const array = m.inArray();
+        if (b == ',') return m.to(true, if (array) .value else .key);
+        if (b == @as(u8, if (array) ']' else '}')) return m.close();
+        return false;
+    }
+
+    /// A number's next byte, as JSON writes numbers: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
+    fn number(m: *Matcher, b: u8) bool {
+        const d = digit(b);
+        const e = b == 'e' or b == 'E';
+        return switch (m.lex) {
+            .minus => if (b == '0') m.to(true, .zero) else m.to(nonzero(b), .int),
+            .zero => if (b == '.') m.to(true, .dot) else if (e) m.to(true, .exp) else m.end(b),
+            .int => if (d) true else if (b == '.') m.to(true, .dot) else if (e) m.to(true, .exp) else m.end(b),
+            .dot => m.to(d, .frac),
+            .frac => if (d) true else if (e) m.to(true, .exp) else m.end(b),
+            .exp => if (b == '+' or b == '-') m.to(true, .exp_sign) else m.to(d, .exp_digits),
+            .exp_sign => m.to(d, .exp_digits),
+            .exp_digits => d or m.end(b),
+            else => unreachable,
+        };
+    }
+
+    /// A number ends at the first byte that cannot extend it; that byte must then follow the value.
+    fn end(m: *Matcher, b: u8) bool {
+        m.lex = .after;
+        return m.take(b);
+    }
+
+    fn literal(m: *Matcher, word: u2) void {
+        m.word = word;
+        m.count = 1;
+        m.lex = .literal;
+    }
+
+    fn letter(m: *Matcher, b: u8) bool {
+        const w = words[m.word];
+        if (b != w[m.count]) return false;
+        m.count += 1;
+        if (m.count == w.len) {
+            m.count = 0;
+            m.lex = .after;
+        }
+        return true;
+    }
+
+    fn hexStart(m: *Matcher) bool {
+        m.count = 0;
+        m.lex = .hex;
+        return true;
+    }
+
+    fn hexDigit(m: *Matcher, b: u8) bool {
+        if (!std.ascii.isHex(b)) return false;
+        m.count += 1;
+        if (m.count == 4) {
+            m.count = 0;
+            m.lex = .string;
+        }
+        return true;
+    }
+
+    /// A string byte: no raw control byte, strict UTF-8 (no overlong form, surrogate, or code point past U+10FFFF).
+    fn char(m: *Matcher, b: u8) bool {
+        if (m.need > 0) {
+            if (b < m.lo or b > m.hi) return false;
+            m.need -= 1;
+            m.lo = 0x80;
+            m.hi = 0xBF;
+            return true;
+        }
+        if (b == '"') return m.to(true, if (m.key) .colon else .after);
+        if (b == '\\') return m.to(true, .escape);
+        switch (b) {
+            0x20...0x7F => {},
+            0xC2...0xDF => m.lead(1, 0x80, 0xBF),
+            0xE0 => m.lead(2, 0xA0, 0xBF),
+            0xE1...0xEC, 0xEE, 0xEF => m.lead(2, 0x80, 0xBF),
+            0xED => m.lead(2, 0x80, 0x9F),
+            0xF0 => m.lead(3, 0x90, 0xBF),
+            0xF1...0xF3 => m.lead(3, 0x80, 0xBF),
+            0xF4 => m.lead(3, 0x80, 0x8F),
+            else => return false,
+        }
+        return true;
+    }
+
+    fn lead(m: *Matcher, need: u2, lo: u8, hi: u8) void {
+        m.need = need;
+        m.lo = lo;
+        m.hi = hi;
+    }
+};
+
+fn blankable(lex: Lex) bool {
+    return switch (lex) {
+        .first_key, .key, .colon, .value, .first_item, .after => true,
+        else => false,
+    };
+}
+
+pub fn blank(b: u8) bool {
+    return b == ' ' or b == '\n' or b == '\r' or b == '\t';
+}
+
+fn digit(b: u8) bool {
+    return b >= '0' and b <= '9';
+}
+
+fn nonzero(b: u8) bool {
+    return b >= '1' and b <= '9';
+}
+
+fn escaped(b: u8) bool {
+    return switch (b) {
+        '"', '\\', '/', 'b', 'f', 'n', 'r', 't' => true,
+        else => false,
+    };
+}
diff --git a/zig/src/core/grammar/json_test.zig b/zig/src/core/grammar/json_test.zig
new file mode 100644
index 00000000..6446506c
--- /dev/null
+++ b/zig/src/core/grammar/json_test.zig
@@ -0,0 +1,276 @@
+//! The json_object matcher: accepted and refused replies, its limits, and random walks that std.json must parse.
+const std = @import("std");
+const json = @import("json.zig");
+const Matcher = json.Matcher;
+
+const Want = union(enum) { complete, prefix, reject: usize };
+
+fn run(bytes: []const u8) Want {
+    var m: Matcher = .{};
+    for (bytes, 0..) |b, i| if (!m.step(b)) return .{ .reject = i };
+    return if (m.complete()) .complete else .prefix;
+}
+
+fn expectRun(want: Want, bytes: []const u8) !void {
+    const got = run(bytes);
+    if (!std.meta.eql(want, got)) {
+        std.debug.print("{f}: want {any}, got {any}\n", .{ std.ascii.hexEscape(bytes, .lower), want, got });
+        return error.TestUnexpectedResult;
+    }
+}
+
+/// `n` copies of `c`.
+fn rep(comptime c: u8, comptime n: usize) [n]u8 {
+    return @splat(c);
+}
+
+fn at(i: usize) Want {
+    return .{ .reject = i };
+}
+
+test "the root is one object with no blank before or after it" {
+    try expectRun(.complete, "{}");
+    try expectRun(.complete, "{\"a\":1}");
+    try expectRun(at(0), " {}");
+    try expectRun(at(0), "\n{}");
+    try expectRun(at(2), "{} ");
+    try expectRun(at(2), "{}\n");
+    try expectRun(at(2), "{}{}");
+    try expectRun(at(0), "[1]");
+    try expectRun(at(0), "\"a\"");
+    try expectRun(at(0), "1");
+    try expectRun(at(0), "null");
+    try expectRun(.prefix, "");
+    try expectRun(.prefix, "{\"a\":[1,{\"b\":2}]");
+}
+
+test "objects and arrays: keys are strings, commas separate, closers match" {
+    try expectRun(.complete, "{\"a\":[],\"b\":{},\"c\":[1,\"x\",true,false,null,{\"d\":[[]]}]}");
+    try expectRun(.complete, "{ \"a\" : 1 , \"b\" :\t2\r\n}");
+    try expectRun(.complete, "{\"a\":[ ],\"b\":{ }}");
+    try expectRun(at(1), "{a:1}");
+    try expectRun(at(1), "{1:2}");
+    try expectRun(at(1), "{,}");
+    try expectRun(at(5), "{\"a\" 1}");
+    try expectRun(at(7), "{\"a\":1,}");
+    try expectRun(at(8), "{\"a\":[1,]}");
+    try expectRun(at(7), "{\"a\":1 2}");
+    try expectRun(at(7), "{\"a\":[1}");
+    try expectRun(at(6), "{\"a\":{]}");
+    try expectRun(at(6), "{\"a\":1]");
+    try expectRun(at(7), "{\"a\":1}}");
+    try expectRun(at(5), "{\"a\":}");
+}
+
+test "strings: escapes, \\u escapes as xgrammar takes them, no raw control byte" {
+    try expectRun(.complete, "{\"a\":\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"}");
+    try expectRun(.complete, "{\"a\":\"\\u00e9\\u00C9\\uFFFF\\u0000\"}");
+    try expectRun(.complete, "{\"\\u0000\":1}");
+    try expectRun(.complete, "{\"a\":\"\\uD83D\\uDE00\"}");
+    // xgrammar's escape rule is any four hex digits, so a lone surrogate half is taken too.
+    try expectRun(.complete, "{\"a\":\"\\ud800\"}");
+    try expectRun(.complete, "{\"a\":\"\\uDC00x\"}");
+    try expectRun(at(7), "{\"a\":\"\\x\"}");
+    try expectRun(at(7), "{\"a\":\"\\U0041\"}");
+    try expectRun(at(10), "{\"a\":\"\\u00G0\"}");
+    try expectRun(at(10), "{\"a\":\"\\u12\"}");
+    try expectRun(.complete, "{\"a\":\"\x7f ~\"}");
+    for ([_]u8{ 0x00, 0x09, 0x0a, 0x0d, 0x1f }) |c| try expectRun(at(6), &[_]u8{ '{', '"', 'a', '"', ':', '"', c, '"', '}' });
+    try expectRun(.prefix, "{\"a\":\"open");
+}
+
+test "strings are strict UTF-8: no overlong form, surrogate or code point past U+10FFFF" {
+    try expectRun(.complete, "{\"a\":\"\xc2\x80\xdf\xbf\xe0\xa0\x80\xe4\xb8\xad\xed\x9f\xbf\xee\x80\x80\xef\xbf\xbf\"}");
+    try expectRun(.complete, "{\"a\":\"\xf0\x90\x80\x80\xf0\x9f\x98\x80\xf3\xbf\xbf\xbf\xf4\x8f\xbf\xbf\"}");
+    try expectRun(.complete, "{\"\xe4\xb8\xad\":1}");
+    try expectRun(at(6), "{\"a\":\"\xc0\xaf\"}");
+    try expectRun(at(6), "{\"a\":\"\xc1\xbf\"}");
+    try expectRun(at(7), "{\"a\":\"\xe0\x80\xaf\"}");
+    try expectRun(at(7), "{\"a\":\"\xe0\x9f\xbf\"}");
+    try expectRun(at(7), "{\"a\":\"\xf0\x8f\xbf\xbf\"}");
+    try expectRun(at(7), "{\"a\":\"\xf4\x90\x80\x80\"}");
+    try expectRun(at(6), "{\"a\":\"\xf5\x80\x80\x80\"}");
+    try expectRun(at(6), "{\"a\":\"\xff\"}");
+    try expectRun(at(6), "{\"a\":\"\x80\"}");
+    try expectRun(at(8), "{\"a\":\"\xe4\xb8\"}");
+    try expectRun(at(7), "{\"a\":\"\xc3A\"}");
+    // xgrammar 0.2.8 takes an encoded surrogate (ED A0..BF); the reply would decode to U+FFFD, so it is refused here.
+    try expectRun(at(7), "{\"a\":\"\xed\xa0\x80\"}");
+    try expectRun(at(7), "{\"a\":\"\xed\xbf\xbf\"}");
+}
+
+test "numbers as JSON writes them" {
+    const good = [_][]const u8{ "0", "-0", "1", "-12", "0.5", "-0.5", "1e5", "1E-5", "1e+05", "1.5E+3", "0e0", "10.01e-1" };
+    for (good) |n| {
+        var buf: [32]u8 = undefined;
+        try expectRun(.complete, try std.fmt.bufPrint(&buf, "{{\"a\":{s}}}", .{n}));
+        try expectRun(.complete, try std.fmt.bufPrint(&buf, "{{\"a\":[{s},{s} ]}}", .{ n, n }));
+    }
+    try expectRun(at(6), "{\"a\":01}");
+    try expectRun(at(7), "{\"a\":-01}");
+    try expectRun(at(7), "{\"a\":1.}");
+    try expectRun(at(5), "{\"a\":.5}");
+    try expectRun(at(5), "{\"a\":+1}");
+    try expectRun(at(6), "{\"a\":-}");
+    try expectRun(at(7), "{\"a\":1e}");
+    try expectRun(at(8), "{\"a\":1e+}");
+    try expectRun(at(7), "{\"a\":1.e5}");
+    try expectRun(at(8), "{\"a\":1.5.2}");
+    try expectRun(at(6), "{\"a\":0x1}");
+    try expectRun(at(6), "{\"a\":--1}");
+}
+
+test "literals" {
+    try expectRun(.complete, "{\"a\":true,\"b\":false,\"c\":null}");
+    try expectRun(at(8), "{\"a\":tru}");
+    try expectRun(at(5), "{\"a\":True}");
+    try expectRun(at(9), "{\"a\":nulll}");
+    try expectRun(.prefix, "{\"a\":nul");
+}
+
+test "a run of exactly 32 blanks is taken in every place, the 33rd is not" {
+    const places = [_][2][]const u8{
+        .{ "{", "}" },           .{ "{", "\"a\":1}" },         .{ "{\"a\"", ":1}" },         .{ "{\"a\":", "1}" },
+        .{ "{\"a\":1", "}" },    .{ "{\"a\":1", ",\"b\":2}" }, .{ "{\"a\":1,", "\"b\":2}" }, .{ "{\"a\":[", "]}" },
+        .{ "{\"a\":[", "1]}" },  .{ "{\"a\":[1", "]}" },       .{ "{\"a\":[1,", "2]}" },     .{ "{\"a\":\"x\"", "}" },
+        .{ "{\"a\":true", "}" }, .{ "{\"a\":{}", "}" },
+    };
+    const mix = " \t\r\n";
+    for (places) |p| for ([_]usize{ 32, 33 }) |n| {
+        var buf: [96]u8 = undefined;
+        @memcpy(buf[0..p[0].len], p[0]);
+        for (0..n) |i| buf[p[0].len + i] = mix[i % mix.len];
+        @memcpy(buf[p[0].len + n ..][0..p[1].len], p[1]);
+        const text = buf[0 .. p[0].len + n + p[1].len];
+        try expectRun(if (n == 32) .complete else at(p[0].len + 32), text);
+    };
+    // Blanks inside a string are text, not a run.
+    try expectRun(.complete, "{\"a\":\"" ++ rep(' ', 40) ++ "\"}");
+}
+
+test "containers nest at most 128 deep" {
+    const deep = "{\"a\":" ++ rep('[', 127) ++ "1" ++ rep(']', 127) ++ "}";
+    try expectRun(.complete, deep);
+    try expectRun(at(5 + 127), "{\"a\":" ++ rep('[', 128));
+    try expectRun(at(5 + 127), "{\"a\":" ++ rep('[', 127) ++ "{");
+    var m: Matcher = .{};
+    try std.testing.expect(m.advance("{\"a\":" ++ rep('[', 127)));
+    try std.testing.expectEqual(@as(u8, json.max_depth), m.depth);
+    try std.testing.expect(m.accepts("]") and m.accepts("1") and m.accepts("\"") and !m.accepts("[") and !m.accepts("{"));
+    try std.testing.expect(m.advance("{}" ++ rep(']', 127) ++ "}") == false);
+    try std.testing.expect(m.advance("{}") == false and m.advance("1" ++ rep(']', 127) ++ "}") and m.complete());
+}
+
+test "a refused byte leaves the matcher as it was; advance takes all or nothing; accepts takes none" {
+    var m: Matcher = .{};
+    try std.testing.expect(m.advance("{\"k\":[1"));
+    const before = m;
+    try std.testing.expect(!m.step('}'));
+    try std.testing.expectEqual(before, m);
+    try std.testing.expect(!m.advance(",2}"));
+    try std.testing.expectEqual(before, m);
+    try std.testing.expect(m.accepts(",2]}") and !m.complete());
+    try std.testing.expectEqual(before, m);
+    try std.testing.expect(m.advance(",2]}") and m.complete());
+}
+
+test "complete only once the object closes, and nothing after it" {
+    const doc = "{\"a\":[1,{\"b\":\"c\"}],\"d\":-1.5e3}";
+    var m: Matcher = .{};
+    for (doc, 0..) |b, i| {
+        try std.testing.expect(!m.complete());
+        try std.testing.expect(m.step(b));
+        try std.testing.expectEqual(i + 1 == doc.len, m.complete());
+    }
+    for (0..256) |b| try std.testing.expect(!m.accepts(&.{@intCast(b)}));
+}
+
+/// The bytes `m` takes next.
+fn allowed(m: Matcher) [256]bool {
+    var out: [256]bool = undefined;
+    for (&out, 0..) |*o, b| o.* = m.accepts(&.{@intCast(b)});
+    return out;
+}
+
+/// A walk's weight for byte `b`: closers and quotes win often, so most walks finish within the budget.
+fn weight(m: Matcher, b: u8, len: usize) u32 {
+    // std.json refuses a lone surrogate escape that xgrammar takes, so walks write none.
+    if (m.lex == .hex and m.count == 0 and (b == 'd' or b == 'D')) return 0;
+    return switch (b) {
+        '}', ']' => 24,
+        '"' => if (m.lex == .string) 6 else 10,
+        ':' => 20,
+        ',' => 5,
+        '{', '[' => if (len > 300 or m.depth > 8) 0 else 4,
+        '0'...'9' => 3,
+        ' ', '\t', '\r', '\n' => 1,
+        '\\' => 3,
+        0x80...0xFF => 1,
+        else => 1,
+    };
+}
+
+fn walk(rng: std.Random, out: []u8) ?[]u8 {
+    var m: Matcher = .{};
+    var n: usize = 0;
+    while (n < out.len) {
+        if (m.complete()) return out[0..n];
+        const ok = allowed(m);
+        var total: u32 = 0;
+        for (ok, 0..) |o, b| total += if (o) weight(m, @intCast(b), n) else 0;
+        if (total == 0) return null;
+        var pick = rng.uintLessThan(u32, total);
+        const b: u8 = for (ok, 0..) |o, c| {
+            const w = if (o) weight(m, @intCast(c), n) else 0;
+            if (pick < w) break @intCast(c);
+            pick -= w;
+        } else unreachable;
+        if (!m.step(b)) unreachable;
+        out[n] = b;
+        n += 1;
+    }
+    return null;
+}
+
+test "random walks over accepted bytes never stall, and every finished walk parses with std.json as an object" {
+    const a = std.testing.allocator;
+    var prng = std.Random.DefaultPrng.init(0x7f4a7c15);
+    var buf: [2048]u8 = undefined;
+    var finished: usize = 0;
+    const walks = 3000;
+    for (0..walks) |_| {
+        var m: Matcher = .{};
+        const doc = walk(prng.random(), &buf) orelse continue;
+        finished += 1;
+        try std.testing.expect(m.advance(doc) and m.complete());
+        const parsed = std.json.parseFromSlice(std.json.Value, a, doc, .{}) catch |e| {
+            std.debug.print("std.json refused {f}: {t}\n", .{ std.ascii.hexEscape(doc, .lower), e });
+            return e;
+        };
+        defer parsed.deinit();
+        try std.testing.expect(parsed.value == .object);
+    }
+    try std.testing.expect(finished * 10 >= walks * 9);
+}
+
+test "no state the matcher reaches is a dead end: something is always allowed until the object closes" {
+    var prng = std.Random.DefaultPrng.init(0x9e3779b9);
+    const rng = prng.random();
+    for (0..2000) |_| {
+        var m: Matcher = .{};
+        for (0..200) |_| {
+            const ok = allowed(m);
+            const count = std.mem.count(bool, &ok, &.{true});
+            try std.testing.expectEqual(m.complete(), count == 0);
+            if (count == 0) break;
+            var pick = rng.uintLessThan(usize, count);
+            for (ok, 0..) |o, b| if (o) {
+                if (pick == 0) {
+                    try std.testing.expect(m.step(@intCast(b)));
+                    break;
+                }
+                pick -= 1;
+            };
+        }
+    }
+}
diff --git a/zig/src/core/grammar/schema.zig b/zig/src/core/grammar/schema.zig
new file mode 100644
index 00000000..a31c2b57
--- /dev/null
+++ b/zig/src/core/grammar/schema.zig
@@ -0,0 +1,586 @@
+//! A JSON schema or guided_choice list as a program with xgrammar 0.2.8's strict semantics, as Python 0.6 used them.
+const std = @import("std");
+const formats = @import("formats.zig");
+const bounds = @import("bounds.zig");
+const bytetrie = @import("bytetrie.zig");
+const keys = @import("schema_keys.zig");
+const Value = std.json.Value;
+const Allocator = std.mem.Allocator;
+
+/// A node's index in Program.nodes.
+pub const Id = u16;
+/// No node: no other keys, no more items.
+pub const none: Id = std.math.maxInt(Id);
+/// The most properties, prefix items or items a count may name: the matcher keeps counts in 16 bits.
+pub const max_count = none - 1;
+/// The most schema levels the compiler follows.
+pub const max_nesting = 128;
+/// A string length with no bound.
+pub const unbounded = std.math.maxInt(u32);
+/// The longest schema text or choice list the compiler takes: a program lives on the server's heap with its request.
+pub const max_text = 1 << 20;
+
+pub const Node = union(enum) {
+    /// Any JSON value.
+    any,
+    object: u32,
+    array: u32,
+    /// Any JSON string.
+    string,
+    /// A string of min to max characters, none of them a quote, a backslash, CR or LF.
+    text: struct { min: u32, max: u32 },
+    format: formats.Format,
+    integer,
+    number,
+    /// An integer or number with bounds: its automaton's start in Program.states.
+    range: u32,
+    /// One of a set of byte strings: enum, const, true and false, null, guided_choice.
+    literal: u32,
+    any_of: u32,
+    /// A $ref, until the compiler replaces it by its target.
+    alias: Id,
+};
+
+/// An object: properties in their order, those not required may be left out, then other keys if allowed.
+pub const Object = struct {
+    props: []const Prop,
+    /// required_from[c]: the first required property at or after property c, props.len for none.
+    required_from: []const u16,
+    /// The values of other keys; none: no other key.
+    additional: Id,
+    /// The trie of the keys after their opening quote, so a key's next byte costs no scan of the properties.
+    trie: u32,
+    /// below[t - trie]: the properties whose keys pass through trie node t, a slice of `members` in order.
+    below: []const Span,
+    members: []const u16,
+};
+
+pub const Span = struct { first: u32, len: u32 };
+
+/// A property: its key as a JSON string, its raw name, and its value's node.
+pub const Prop = struct { key: []const u8, name: []const u8, node: Id };
+
+/// An array: prefix items in order (the array may end after any of them), then `items` if allowed.
+pub const Array = struct { prefix: []const Id, items: Id, min: u16, max: u16 };
+
+/// anyOf, oneOf or a list of types: the branch each first byte starts.
+pub const Union = struct { dispatch: [256]Id };
+
+pub const Trie = struct { first: u32, len: u32, end: bool };
+pub const Edge = struct { byte: u8, to: u32 };
+
+pub const Program = struct {
+    nodes: []const Node,
+    objects: []const Object,
+    arrays: []const Array,
+    unions: []const Union,
+    tries: []const Trie,
+    edges: []const Edge,
+    /// The automata of bounded numbers.
+    states: []const bounds.State,
+    root: Id,
+    /// The trie of true, false and null, for any value.
+    words: u32,
+
+    /// Nodes every program has.
+    pub const any: Id = 0;
+    pub const any_object: Id = 1;
+    pub const any_array: Id = 2;
+    const string: Id = 3;
+    const integer: Id = 4;
+    const number: Id = 5;
+    const boolean: Id = 6;
+    const @"null": Id = 7;
+
+    /// Trie node `t`'s child by byte `b`. A node's edges are in byte order.
+    pub fn child(p: *const Program, t: u32, b: u8) ?u32 {
+        const n = p.tries[t];
+        var lo = n.first;
+        var hi = n.first + n.len;
+        if (n.len <= 8) {
+            for (p.edges[lo..hi]) |e| if (e.byte == b) return e.to;
+            return null;
+        }
+        while (lo < hi) {
+            const mid = lo + (hi - lo) / 2;
+            const e = p.edges[mid];
+            if (e.byte == b) return e.to;
+            if (e.byte < b) lo = mid + 1 else hi = mid;
+        }
+        return null;
+    }
+};
+
+pub const Error = error{ OutOfMemory, Refused };
+
+/// The program for a schema's text, in `a`; on error.Refused, `why` names what this engine cannot enforce, and where.
+pub fn compile(a: Allocator, text: []const u8, why: *[]const u8) Error!Program {
+    var c: Compiler = .{ .a = a, .why = why };
+    try c.init();
+    if (text.len > max_text) return c.fail("the schema is longer than {d} bytes", .{max_text});
+    c.top = std.json.parseFromSliceLeaky(Value, a, text, .{ .parse_numbers = false }) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.DuplicateField => return c.fail("the schema repeats a key", .{}),
+        else => return c.fail("the schema is not JSON this engine reads ({s})", .{@errorName(e)}),
+    };
+    const root = try c.ref(.{ .string = "#" });
+    return c.finish(root);
+}
+
+/// The program for guided_choice: exactly one of `options`, byte for byte, then the end of the reply.
+pub fn choice(a: Allocator, options: []const []const u8) Allocator.Error!Program {
+    var why: []const u8 = "";
+    var c: Compiler = .{ .a = a, .why = &why };
+    // a choice list has no keyword to refuse, and a few nodes
+    return c.options(options) catch |e| switch (e) {
+        error.OutOfMemory => error.OutOfMemory,
+        error.Refused => unreachable,
+    };
+}
+
+const Compiler = struct {
+    a: Allocator,
+    why: *[]const u8,
+    top: Value = .null,
+    nodes: std.ArrayList(Node) = .empty,
+    objects: std.ArrayList(Object) = .empty,
+    arrays: std.ArrayList(Array) = .empty,
+    branches: std.ArrayList([]const Id) = .empty,
+    tries: std.ArrayList(Trie) = .empty,
+    edges: std.ArrayList(Edge) = .empty,
+    numbers: bounds.Table = .{},
+    /// Each literal node's byte strings by its trie, for anyOf to merge.
+    sets: std.AutoHashMapUnmanaged(u32, []const []const u8) = .empty,
+    refs: std.StringHashMapUnmanaged(Id) = .empty,
+    path: std.ArrayList(u8) = .empty,
+    depth: u32 = 0,
+    words: u32 = 0,
+
+    fn options(c: *Compiler, texts: []const []const u8) Error!Program {
+        try c.init();
+        return c.finish(try c.literal(texts));
+    }
+
+    fn fail(c: *Compiler, comptime fmt: []const u8, args: anytype) Error {
+        c.why.* = try std.fmt.allocPrint(c.a, "{s}: " ++ fmt, .{c.path.items} ++ args);
+        return error.Refused;
+    }
+
+    fn add(c: *Compiler, n: Node) Error!Id {
+        if (c.nodes.items.len >= max_count) return c.fail("the schema needs more than {d} nodes", .{max_count});
+        try c.nodes.append(c.a, n);
+        return @intCast(c.nodes.items.len - 1);
+    }
+
+    fn init(c: *Compiler) Error!void {
+        try c.path.appendSlice(c.a, "#");
+        _ = try c.add(.any);
+        _ = try c.add(.{ .object = try c.objectOf(&.{}, &.{0}, Program.any) });
+        try c.arrays.append(c.a, .{ .prefix = &.{}, .items = Program.any, .min = 0, .max = none });
+        _ = try c.add(.{ .array = 0 });
+        _ = try c.add(.string);
+        _ = try c.add(.integer);
+        _ = try c.add(.number);
+        _ = try c.literal(&.{ "true", "false" });
+        _ = try c.literal(&.{"null"});
+        c.words = try c.trie(&.{ "true", "false", "null" });
+    }
+
+    /// Walks into `segment` of the schema for messages; `back` returns.
+    fn into(c: *Compiler, comptime fmt: []const u8, args: anytype) Error!usize {
+        const mark = c.path.items.len;
+        try c.path.print(c.a, fmt, args);
+        return mark;
+    }
+
+    fn back(c: *Compiler, mark: usize) void {
+        c.path.shrinkRetainingCapacity(mark);
+    }
+
+    fn sub(c: *Compiler, v: Value, comptime fmt: []const u8, args: anytype) Error!Id {
+        const mark = try c.into(fmt, args);
+        defer c.back(mark);
+        return c.schema(v);
+    }
+
+    /// One schema in xgrammar's keyword order: $ref, const, enum, anyOf, oneOf, allOf, type, then untyped ones.
+    fn schema(c: *Compiler, v: Value) Error!Id {
+        c.depth += 1;
+        defer c.depth -= 1;
+        if (c.depth > max_nesting) return c.fail("the schema nests deeper than {d} levels", .{max_nesting});
+        const s = switch (v) {
+            .bool => |b| return if (b) Program.any else c.fail("the schema false accepts no value", .{}),
+            .object => |o| o,
+            else => return c.fail("a schema must be an object or a boolean", .{}),
+        };
+        if (keys.refusal(s)) |k| return c.fail("{s}: {s}", .{ k, keys.advice(k) });
+        if (bounds.given(s)) |k| if (!bounds.placed(s))
+            return c.fail("{s} needs type integer or number, without $ref, const, enum, anyOf, oneOf or allOf: xgrammar ignores it elsewhere", .{k});
+        if (s.get("$ref")) |r| return c.ref(r);
+        if (s.get("const")) |k| return c.values(&.{k});
+        if (s.get("enum")) |e| {
+            if (e != .array or e.array.items.len == 0) return c.fail("enum must be a non-empty list", .{});
+            return c.values(e.array.items);
+        }
+        inline for (.{ "anyOf", "oneOf" }) |word| if (s.get(word)) |o| return c.anyOf(o, word);
+        if (s.get("allOf")) |o| {
+            if (o != .array or o.array.items.len != 1)
+                return c.fail("allOf with other than one schema is not enforced by this engine (xgrammar takes any value)", .{});
+            return c.sub(o.array.items[0], "/allOf/0", .{});
+        }
+        if (s.get("type")) |t| switch (t) {
+            .string => |name| return c.typed(s, name),
+            .array => |types| {
+                if (types.items.len == 0) return c.untyped(s);
+                var ids: std.ArrayList(Id) = .empty;
+                // a repeated type name adds no branch; there are 7 names, so `seen` stays short
+                var seen: std.ArrayList([]const u8) = .empty;
+                for (types.items) |name| {
+                    if (name != .string) return c.fail("type must be a string or a list of strings", .{});
+                    const again = for (seen.items) |prev| {
+                        if (std.mem.eql(u8, prev, name.string)) break true;
+                    } else false;
+                    if (again) continue;
+                    try ids.append(c.a, try c.typed(s, name.string));
+                    try seen.append(c.a, name.string);
+                }
+                return c.union_(ids.items);
+            },
+            else => return c.fail("type must be a string or a list of strings", .{}),
+        };
+        return c.untyped(s);
+    }
+
+    fn untyped(c: *Compiler, s: std.json.ObjectMap) Error!Id {
+        if (s.contains("properties") or s.contains("additionalProperties")) return c.object(s);
+        if (s.contains("items") or s.contains("prefixItems")) return c.array(s);
+        // xgrammar takes any value here and drops these
+        for ([_][]const u8{ "required", "minItems", "maxItems", "minLength", "maxLength", "format" }) |k|
+            if (s.contains(k)) return c.fail("{s} needs a type here: without one xgrammar takes any value", .{k});
+        return Program.any;
+    }
+
+    fn typed(c: *Compiler, s: std.json.ObjectMap, name: []const u8) Error!Id {
+        const eql = std.mem.eql;
+        if (eql(u8, name, "string")) return c.string(s);
+        if (eql(u8, name, "integer")) return if (bounds.given(s) == null) Program.integer else c.bounded(s, true);
+        if (eql(u8, name, "number")) return if (bounds.given(s) == null) Program.number else c.bounded(s, false);
+        if (eql(u8, name, "boolean")) return Program.boolean;
+        if (eql(u8, name, "null")) return Program.null;
+        // a schema with only "type" and annotations is xgrammar's plain object or array: any keys, any items
+        if (eql(u8, name, "object")) return if (keys.plain(s)) Program.any_object else c.object(s);
+        if (eql(u8, name, "array")) return if (keys.plain(s)) Program.any_array else c.array(s);
+        return c.fail("type {s} is not a JSON type", .{name});
+    }
+
+    fn bounded(c: *Compiler, s: std.json.ObjectMap, integer: bool) Error!Id {
+        var why: []const u8 = "";
+        const start = bounds.compile(c.a, &c.numbers, s, integer, &why) catch |e| switch (e) {
+            error.OutOfMemory => return error.OutOfMemory,
+            error.Refused => return c.fail("{s}", .{why}),
+        };
+        return c.add(.{ .range = start });
+    }
+
+    /// A non-negative count, as xgrammar reads one: an integer that fits in 64 bits.
+    fn count(c: *Compiler, s: std.json.ObjectMap, comptime word: []const u8) Error!?i64 {
+        const v = s.get(word) orelse return null;
+        return keys.int64(v) orelse return c.fail(word ++ " must be an integer", .{});
+    }
+
+    fn string(c: *Compiler, s: std.json.ObjectMap) Error!Id {
+        const limit = std.math.maxInt(i32);
+        var min: u32 = 0;
+        var max: u32 = unbounded;
+        if (try c.count(s, "minLength")) |n| {
+            if (n < 0 or n > limit) return c.fail("minLength must be from 0 to {d}", .{limit});
+            min = @intCast(n);
+        }
+        if (try c.count(s, "maxLength")) |n| {
+            if (n < 0) return c.fail("maxLength must not be negative", .{});
+            if (n <= limit) max = @intCast(n);
+        }
+        if (min > max) return c.fail("minLength {d} is greater than maxLength {d}", .{ min, max });
+        if (s.get("format")) |f| {
+            if (f != .string) return c.fail("format must be a string", .{});
+            if (formats.named(f.string)) |known| {
+                if (min != 0 or max != unbounded)
+                    return c.fail("format {s} with minLength or maxLength is not enforced: xgrammar drops the lengths", .{f.string});
+                return c.add(.{ .format = known });
+            }
+            for (formats.unsupported) |u| if (std.mem.eql(u8, u, f.string))
+                return c.fail("format {s} is not enforced by this engine", .{f.string});
+            // xgrammar takes an unknown format as a plain string
+        }
+        if (min == 0 and max == unbounded) return Program.string;
+        return c.add(.{ .text = .{ .min = min, .max = max } });
+    }
+
+    fn object(c: *Compiler, s: std.json.ObjectMap) Error!Id {
+        var props: std.ArrayList(Prop) = .empty;
+        if (s.get("properties")) |pv| {
+            if (pv != .object) return c.fail("properties must be an object", .{});
+            if (pv.object.count() > max_count) return c.fail("an object has more than {d} properties", .{max_count});
+            for (pv.object.keys(), pv.object.values()) |name, v| {
+                var key: std.ArrayList(u8) = .empty;
+                try keys.writeString(c.a, &key, name);
+                if (key.items.len > 60_000) return c.fail("a property name is longer than this engine takes", .{});
+                const node = try c.sub(v, "/properties/{s}", .{name});
+                try props.append(c.a, .{ .key = key.items, .name = name, .node = node });
+            }
+        }
+        const required = try c.a.alloc(bool, props.items.len);
+        @memset(required, false);
+        if (s.get("required")) |r| {
+            if (r != .array) return c.fail("required must be a list of strings", .{});
+            for (r.array.items) |name| {
+                if (name != .string) return c.fail("required must be a list of strings", .{});
+                const at = for (props.items, 0..) |p, i| {
+                    if (std.mem.eql(u8, p.name, name.string)) break i;
+                } else return c.fail("required names {s}, which properties does not define", .{name.string});
+                required[at] = true;
+            }
+        }
+        var additional = none;
+        if (s.get("additionalProperties")) |ap| switch (ap) {
+            .bool => |b| additional = if (b) Program.any else none,
+            else => additional = try c.sub(ap, "/additionalProperties", .{}),
+        };
+        if (additional != none) for (props.items) |p| if (!keys.bare(p.name))
+            return c.fail("beside additionalProperties a property name must be printable ASCII without a quote or backslash: {s}", .{p.name});
+        const from = try c.a.alloc(u16, props.items.len + 1);
+        from[props.items.len] = @intCast(props.items.len);
+        var i = props.items.len;
+        while (i > 0) {
+            i -= 1;
+            from[i] = if (required[i]) @intCast(i) else from[i + 1];
+        }
+        return c.add(.{ .object = try c.objectOf(props.items, from, additional) });
+    }
+
+    fn objectOf(c: *Compiler, props: []const Prop, from: []const u16, additional: Id) Error!u32 {
+        const texts = try c.a.alloc([]const u8, props.len);
+        for (props, texts) |p, *t| t.* = p.key[1..];
+        var below: bytetrie.Below = .{};
+        const root = try c.trieOf(texts, &below);
+        try c.objects.append(c.a, .{
+            .props = props,
+            .required_from = from,
+            .additional = additional,
+            .trie = root,
+            .below = below.spans.items,
+            .members = below.members.items,
+        });
+        return @intCast(c.objects.items.len - 1);
+    }
+
+    fn array(c: *Compiler, s: std.json.ObjectMap) Error!Id {
+        var prefix: std.ArrayList(Id) = .empty;
+        if (s.get("prefixItems")) |pi| {
+            if (pi != .array) return c.fail("prefixItems must be a list", .{});
+            if (pi.array.items.len > max_count) return c.fail("prefixItems has more than {d} schemas", .{max_count});
+            for (pi.array.items, 0..) |item, i| {
+                if (item != .object) return c.fail("prefixItems must be a list of schema objects", .{});
+                try prefix.append(c.a, try c.sub(item, "/prefixItems/{d}", .{i}));
+            }
+        }
+        var items = none;
+        if (s.get("items")) |it| switch (it) {
+            .bool => |b| items = if (b) Program.any else none,
+            .object => items = try c.sub(it, "/items", .{}),
+            else => return c.fail("items must be a boolean or a schema object", .{}),
+        };
+        const min: i64 = @max(0, try c.count(s, "minItems") orelse 0);
+        var max: i64 = -1;
+        if (try c.count(s, "maxItems")) |n| {
+            if (n < 0) return c.fail("maxItems must not be negative", .{});
+            if (n <= std.math.maxInt(i32)) max = n;
+        }
+        const n: i64 = @intCast(prefix.items.len);
+        if (max != -1 and min > max) return c.fail("minItems {d} is greater than maxItems {d}", .{ min, max });
+        if (max != -1 and max < n) return c.fail("maxItems {d} is less than the {d} prefixItems", .{ max, n });
+        if (items == none and n < min) return c.fail("minItems {d} is more than the {d} prefixItems, and no other item is allowed", .{ min, n });
+        if (min > max_count or max > max_count) return c.fail("minItems and maxItems above {d} are too large for this engine", .{max_count});
+        if (max == -1) max = none;
+        try c.arrays.append(c.a, .{ .prefix = prefix.items, .items = items, .min = @intCast(min), .max = @intCast(max) });
+        return c.add(.{ .array = @intCast(c.arrays.items.len - 1) });
+    }
+
+    /// enum and const: the values as xgrammar writes them.
+    fn values(c: *Compiler, vs: []const Value) Error!Id {
+        const texts = try c.a.alloc([]const u8, vs.len);
+        for (vs, texts) |v, *t| {
+            var out: std.ArrayList(u8) = .empty;
+            keys.write(c.a, &out, v) catch |e| switch (e) {
+                error.OutOfMemory => return error.OutOfMemory,
+                error.Unwritable => return c.fail("enum and const take no number with more than 17 significant digits: xgrammar writes it rounded", .{}),
+            };
+            t.* = out.items;
+        }
+        return c.literal(texts);
+    }
+
+    fn literal(c: *Compiler, texts: []const []const u8) Error!Id {
+        const root = try c.trie(texts);
+        try c.sets.put(c.a, root, texts);
+        return c.add(.{ .literal = root });
+    }
+
+    /// A trie of `texts`, built without recursion (a value may be long).
+    fn trie(c: *Compiler, texts: []const []const u8) Error!u32 {
+        return c.trieOf(texts, null);
+    }
+
+    fn trieOf(c: *Compiler, texts: []const []const u8, below: ?*bytetrie.Below) Error!u32 {
+        return bytetrie.build(.{ .a = c.a, .tries = &c.tries, .edges = &c.edges }, texts, below);
+    }
+
+    fn anyOf(c: *Compiler, o: Value, comptime word: []const u8) Error!Id {
+        if (o != .array or o.array.items.len == 0) return c.fail(word ++ " must be a non-empty list", .{});
+        const ids = try c.a.alloc(Id, o.array.items.len);
+        for (o.array.items, ids, 0..) |item, *id, i| id.* = try c.sub(item, "/" ++ word ++ "/{d}", .{i});
+        return c.union_(ids);
+    }
+
+    fn union_(c: *Compiler, ids: []const Id) Error!Id {
+        try c.branches.append(c.a, ids);
+        return c.add(.{ .any_of = @intCast(c.branches.items.len - 1) });
+    }
+
+    /// A local $ref ("#" or "#/a/b", parts split at '/' as xgrammar splits them), compiled once.
+    fn ref(c: *Compiler, r: Value) Error!Id {
+        if (r != .string) return c.fail("$ref must be a string", .{});
+        const uri = r.string;
+        if (c.refs.get(uri)) |id| return id;
+        var target = c.top;
+        if (!std.mem.eql(u8, uri, "#")) {
+            if (!std.mem.startsWith(u8, uri, "#/")) return c.fail("$ref {s} is not local: this engine follows only # and #/...", .{uri});
+            var parts = std.mem.splitScalar(u8, uri[2..], '/');
+            while (parts.next()) |part| {
+                if (part.len == 0) continue;
+                if (target != .object or !target.object.contains(part)) return c.fail("$ref {s} does not resolve", .{uri});
+                target = target.object.get(part).?;
+            }
+        }
+        const id = try c.add(.{ .alias = none });
+        try c.refs.put(c.a, uri, id);
+        const saved = c.path;
+        c.path = .empty;
+        defer c.path = saved;
+        try c.path.appendSlice(c.a, uri);
+        const to = try c.schema(target); // before the store: compiling may move c.nodes
+        c.nodes.items[id] = .{ .alias = to };
+        return id;
+    }
+
+    fn finish(c: *Compiler, root: Id) Error!Program {
+        c.path.clearRetainingCapacity();
+        try c.path.appendSlice(c.a, "#");
+        const nodes = c.nodes.items; // nothing adds a node until the unions below
+        // each $ref takes its target's node, so the matcher never follows one
+        const targets = try c.a.alloc(Id, nodes.len);
+        for (nodes, 0..) |_, i| {
+            var at: Id = @intCast(i);
+            var steps: usize = 0;
+            while (nodes[at] == .alias) : (steps += 1) {
+                if (steps > nodes.len) return c.fail("a $ref refers only to itself", .{});
+                at = nodes[at].alias;
+            }
+            targets[i] = at;
+        }
+        for (nodes, targets) |*n, t| n.* = nodes[t];
+        const unions = try c.a.alloc(Union, c.branches.items.len);
+        for (unions, 0..) |*u, i| u.* = try c.dispatch(@intCast(i));
+        return .{
+            .nodes = c.nodes.items, // a union may have added a merged literal
+            .objects = c.objects.items,
+            .arrays = c.arrays.items,
+            .unions = unions,
+            .tries = c.tries.items,
+            .edges = c.edges.items,
+            .states = c.numbers.states.items,
+            .root = targets[root],
+            .words = c.words,
+        };
+    }
+
+    /// A union's branch for each first byte (nested unions opened, integer in number, literals merged), or a refusal.
+    fn dispatch(c: *Compiler, u: u32) Error!Union {
+        var all: std.ArrayList(Id) = .empty;
+        try c.flatten(u, &all, 0);
+        // branches with the same node take the same replies, so one of them stands for all
+        var flat: std.ArrayList(Id) = .empty;
+        var seen: std.AutoHashMapUnmanaged(Node, void) = .empty;
+        for (all.items) |b| if (!(try seen.getOrPut(c.a, c.nodes.items[b])).found_existing) try flat.append(c.a, b);
+        var number = false;
+        var texts: std.ArrayList([]const u8) = .empty;
+        for (flat.items) |b| switch (c.nodes.items[b]) {
+            .number => number = true,
+            .literal => |t| try texts.appendSlice(c.a, c.sets.get(t).?),
+            .any => if (flat.items.len > 1) return c.fail("anyOf has a branch that takes any value beside others: this engine needs branches that start with different bytes", .{}),
+            else => {},
+        };
+        var kept: std.ArrayList(Id) = .empty;
+        // integer and bounded replies are numbers too; without number, two or more become one automaton
+        var ints: std.ArrayList(Id) = .empty;
+        for (flat.items) |b| switch (c.nodes.items[b]) {
+            .integer, .range => if (!number) try ints.append(c.a, b),
+            .literal => {},
+            else => try kept.append(c.a, b),
+        };
+        if (ints.items.len == 1) try kept.append(c.a, ints.items[0]);
+        if (ints.items.len > 1) try kept.append(c.a, try c.united(ints.items));
+        if (texts.items.len > 0) try kept.append(c.a, try c.literal(texts.items));
+        var out: Union = .{ .dispatch = @splat(none) };
+        for (kept.items) |b| {
+            const starts = c.firstBytes(b);
+            for (starts, 0..) |yes, byte| if (yes) {
+                if (out.dispatch[byte] != none)
+                    return c.fail("two anyOf, oneOf or type branches can start with '{c}': this engine needs branches that start with different bytes", .{@as(u8, @intCast(byte))});
+                out.dispatch[byte] = b;
+            };
+        }
+        return out;
+    }
+
+    /// One automaton for integer and bounded branches: a reply any of them takes.
+    fn united(c: *Compiler, ids: []const Id) Error!Id {
+        const starts = try c.a.alloc(?u32, ids.len);
+        for (ids, starts) |b, *s| s.* = if (c.nodes.items[b] == .range) c.nodes.items[b].range else null;
+        const start = bounds.unite(c.a, &c.numbers, starts) catch |e| return if (e == error.Refused) c.fail("{s}", .{bounds.too_many}) else e;
+        return c.add(.{ .range = start });
+    }
+
+    fn flatten(c: *Compiler, u: u32, out: *std.ArrayList(Id), depth: usize) Error!void {
+        if (depth > c.branches.items.len) return c.fail("anyOf contains itself", .{});
+        for (c.branches.items[u]) |b| switch (c.nodes.items[b]) {
+            .any_of => |v| try c.flatten(v, out, depth + 1),
+            else => try out.append(c.a, b),
+        };
+    }
+
+    fn firstBytes(c: *Compiler, id: Id) [256]bool {
+        var set: [256]bool = @splat(false);
+        const number = "-0123456789";
+        switch (c.nodes.items[id]) {
+            .any => for ("{[\"tfn" ++ number) |b| {
+                set[b] = true;
+            },
+            .object => set['{'] = true,
+            .array => set['['] = true,
+            .string, .text, .format => set['"'] = true,
+            .integer, .number => for (number) |b| {
+                set[b] = true;
+            },
+            .range => |r| for (number) |b| {
+                set[b] = bounds.step(c.numbers.states.items, r, b) != null;
+            },
+            .literal => |t| {
+                const n = c.tries.items[t];
+                for (c.edges.items[n.first..][0..n.len]) |e| set[e.byte] = true;
+            },
+            .any_of, .alias => unreachable,
+        }
+        return set;
+    }
+};
diff --git a/zig/src/core/grammar/schema_keys.zig b/zig/src/core/grammar/schema_keys.zig
new file mode 100644
index 00000000..0a4b1283
--- /dev/null
+++ b/zig/src/core/grammar/schema_keys.zig
@@ -0,0 +1,221 @@
+//! A schema's keywords as this engine treats them, and the bytes xgrammar matches for a key, an enum value or a const.
+const std = @import("std");
+const Value = std.json.Value;
+const Allocator = std.mem.Allocator;
+
+/// Keys xgrammar 0.2.8 drops before it compares a schema with {"type": "object"} and the other plain types.
+const annotations = [_][]const u8{ "title", "default", "description", "examples", "deprecated", "readOnly", "writeOnly", "$comment", "$schema" };
+
+/// Keywords that constrain a reply and that this engine does not enforce (xgrammar enforces or ignores them): refused.
+const refused = [_][]const u8{
+    "pattern",       "patternProperties", "propertyNames",    "multipleOf",            "minProperties",
+    "maxProperties", "dependentRequired", "dependentSchemas", "dependencies",          "if",
+    "then",          "else",              "not",              "unevaluatedProperties", "unevaluatedItems",
+    "contains",      "minContains",       "maxContains",      "uniqueItems",           "additionalItems",
+    "$dynamicRef",   "$dynamicAnchor",    "$recursiveRef",    "$recursiveAnchor",
+};
+
+/// The first keyword of `schema` that this engine refuses, with why.
+pub fn refusal(schema: std.json.ObjectMap) ?[]const u8 {
+    for (schema.keys()) |k| {
+        for (refused) |r| if (std.mem.eql(u8, k, r)) return k;
+        if (std.mem.eql(u8, k, "nullable")) return k;
+    }
+    return null;
+}
+
+/// What to say about a refused keyword.
+pub fn advice(keyword: []const u8) []const u8 {
+    if (std.mem.eql(u8, keyword, "nullable")) return "nullable is not JSON Schema: use \"type\": [..., \"null\"]";
+    return "it is not enforced by this engine";
+}
+
+/// Whether `key` is an annotation that xgrammar drops before it compares a schema with the plain types.
+pub fn annotation(key: []const u8) bool {
+    for (annotations) |n| if (std.mem.eql(u8, key, n)) return true;
+    return false;
+}
+
+/// `schema` has only annotations and "type": xgrammar then takes any keys or items, not a strict object or array.
+pub fn plain(schema: std.json.ObjectMap) bool {
+    for (schema.keys()) |k| if (!annotation(k) and !std.mem.eql(u8, k, "type")) return false;
+    return true;
+}
+
+/// A number past 17 significant digits, which xgrammar writes rounded ("%.17g"): enum and const do not take it.
+pub const Unwritable = error{Unwritable};
+
+/// The integer a number's text gives, as picojson parses it: integer digits that fit in 64 bits.
+pub fn int64(v: Value) ?i64 {
+    const text = switch (v) {
+        .number_string => |t| t,
+        .integer => |i| return i,
+        else => return null,
+    };
+    if (std.mem.findAny(u8, text, ".eE") != null) return null;
+    return std.fmt.parseInt(i64, text, 10) catch null;
+}
+
+/// Appends `v` as picojson writes an enum or const for xgrammar: compact, int64 in decimal, else "%.f" or "%.17g".
+pub fn write(a: Allocator, out: *std.ArrayList(u8), v: Value) (Allocator.Error || Unwritable)!void {
+    switch (v) {
+        .null => try out.appendSlice(a, "null"),
+        .bool => |b| try out.appendSlice(a, if (b) "true" else "false"),
+        .integer, .float, .number_string => try writeNumber(a, out, v),
+        .string => |s| try writeString(a, out, s),
+        .array => |items| {
+            try out.append(a, '[');
+            for (items.items, 0..) |item, i| {
+                if (i > 0) try out.append(a, ',');
+                try write(a, out, item);
+            }
+            try out.append(a, ']');
+        },
+        .object => |o| {
+            try out.append(a, '{');
+            for (o.keys(), o.values(), 0..) |k, item, i| {
+                if (i > 0) try out.append(a, ',');
+                try writeString(a, out, k);
+                try out.append(a, ':');
+                try write(a, out, item);
+            }
+            try out.append(a, '}');
+        },
+    }
+}
+
+fn writeNumber(a: Allocator, out: *std.ArrayList(u8), v: Value) (Allocator.Error || Unwritable)!void {
+    if (int64(v)) |i| return out.print(a, "{d}", .{i});
+    const x: f64 = switch (v) {
+        .float => |f| f,
+        .number_string => |t| std.fmt.parseFloat(f64, t) catch return error.Unwritable,
+        else => unreachable,
+    };
+    if (!std.math.isFinite(x)) return error.Unwritable;
+    if (std.math.signbit(x)) try out.append(a, '-');
+    var buf: [40]u8 = undefined;
+    const digits, const exp = try decimal(&buf, @abs(x));
+    if (exp < -4 or exp >= 17) {
+        // %e: d.ddd, then the exponent with a sign and at least two digits
+        try out.append(a, digits[0]);
+        if (digits.len > 1) try out.print(a, ".{s}", .{digits[1..]});
+        return out.print(a, "e{c}{d:0>2}", .{ @as(u8, if (exp < 0) '-' else '+'), @abs(exp) });
+    }
+    if (exp < 0) {
+        try out.appendSlice(a, "0.");
+        try out.appendNTimes(a, '0', @intCast(-exp - 1));
+        return out.appendSlice(a, digits);
+    }
+    const whole: usize = @intCast(exp + 1);
+    if (digits.len <= whole) {
+        try out.appendSlice(a, digits);
+        return out.appendNTimes(a, '0', whole - digits.len);
+    }
+    try out.print(a, "{s}.{s}", .{ digits[0..whole], digits[whole..] });
+}
+
+/// The exact digits of `x` (finite, positive or 0) without trailing zeros and the first one's power of ten; 17 at most.
+fn decimal(buf: *[40]u8, x: f64) Unwritable!struct { []const u8, i32 } {
+    if (x == 0) return .{ "0", 0 };
+    const bits: u64 = @bitCast(x);
+    const biased: i32 = @intCast(bits >> 52);
+    var m: u64 = bits & ((1 << 52) - 1);
+    var e: i32 = biased - 1075;
+    if (biased == 0) e = -1074 else m |= 1 << 52;
+    const zeros = @ctz(m);
+    m >>= @intCast(zeros);
+    e += @intCast(zeros);
+    // x = m * 2^e = n * 10^point exactly, when n fits in 128 bits
+    var n: u128 = m;
+    var point: i32 = 0;
+    if (e >= 0) {
+        if (e >= 128 - 53) return error.Unwritable;
+        n = @as(u128, m) << @intCast(e);
+    } else {
+        for (0..@intCast(-e)) |_| n = std.math.mul(u128, n, 5) catch return error.Unwritable;
+        point = e;
+    }
+    while (n % 10 == 0) {
+        n /= 10;
+        point += 1;
+    }
+    const digits = std.fmt.bufPrint(buf, "{d}", .{n}) catch unreachable;
+    if (digits.len > 17) return error.Unwritable;
+    return .{ digits, point + @as(i32, @intCast(digits.len)) - 1 };
+}
+
+/// Appends `s` as picojson writes a string: \" \\ \b \f \n \r \t, \u00XX for other control bytes and DEL, else raw.
+pub fn writeString(a: Allocator, out: *std.ArrayList(u8), s: []const u8) Allocator.Error!void {
+    try out.append(a, '"');
+    for (s) |c| switch (c) {
+        '"' => try out.appendSlice(a, "\\\""),
+        '\\' => try out.appendSlice(a, "\\\\"),
+        0x08 => try out.appendSlice(a, "\\b"),
+        0x0C => try out.appendSlice(a, "\\f"),
+        '\n' => try out.appendSlice(a, "\\n"),
+        '\r' => try out.appendSlice(a, "\\r"),
+        '\t' => try out.appendSlice(a, "\\t"),
+        else => if (c < 0x20 or c == 0x7F) try out.print(a, "\\u{x:0>4}", .{c}) else try out.append(a, c),
+    };
+    try out.append(a, '"');
+}
+
+/// A name spelled the same raw and in JSON; xgrammar keeps other keys from names by raw bytes, so it needs this.
+pub fn bare(key: []const u8) bool {
+    for (key) |c| if (c < 0x20 or c > 0x7E or c == '"' or c == '\\') return false;
+    return true;
+}
+
+fn written(v: []const u8) ![]u8 {
+    const a = std.testing.allocator;
+    const parsed = try std.json.parseFromSlice(Value, a, v, .{ .parse_numbers = false });
+    defer parsed.deinit();
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try write(a, &out, parsed.value);
+    return out.toOwnedSlice(a);
+}
+
+test "enum and const values are written as xgrammar 0.2.8 wrote them" {
+    const a = std.testing.allocator;
+    // from xgrammar's own grammar for each value (tools/zig/xgrammar_schema_corpus.py checks the same)
+    const cases = [_][2][]const u8{
+        .{ "{\"z\": 1, \"a\": [1, 2.50, true, null]}", "{\"z\":1,\"a\":[1,2.5,true,null]}" },
+        .{ "\"a/b\\u007f\\b\\f\\r\\t\\u0001\\\"\\\\\"", "\"a/b\\u007f\\b\\f\\r\\t\\u0001\\\"\\\\\"" },
+        .{ "\"\u{e9}\u{2028}\u{1f600}\"", "\"\u{e9}\u{2028}\u{1f600}\"" },
+        .{ "9007199254740993", "9007199254740993" },
+        .{ "-0", "0" },
+        .{ "-0.0", "-0" },
+        .{ "1.0", "1" },
+        .{ "3.0e2", "300" },
+        .{ "-9223372036854775808", "-9223372036854775808" },
+        .{ "[0.5, -2.25, 0.0001220703125, 0.00006103515625, 1e20, 9007199254740992.0, 1e16, 123456.75]", "[0.5,-2.25,0.0001220703125,6.103515625e-05,1e+20,9007199254740992,10000000000000000,123456.75]" },
+    };
+    for (cases) |c| {
+        const got = try written(c[0]);
+        defer a.free(got);
+        try std.testing.expectEqualStrings(c[1], got);
+    }
+    for ([_][]const u8{ "0.1", "1e100", "9223372036854775808", "1e-7", "[1, 0.3]", "1e400" }) |v|
+        try std.testing.expectError(error.Unwritable, written(v));
+}
+
+test "keywords: refused ones, annotations and the plain-type rule" {
+    const a = std.testing.allocator;
+    const cases = [_]struct { []const u8, ?[]const u8, bool }{
+        .{ "{\"type\": \"object\", \"title\": \"t\", \"description\": \"d\"}", null, true },
+        .{ "{\"type\": \"object\", \"$id\": \"x\"}", null, false },
+        .{ "{\"type\": \"string\", \"pattern\": \"a\"}", "pattern", false },
+        .{ "{\"type\": \"string\", \"nullable\": true}", "nullable", false },
+        .{ "{\"type\": \"array\", \"uniqueItems\": true}", "uniqueItems", false },
+        .{ "{\"x-vendor\": 1}", null, false },
+    };
+    for (cases) |c| {
+        const parsed = try std.json.parseFromSlice(Value, a, c[0], .{});
+        defer parsed.deinit();
+        const got = refusal(parsed.value.object);
+        if (c[1]) |k| try std.testing.expectEqualStrings(k, got.?) else try std.testing.expectEqual(@as(?[]const u8, null), got);
+        try std.testing.expectEqual(c[2], plain(parsed.value.object));
+    }
+    try std.testing.expect(bare("a_b-1 ~") and !bare("a\"b") and !bare("\u{e9}") and !bare("a\\b") and !bare("a\x7f"));
+}
diff --git a/zig/src/core/grammar/schema_match.zig b/zig/src/core/grammar/schema_match.zig
new file mode 100644
index 00000000..09fdf76f
--- /dev/null
+++ b/zig/src/core/grammar/schema_match.zig
@@ -0,0 +1,548 @@
+//! A byte matcher for a program (schema.zig): xgrammar 0.2.8's blanks, at most 32 a run, none around the root value.
+const std = @import("std");
+const schema = @import("schema.zig");
+const formats = @import("formats.zig");
+const bounds = @import("bounds.zig");
+const json = @import("json.zig");
+const Program = schema.Program;
+const Id = schema.Id;
+const none = schema.none;
+
+/// Containers nest at most this deep, as in the json_object matcher; xgrammar has no limit.
+pub const max_depth = json.max_depth;
+pub const max_blanks = json.max_blanks;
+
+/// An open container: its node, and the properties it passed (`tail`: other keys began) or the items it began.
+pub const Frame = struct { node: Id, at: u16 };
+const tail: u16 = std.math.maxInt(u16);
+const no: u16 = std.math.maxInt(u16);
+const gone: u32 = std.math.maxInt(u32);
+
+const Lex = enum(u8) {
+    root, // before the root value
+    obj_open, // after '{': a key's quote or '}'
+    obj_key, // inside a key
+    obj_colon, // after a key: ':'
+    obj_value, // after ':': the value
+    obj_after, // after a value in an object: ',' or '}'
+    obj_next, // after an object's ',': a key's quote
+    arr_open, // after '[': an item or ']'
+    arr_item, // after an array's ',': an item
+    arr_after, // after an item: ',' or ']'
+    string, // inside any string
+    text, // inside a minLength/maxLength string
+    format, // inside a format string
+    literal, // inside an enum, const, choice, true, false or null
+    number,
+    range, // inside a number with bounds: `count` is its automaton's state
+    done, // the root value is complete: only the end of the reply may follow
+};
+const Esc = enum(u2) { none, escape, hex };
+const Num = enum(u8) { minus, zero, int, dot, frac, exp, exp_sign, exp_digits };
+const Body = enum { more, close, bad };
+
+/// The state after some bytes of a reply. Trials copy only this small part; the frames below `cur` stay put.
+const Lexer = struct {
+    lex: Lex = .root,
+    depth: u8 = 0,
+    blanks: u8 = 0,
+    cur: Frame = .{ .node = 0, .at = 0 },
+    /// obj_value: the value's node; string, text, format: the string's node.
+    node: Id = 0,
+    // a string's escape and UTF-8 state
+    esc: Esc = .none,
+    hex: u3 = 0,
+    need: u2 = 0,
+    lo: u8 = 0x80,
+    hi: u8 = 0xBF,
+    // a key: its node in the object's key trie (gone: it starts no key), and whether it can be another key
+    trie: u32 = gone,
+    free: bool = false,
+    num: Num = .minus,
+    integer: bool = false,
+    /// text: characters taken; literal: the trie node; range: the automaton's state.
+    count: u32 = 0,
+    nfa: u64 = 0,
+
+    fn take(lx: *Lexer, p: *const Program, st: anytype, b: u8) bool {
+        switch (lx.lex) {
+            .root => return lx.begin(p, st, p.root, b),
+            .obj_open, .obj_colon, .obj_value, .obj_after, .obj_next, .arr_open, .arr_item, .arr_after => {
+                if (json.blank(b)) {
+                    if (lx.blanks == lx.blankLimit(p)) return false;
+                    lx.blanks += 1;
+                    return true;
+                }
+                const run = lx.blanks;
+                lx.blanks = 0;
+                return lx.token(p, st, b, run);
+            },
+            .obj_key => return lx.key(p, b),
+            .string => return switch (lx.body(b)) {
+                .more => true,
+                .close => lx.finish(p),
+                .bad => false,
+            },
+            .text => return lx.textByte(p, b),
+            .format => {
+                const n = formats.nfa(p.nodes[lx.node].format);
+                if (b == '"' and n.accepting(lx.nfa)) return lx.finish(p);
+                lx.nfa = n.step(lx.nfa, b);
+                return lx.nfa != 0;
+            },
+            .literal => {
+                if (p.child(lx.count, b)) |t| {
+                    lx.count = t;
+                    return true;
+                }
+                return p.tries[lx.count].end and lx.end(p, st, b);
+            },
+            .number => return lx.numberByte(p, st, b),
+            .range => {
+                lx.count = bounds.step(p.states, lx.count, b) orelse return p.states[lx.count].accept and lx.end(p, st, b);
+                return true;
+            },
+            .done => return false,
+        }
+    }
+
+    /// xgrammar writes an empty array with prefixItems and no minItems as '[' blanks blanks ']': two runs.
+    fn blankLimit(lx: *const Lexer, p: *const Program) u8 {
+        if (lx.lex != .arr_open) return max_blanks;
+        const a = arr(p, lx.cur);
+        return if (a.prefix.len > 0 and a.min == 0) 2 * max_blanks else max_blanks;
+    }
+
+    /// The first byte after the blanks between JSON tokens; `run` is how many blanks came before it.
+    fn token(lx: *Lexer, p: *const Program, st: anytype, b: u8, run: u8) bool {
+        switch (lx.lex) {
+            .obj_open => return switch (b) {
+                '"' => lx.keyStart(p),
+                '}' => lx.closes(p) and lx.close(p, st),
+                else => false,
+            },
+            .obj_next => return b == '"' and lx.keyStart(p),
+            .obj_colon => {
+                if (b != ':') return false;
+                lx.lex = .obj_value;
+                return true;
+            },
+            .obj_value => return lx.begin(p, st, lx.node, b),
+            .obj_after => return switch (b) {
+                ',' => lx.opens(p) and lx.to(.obj_next),
+                '}' => lx.closes(p) and lx.close(p, st),
+                else => false,
+            },
+            .arr_open => {
+                const a = arr(p, lx.cur);
+                if (b == ']') return a.min == 0 and lx.close(p, st);
+                return run <= max_blanks and (a.prefix.len > 0 or (a.items != none and a.max != 0)) and lx.item(p, st, b);
+            },
+            .arr_item => return lx.item(p, st, b),
+            .arr_after => {
+                const a = arr(p, lx.cur);
+                const n = lx.cur.at;
+                return switch (b) {
+                    ',' => (n < a.prefix.len or (a.items != none and (a.max == none or n < a.max))) and lx.to(.arr_item),
+                    ']' => n >= a.min and lx.close(p, st),
+                    else => false,
+                };
+            },
+            else => unreachable,
+        }
+    }
+
+    fn to(lx: *Lexer, lex: Lex) bool {
+        lx.lex = lex;
+        return true;
+    }
+
+    /// A value of `node` starts with byte `b`.
+    fn begin(lx: *Lexer, p: *const Program, st: anytype, node: Id, b: u8) bool {
+        switch (p.nodes[node]) {
+            .any => return switch (b) {
+                '{' => lx.push(st, Program.any_object, .obj_open),
+                '[' => lx.push(st, Program.any_array, .arr_open),
+                '"' => lx.open(.string, node),
+                '-', '0'...'9' => lx.numberStart(b, false),
+                else => lx.literalStart(p, p.words, b),
+            },
+            .object => return b == '{' and lx.push(st, node, .obj_open),
+            .array => return b == '[' and lx.push(st, node, .arr_open),
+            .string => return b == '"' and lx.open(.string, node),
+            .text => return b == '"' and lx.open(.text, node),
+            .format => return b == '"' and lx.open(.format, node),
+            .integer => return lx.numberStart(b, true),
+            .number => return lx.numberStart(b, false),
+            .range => |s| {
+                lx.count = bounds.step(p.states, s, b) orelse return false;
+                lx.lex = .range;
+                return true;
+            },
+            .literal => |t| return lx.literalStart(p, t, b),
+            .any_of => |u| {
+                const branch = p.unions[u].dispatch[b];
+                return branch != none and lx.begin(p, st, branch, b);
+            },
+            .alias => unreachable,
+        }
+    }
+
+    fn open(lx: *Lexer, lex: Lex, node: Id) bool {
+        lx.lex = lex;
+        lx.node = node;
+        lx.esc = .none;
+        lx.need = 0;
+        lx.count = 0;
+        lx.nfa = formats.Nfa.start;
+        return true;
+    }
+
+    fn push(lx: *Lexer, st: anytype, node: Id, lex: Lex) bool {
+        if (lx.depth == max_depth) return false;
+        if (lx.depth > 0 and !st.save(lx.depth - 1, lx.cur)) return false;
+        lx.cur = .{ .node = node, .at = 0 };
+        lx.depth += 1;
+        lx.lex = lex;
+        lx.blanks = 0;
+        return true;
+    }
+
+    /// The innermost container closes, and so ends as a value.
+    fn close(lx: *Lexer, p: *const Program, st: anytype) bool {
+        lx.depth -= 1;
+        if (lx.depth > 0) lx.cur = st.load(lx.depth - 1);
+        return lx.finish(p);
+    }
+
+    /// A value has ended: its container's ',' or closer may follow, or nothing after the root value.
+    fn finish(lx: *Lexer, p: *const Program) bool {
+        lx.blanks = 0;
+        lx.lex = if (lx.depth == 0) .done else if (p.nodes[lx.cur.node] == .object) .obj_after else .arr_after;
+        return true;
+    }
+
+    /// A number or literal ends at the first byte that cannot extend it; that byte must then follow the value.
+    fn end(lx: *Lexer, p: *const Program, st: anytype, b: u8) bool {
+        _ = lx.finish(p);
+        return lx.take(p, st, b);
+    }
+
+    fn item(lx: *Lexer, p: *const Program, st: anytype, b: u8) bool {
+        const a = arr(p, lx.cur);
+        const n = lx.cur.at;
+        const node = if (n < a.prefix.len) a.prefix[n] else a.items;
+        lx.cur.at = n +| 1;
+        return node != none and lx.begin(p, st, node, b);
+    }
+
+    /// After a value in an object, another key may come: a property still ahead, or another key.
+    fn opens(lx: *const Lexer, p: *const Program) bool {
+        const o = obj(p, lx.cur);
+        const c = lx.cur.at;
+        if (c == tail) return true;
+        return c < o.props.len or (o.additional != none and o.required_from[c] == o.props.len);
+    }
+
+    /// The object may close: no required property is still ahead.
+    fn closes(lx: *const Lexer, p: *const Program) bool {
+        const o = obj(p, lx.cur);
+        const c = lx.cur.at;
+        return c == tail or o.required_from[c] == o.props.len;
+    }
+
+    fn keyStart(lx: *Lexer, p: *const Program) bool {
+        const o = obj(p, lx.cur);
+        const c = lx.cur.at;
+        const free = o.additional != none and (c == tail or o.required_from[c] == o.props.len);
+        if ((c == tail or c >= o.props.len) and !free) return false;
+        lx.trie = o.trie;
+        lx.free = free;
+        lx.esc = .none;
+        lx.need = 0;
+        lx.lex = .obj_key;
+        return true;
+    }
+
+    /// A key's next byte: a property up to the next required one, or (if allowed) another key that is no name.
+    fn key(lx: *Lexer, p: *const Program, b: u8) bool {
+        const o = obj(p, lx.cur);
+        const t: u32 = if (lx.trie == gone) gone else p.child(lx.trie, b) orelse gone;
+        const cand = if (t == gone) no else ahead(o, t, lx.cur.at);
+        // the key so far, closing quote included, is a property's key
+        const whole = t != gone and p.tries[t].end;
+        var free = lx.free;
+        var other = false;
+        if (free) {
+            switch (lx.body(b)) {
+                .bad => free = false,
+                // xgrammar keeps every name, passed or ahead, from other keys; names are bare (schema_keys.bare)
+                .close => if (whole) {
+                    free = false;
+                } else {
+                    other = true;
+                },
+                .more => {},
+            }
+        }
+        if (cand != no and whole) {
+            lx.cur.at = cand + 1;
+            lx.node = o.props[cand].node;
+            lx.lex = .obj_colon;
+            return true;
+        }
+        if (other) {
+            lx.cur.at = tail;
+            lx.node = o.additional;
+            lx.lex = .obj_colon;
+            return true;
+        }
+        if (cand == no and !free) return false;
+        lx.trie = t;
+        lx.free = free;
+        return true;
+    }
+
+    /// A JSON string's next byte: no raw control byte, strict UTF-8 (as the json_object matcher).
+    fn body(lx: *Lexer, b: u8) Body {
+        if (lx.need > 0) return if (lx.continuation(b)) .more else .bad;
+        switch (lx.esc) {
+            .escape => {
+                if (b == 'u') {
+                    lx.esc = .hex;
+                    lx.hex = 0;
+                } else if (escaped(b)) lx.esc = .none else return .bad;
+                return .more;
+            },
+            .hex => {
+                if (!std.ascii.isHex(b)) return .bad;
+                lx.hex += 1;
+                if (lx.hex == 4) lx.esc = .none;
+                return .more;
+            },
+            .none => {},
+        }
+        return switch (b) {
+            '"' => .close,
+            '\\' => blk: {
+                lx.esc = .escape;
+                break :blk .more;
+            },
+            0x20...0x21, 0x23...0x5B, 0x5D...0x7F => .more,
+            else => if (lx.lead(b)) .more else .bad,
+        };
+    }
+
+    /// A minLength/maxLength string's byte: xgrammar's [^"\\\r\n] by character, no escape, other control bytes taken.
+    fn textByte(lx: *Lexer, p: *const Program, b: u8) bool {
+        if (lx.need > 0) return lx.continuation(b);
+        const t = p.nodes[lx.node].text;
+        if (b == '"') return lx.count >= t.min and lx.finish(p);
+        if (b == '\\' or b == '\r' or b == '\n' or lx.count == t.max) return false;
+        if (b >= 0x80 and !lx.lead(b)) return false;
+        lx.count += 1;
+        return true;
+    }
+
+    fn continuation(lx: *Lexer, b: u8) bool {
+        if (b < lx.lo or b > lx.hi) return false;
+        lx.need -= 1;
+        lx.lo = 0x80;
+        lx.hi = 0xBF;
+        return true;
+    }
+
+    /// A UTF-8 lead byte: no overlong form, surrogate, or code point past U+10FFFF.
+    fn lead(lx: *Lexer, b: u8) bool {
+        const n: struct { u2, u8, u8 } = switch (b) {
+            0xC2...0xDF => .{ 1, 0x80, 0xBF },
+            0xE0 => .{ 2, 0xA0, 0xBF },
+            0xE1...0xEC, 0xEE, 0xEF => .{ 2, 0x80, 0xBF },
+            0xED => .{ 2, 0x80, 0x9F },
+            0xF0 => .{ 3, 0x90, 0xBF },
+            0xF1...0xF3 => .{ 3, 0x80, 0xBF },
+            0xF4 => .{ 3, 0x80, 0x8F },
+            else => return false,
+        };
+        lx.need = n[0];
+        lx.lo = n[1];
+        lx.hi = n[2];
+        return true;
+    }
+
+    fn literalStart(lx: *Lexer, p: *const Program, t: u32, b: u8) bool {
+        lx.count = p.child(t, b) orelse return false;
+        lx.lex = .literal;
+        return true;
+    }
+
+    fn numberStart(lx: *Lexer, b: u8, integer: bool) bool {
+        lx.num = switch (b) {
+            '-' => .minus,
+            '0' => .zero,
+            '1'...'9' => .int,
+            else => return false,
+        };
+        lx.integer = integer;
+        lx.lex = .number;
+        return true;
+    }
+
+    /// number: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?; integer: 0|-?[1-9][0-9]* (xgrammar refuses -0).
+    fn numberByte(lx: *Lexer, p: *const Program, st: anytype, b: u8) bool {
+        const d = std.ascii.isDigit(b);
+        const dot = !lx.integer and b == '.';
+        const e = !lx.integer and (b == 'e' or b == 'E');
+        switch (lx.num) {
+            .minus => lx.num = if (b == '0' and !lx.integer) .zero else if (b >= '1' and b <= '9') .int else return false,
+            .zero => lx.num = if (dot) .dot else if (e) .exp else return lx.end(p, st, b),
+            .int => lx.num = if (d) .int else if (dot) .dot else if (e) .exp else return lx.end(p, st, b),
+            .dot => lx.num = if (d) .frac else return false,
+            .frac => lx.num = if (d) .frac else if (e) .exp else return lx.end(p, st, b),
+            .exp => lx.num = if (b == '+' or b == '-') .exp_sign else if (d) .exp_digits else return false,
+            .exp_sign => lx.num = if (d) .exp_digits else return false,
+            .exp_digits => if (!d) return lx.end(p, st, b),
+        }
+        return true;
+    }
+
+    fn complete(lx: *const Lexer, p: *const Program) bool {
+        return switch (lx.lex) {
+            .done => true,
+            .number => lx.depth == 0 and switch (lx.num) {
+                .zero, .int, .frac, .exp_digits => true,
+                else => false,
+            },
+            .literal => lx.depth == 0 and p.tries[lx.count].end,
+            .range => lx.depth == 0 and p.states[lx.count].accept,
+            else => false,
+        };
+    }
+};
+
+fn obj(p: *const Program, f: Frame) *const schema.Object {
+    return &p.objects[p.nodes[f.node].object];
+}
+
+fn arr(p: *const Program, f: Frame) schema.Array {
+    return p.arrays[p.nodes[f.node].array];
+}
+
+/// The first property from `c` up to the next required one whose key passes through key-trie node `t`, or `no`.
+fn ahead(o: *const schema.Object, t: u32, c: u16) u16 {
+    // after the last property every list ends before c, so only `tail` needs a test
+    if (c == tail) return no;
+    const span = o.below[t - o.trie];
+    const list = o.members[span.first..][0..span.len];
+    // the members are in property order: find the first at or after c
+    var lo: usize = 0;
+    var hi: usize = list.len;
+    while (lo < hi) {
+        const mid = lo + (hi - lo) / 2;
+        if (list[mid] < c) lo = mid + 1 else hi = mid;
+    }
+    // past a required property the key cannot be a later one
+    return if (lo < list.len and list[lo] <= o.required_from[c]) list[lo] else no;
+}
+
+fn escaped(b: u8) bool {
+    return switch (b) {
+        '"', '\\', '/', 'b', 'f', 'n', 'r', 't' => true,
+        else => false,
+    };
+}
+
+/// The frames below the innermost container, in the matcher.
+const Own = struct {
+    frames: *[max_depth]Frame,
+
+    fn save(s: *Own, at: usize, f: Frame) bool {
+        s.frames[at] = f;
+        return true;
+    }
+
+    fn load(s: *Own, at: usize) Frame {
+        return s.frames[at];
+    }
+};
+
+/// The frames below the innermost container for a trial: the matcher's, read only, under a few new ones.
+const Overlay = struct {
+    base: *const [max_depth]Frame,
+    /// The matcher's frames still below.
+    keep: usize,
+    local: [8]Frame = undefined,
+    n: usize = 0,
+    /// More containers opened than `local` holds: the trial must run on a whole copy.
+    full: bool = false,
+
+    fn save(s: *Overlay, at: usize, f: Frame) bool {
+        std.debug.assert(at == s.keep + s.n);
+        if (s.n == s.local.len) {
+            s.full = true;
+            return false;
+        }
+        s.local[s.n] = f;
+        s.n += 1;
+        return true;
+    }
+
+    fn load(s: *Overlay, at: usize) Frame {
+        std.debug.assert(at + 1 == s.keep + s.n);
+        if (s.n > 0) {
+            s.n -= 1;
+            return s.local[s.n];
+        }
+        s.keep -= 1;
+        return s.base[s.keep];
+    }
+};
+
+/// The state after some bytes of a reply under a program. `accepts` tries bytes without copying the frames.
+pub const Matcher = struct {
+    program: *const Program,
+    lexer: Lexer = .{},
+    frames: [max_depth]Frame = undefined,
+
+    pub fn init(p: *const Program) Matcher {
+        return .{ .program = p };
+    }
+
+    /// Takes `b` and returns true, or returns false and leaves the matcher as it was.
+    pub fn step(m: *Matcher, b: u8) bool {
+        var lx = m.lexer;
+        // one byte opens or closes at most one container, so a refused byte leaves the frames below intact
+        var own: Own = .{ .frames = &m.frames };
+        if (!lx.take(m.program, &own, b)) return false;
+        m.lexer = lx;
+        return true;
+    }
+
+    /// Takes all of `bytes` and returns true, or takes none of them and returns false.
+    pub fn advance(m: *Matcher, bytes: []const u8) bool {
+        if (!m.accepts(bytes)) return false;
+        for (bytes) |b| {
+            const took = m.step(b);
+            std.debug.assert(took);
+        }
+        return true;
+    }
+
+    /// Whether `bytes` may come next, without taking them.
+    pub fn accepts(m: *const Matcher, bytes: []const u8) bool {
+        var lx = m.lexer;
+        var trial: Overlay = .{ .base = &m.frames, .keep = if (lx.depth > 0) lx.depth - 1 else 0 };
+        for (bytes) |b| if (!lx.take(m.program, &trial, b)) {
+            if (!trial.full) return false;
+            var copy = m.*;
+            for (bytes) |c| if (!copy.step(c)) return false;
+            return true;
+        };
+        return true;
+    }
+
+    /// The root value is complete: the reply may end here.
+    pub fn complete(m: *const Matcher) bool {
+        return m.lexer.complete(m.program);
+    }
+};
diff --git a/zig/src/core/grammar/schema_match_test.zig b/zig/src/core/grammar/schema_match_test.zig
new file mode 100644
index 00000000..d922cae3
--- /dev/null
+++ b/zig/src/core/grammar/schema_match_test.zig
@@ -0,0 +1,558 @@
+//! The program matcher: hand cases, limits, trials against steps, and random walks a separate validator accepts.
+const std = @import("std");
+const schema = @import("schema.zig");
+const keys = @import("schema_keys.zig");
+const formats = @import("formats.zig");
+const Matcher = @import("schema_match.zig").Matcher;
+const Value = std.json.Value;
+const Allocator = std.mem.Allocator;
+
+const Want = union(enum) { complete, prefix, reject: usize };
+
+fn run(p: *const schema.Program, bytes: []const u8) Want {
+    var m: Matcher = .init(p);
+    for (bytes, 0..) |b, i| if (!m.step(b)) return .{ .reject = i };
+    return if (m.complete()) .complete else .prefix;
+}
+
+fn expectRun(p: *const schema.Program, want: Want, bytes: []const u8) !void {
+    const got = run(p, bytes);
+    if (!std.meta.eql(want, got)) {
+        std.debug.print("{s}: want {any}, got {any}\n", .{ bytes, want, got });
+        return error.TestUnexpectedResult;
+    }
+}
+
+/// `n` copies of `c`.
+fn rep(comptime c: u8, comptime n: usize) [n]u8 {
+    return @splat(c);
+}
+
+fn at(i: usize) Want {
+    return .{ .reject = i };
+}
+
+fn compile(a: Allocator, text: []const u8) !schema.Program {
+    var why: []const u8 = "";
+    return schema.compile(a, text, &why) catch |e| {
+        std.debug.print("{s}: {s}\n", .{ text, why });
+        return e;
+    };
+}
+
+const signal =
+    \\{"type": "object", "additionalProperties": false, "required": ["action", "confidence", "pair"],
+    \\ "properties": {"action": {"type": "string", "enum": ["buy", "sell", "hold"]}, "confidence": {"type": "number"},
+    \\ "pair": {"type": "string"}}}
+;
+
+test "a trade signal schema: its keys in order, an enum value, no other key, blanks only between tokens" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const p = try compile(arena.allocator(), signal);
+    try expectRun(&p, .complete, "{\"action\":\"buy\",\"confidence\":0.72,\"pair\":\"BTC/USD\"}");
+    try expectRun(&p, .complete, "{ \"action\" : \"hold\" ,\n\t\"confidence\": -1e-3, \"pair\": \"\\u00e9\" }");
+    try expectRun(&p, at(0), " {\"action\":\"buy\"");
+    try expectRun(&p, at(2), "{\"confidence\":1,\"action\":\"buy\",\"pair\":\"x\"}");
+    try expectRun(&p, at(12), "{\"action\":\"short\"}");
+    try expectRun(&p, at(16), "{\"action\":\"sell\"}");
+    try expectRun(&p, at(42), "{\"action\":\"sell\",\"confidence\":1,\"pair\":\"x\",\"note\":1}");
+    try expectRun(&p, at(43), "{\"action\":\"sell\",\"confidence\":1,\"pair\":\"x\"} ");
+    try expectRun(&p, .prefix, "{\"action\":\"sell\",\"confidence\":1");
+}
+
+test "optional properties may be left out in order; other keys come last and are never a property's name" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const p = try compile(a,
+        \\{"type": "object", "properties": {"a": {"type": "integer"}, "ab": {"type": "string"}, "b": {"type": "boolean"}},
+        \\ "required": ["ab"], "additionalProperties": {"type": "null"}}
+    );
+    try expectRun(&p, .complete, "{\"ab\":\"x\"}");
+    try expectRun(&p, .complete, "{\"a\":1,\"ab\":\"x\",\"b\":true}");
+    try expectRun(&p, .complete, "{\"ab\":\"x\",\"abc\":null,\"\":null,\"\\u0061\":null}");
+    try expectRun(&p, at(6), "{\"a\":1}"); // ab is required
+    try expectRun(&p, at(2), "{\"b\":true,\"ab\":\"x\"}"); // b may not come before ab
+    try expectRun(&p, at(2), "{\"z\":null,\"ab\":\"x\"}"); // other keys only once nothing is required
+    try expectRun(&p, at(12), "{\"ab\":\"x\",\"a\":1}"); // a is a property's name, so never another key
+    try expectRun(&p, at(22), "{\"ab\":\"x\",\"zz\":null,\"b\":true}"); // no property after another key
+    const none = try compile(a, "{\"type\": \"object\", \"properties\": {\"k\": {\"type\": \"integer\"}}}");
+    try expectRun(&none, .complete, "{}");
+    try expectRun(&none, .complete, "{ \"k\" : 0 }");
+    try expectRun(&none, at(2), "{\"j\":0}");
+}
+
+test "keys that start each other in any order, a required one between, other keys after it (xgrammar 0.2.8 verdicts)" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const p = try compile(arena.allocator(),
+        \\{"type": "object", "properties": {"ab": {"type": "integer"}, "a": {"type": "integer"}, "abc": {"type": "integer"},
+        \\ "b": {"type": "integer"}}, "required": ["abc"], "additionalProperties": true}
+    );
+    try expectRun(&p, .complete, "{\"abc\":1}");
+    try expectRun(&p, .complete, "{\"a\":1,\"abc\":1}");
+    try expectRun(&p, .complete, "{\"ab\":1,\"a\":1,\"abc\":1}");
+    try expectRun(&p, at(10), "{\"a\":1,\"ab\":1,\"abc\":1}"); // ab comes before a
+    try expectRun(&p, at(2), "{\"b\":1}"); // b lies past the required abc
+    try expectRun(&p, .complete, "{\"abc\":1,\"zz\":1,\"\":1}");
+    try expectRun(&p, at(12), "{\"abc\":1,\"ab\":1}"); // a passed name is no other key
+    try expectRun(&p, at(11), "{\"abc\":1,\"a\":1}");
+    try expectRun(&p, at(19), "{\"ab\":1,\"abc\":1,\"ab\":1}");
+    try expectRun(&p, .complete, "{\"abc\":1,\"b\":1,\"abx\":1,\"abcd\":1}");
+    try expectRun(&p, .prefix, "{\"ab");
+}
+
+test "an object of 30,000 properties takes each key in order; its key trie lists the properties under each prefix" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var text: std.ArrayList(u8) = .empty;
+    try text.appendSlice(a, "{\"type\": \"object\", \"properties\": {");
