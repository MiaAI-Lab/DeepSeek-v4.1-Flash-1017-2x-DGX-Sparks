+
+def decode(payload: str) -> bytes:
+    """The inverse of encode."""
+    out, i = bytearray(), 0
+    while i < len(payload):
+        c = payload[i]
+        if c == "%":
+            out.append(int(payload[i + 1:i + 3], 16))
+            i += 3
+        else:
+            out.append(0x20 if c == "_" else ord(c))
+            i += 1
+    return bytes(out)
+
