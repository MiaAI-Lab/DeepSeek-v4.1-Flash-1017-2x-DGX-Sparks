@@ -161,12 +185,30 @@ pub const LaneHost = struct {
         const h = self(ctx);
         const job = h.gpa.create(Job) catch return error.Busy;
         job.* = .{ .host = h, .id = id, .request = request, .sink = sink };
+        var yielded: std.ArrayList(*Job) = .empty;
