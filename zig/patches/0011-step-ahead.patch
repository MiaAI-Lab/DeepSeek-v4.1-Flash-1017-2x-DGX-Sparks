     }
 
+    /// The step-ahead pass after `job`'s reply: null when off, when the reply moves no kept state a chunk on, or while
+    /// other work is in the engine (it would compete with it).
+    fn aheadOf(h: *LaneHost, job: *Job) ?*Job {
+        if (!h.ahead_on or job.warm != null or !job.started or h.filling != null) return null;
+        const g = h.ahead_grid orelse return null;
+        const store = h.cache orelse return null;
+        const r = job.request;
+        if (r.images.len > 0 or r.cache_key.len != 0 or r.prompt.len < store.rules.min_prompt) return null;
+        const seq = job.stream.context.items; // prompt ++ reply: the next step's prompt starts so
+        if (seq.len < @as(usize, g.chunk) + g.tail) return null;
+        const at = (seq.len - g.tail) / g.chunk * g.chunk;
+        const from: usize = if (store.find(seq[0 .. at + g.tail], &.{})) |e| e.at else 0;
+        if (at <= from) return null;
+        h.lock();
+        const busy = h.closing or h.queued.items.len > 0 or h.admitted.items.len > 1;
+        h.unlock();
+        if (busy) return null;
+        const w = h.gpa.create(Warm) catch return null;
+        const tokens = h.gpa.dupe(u32, seq[0 .. at + g.tail]) catch {
+            h.gpa.destroy(w);
+            return null;
+        };
+        // one token, no drafts (the pass is all it is for), its history mark the kept point; nothing of the
+        // reply's request (its slices go with it) beyond its sampling, a value
+        w.* = .{ .tokens = tokens, .from = @intCast(from), .at = @intCast(at), .request = .{ .prompt = tokens, .max_tokens = 1, .sampling = r.sampling, .drafts = false, .background = true, .history_len = @intCast(at) } };
+        const wj = h.gpa.create(Job) catch {
+            h.gpa.free(tokens);
+            h.gpa.destroy(w);
+            return null;
+        };
+        h.ahead_ids +%= 1;
+        wj.* = .{ .host = h, .id = h.ahead_ids, .request = &w.request, .sink = h.ahead_sink orelse .{ .ctx = h, .event = quiet }, .warm = w };
+        return wj;
+    }
+
+    /// Queues a step-ahead pass behind nothing; anything that arrived meanwhile wins and the pass goes.
+    fn queueAhead(h: *LaneHost, job: *Job) void {
+        h.lock();
+        const ok = !h.closing and h.queued.items.len == 0;
+        if (ok) if (h.queued.append(h.gpa, job)) {
+            h.ahead_counts.queued += 1;
+            h.wake.signal(h.io);
+            h.unlock();
+            return;
+        } else |_| {};
+        h.unlock();
+        h.finish(job, .cancelled, "");
+    }
+
     fn finish(h: *LaneHost, job: *Job, reason: Reason, message: []const u8) void {
         job.reported();
         h.gpa.free(job.marks);
         const s = &job.stream;
         const stats: Stats = if (job.started) .{ .rounds = s.rounds, .drafted = s.drafted, .accepted = s.accepted, .min_rows = s.min_rows, .loop_period = s.loop_period, .prefill_seconds = if (job.prefilled) |done| @as(f64, @floatFromInt(@as(i64, @intCast(@max(0, done - job.began))))) / 1e9 else null } else .{};
         emit(job, .{ .finished = .{ .reason = reason, .stats = stats, .message = message } });
+        if (job.warm) |w| {
+            if (job.prefilled) |done| if (reason == .stop or reason == .length) {
+                h.ahead_counts.ran += 1;
+                h.ahead_counts.tokens += w.at -| s.cached;
+                if (!@import("builtin").is_test) std.log.info("step-ahead: kept {d} tokens, read {d} after {d} in {d} ms ({d} passes, {d} yielded)", .{ w.at, w.at -| s.cached, s.cached, @divTrunc(done - job.began, std.time.ns_per_ms), h.ahead_counts.ran, h.ahead_counts.dropped });
+            };
+        }
         if (job.started) {
             s.deinit(h.gpa);
             job.proposer.deinit();
         }
+        if (job.warm) |w| {
+            h.gpa.free(w.tokens);
+            h.gpa.destroy(w);
+        }
         h.gpa.destroy(job);
     }
 
@@ -343,6 +447,12 @@ pub const LaneHost = struct {
             h.finish_until = null;
         }
         const job = h.queued.orderedRemove(0);
+        if (job.warm != null and (h.admitted.items.len > 0 or h.core.activeCount() > 0)) { // a step-ahead pass runs alone
+            h.ahead_counts.dropped += 1;
+            h.unlock();
+            h.finish(job, .cancelled, "");
+            return true;
+        }
         h.admitted.append(h.gpa, job) catch {
             h.unlock();
             h.finish(job, .failed, "out of memory");
@@ -398,7 +508,7 @@ pub const LaneHost = struct {
         defer h.filling = null;
         h.core.addStream(&job.stream) catch |e| {
             if (e == error.Cancelled) return h.cancel(job);
-            if (e == error.ContextFull and h.core.activeCount() > 0) return h.requeue(job);
+            if (e == error.ContextFull and h.core.activeCount() > 0 and job.warm == null) return h.requeue(job);
             return h.drop(job, h.words(e));
         };
         h.prefilled(job, began);
@@ -469,6 +579,7 @@ pub const LaneHost = struct {
     fn loneFits(h: *LaneHost, job: *Job) bool {
         const r = job.request;
         const lone = h.lone orelse return false;
+        if (job.warm != null) return false;
         if ((r.sampling != null and !lone.sampled) or !r.drafts or r.think_budget > 0 or r.loop_guard or r.call != null or r.structure != null) return false;
         h.lock();
         defer h.unlock();
diff --git a/zig/src/core/lane_host_reuse_test.zig b/zig/src/core/lane_host_reuse_test.zig
index 963ba7e4..cf13157f 100644
--- a/zig/src/core/lane_host_reuse_test.zig
+++ b/zig/src/core/lane_host_reuse_test.zig
@@ -288,3 +288,134 @@ test "a turn with a picture resumes its conversation's kept state, and a differe
     try std.testing.expectEqual(@as(?u32, 0), b4.cached);
     try std.testing.expectEqual(kept_before, store.entries.items.len);
 }
+
+/// A fake snapshot vtable over lanes.fake.Fake (states at any position) and a sink that records one reply.
+const AheadKit = struct {
+    const Snaps = struct {
+        fn bytes(_: *anyopaque, at: u32) u64 {
+            return 64 + 4 * @as(u64, at);
+        }
+        fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            return f.save(@ptrCast(@alignCast(owner.?)), at);
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+            return error.BackendRestores;
+        }
+        fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            f.drop(saved);
+        }
+    };
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        tokens: std.ArrayList(u32) = .empty,
+        cached: ?u32 = null,
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .prefilled => |c| b.cached = c,
+                .tokens => |t| b.tokens.appendSlice(std.testing.allocator, t) catch {},
+                .finished => |f| b.done = f.reason,
+            }
+        }
+        fn wait(b: *@This()) Reason {
+            while (true) {
+                b.mutex.lockUncancelable(std.testing.io);
+                const d = b.done;
+                b.mutex.unlock(std.testing.io);
+                if (d) |r| return r;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+};
+
+test "step-ahead: a reply's own tokens are read while the client works, and its next step resumes past them with the same tokens" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = AheadKit.Snaps.bytes, .save = AheadKit.Snaps.save, .restore = AheadKit.Snaps.restore, .drop = AheadKit.Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    host.cache = &store;
+    host.ahead_on = true;
+    host.ahead_grid = .{ .chunk = 4, .tail = 2 };
+    var warm: AheadKit.Box = .{};
+    defer warm.tokens.deinit(gpa);
+    host.ahead_sink = .{ .ctx = &warm, .event = AheadKit.Box.event };
+    try host.start();
+    defer host.stop();
+    const e = host.engine();
+    // step 1: a 10-token prompt kept at its history (8); the reply's 6 tokens make 16, so the pass keeps 12 (16 - 2 down to 4s)
+    const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+    var b1: AheadKit.Box = .{};
+    defer b1.tokens.deinit(gpa);
+    const r1: Request = .{ .prompt = &t1, .max_tokens = 6, .history_len = 8 };
+    try e.submit(1, &r1, .{ .ctx = &b1, .event = AheadKit.Box.event });
+    try std.testing.expectEqual(Reason.length, b1.wait());
+    try std.testing.expectEqual(@as(?u32, 0), b1.cached);
+    // the step-ahead pass: one token past a pass that resumed at 8
+    try std.testing.expectEqual(Reason.length, warm.wait());
+    try std.testing.expectEqual(@as(?u32, 8), warm.cached);
+    var found = false;
+    for (store.entries.items) |x| found = found or x.at == 12;
+    try std.testing.expect(found);
+    // step 2: the history, the whole reply, a tool result: resumes at 12, not 8, and reads the history exactly
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try t2.appendSlice(gpa, &t1);
+    try t2.appendSlice(gpa, b1.tokens.items);
+    try t2.appendSlice(gpa, &.{ 7, 7, 5, 3 });
+    var b2: AheadKit.Box = .{};
+    defer b2.tokens.deinit(gpa);
+    const r2: Request = .{ .prompt = t2.items, .max_tokens = 12, .history_len = @intCast(t2.items.len - 2), .drafts = true };
+    try e.submit(2, &r2, .{ .ctx = &b2, .event = AheadKit.Box.event });
+    try std.testing.expectEqual(Reason.length, b2.wait());
+    try std.testing.expectEqual(@as(?u32, 12), b2.cached);
+    var history: std.ArrayList(u32) = .empty;
+    defer history.deinit(gpa);
+    try history.appendSlice(gpa, t2.items);
+    for (b2.tokens.items) |t| {
+        try std.testing.expectEqual(lanes.fake.next(history.items, null, history.items.len), t);
+        try history.append(gpa, t);
+    }
+}
+
+test "step-ahead: nothing runs when off, or when the reply moves no kept state a chunk on" {
+    const gpa = std.testing.allocator;
+    for ([_]bool{ false, true }) |on| {
+        var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+        defer cfg.deinit(gpa);
+        var target: lanes.fake.Fake = .{ .gpa = gpa };
+        defer target.deinit();
+        var clock: lanes.fake.FixedClock = .{};
+        var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+        defer core.deinit();
+        var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = AheadKit.Snaps.bytes, .save = AheadKit.Snaps.save, .restore = AheadKit.Snaps.restore, .drop = AheadKit.Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+        defer store.deinit();
+        var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+        host.cache = &store;
+        host.ahead_on = on;
+        // with the grid's 8-row chunks, 10 + 2 tokens reach no chunk end past the kept 8: no pass when on either
+        host.ahead_grid = .{ .chunk = 8, .tail = 2 };
+        try host.start();
+        const e = host.engine();
+        const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+        var b1: AheadKit.Box = .{};
+        defer b1.tokens.deinit(gpa);
+        const r1: Request = .{ .prompt = &t1, .max_tokens = 2, .history_len = 8 };
+        try e.submit(1, &r1, .{ .ctx = &b1, .event = AheadKit.Box.event });
+        try std.testing.expectEqual(Reason.length, b1.wait());
+        host.stop();
+        try std.testing.expectEqual(@as(u64, 0), host.ahead_counts.queued);
+    }
+}
