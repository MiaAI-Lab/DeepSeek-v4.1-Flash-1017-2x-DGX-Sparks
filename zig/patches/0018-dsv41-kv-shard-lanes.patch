+        .{ .move = .{ .stream = 9, .gen = 2, .src = 0, .src_part = 0, .dst = 33 * C, .dst_part = 1, .size = 4 * C, .rows = 3000, .hold_gen = 7, .tick = -5 } },
+        .{ .untwin = .{ .stream = 1, .gen = 2, .revoke = true } },
