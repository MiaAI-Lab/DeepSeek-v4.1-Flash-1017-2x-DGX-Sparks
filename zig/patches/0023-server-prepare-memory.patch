+        return p;
+    }
+    fn free(ctx: *anyopaque, m: []u8, al: std.mem.Alignment, ra: usize) void {
+        const c: *Counting = @ptrCast(@alignCast(ctx));
+        c.child.rawFree(m, al, ra);
