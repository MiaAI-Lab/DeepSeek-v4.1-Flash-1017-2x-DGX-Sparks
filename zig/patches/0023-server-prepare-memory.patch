+        const c: *Counting = @ptrCast(@alignCast(ctx));
+        if (!c.child.rawResize(m, al, n, ra)) return false;
+        c.note(n, m.len);
+        return true;
+    }
+    fn remap(ctx: *anyopaque, m: []u8, al: std.mem.Alignment, n: usize, ra: usize) ?[*]u8 {
+        const c: *Counting = @ptrCast(@alignCast(ctx));
