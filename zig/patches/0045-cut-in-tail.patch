 zig/src/families/dsv41/lanes.zig      |  17 ++-
 5 files changed, 195 insertions(+), 10 deletions(-)

diff --git a/zig/src/core/lane_host.zig b/zig/src/core/lane_host.zig
index a90d26a5..1ac62417 100644
--- a/zig/src/core/lane_host.zig
+++ b/zig/src/core/lane_host.zig
@@ -262,6 +262,15 @@ pub const LaneHost = struct {
         return r.images.len == 0 or r.cache_key.len == r.prompt.len;
     }
 
+    /// Where a queued request would resume from memory, for the cut-in test (Store.find changes nothing; a state only on
+    /// disk counts as none: such a prompt does not cut in). Its pass may still run from 0 if the state is gone by then.
+    fn resumable(h: *LaneHost, r: *const Request) usize {
+        if (!cacheable(r)) return 0;
+        const store = h.cache orelse return 0;
+        const e = store.find(r.cacheKey(), r.chunks) orelse return 0;
+        return @min(@as(usize, e.at), r.prompt.len);
+    }
+
     /// The pictures' identities the durable tier gets for a request: its `cache_media` only when they name exactly the
     /// spans the engine runs (`images`: the spans its restored rows and tower work are placed by), one for one; anything
     /// else gives none, and the tier then misses and keeps nothing for it (a disk hit must not resume pictures placed
@@ -563,7 +572,9 @@ pub const LaneHost = struct {
         var at: usize = 0;
         if (h.filling != null) {
             at = for (h.queued.items, 0..) |j, i| {
-                if (h.core.cutsIn(j.request.prompt.len, j.request.images.len > 0)) break i;
+                const r = j.request;
+                const from = h.resumable(r);
+                if (h.core.cutsIn(r.prompt.len - from, lanes.Engine.picturesPast(r.images, from))) break i;
             } else {
                 h.unlock();
                 return false;
diff --git a/zig/src/core/lane_host_reuse_test.zig b/zig/src/core/lane_host_reuse_test.zig
index 060971dd..afb30847 100644
--- a/zig/src/core/lane_host_reuse_test.zig
+++ b/zig/src/core/lane_host_reuse_test.zig
@@ -294,3 +294,149 @@ test "a prompt with an image resumes when its image is the same, and not past th
     try std.testing.expectEqual(Reason.length, b3.wait());
     try std.testing.expectEqual(@as(?u32, 0), b3.cached);
 }
+
+test "a turn resuming its kept state cuts in when the tokens it computes fit cut_in, although its prompt is longer" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    const Hold = struct {
+        mutex: std.Io.Mutex = .init,
+        seen: std.ArrayList([2]usize) = .empty,
+        armed: bool = false, // the other pass's first piece waits for `sent` (the first turn runs freely)
+        sent: bool = false,
+        fn call(ctx: *anyopaque, s: *lanes.Stream, chunk: usize) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            w.mutex.lockUncancelable(io);
+            w.seen.append(gpa, .{ s.prompt_len, chunk }) catch {};
+            const wait = w.armed and s.prompt_len == 12 and chunk == 0;
+            w.mutex.unlock(io);
+            if (wait) while (!w.get(.sent)) std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+        }
+        fn get(w: *@This(), comptime what: enum { sent, started }) bool {
+            w.mutex.lockUncancelable(io);
+            defer w.mutex.unlock(io);
+            return switch (what) {
+                .sent => w.sent,
+                .started => for (w.seen.items) |o| {
+                    if (o[0] == 12) break true;
+                } else false,
+            };
+        }
+        fn set(w: *@This(), comptime what: enum { armed, sent }) void {
+            w.mutex.lockUncancelable(io);
+            defer w.mutex.unlock(io);
+            @field(w, @tagName(what)) = true;
+        }
+    };
+    var hold: Hold = .{};
+    defer hold.seen.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .prefill_chunks = 6, .prefill_hook = Hold.call, .prefill_hook_ctx = &hold };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    core.fill_chunks = 1;
+    core.fill_rounds = 2;
+    core.cut_in = 10; // the next turn is 18 tokens: only the 10 past the state kept at 8 fit
+    const Snaps = struct {
+        fn bytes(_: *anyopaque, at: u32) u64 {
+            return 64 + 4 * @as(u64, at);
+        }
+        fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            return f.save(@ptrCast(@alignCast(owner.?)), at);
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+            return error.BackendRestores;
+        }
+        fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            f.drop(saved);
+        }
+    };
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, io, &core, .{ .lanes = 2 });
+    host.cache = &store;
+    try host.start();
+    defer host.stop();
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        tokens: std.ArrayList(u32) = .empty,
+        cached: ?u32 = null,
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(io);
+            defer b.mutex.unlock(io);
+            switch (e.*) {
+                .prefilled => |c| b.cached = c,
+                .tokens => |t| b.tokens.appendSlice(gpa, t) catch {},
+                .finished => |f| b.done = f.reason,
+            }
+        }
+        fn wait(b: *@This()) Reason {
+            while (true) {
+                b.mutex.lockUncancelable(io);
+                const d = b.done;
+                b.mutex.unlock(io);
+                if (d) |r| return r;
+                std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+    const e = host.engine();
+    // the conversation's first turn keeps its state at 8
+    const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+    var b1: Box = .{};
+    defer b1.tokens.deinit(gpa);
+    const r1: Request = .{ .prompt = &t1, .max_tokens = 6, .history_len = 8 };
+    try e.submit(1, &r1, .{ .ctx = &b1, .event = Box.event });
+    try std.testing.expectEqual(Reason.length, b1.wait());
+    // another conversation's cold pass runs in pieces, its first held until the next turn is queued
+    hold.set(.armed);
+    const other = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4, 4, 4 };
+    var bo: Box = .{};
+    defer bo.tokens.deinit(gpa);
+    const ro: Request = .{ .prompt = &other, .max_tokens = 1 };
+    try e.submit(2, &ro, .{ .ctx = &bo, .event = Box.event });
+    for (0..5000) |_| {
+        if (hold.get(.started)) break;
+        std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    } else return error.Timeout;
+    var t2: std.ArrayList(u32) = .empty; // the next turn: the history, the reply, a tool result, a new generation prompt
+    defer t2.deinit(gpa);
+    try t2.appendSlice(gpa, &t1);
+    try t2.appendSlice(gpa, b1.tokens.items[0..4]);
+    try t2.appendSlice(gpa, &.{ 7, 7, 5, 3 });
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    const r2: Request = .{ .prompt = t2.items, .max_tokens = 6, .history_len = @intCast(t2.items.len - 2) };
+    try e.submit(3, &r2, .{ .ctx = &b2, .event = Box.event });
+    hold.set(.sent);
+    try std.testing.expectEqual(Reason.length, b2.wait());
+    try std.testing.expectEqual(Reason.length, bo.wait());
+    try std.testing.expectEqual(@as(?u32, 8), b2.cached);
+    var history: std.ArrayList(u32) = .empty; // the fake's tokens read the whole history: any slip in it changes them
+    defer history.deinit(gpa);
+    try history.appendSlice(gpa, t2.items);
+    for (b2.tokens.items) |t| {
+        try std.testing.expectEqual(lanes.fake.next(history.items, null, history.items.len), t);
+        try history.append(gpa, t);
+    }
+    // the turn's whole pass ran between the other pass's first and second pieces
+    hold.mutex.lockUncancelable(io);
+    defer hold.mutex.unlock(io);
+    const seen = hold.seen.items;
+    const first = for (seen, 0..) |s, i| {
+        if (s[0] == 12) break i;
+    } else return error.TestUnexpectedResult;
+    try std.testing.expectEqual(@as(usize, 0), seen[first][1]);
+    const second = for (seen[first..], first..) |s, i| {
+        if (s[0] == 12 and s[1] == 1) break i;
+    } else return error.TestUnexpectedResult;
+    try std.testing.expect(second > first + 1);
+    for (seen[first + 1 .. second]) |s| try std.testing.expectEqual(t2.items.len, s[0]);
+    for (seen[second..]) |s| try std.testing.expect(s[0] != t2.items.len);
+}
diff --git a/zig/src/core/lanes/engine.zig b/zig/src/core/lanes/engine.zig
index 030743f8..1b1d09d0 100644
--- a/zig/src/core/lanes/engine.zig
+++ b/zig/src/core/lanes/engine.zig
@@ -42,7 +42,7 @@ pub const Engine = struct {
     fill_chunks: u32 = 0, // a piece's chunks (backend prefill_part; 0: a prompt pass runs whole inside addStream)
     fill_rounds: u32 = 4, // the live streams' rounds between two pieces
     fill_first: u32 = 0, // the first piece's chunks (0: fill_chunks): a short prompt then runs whole
-    cut_in: u32 = 0, // prompts of at most this many tokens cut in between pieces; set, every pass runs in pieces
+    cut_in: u32 = 0, // prompts that compute at most this many tokens (past a kept state) cut in between pieces; set, every pass runs in pieces
     rounds_since: u32 = 0,
 
     pub fn init(gpa: Allocator, cfg: *const Config, backend: be.Backend, clock: be.Clock) Engine {
@@ -95,7 +95,8 @@ pub const Engine = struct {
         _ = e.arena.reset(.retain_capacity);
         try trail.event(e, &.{ f("ev", str("add")), f("stream", str(s.id)) });
         if (e.filling != null) {
-            if (!e.cutsIn(s.prompt_len, s.images.len > 0)) return error.FillBusy;
+            const at = @min(@as(usize, s.reuse.at), s.prompt_len);
+            if (!e.cutsIn(s.prompt_len - at, picturesPast(s.images, at))) return error.FillBusy;
             e.backend.prefill(s) catch |err| {
                 if (err == error.Cancelled) e.backend.release(s);
                 return err;
@@ -115,10 +116,19 @@ pub const Engine = struct {
         try e.started(s);
     }
 
-    /// Whether a prompt of `len` tokens runs whole between the filling stream's pieces (no images: one at a time).
-    pub fn cutsIn(e: *const Engine, len: usize, images: bool) bool {
+    /// Whether a prompt that computes `tokens` tokens (past the kept state it resumes, all of it without one) runs whole
+    /// between the filling stream's pieces. `rows`: it needs picture rows (a picture past that state); such a prompt,
+    /// like any while the filling pass has pictures of its own, does not cut in (one at a time).
+    pub fn cutsIn(e: *const Engine, tokens: usize, rows: bool) bool {
         const filling = e.filling orelse return false;
-        return e.cut_in > 0 and len <= e.cut_in and !images and filling.images.len == 0;
+        return e.cut_in > 0 and tokens <= e.cut_in and !rows and filling.images.len == 0;
+    }
+
+    /// Whether a prompt resuming at `at` needs rows for any of its pictures: one that ends past the resume point (a
+    /// picture wholly before it is in the kept state, and the pass runs no tower for it: dsv41's pictureNeedsRows).
+    pub fn picturesPast(images: []const sm.Image, at: usize) bool {
+        for (images) |img| if (@as(usize, img.at) + img.tokens > at) return true;
+        return false;
     }
 
     fn piece(e: *Engine, s: *Stream, chunks: u32) !bool {
diff --git a/zig/src/core/lanes/engine_test.zig b/zig/src/core/lanes/engine_test.zig
index b8dc1351..6c33ca37 100644
--- a/zig/src/core/lanes/engine_test.zig
+++ b/zig/src/core/lanes/engine_test.zig
@@ -181,3 +181,12 @@ test "a cycle in the answer does not refire or reclose" {
     for (plain[0].emitted) |token| close_count += @intFromBool(token == 90);
     try std.testing.expectEqual(@as(usize, 1), close_count);
 }
+
+test "a cut-in needs picture rows only for a picture ending past its resume point, as dsv41's pictureNeedsRows" {
+    const img = [_]sm.Image{.{ .at = 4, .tokens = 6, .bytes = "" }};
+    try std.testing.expect(!Engine.picturesPast(&img, 10)); // ends exactly at the resume point: in the kept state
+    try std.testing.expect(!Engine.picturesPast(&img, 12)); // wholly before
+    try std.testing.expect(Engine.picturesPast(&img, 9)); // straddles it
+    try std.testing.expect(Engine.picturesPast(&img, 0)); // a fresh pass
+    try std.testing.expect(!Engine.picturesPast(&.{}, 0));
+}
diff --git a/zig/src/families/dsv41/lanes.zig b/zig/src/families/dsv41/lanes.zig
index eaab37f8..755baca5 100644
--- a/zig/src/families/dsv41/lanes.zig
+++ b/zig/src/families/dsv41/lanes.zig
@@ -782,8 +782,9 @@ pub const Lanes = struct {
             p.prefill += m.now() - t0;
         };
         if (self.fill) |f| if (f.s != s) {
-            // a prompt cuts in between this pass's pieces: it waits (one at most, no images), its next piece resumes it
-            if (self.paused != null or f.s.images.len > 0 or s.images.len > 0) return error.FillBusy;
+            // a prompt cuts in between this pass's pieces: it waits (one at most; neither pass needs picture rows: a cut-in's
+            // pictures wholly before the state it resumes run no tower and set no spans), its next piece resumes it
+            if (self.paused != null or f.s.images.len > 0 or lanes.Engine.picturesPast(s.images, s.reuse.at)) return error.FillBusy;
             self.paused = f;
             self.fill = null;
         };
@@ -2093,18 +2094,26 @@ test "a prefix two conversations share: the second one resuming it in place woul
     try std.testing.expect(!ln.keptOver(later.base + later.at, later.base + 432128, &later)); // the first one's next turn stays
 }
 
-test "a prompt with images does not cut in between another pass's pieces" {
+test "a prompt that needs picture rows does not cut in between another pass's pieces, nor any into a pass with pictures" {
     var m: Model = undefined;
     m.io = std.testing.io;
     var ln: Lanes = .{ .gpa = std.testing.allocator, .m = &m, .peer = null };
     var long: lanes.Stream = undefined;
     long.images = &.{};
     var short: lanes.Stream = undefined;
-    const image = [_]lanes.stream.Image{.{ .at = 0, .tokens = 1, .bytes = "" }};
+    const image = [_]lanes.stream.Image{.{ .at = 4, .tokens = 6, .bytes = "" }};
     short.images = &image;
+    // resuming at 8, the picture [4, 10) straddles the cut: its rows are needed
+    short.reuse = .{ .at = 8 };
     ln.fill = .{ .s = &long, .slot = 0, .len = 16, .replay = 0, .last_end = 0, .start = 8 };
     try std.testing.expectError(error.FillBusy, ln.prefillPart(&short, 1));
     try std.testing.expect(ln.paused == null and ln.fill.?.s == &long); // the pass in pieces stays as it was
+    // the filling pass has pictures: nothing cuts in, a text prompt neither
+    long.images = &image;
+    short.images = &.{};
+    short.reuse = .{};
+    try std.testing.expectError(error.FillBusy, ln.prefillPart(&short, 1));
+    try std.testing.expect(ln.paused == null and ln.fill.?.s == &long);
 }
 
