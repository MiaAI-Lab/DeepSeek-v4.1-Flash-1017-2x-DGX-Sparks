 zig/src/core/lane_host_test.zig       |  14 ++-
 zig/src/core/lanes/engine.zig         |  21 +++-
 zig/src/core/lanes/engine_test.zig    |   9 ++
 zig/src/core/lanes/fake.zig           |   5 +
 zig/src/core/lanes/stream.zig         |   4 +
 zig/src/families/dsv41/lanes.zig      |  29 ++++-
 8 files changed, 237 insertions(+), 12 deletions(-)

diff --git a/zig/src/core/lane_host.zig b/zig/src/core/lane_host.zig
index a90d26a5..bdddc8cb 100644
--- a/zig/src/core/lane_host.zig
+++ b/zig/src/core/lane_host.zig
@@ -220,6 +220,7 @@ pub const LaneHost = struct {
         parent: ?u64 = null, // the durable point its pass resumes from, and where
         fork: u32 = 0,
         lineage: []pc.Fork = &.{}, // the computation its pass's rows belong to (gpa-owned; Store.passLineage)
+        whole: bool = false, // refused as a cut-in (error.FillBusy: its kept state gone): it waits for the pass in pieces
 
         /// The backend's prompt pass stands at a mark: the cache keeps the stream's state there.
         fn kept(ptr: *anyopaque, s: *lanes.Stream, at: u32) void {
@@ -262,6 +263,15 @@ pub const LaneHost = struct {
         return r.images.len == 0 or r.cache_key.len == r.prompt.len;
     }
 
+    /// Where a queued request would resume from memory, for the cut-in test (Store.find changes nothing; a state only on
+    /// disk counts as none: such a prompt does not cut in). Its pass may still run from 0 if the state is gone by then.
+    fn resumable(h: *LaneHost, r: *const Request) usize {
+        if (!cacheable(r)) return 0;
+        const store = h.cache orelse return 0;
+        const e = store.find(r.cacheKey(), r.chunks) orelse return 0;
+        return @min(@as(usize, e.at), r.prompt.len);
+    }
+
     /// The pictures' identities the durable tier gets for a request: its `cache_media` only when they name exactly the
     /// spans the engine runs (`images`: the spans its restored rows and tower work are placed by), one for one; anything
     /// else gives none, and the tier then misses and keeps nothing for it (a disk hit must not resume pictures placed
@@ -563,7 +573,10 @@ pub const LaneHost = struct {
         var at: usize = 0;
         if (h.filling != null) {
             at = for (h.queued.items, 0..) |j, i| {
-                if (h.core.cutsIn(j.request.prompt.len, j.request.images.len > 0)) break i;
+                if (j.whole) continue;
+                const r = j.request;
+                const from = h.resumable(r);
+                if (h.core.cutsIn(r.prompt.len - from, lanes.Engine.picturesPast(r.images, from))) break i;
             } else {
                 h.unlock();
                 return false;
@@ -661,6 +674,12 @@ pub const LaneHost = struct {
             if (e == error.Cancelled) return h.cancel(job);
             // refused for room: while other streams run or a pass fills (this one cut in), it waits in the queue
             if (e == error.ContextFull and (h.core.activeCount() > 0 or h.filling != null)) return h.requeue(job);
+            // refused as a cut-in (its kept state gone as its pass opened): it waits for the pass in pieces, not
+            // tried again between that pass's pieces
+            if (e == error.FillBusy and h.filling != null) {
+                job.whole = true;
+                return h.requeue(job);
+            }
             h.checkFatal(e);
             return h.drop(job, h.words(e));
         };
diff --git a/zig/src/core/lane_host_reuse_test.zig b/zig/src/core/lane_host_reuse_test.zig
index 060971dd..afb30847 100644
--- a/zig/src/core/lane_host_reuse_test.zig
+++ b/zig/src/core/lane_host_reuse_test.zig
@@ -294,3 +294,149 @@ test "a prompt with an image resumes when its image is the same, and not past th
     try std.testing.expectEqual(Reason.length, b3.wait());
     try std.testing.expectEqual(@as(?u32, 0), b3.cached);
 }
+
+test "a turn resuming its kept state cuts in when the tokens it computes fit cut_in, although its prompt is longer" {
+    const gpa = std.testing.allocator;
+    const io = std.testing.io;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    const Hold = struct {
+        mutex: std.Io.Mutex = .init,
+        seen: std.ArrayList([2]usize) = .empty,
+        armed: bool = false, // the other pass's first piece waits for `sent` (the first turn runs freely)
+        sent: bool = false,
+        fn call(ctx: *anyopaque, s: *lanes.Stream, chunk: usize) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            w.mutex.lockUncancelable(io);
+            w.seen.append(gpa, .{ s.prompt_len, chunk }) catch {};
+            const wait = w.armed and s.prompt_len == 12 and chunk == 0;
+            w.mutex.unlock(io);
+            if (wait) while (!w.get(.sent)) std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+        }
+        fn get(w: *@This(), comptime what: enum { sent, started }) bool {
+            w.mutex.lockUncancelable(io);
+            defer w.mutex.unlock(io);
+            return switch (what) {
+                .sent => w.sent,
+                .started => for (w.seen.items) |o| {
+                    if (o[0] == 12) break true;
+                } else false,
+            };
+        }
+        fn set(w: *@This(), comptime what: enum { armed, sent }) void {
+            w.mutex.lockUncancelable(io);
+            defer w.mutex.unlock(io);
+            @field(w, @tagName(what)) = true;
+        }
+    };
+    var hold: Hold = .{};
+    defer hold.seen.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .prefill_chunks = 6, .prefill_hook = Hold.call, .prefill_hook_ctx = &hold };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    core.fill_chunks = 1;
+    core.fill_rounds = 2;
+    core.cut_in = 10; // the next turn is 18 tokens: only the 10 past the state kept at 8 fit
+    const Snaps = struct {
+        fn bytes(_: *anyopaque, at: u32) u64 {
+            return 64 + 4 * @as(u64, at);
+        }
+        fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            return f.save(@ptrCast(@alignCast(owner.?)), at);
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+            return error.BackendRestores;
+        }
+        fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            f.drop(saved);
+        }
+    };
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, io, &core, .{ .lanes = 2 });
+    host.cache = &store;
+    try host.start();
+    defer host.stop();
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        tokens: std.ArrayList(u32) = .empty,
+        cached: ?u32 = null,
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(io);
+            defer b.mutex.unlock(io);
+            switch (e.*) {
+                .prefilled => |c| b.cached = c,
+                .tokens => |t| b.tokens.appendSlice(gpa, t) catch {},
+                .finished => |f| b.done = f.reason,
+            }
+        }
+        fn wait(b: *@This()) Reason {
+            while (true) {
+                b.mutex.lockUncancelable(io);
+                const d = b.done;
+                b.mutex.unlock(io);
+                if (d) |r| return r;
+                std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+    const e = host.engine();
+    // the conversation's first turn keeps its state at 8
+    const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+    var b1: Box = .{};
+    defer b1.tokens.deinit(gpa);
+    const r1: Request = .{ .prompt = &t1, .max_tokens = 6, .history_len = 8 };
+    try e.submit(1, &r1, .{ .ctx = &b1, .event = Box.event });
+    try std.testing.expectEqual(Reason.length, b1.wait());
+    // another conversation's cold pass runs in pieces, its first held until the next turn is queued
+    hold.set(.armed);
+    const other = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4, 4, 4 };
+    var bo: Box = .{};
+    defer bo.tokens.deinit(gpa);
+    const ro: Request = .{ .prompt = &other, .max_tokens = 1 };
+    try e.submit(2, &ro, .{ .ctx = &bo, .event = Box.event });
+    for (0..5000) |_| {
+        if (hold.get(.started)) break;
+        std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+    } else return error.Timeout;
+    var t2: std.ArrayList(u32) = .empty; // the next turn: the history, the reply, a tool result, a new generation prompt
+    defer t2.deinit(gpa);
+    try t2.appendSlice(gpa, &t1);
+    try t2.appendSlice(gpa, b1.tokens.items[0..4]);
+    try t2.appendSlice(gpa, &.{ 7, 7, 5, 3 });
+    var b2: Box = .{};
+    defer b2.tokens.deinit(gpa);
+    const r2: Request = .{ .prompt = t2.items, .max_tokens = 6, .history_len = @intCast(t2.items.len - 2) };
+    try e.submit(3, &r2, .{ .ctx = &b2, .event = Box.event });
+    hold.set(.sent);
+    try std.testing.expectEqual(Reason.length, b2.wait());
+    try std.testing.expectEqual(Reason.length, bo.wait());
+    try std.testing.expectEqual(@as(?u32, 8), b2.cached);
+    var history: std.ArrayList(u32) = .empty; // the fake's tokens read the whole history: any slip in it changes them
+    defer history.deinit(gpa);
+    try history.appendSlice(gpa, t2.items);
+    for (b2.tokens.items) |t| {
+        try std.testing.expectEqual(lanes.fake.next(history.items, null, history.items.len), t);
+        try history.append(gpa, t);
+    }
+    // the turn's whole pass ran between the other pass's first and second pieces
+    hold.mutex.lockUncancelable(io);
+    defer hold.mutex.unlock(io);
+    const seen = hold.seen.items;
+    const first = for (seen, 0..) |s, i| {
+        if (s[0] == 12) break i;
+    } else return error.TestUnexpectedResult;
+    try std.testing.expectEqual(@as(usize, 0), seen[first][1]);
+    const second = for (seen[first..], first..) |s, i| {
+        if (s[0] == 12 and s[1] == 1) break i;
+    } else return error.TestUnexpectedResult;
+    try std.testing.expect(second > first + 1);
+    for (seen[first + 1 .. second]) |s| try std.testing.expectEqual(t2.items.len, s[0]);
+    for (seen[second..]) |s| try std.testing.expect(s[0] != t2.items.len);
+}
diff --git a/zig/src/core/lane_host_test.zig b/zig/src/core/lane_host_test.zig
index a8706236..4b18c361 100644
--- a/zig/src/core/lane_host_test.zig
