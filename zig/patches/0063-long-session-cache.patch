+    defer ln.snaps.deinit(gpa);
+    var source: Snap = .{ .id = 1, .at = 270336, .base = 0, .end = 270336, .buf = undefined };
+    var loading: Snap = .{ .id = 2, .at = 65536, .base = 270336, .end = 370688, .buf = undefined, .loading = true };
+    try ln.snaps.append(gpa, &source);
+    try ln.snaps.append(gpa, &loading);
+    try std.testing.expect(!ln.canGrowHere(&.{}, 274432, &source));
+    try std.testing.expectError(error.ContextFull, ln.placeKept(&.{}, 274432, &source));
+    try std.testing.expect(!loading.stale);
+    source.stale = false;
+    loading.stale = true;
+    try std.testing.expect(ln.canGrowHere(&.{}, 274432, &source));
+    try std.testing.expect(!ln.canGrowHere(&.{.{ 270336, 370688 }}, 274432, &source));
+    try std.testing.expect(!ln.canGrowHere(&.{.{ 0, 270336 }}, 274432, &source));
