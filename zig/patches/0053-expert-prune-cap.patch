+fn randomWindow(rnd: std.Random, rows: usize, p: []i32, w: []f32) void {
+    for (0..rows) |r| {
+        for (0..test_slots) |i| {
+            p[r * test_slots + i] = if (i == 6) 384 else rnd.intRangeAtMost(i32, 0, 47); // few ids: rows share experts
+            w[r * test_slots + i] = rnd.float(f32) + 0.01;
