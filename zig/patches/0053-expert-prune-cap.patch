diff --git a/zig/src/families/dsv41/expert_prune.zig b/zig/src/families/dsv41/expert_prune.zig
new file mode 100644
index 000000000..48468166d
--- /dev/null
+++ b/zig/src/families/dsv41/expert_prune.zig
@@ -0,0 +1,818 @@
+//! Routed-expert top-p prune of a decode round's picks (TF_DS_T13_EXPERT_PRUNE; lossy, opt-in, experiment only): the
+//! switch's parsing, the host reference of the kernel (tf_ds_expert_prune_kernel), the kernel's argument and the
+//! counters it keeps. Pure: no cuda import.
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_T13_EXPERT_PRUNE";
+pub const cap_env_name: [:0]const u8 = "TF_DS_T13_EXPERT_CAP";
+pub const max_topk = 8; // the kernel's per-row arrays
+pub const max_experts = 512; // the kernel's distinct-expert bitmasks (16 words)
+pub const max_rows = 64; // the kernel's block width: one thread a row
+const stats_prefix = "stats";
+
+pub const Renorm = enum(c_int) { orig = 0, kept = 1 };
+
+pub const Rule = struct { topp: f32, min_k: u32, renorm: Renorm };
+
+/// Jay Leaton's p85k (credited in CREDITS.md): the slots whose exclusive prefix of weight share (heaviest first) is under 0.85, at least 3.
+pub const default_rule: Rule = .{ .topp = 0.85, .min_k = 3, .renorm = .kept };
+
+/// A window's cap after the rule: its `experts` heaviest experts by the rows' summed kept
+/// shares, and each row's `floor` heaviest picks.
+pub const Cap = struct { experts: u32, floor: u32 = 1 };
+
+/// `apply` false: the kernel only counts what the rule would drop.
+pub const Mode = struct { rule: Rule, apply: bool, cap: ?Cap = null };
+
+/// "<topp>,<min_k>[,kept|orig]" with topp in (0, 1) and min_k in 1..max_topk (null: malformed).
+fn parseRule(text: []const u8) ?Rule {
+    var it = std.mem.splitScalar(u8, text, ',');
+    const p = it.next() orelse return null;
+    const k = it.next() orelse return null;
+    const topp = std.fmt.parseFloat(f32, p) catch return null;
+    if (!(topp > 0 and topp < 1)) return null;
+    const min_k = std.fmt.parseInt(u32, k, 10) catch return null;
+    if (min_k < 1 or min_k > max_topk) return null;
+    var renorm: Renorm = .kept;
+    if (it.next()) |r| {
+        if (std.mem.eql(u8, r, "kept")) renorm = .kept else if (std.mem.eql(u8, r, "orig")) renorm = .orig else return null;
+    }
+    if (it.next() != null) return null;
+    return .{ .topp = topp, .min_k = min_k, .renorm = renorm };
+}
+
+/// The switch's value: unset, "" or "0" off; "1" prune by the default rule; a rule prunes by it; "stats" counts
+/// by the default rule and "stats:<rule>" by that rule, neither pruning. Malformed: null, with a message on stderr
+/// (`fromText` turns that into a refusal to start).
+pub fn parse(text: ?[]const u8) ?Mode {
+    const t = text orelse return null;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return null;
+    if (std.mem.eql(u8, t, "1")) return .{ .rule = default_rule, .apply = true };
+    if (std.mem.startsWith(u8, t, stats_prefix)) {
+        const rest = t[stats_prefix.len..];
+        if (rest.len == 0) return .{ .rule = default_rule, .apply = false };
+        if (rest[0] == ':') if (parseRule(rest[1..])) |r| return .{ .rule = r, .apply = false };
+    } else if (parseRule(t)) |r| return .{ .rule = r, .apply = true };
+    std.debug.print("{s}: expected 1, stats, [stats:]<topp>,<min_k>[,kept|orig] (topp in (0, 1), min_k in 1..{d})\n", .{ env_name, max_topk });
+    return null;
+}
+
+/// "<experts>[,<floor>]" with experts in 1..max_experts and floor in 1..max_topk (default 1; null: malformed).
+fn parseCap(text: []const u8) ?Cap {
+    var it = std.mem.splitScalar(u8, text, ',');
+    const c = std.fmt.parseInt(u32, it.next() orelse return null, 10) catch return null;
+    if (c < 1 or c > max_experts) return null;
+    var floor: u32 = 1;
+    if (it.next()) |f| floor = std.fmt.parseInt(u32, f, 10) catch return null;
+    if (floor < 1 or floor > max_topk or it.next() != null) return null;
+    return .{ .experts = c, .floor = floor };
+}
+
+/// The cap's switch over a prune mode: unset, "" or "0" leaves `m` as it is. A cap needs the prune on and a floor
+/// within its min_k (the rule keeps the floor's picks); otherwise the result carries no cap, with a message on stderr.
+pub fn withCap(m: ?Mode, text: ?[]const u8) ?Mode {
+    const t = text orelse return m;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return m;
+    const c = parseCap(t) orelse {
+        std.debug.print("{s}: expected <experts>[,<floor>] (experts in 1..{d}, floor in 1..{d})\n", .{ cap_env_name, max_experts, max_topk });
+        return m;
+    };
+    var x = m orelse {
+        std.debug.print("{s}: needs {s} on; the cap is off\n", .{ cap_env_name, env_name });
+        return null;
+    };
+    if (c.floor > x.rule.min_k) {
+        std.debug.print("{s}: floor {d} above the rule's min_k {d}; the cap is off\n", .{ cap_env_name, c.floor, x.rule.min_k });
+        return x;
+    }
+    x.cap = c;
+    return x;
+}
+
+fn isSet(text: ?[]const u8) bool {
+    const t = text orelse return false;
+    return t.len != 0 and !std.mem.eql(u8, t, "0");
+}
+
+/// The mode from the two switches' texts. A switch that is set and malformed, or a cap without its prune, is an
+/// error (the message is already on stderr): the process refuses to start rather than run unpruned.
+pub fn fromText(prune_text: ?[]const u8, cap_text: ?[]const u8) error{BadExpertPrune}!?Mode {
+    const m = parse(prune_text);
+    if (m == null and isSet(prune_text)) return error.BadExpertPrune;
+    const r = withCap(m, cap_text);
+    if (isSet(cap_text) and (r == null or r.?.cap == null)) return error.BadExpertPrune;
+    return r;
+}
+
+/// The mode from the process environment.
+pub fn fromEnv() error{BadExpertPrune}!?Mode {
+    const p = if (std.c.getenv(env_name)) |v| std.mem.span(v) else null;
+    const c = if (std.c.getenv(cap_env_name)) |v| std.mem.span(v) else null;
+    return fromText(p, c);
+}
+
+/// Whether the model's shape fits the kernel's arrays; the caller refuses to start otherwise.
+pub fn fits(topk: usize, experts: usize, rows: usize, m: Mode) bool {
+    const floor_ok = if (m.cap) |c| c.floor <= m.rule.min_k else true;
+    return topk <= max_topk and experts <= max_experts and rows <= max_rows and m.rule.min_k <= topk and floor_ok;
+}
+
+/// Opt-in switch: size the experts launch's grid by placeBound instead of every slot of the window.
+pub const bound_env_name: [:0]const u8 = "TF_DS_T15_PLACE_BOUND";
+
+/// Whether the bound switch is "1".
+pub fn boundOn() bool {
+    const v = std.c.getenv(bound_env_name) orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// The most expert places a window of `rows` can have once `m` has run: the cap's experts, each row's floor and the
+/// shared expert. Null when nothing bounds them (no cap, or the cap counts without applying).
+pub fn placeBound(m: Mode, rows: usize) ?usize {
+    const c = m.cap orelse return null;
+    if (!m.apply) return null;
+    return c.experts + rows * c.floor + 1;
+}
+
+/// tf_ds_expert_prune_kernel's argument.
+pub const KArgs = extern struct { topp: f32, min_k: c_int, renorm: c_int, apply: c_int, topk: c_int, slots: c_int, rows: c_int, cap: c_int, cap_min: c_int };
+
+pub fn kargs(m: Mode, rows: usize, topk: usize, slots: usize) KArgs {
+    const c: Cap = m.cap orelse .{ .experts = 0, .floor = 0 };
+    return .{ .topp = m.rule.topp, .min_k = @intCast(m.rule.min_k), .renorm = @intFromEnum(m.rule.renorm), .apply = @intFromBool(m.apply), .topk = @intCast(topk), .slots = @intCast(slots), .rows = @intCast(rows), .cap = @intCast(c.experts), .cap_min = @intCast(c.floor) };
+}
+
+/// The kernel's counters (device u64s, in this order), summed over the layer windows since the last print.
+pub const Stats = extern struct {
+    windows: u64 = 0, // kernel launches: a layer's decode window each
+    before: u64 = 0, // distinct routed experts of the windows' picks as routed
+    after: u64 = 0, // the same once the rule has dropped its slots (counted, not applied, in stats mode)
+    dropped: u64 = 0, // slots the rule drops
+    rows: u64 = 0, // rows seen
+    dropped_ppm: u64 = 0, // weight share of the dropped slots, in millionths, summed over rows
+};
+
+pub const stats_bytes = @sizeOf(Stats);
+
+fn per(total: u64, n: u64) f64 {
+    return if (n == 0) 0 else @as(f64, @floatFromInt(total)) / @as(f64, @floatFromInt(n));
+}
+
+/// The counters as a profile line: per layer window the distinct routed experts before and after the rule (the experts
+/// read), and per row the slots and weight share it drops.
+pub fn write(w: *std.Io.Writer, rank: u32, s: Stats) !void {
+    const ppm: f64 = @floatFromInt(s.dropped_ppm);
+    try w.print("{{\"rank\": {d}, \"expert_prune\": {{\"windows\": {d}, \"rows\": {d}, \"distinct_before\": {d:.3}, \"distinct_after\": {d:.3}, \"saved_a_window\": {d:.3}, \"dropped_a_row\": {d:.3}, \"dropped_share\": {d:.4}}}}}\n", .{
+        rank,
+        s.windows,
+        s.rows,
+        per(s.before, s.windows),
+        per(s.after, s.windows),
+        per(s.before -| s.after, s.windows),
+        per(s.dropped, s.rows),
+        if (s.rows == 0) 0 else ppm / 1e6 / @as(f64, @floatFromInt(s.rows)),
+    });
+}
+
+/// What pruneRow did to a row.
+pub const Outcome = struct { dropped: u32 = 0, mass: f32 = 0 };
+
+/// One row's first `p.len` slots (the routed ones: the shared expert's slot is the caller's to leave out), the
+/// kernel's arithmetic op for op. A slot with pick < 0 is not routed: it is left as it is and takes no part. f = w / total (fp32 sum
+/// in slot order); rank by f descending, ties to the lower slot; keep = rank < max(min_k, 1) or the exclusive prefix
+/// of f in rank order < topp. A dropped slot becomes pick -1, weight 0; with `.kept` the kept weights are scaled by
+/// total / kept sum so their sum holds. Nothing to drop (or a total that is not a positive finite number): the row is
+/// untouched, bit for bit. `apply` false only measures.
+pub fn pruneRow(r: Rule, apply: bool, p: []i32, w: []f32) Outcome {
+    std.debug.assert(p.len == w.len and p.len <= max_topk);
+    var live: u32 = 0;
+    var tot: f32 = 0;
+    for (p, w) |e, x| {
+        if (e < 0) continue;
+        live += 1;
+        tot += x;
+    }
+    if (live == 0 or !(tot > 0) or std.math.isInf(tot)) return .{};
+    var f: [max_topk]f32 = undefined;
+    var rank: [max_topk]u32 = undefined;
+    for (p, w, 0..) |e, x, i| f[i] = if (e >= 0) x / tot else 0;
+    for (p, 0..) |ei, i| {
+        rank[i] = 0;
+        if (ei < 0) continue;
+        for (p, 0..) |ej, j| {
+            if (ej >= 0 and (f[j] > f[i] or (f[j] == f[i] and j < i))) rank[i] += 1;
+        }
+    }
+    var ex: [max_topk]f32 = undefined;
+    var acc: f32 = 0;
+    for (0..live) |k| {
+        for (p, 0..) |ei, i| {
+            if (ei >= 0 and rank[i] == k) {
+                ex[i] = acc;
+                acc += f[i];
+            }
+        }
+    }
+    const floor = @max(r.min_k, 1);
+    var keep: [max_topk]bool = undefined;
+    var kept: u32 = 0;
+    var kept_sum: f32 = 0;
+    var mass: f32 = 0;
+    for (p, w, 0..) |e, x, i| {
+        keep[i] = true;
+        if (e < 0) continue;
+        keep[i] = rank[i] < floor or ex[i] < r.topp;
+        if (keep[i]) {
+            kept += 1;
+            kept_sum += x;
+        } else mass += f[i];
+    }
+    if (kept == live) return .{};
+    if (apply) {
+        const g = tot / kept_sum;
+        for (p, w, 0..) |*e, *x, i| {
+            if (e.* < 0) continue;
+            if (keep[i]) {
+                if (r.renorm == .kept) x.* *= g;
+            } else {
+                e.* = -1;
+                x.* = 0;
+            }
+        }
+    }
+    return .{ .dropped = live - kept, .mass = mass };
+}
+
+/// A window's rows (`rows` of `slots` slots, the first `topk` routed) as tf_ds_expert_prune_kernel leaves them, op
+/// for op: each row's rule (pruneRow's arithmetic), then `m.cap`'s window cap if any. Returns the slots dropped and
+/// the dropped weight share summed over the rows.
+pub fn pruneWindow(m: Mode, rows: usize, slots: usize, topk: usize, p: []i32, w: []f32) Outcome {
+    std.debug.assert(rows <= max_rows and topk <= max_topk and topk <= slots and p.len == w.len and p.len >= rows * slots);
+    var f: [max_rows][max_topk]f32 = undefined;
+    var rank: [max_rows][max_topk]u32 = undefined;
+    var keep: [max_rows][max_topk]bool = undefined;
+    var tot: [max_rows]f32 = undefined;
+    var live: [max_rows]u32 = undefined;
+    var ok: [max_rows]bool = undefined;
+    for (0..rows) |r| {
+        const pr = p[r * slots ..][0..topk];
+        const wr = w[r * slots ..][0..topk];
+        live[r] = 0;
+        tot[r] = 0;
+        for (pr, wr, 0..) |e, x, i| {
+            keep[r][i] = true;
+            if (e < 0) continue;
+            live[r] += 1;
+            tot[r] += x;
+        }
+        ok[r] = live[r] > 0 and tot[r] > 0 and !std.math.isInf(tot[r]);
+        if (!ok[r]) continue;
+        for (pr, wr, 0..) |e, x, i| f[r][i] = if (e >= 0) x / tot[r] else 0;
+        for (pr, 0..) |ei, i| {
+            rank[r][i] = 0;
+            if (ei < 0) continue;
+            for (pr, 0..) |ej, j| {
+                if (ej >= 0 and (f[r][j] > f[r][i] or (f[r][j] == f[r][i] and j < i))) rank[r][i] += 1;
+            }
+        }
+        var ex: [max_topk]f32 = undefined;
+        var run: f32 = 0;
+        for (0..live[r]) |k| {
+            for (pr, 0..) |e, i| {
+                if (e >= 0 and rank[r][i] == k) {
+                    ex[i] = run;
+                    run += f[r][i];
+                }
+            }
+        }
+        const floor = @max(m.rule.min_k, 1);
+        for (pr, 0..) |e, i| {
+            if (e >= 0) keep[r][i] = rank[r][i] < floor or ex[i] < m.rule.topp;
+        }
+    }
+    var in_cap: [max_experts]bool = @splat(false);
+    if (m.cap) |c| {
+        var score: [max_experts]f32 = undefined;
+        for (0..max_experts) |e| {
+            var s: f32 = 0;
+            var any = false;
+            for (0..rows) |q| {
+                for (0..topk) |i| {
+                    const x = p[q * slots + i];
+                    if (ok[q] and x >= 0 and x < max_experts and keep[q][i] and @as(usize, @intCast(x)) == e) {
+                        s += f[q][i];
+                        any = true;
+                    }
+                }
+            }
+            score[e] = if (any) s else -1;
+        }
+        for (0..max_experts) |e| {
+            if (score[e] < 0) continue;
+            var k: usize = 0;
+            for (0..max_experts) |o| {
+                if (score[o] >= 0 and (score[o] > score[e] or (score[o] == score[e] and o < e))) k += 1;
+            }
+            in_cap[e] = k < c.experts;
+        }
+    }
+    var out: Outcome = .{};
+    for (0..rows) |r| {
+        if (!ok[r]) {
+            if (m.cap) |c| {
+                if (live[r] > c.floor) {
+                    var seen: u32 = 0;
+                    for (p[r * slots ..][0..topk], w[r * slots ..][0..topk]) |*e, *x| {
+                        if (e.* < 0) continue;
+                        if (seen >= c.floor and m.apply) {
+                            e.* = -1;
+                            x.* = 0;
+                        }
+                        seen += 1;
+                    }
+                    out.dropped += live[r] - c.floor;
+                }
+            }
+            continue;
+        }
+        const pr = p[r * slots ..][0..topk];
+        const wr = w[r * slots ..][0..topk];
+        var kept: u32 = 0;
+        var ks: f32 = 0;
+        var mass: f32 = 0;
+        for (pr, wr, 0..) |e, x, i| {
+            if (e < 0) continue;
+            if (m.cap) |c| {
+                if (keep[r][i] and rank[r][i] >= c.floor and (e >= max_experts or !in_cap[@intCast(e)])) keep[r][i] = false;
+            }
+            if (keep[r][i]) {
+                kept += 1;
+                ks += x;
+            } else mass += f[r][i];
+        }
+        if (kept == live[r]) continue;
+        if (m.apply) {
+            const g = tot[r] / ks;
+            for (pr, wr, 0..) |*e, *x, i| {
+                if (e.* < 0) continue;
+                if (keep[r][i]) {
+                    if (m.rule.renorm == .kept) x.* *= g;
+                } else {
+                    e.* = -1;
+                    x.* = 0;
+                }
+            }
+        }
+        out.dropped += live[r] - kept;
+        out.mass += mass;
+    }
+    return out;
+}
+
+/// Distinct non-negative expert ids below max_experts in `p` (a window's rows' routed picks).
+pub fn distinct(p: []const i32) u32 {
+    var seen: [max_experts / 64]u64 = @splat(0);
+    var n: u32 = 0;
+    for (p) |e| {
+        if (e < 0 or e >= max_experts) continue;
+        const u: usize = @intCast(e);
+        const bit = @as(u64, 1) << @intCast(u % 64);
+        if (seen[u / 64] & bit == 0) n += 1;
+        seen[u / 64] |= bit;
+    }
+    return n;
+}
+
+/// The rule as 16 bytes every rank must hold alike: ranks on different rules pick different expert sets and sum
+/// wrong partials without any error.
+pub const fingerprint_bytes = 16;
+
+pub fn fingerprint(m: ?Mode) [fingerprint_bytes]u8 {
+    var b: [fingerprint_bytes]u8 = @splat(0);
+    const x = m orelse return b;
+    b[0] = if (x.apply) 2 else 1;
+    b[1] = @as(u8, @intCast(@intFromEnum(x.rule.renorm))) + 1;
+    std.mem.writeInt(u32, b[4..8], @bitCast(x.rule.topp), .little);
+    std.mem.writeInt(u32, b[8..12], x.rule.min_k, .little);
+    if (x.cap) |c| {
+        std.mem.writeInt(u16, b[12..14], @intCast(c.experts), .little);
+        b[14] = @intCast(c.floor);
+    }
+    return b;
+}
+
+/// Whether every rank's fingerprint (`all`: rank after rank) is the first's.
+pub fn agree(all: []const u8) bool {
+    const n = fingerprint_bytes;
+    if (all.len == 0 or all.len % n != 0) return false;
+    var i: usize = n;
+    while (i < all.len) : (i += n) {
+        if (!std.mem.eql(u8, all[0..n], all[i..][0..n])) return false;
+    }
+    return true;
+}
