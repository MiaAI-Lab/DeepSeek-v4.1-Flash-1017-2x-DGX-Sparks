+        const m = withCap(parse("0.83,3"), null).?;
+        var mc = m;
+        mc.cap = c;
+        var p: [16 * test_slots]i32 = undefined;
+        var w: [16 * test_slots]f32 = undefined;
+        randomWindow(rnd, rows, &p, &w);
+        const p0 = p;
+        const w0 = w;
+        var pr = p;
+        var wr = w;
+        _ = pruneWindow(m, rows, test_slots, 6, pr[0 .. rows * test_slots], wr[0 .. rows * test_slots]);
+        _ = pruneWindow(mc, rows, test_slots, 6, p[0 .. rows * test_slots], w[0 .. rows * test_slots]);
+        var routed: [16 * 6]i32 = undefined;
+        var routed_rule: [16 * 6]i32 = undefined;
+        for (0..rows) |r| {
+            @memcpy(routed[r * 6 ..][0..6], p[r * test_slots ..][0..6]);
+            @memcpy(routed_rule[r * 6 ..][0..6], pr[r * test_slots ..][0..6]);
+            try expectEqual(@as(i32, 384), p[r * test_slots + 6]); // the shared slot is not the cap's
+            // kept is a subset of what the rule kept, and the weights still sum to the row's total
