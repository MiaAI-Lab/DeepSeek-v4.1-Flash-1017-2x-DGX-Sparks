+        for (0..rows) |r| _ = pruneRow(m.rule, true, p2[r * test_slots ..][0..6], w2[r * test_slots ..][0..6]);
+        try std.testing.expectEqualSlices(i32, p2[0 .. rows * test_slots], p[0 .. rows * test_slots]);
