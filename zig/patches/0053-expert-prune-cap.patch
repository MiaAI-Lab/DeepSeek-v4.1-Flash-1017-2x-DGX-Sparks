+
+test "pruning keeps the weight sum, min_k slots and invents no pick" {
+    var prng = std.Random.DefaultPrng.init(0x5eed);
+    const rnd = prng.random();
+    for (0..2000) |_| {
+        var p: [6]i32 = undefined;
+        var w: [6]f32 = undefined;
+        for (&p, &w) |*e, *x| {
+            e.* = rnd.intRangeAtMost(i32, 0, 383);
+            x.* = rnd.float(f32) + 0.01;
+        }
+        const p0 = p;
+        const t0 = sum(&w);
+        const rule: Rule = .{ .topp = 0.5 + 0.49 * rnd.float(f32), .min_k = rnd.intRangeAtMost(u32, 1, 6), .renorm = .kept };
+        const o = pruneRow(rule, true, &p, &w);
+        try std.testing.expect(o.dropped <= 6 - rule.min_k);
+        try std.testing.expectApproxEqAbs(t0, sum(&w), 4 * std.math.floatEps(f32) * t0);
+        var live: u32 = 0;
+        for (p, p0) |e, e0| {
+            if (e >= 0) {
