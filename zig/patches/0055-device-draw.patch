+// TF_DS_T27_DEVICE_DRAW: a sampled row's token on the device, sampling.zig's sampleRow. One block (1024 threads) a row
+// of logits [rows, n] fp32 (row stride ld); `rules` the device table of each row's rule; out [rows] u32. The host keeps
+// every row this cannot reproduce (top_k == 0, top_k + 8 > 64) off the kernel. The first top_k candidates by (value
+// desc, id asc) are the first top_k of the host's top_k + 8, so the margin is not read. The candidates come from a radix
+// select over 64-bit keys (the value's order-preserving bits above, the inverted id below, -0 as +0, a NaN as the
+// lowest value): a key is unique, so the top_k-th largest key is exact, and the keys at or above it are the candidates in
+// no order, which a rank count then sorts. The score, top_p and min_p arithmetic is the host's in double, with the
+// device exp and log in place of libm's: a pick can differ only where two scores sit within their rounding.
+struct TfDsDrawRow {
+    uint64_t seed;
+    double temp;
+    double top_p;
+    double min_p;
+    uint64_t pos;
+    uint32_t top_k;  // 1..56 when temp > 0
+    uint32_t pad;
+};
+
+__device__ __forceinline__ uint64_t tf_ds_draw_key(float v, int id) {
+    uint32_t b = __float_as_uint(v);
+    if ((b << 1) == 0) b = 0;
+    const uint32_t hi = v != v ? 0u : ((b & 0x80000000u) ? ~b : (b | 0x80000000u));
+    return (uint64_t(hi) << 32) | uint64_t(0xFFFFFFFFu - uint32_t(id));
+}
+
+extern "C" __global__ void __launch_bounds__(1024) tf_ds_draw_rows_kernel(const float* logits, unsigned long long ld, int n,
+                                                                           const TfDsDrawRow* rules, unsigned* out) {
+    const float* row = logits + (unsigned long long)blockIdx.x * ld;
+    const TfDsDrawRow rule = rules[blockIdx.x];
+    if (rule.temp <= 0.0) {
+        const unsigned token = tf_ds_block_argmax(row, n);
+        if (threadIdx.x == 0) out[blockIdx.x] = token;
+        return;
+    }
+    __shared__ unsigned hist[256];
+    __shared__ uint64_t sel[64];
+    __shared__ unsigned sid[64];
+    __shared__ double scaled[64];
+    __shared__ double score[64];
+    __shared__ unsigned count, digit, remain;
+    const int tid = threadIdx.x;
+    const unsigned k = min(rule.top_k, (unsigned)n);
+
+    uint64_t prefix = 0;
+    unsigned want = k;
+    for (int d = 0; d < 8; ++d) {
+        const int shift = 56 - 8 * d;
+        for (int i = tid; i < 256; i += blockDim.x) hist[i] = 0;
+        __syncthreads();
+        for (int i = tid; i < n; i += blockDim.x) {
+            const uint64_t key = tf_ds_draw_key(row[i], i);
+            if (d == 0 || (key >> (shift + 8)) == (prefix >> (shift + 8))) atomicAdd(&hist[(key >> shift) & 0xFF], 1u);
+        }
+        __syncthreads();
+        if (tid == 0) {
+            unsigned above = 0;
+            int b = 255;
+            for (; b > 0; --b) {
+                if (above + hist[b] >= want) break;
+                above += hist[b];
+            }
+            digit = b;
+            remain = want - above;
+        }
+        __syncthreads();
+        prefix |= uint64_t(digit) << shift;
+        want = remain;
+    }
+    // prefix is the k-th largest key
+    if (tid == 0) count = 0;
+    __syncthreads();
+    for (int i = tid; i < n; i += blockDim.x) {
+        const uint64_t key = tf_ds_draw_key(row[i], i);
+        if (key >= prefix) {
+            const unsigned at = atomicAdd(&count, 1u);
+            if (at < 64) sel[at] = key;
+        }
+    }
+    __syncthreads();
+    if (tid < (int)k) {
+        unsigned rank = 0;
+        for (unsigned m = 0; m < k; ++m) rank += sel[m] > sel[tid] ? 1u : 0u;
+        sid[rank] = ~uint32_t(sel[tid]);
+    }
+    __syncthreads();
+    const double t = fmax(rule.temp, 1e-6);
+    if (tid < (int)k) {
+        const unsigned id = sid[tid];
+        scaled[tid] = double(row[id]) / t;
+        uint64_t x = tf_ds_mix64(rule.seed + 0x9E3779B97F4A7C15ull);
+        x = tf_ds_mix64(x ^ (rule.pos * 0xD1B54A32D192ED03ull));
+        x = tf_ds_mix64(x ^ uint64_t(id));
+        const double u = double(x >> 11) * 0x1p-53 + 0x1p-54;
+        score[tid] = scaled[tid] - log(-log(u));
+    }
+    __syncthreads();
+    if (tid != 0) return;
+    const double ninf = -__longlong_as_double(0x7ff0000000000000ll);
+    if (0.0 < rule.top_p && rule.top_p < 1.0) {
+        double mx = scaled[0];
+        for (unsigned j = 1; j < k; ++j) mx = fmax(mx, scaled[j]);
+        double probs[64];
+        for (unsigned j = 0; j < k; ++j) probs[j] = exp(scaled[j] - mx);
+        // numpy's pairwise sum of k <= 56 values (sampling.pairwiseSum)
+        double sum;
+        if (k < 8) {
+            sum = 0.0;
+            for (unsigned j = 0; j < k; ++j) sum += probs[j];
+        } else {
+            double r[8];
+            for (int j = 0; j < 8; ++j) r[j] = probs[j];
+            unsigned i = 8;
+            for (; i < k - k % 8; i += 8) {
+                for (int j = 0; j < 8; ++j) r[j] += probs[i + j];
+            }
+            sum = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]));
+            for (; i < k; ++i) sum += probs[i];
+        }
+        double acc = 0.0;
+        unsigned below = 0;
+        for (unsigned j = 0; j < k; ++j) {
+            acc += probs[j] / sum;
+            if (acc < rule.top_p) below += 1;
+        }
+        for (unsigned j = below + 1; j < k; ++j) score[j] = ninf;
+    }
+    if (rule.min_p > 0.0) {
+        const double floor_ = scaled[0] + log(rule.min_p);
+        for (unsigned j = 0; j < k; ++j) {
+            if (scaled[j] < floor_) score[j] = ninf;
+        }
+    }
+    unsigned best = 0;
+    for (unsigned j = 0; j < k; ++j) {
+        if (score[j] > score[best]) best = j;
+    }
+    out[blockIdx.x] = sid[best];
+}
