+/// How a verify round gets its tokens: the device's argmax, the device's draw, or the logits on the host.
+pub const RoundPath = enum { greedy, device_draw, host_draw };
+
+/// The path of a round from its windows' rules (`add` each window's stream) and the TF_DS_T27_DEVICE_DRAW switch: one
+/// row the device cannot draw sends the whole round to the host.
+pub const RoundRules = struct {
+    sampled: bool = false,
+    drawable: bool = true,
+
+    pub fn add(r: *RoundRules, temperature: f64, top_k: usize) void {
+        if (temperature > 0) r.sampled = true;
+        if (!deviceDrawable(temperature, top_k)) r.drawable = false;
+    }
+
+    pub fn path(r: RoundRules, device_draw: bool) RoundPath {
+        if (!r.sampled) return .greedy;
+        return if (device_draw and r.drawable) .device_draw else .host_draw;
+    }
+};
