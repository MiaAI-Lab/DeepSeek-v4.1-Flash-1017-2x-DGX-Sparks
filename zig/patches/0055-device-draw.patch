+/// A deterministic fp32 row of `n` logits for the device draw's checks: values on a 1/8 grid (many equal ones, so the
+/// ties by id matter), a few large outliers, a spread like a trained model's top.
+fn testRow(a: std.mem.Allocator, n: usize, seed: u64) ![]f32 {
+    var prng = std.Random.DefaultPrng.init(seed);
+    const rnd = prng.random();
+    const row = try a.alloc(f32, n);
+    for (row) |*v| v.* = @round(rnd.floatNorm(f32) * 8.0) / 8.0;
+    for (0..24) |_| row[rnd.uintLessThan(usize, n)] = 4.0 + @round(rnd.float(f32) * 16.0) / 8.0;
+    return row;
+}
