+        const row = try testRow(a, 5000, seed);
+        defer a.free(row);
+        const all = try a.alloc(Pair, row.len);
+        defer a.free(all);
+        for (row, 0..) |v, i| all[i] = .{ .v = v, .id = @intCast(i) };
+        std.mem.sort(Pair, all, {}, struct {
+            fn lt(_: void, x: Pair, y: Pair) bool {
+                return before(x.v, x.id, y.v, y.id);
+            }
+        }.lt);
+        var values: [max_candidates]f32 = undefined;
+        var ids: [max_candidates]i64 = undefined;
+        for ([_]usize{ 1, 20, 28, max_candidates }) |count| {
+            try std.testing.expectEqual(count, topCandidates(row, count, &values, &ids));
+            for (0..count) |j| {
+                try std.testing.expectEqual(all[j].id, ids[j]);
