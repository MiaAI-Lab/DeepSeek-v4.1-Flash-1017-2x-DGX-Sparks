+/// GET /snapshot — everything the engine knows about its sessions, in ONE document with ONE timestamp.
+///
+/// The dashboard used to need a compiled gauge per question (pool rows, chunk speed, conversation ids,
+/// per-stream progress…): ten engine rebuilds in one night. This endpoint is the interface instead — new card
+/// facts are consumer-side work, and the schema is versioned so adding a key never breaks a reader.
+///   · `streams[]` is the session spine: `slot` is stable for the request's life, so a series can never switch
+///     conversation between scrapes; the request's own facts (prompt, cached, context, generated) travel with it.
+///   · `queue` says WHY requests wait, counted where each hold is decided.
+///   · `cache` carries the memory tier's budget, so "how full" has a denominator.
+/// Built on the request thread from state the engine thread already publishes; no walk, no allocation beyond the
+/// response body, and cheap enough to answer at 1 Hz.
+pub fn snapshot(srv: *Server, conn: *Conn, a: Allocator) !void {
+    var status: api.Status = .{};
+    srv.engine.status(&status, &.{});
+    const t = srv.metrics.totals(srv.io);
+    const o = try json.newObject(a);
+    try o.put(a, "schema_version", try json.intValue(a, 1));
+
+    const e = try json.newObject(a);
+    try e.put(a, "model", .{ .string = srv.config.served_name });
+    try e.put(a, "lanes", try json.intValue(a, srv.info.lanes));
+    try e.put(a, "prompt_cache", .{ .bool = srv.info.prompt_cache });
+    try e.put(a, "context_window", try json.intValue(a, srv.info.context_window));
+    try o.put(a, "engine", .{ .object = e });
+    const totals = try json.newObject(a);
+    try totals.put(a, "prompt_tokens_total", try json.intValue(a, t.prompt));
+    try totals.put(a, "prompt_tokens_cached_total", try json.intValue(a, t.cached));
+    try totals.put(a, "generation_tokens_total", try json.intValue(a, t.generation));
+    if (status.preemptions) |p| try totals.put(a, "preemptions_total", try json.intValue(a, p));
+    try o.put(a, "totals", .{ .object = totals });
+    const q = try json.newObject(a);
+    try q.put(a, "running", try json.intValue(a, status.running));
+    try q.put(a, "waiting", try json.intValue(a, status.waiting));
+    try q.put(a, "waiting_lane", try json.intValue(a, status.waiting_lane));
+    try q.put(a, "waiting_restore", try json.intValue(a, status.waiting_restore));
+    try q.put(a, "waiting_deferred", try json.intValue(a, status.waiting_deferred));
+    try q.put(a, "waiting_pool_room", try json.intValue(a, status.waiting_pool_room));
