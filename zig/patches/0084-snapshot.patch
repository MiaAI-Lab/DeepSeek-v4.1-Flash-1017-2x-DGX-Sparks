@@ -380,6 +396,19 @@ pub const Status = struct {
     /// not the one filling). Only one pass fills at a time, so at most one entry here is non-zero.
     prefill_stream_done: [max_stream_groups]u64 = @splat(0),
     prefill_stream_total: [max_stream_groups]u64 = @splat(0),
+    /// One record per admitted stream, the session spine: `slot` is stable for the request's life, so a series
+    /// labelled by it can never switch conversation between scrapes (an array POSITION can, and did).
+    streams_detail: [max_stream_groups]StreamDetail = @splat(StreamDetail{}),
