+        const scale = s.calScale();
+        var factor: f64 = 1.0;
+        for (s.cal_raw[0..n], 0..) |p, i| {
+            factor *= scale;
+            at += (std.fmt.bufPrint(buf[at..], "{s}{d:.3}", .{ if (i > 0) ", " else "", p * factor }) catch return).len;
+        }
+        at += (std.fmt.bufPrint(buf[at..], "], \"tokens\": {d}}}\n", .{tokens}) catch return).len;
