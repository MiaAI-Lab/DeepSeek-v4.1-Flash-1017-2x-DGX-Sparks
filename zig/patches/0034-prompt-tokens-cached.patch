+test "the engine says it keeps prompt states exactly when the host has a prompt cache" {
+    const gpa = std.testing.allocator;
+    const Nothing = struct {
+        fn release(_: *anyopaque) void {}
+        fn bytes(_: *anyopaque, _: u32) u64 {
+            return 0;
+        }
+        fn save(_: *anyopaque, _: ?*anyopaque, _: u32) anyerror!api.prompt_cache.Saved {
+            return error.Unused;
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: api.prompt_cache.Saved) anyerror!void {
+            return error.Unused;
+        }
+        fn drop(_: *anyopaque, _: api.prompt_cache.Saved) void {}
+    };
+    const vt: api.prompt_cache.Snapshots.VTable = .{ .bytes = Nothing.bytes, .save = Nothing.save, .restore = Nothing.restore, .drop = Nothing.drop };
+    for ([_]bool{ false, true }) |keeps| {
+        var target: lanes.fake.Fake = .{ .gpa = gpa };
+        defer target.deinit();
+        const h = try gpa.create(Host);
+        defer gpa.destroy(h);
+        h.* = .{ .gpa = gpa, .gpu = null, .family = &target, .release = Nothing.release, .inner = target.backend(), .vtable = undefined, .cfg = undefined, .clock = undefined, .core = undefined, .host = undefined };
+        if (keeps) h.cache = api.prompt_cache.Store.init(gpa, .{ .ptr = &target, .vtable = &vt }, .{}, 1 << 20);
+        defer if (h.cache) |*store| store.deinit();
+        try h.serve(std.testing.io, .{ .exact_width = 8, .mtp = true, .speculate = true, .drafts = 7, .hidden_rows = true }, 8, .{ .lanes = 2 }, null);
+        defer {
+            h.host.stop();
+            h.core.deinit();
+            h.cfg.deinit(gpa);
+        }
+        try std.testing.expectEqual(keeps, h.host.engine().info().prompt_cache);
+    }
+}
