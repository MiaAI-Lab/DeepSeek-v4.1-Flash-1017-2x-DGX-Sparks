+
+test "cache migration expiry survives restart and permits fresh replacement" {
+    const h = try H.init(testing.allocator, .{ .tag = "migration-expiry", .turns = 0 });
+    defer h.deinit();
+    const ids = try idsOf(testing.allocator, 64, 9091);
+    defer testing.allocator.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(91), .source = 91 });
+    const query: store.Query = .{ .keyed = ids, .max_at = 64 };
+    try testing.expect(h.s.lookup(query) != null);
+    h.cfg.ttl_ns = 1;
+    try h.reopen();
+    try testing.expectError(error.Missing, h.s.beginRead(key));
+    try testing.expect(h.s.lookup(query) == null);
+    try testing.expect(settle(h).done);
+    h.s.cfg.ttl_ns = 24 * 3600 * std.time.ns_per_s;
+    const renewed = try write(h, ids, .{ .lineage = lin(91), .source = 91 });
+    try testing.expectEqualSlices(u8, &key, &renewed);
+    try testing.expect(h.s.lookup(query) != null);
+}
+
+test "cache migration low memory blocks new reads and writes without destroying a healthy cache" {
+    const h = try H.init(testing.allocator, .{ .tag = "migration-memory", .turns = 0 });
+    defer h.deinit();
+    const ids = try idsOf(testing.allocator, 64, 9092);
+    defer testing.allocator.free(ids);
+    const key = try write(h, ids, .{ .lineage = lin(92), .source = 92 });
+    const query: store.Query = .{ .keyed = ids, .max_at = 64 };
+    h.s.cfg.memory_floor = 1024;
+    h.s.cfg.memory_reserve = 512;
+    h.s.hooks.mem_available = compatLowMemory;
+    try testing.expect(keepIds(h, ids, .{ .lineage = lin(92), .source = 92 }) == .no_staging);
+    try testing.expect(h.s.lookup(query) == null);
+    try testing.expectError(error.NoSlot, h.s.beginRead(key));
+    h.s.hooks.mem_available = compatUnknownMemory;
+    try testing.expect(h.s.lookup(query) == null);
+    h.s.hooks.mem_available = compatEnoughMemory;
+    try testing.expect(h.s.lookup(query) != null);
+    const restored = (try restore(h, key)).?;
