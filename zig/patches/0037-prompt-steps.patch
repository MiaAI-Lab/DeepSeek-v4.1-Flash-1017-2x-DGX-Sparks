+    /// Whether an admitted prompt still has chunks to read (prompt steps only).
+    fn fillsPending(h: *const LaneHost) bool {
+        if (!h.core.fills()) return false;
+        for (h.admitted.items) |job| if (job.prefilled == null) return true;
+        return false;
+    }
