+    /// One chunk of one admitted prompt, in turn (prompt steps only); a prompt that is complete joins the rounds, and a
+    /// request that arrived meanwhile starts at the next turn, after the live streams' round in between. A job is set
+    /// up and read its first chunk in the same turn (setup).
+    fn fillOne(h: *LaneHost) bool {
+        if (!h.core.fills() or h.isBroken()) return false;
+        const n = h.admitted.items.len;
+        for (0..n) |offset| {
+            const i = (h.fill_next + offset) % n;
+            const job = h.admitted.items[i];
+            if (job.prefilled != null) continue;
+            h.fill_next = i + 1;
+            const first = !job.started;
+            if (first and !h.setup(job)) return false;
+            h.filling = job; // (the service fence: a keep inside this chunk is not a service between chunks)
+            defer h.filling = null;
+            const t0 = std.Io.Clock.awake.now(h.io).toNanoseconds();
+            h.busyEnter();
+            const stepped = h.core.fillStream(&job.stream, first);
+            h.busyLeave();
+            job.fill_ns += std.Io.Clock.awake.now(h.io).toNanoseconds() - t0;
+            const done = stepped catch |e| {
+                if (h.isBroken()) {
+                    _ = h.dropBroken(job);
+                } else if (e == error.Cancelled) {
+                    _ = h.cancel(job);
+                } else if (e == error.ContextFull and h.admitted.items.len > 1) {
+                    _ = h.requeue(job);
+                } else {
+                    h.checkFatal(e);
+                    _ = h.drop(job, h.words(e));
+                }
+                return false;
+            };
+            job.reported(); // the first chunk restored its entry: another prompt's keep may evict it now
+            h.progressed(); // (a chunk ended: the stall monitor's clock restarts)
+            if (h.aborted()) { // (the collectives were stopped under it: its rows are not the model's)
+                _ = h.dropBroken(job);
+                return false;
+            }
+            if (done) {
+                // the prefill rate and seconds count the job's own chunks, not the rounds and other prompts between them
+                job.began = std.Io.Clock.awake.now(h.io).toNanoseconds() - job.fill_ns;
+                h.prefilled(job, job.began);
+                if (h.deliver(job)) h.remove(job);
+            }
+            return true;
+        }
+        return false;
+    }
