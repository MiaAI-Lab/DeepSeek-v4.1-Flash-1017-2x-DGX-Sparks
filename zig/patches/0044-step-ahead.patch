+            if (at == refuse_at) return error.InjectedFailure;
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            return f.save(@ptrCast(@alignCast(owner.?)), at);
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+            return error.BackendRestores;
+        }
+        fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            f.drop(saved);
+        }
+    };
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        tokens: std.ArrayList(u32) = .empty,
+        cached: ?u32 = null,
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .prefilled => |c| b.cached = c,
+                .tokens => |t| b.tokens.appendSlice(std.testing.allocator, t) catch {},
+                .finished => |f| b.done = f.reason,
+            }
+        }
+        fn wait(b: *@This()) Reason {
+            while (true) {
+                b.mutex.lockUncancelable(std.testing.io);
+                const d = b.done;
+                b.mutex.unlock(std.testing.io);
+                if (d) |r| return r;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+};
+
+test "step-ahead: a reply's own tokens are read while the client works, and its next step resumes past them with the same tokens" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = AheadKit.Snaps.bytes, .save = AheadKit.Snaps.save, .restore = AheadKit.Snaps.restore, .drop = AheadKit.Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    host.cache = &store;
+    host.ahead_on = true;
+    host.ahead_grid = .{ .chunk = 4, .tail = 2 };
+    var warm: AheadKit.Box = .{};
+    defer warm.tokens.deinit(gpa);
+    host.ahead_sink = .{ .ctx = &warm, .event = AheadKit.Box.event };
+    try host.start();
+    defer host.stop();
+    const e = host.engine();
+    // step 1: a 10-token prompt kept at its history (8); the reply's 6 tokens make 16, so the pass keeps 12 (16 - 2 down to 4s)
+    const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+    var b1: AheadKit.Box = .{};
+    defer b1.tokens.deinit(gpa);
+    const r1: Request = .{ .prompt = &t1, .max_tokens = 6, .history_len = 8 };
+    try e.submit(1, &r1, .{ .ctx = &b1, .event = AheadKit.Box.event });
+    try std.testing.expectEqual(Reason.length, b1.wait());
+    try std.testing.expectEqual(@as(?u32, 0), b1.cached);
+    // the step-ahead pass: one token past a pass that resumed at 8
+    try std.testing.expectEqual(Reason.length, warm.wait());
+    try std.testing.expectEqual(@as(?u32, 8), warm.cached);
+    var found = false;
+    for (store.entries.items) |x| found = found or x.at == 12;
+    try std.testing.expect(found);
+    // step 2: the history, the whole reply, a tool result: resumes at 12, not 8, and reads the history exactly
+    var t2: std.ArrayList(u32) = .empty;
+    defer t2.deinit(gpa);
+    try t2.appendSlice(gpa, &t1);
+    try t2.appendSlice(gpa, b1.tokens.items);
+    try t2.appendSlice(gpa, &.{ 7, 7, 5, 3 });
+    var b2: AheadKit.Box = .{};
+    defer b2.tokens.deinit(gpa);
+    const r2: Request = .{ .prompt = t2.items, .max_tokens = 12, .history_len = @intCast(t2.items.len - 2), .drafts = true };
+    try e.submit(2, &r2, .{ .ctx = &b2, .event = AheadKit.Box.event });
+    try std.testing.expectEqual(Reason.length, b2.wait());
+    try std.testing.expectEqual(@as(?u32, 12), b2.cached);
+    var history: std.ArrayList(u32) = .empty;
+    defer history.deinit(gpa);
+    try history.appendSlice(gpa, t2.items);
+    for (b2.tokens.items) |t| {
+        try std.testing.expectEqual(lanes.fake.next(history.items, null, history.items.len), t);
+        try history.append(gpa, t);
+    }
+}
+
+test "step-ahead: nothing runs when off, or when the reply moves no kept state a chunk on; on, the same reply warms" {
+    const gpa = std.testing.allocator;
+    // (on, chunk rows, reply tokens, passes): 10 + 6 tokens reach 12 past the kept 8 on a 4-row grid (the positive
+    // test's workload), which only runs a pass when on; 10 + 2 on an 8-row grid reach no chunk end past 8
+    // a store of 100 bytes holds the state at 8 (96 bytes) but never one at 12 (112): the pass runs, nothing is kept
+    // and a backend save that fails at 12: the store tries, refuses, and the pass is not counted as kept
+    const Case = struct { on: bool, chunk: u32, reply: u32, passes: u64, budget: u64 = 1 << 20, kept: u64 = 0, refuse: u32 = 0 };
+    defer AheadKit.Snaps.refuse_at = 0;
+    for ([_]Case{ .{ .on = false, .chunk = 4, .reply = 6, .passes = 0 }, .{ .on = true, .chunk = 8, .reply = 2, .passes = 0 }, .{ .on = true, .chunk = 4, .reply = 6, .passes = 1, .kept = 1 }, .{ .on = true, .chunk = 4, .reply = 6, .passes = 1, .budget = 100 }, .{ .on = true, .chunk = 4, .reply = 6, .passes = 1, .refuse = 12 } }) |k| {
+        AheadKit.Snaps.refuse_at = k.refuse;
+        var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+        defer cfg.deinit(gpa);
+        var target: lanes.fake.Fake = .{ .gpa = gpa };
+        defer target.deinit();
+        var clock: lanes.fake.FixedClock = .{};
+        var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+        defer core.deinit();
+        var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = AheadKit.Snaps.bytes, .save = AheadKit.Snaps.save, .restore = AheadKit.Snaps.restore, .drop = AheadKit.Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, k.budget);
+        defer store.deinit();
+        var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+        host.cache = &store;
+        host.ahead_on = k.on;
+        host.ahead_grid = .{ .chunk = k.chunk, .tail = 2 };
+        var warm: AheadKit.Box = .{};
+        defer warm.tokens.deinit(gpa);
+        host.ahead_sink = .{ .ctx = &warm, .event = AheadKit.Box.event };
+        try host.start();
+        var stopped = false; // (a failed check below still joins the engine thread before what it uses goes)
+        defer if (!stopped) host.stop();
+        const e = host.engine();
+        const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+        var b1: AheadKit.Box = .{};
+        defer b1.tokens.deinit(gpa);
+        const r1: Request = .{ .prompt = &t1, .max_tokens = k.reply, .history_len = 8 };
+        try e.submit(1, &r1, .{ .ctx = &b1, .event = AheadKit.Box.event });
+        try std.testing.expectEqual(Reason.length, b1.wait());
+        if (k.passes > 0) try std.testing.expectEqual(Reason.length, warm.wait());
+        host.stop(); // (the engine thread joined: its counts are final)
+        stopped = true;
+        try std.testing.expectEqual(k.passes, host.ahead_counts.queued);
+        try std.testing.expectEqual(k.kept, host.ahead_counts.ran); // ran counts a state the cache kept at 12
+        try std.testing.expectEqual(k.passes - k.kept, host.ahead_counts.unkept);
+    }
+}
+
+/// A sink that notes whether its job was still among the host's admitted ones when it reported its end (its job is
+/// freed right after: a submission walking `admitted` would meet it freed). It runs on the engine thread, the one
+/// thread that changes `admitted`, so it reads the list without the lock.
+const Detached = struct {
+    host: *LaneHost,
+    box: AheadKit.Box = .{},
+    ends: std.atomic.Value(u32) = .init(0),
+    listed: std.atomic.Value(u32) = .init(0),
+    fn event(ctx: *anyopaque, id: Id, e: *const Event) void {
+        const d: *@This() = @ptrCast(@alignCast(ctx));
+        if (e.* == .finished) {
+            _ = d.ends.fetchAdd(1, .acq_rel);
+            // (a queued pass that yields ends on the submitting thread, never admitted: not looked at)
+            if (e.finished.reason != .cancelled) for (d.host.admitted.items) |j| if (j.id == id) {
+                _ = d.listed.fetchAdd(1, .acq_rel);
+            };
+        }
+        AheadKit.Box.event(&d.box, id, e);
+    }
+};
+
+test "a reply that ends leaves the admitted jobs before it is freed, step-ahead on or off (its pass too)" {
+    const gpa = std.testing.allocator;
+    for ([_]bool{ false, true }) |on| {
+        var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+        defer cfg.deinit(gpa);
+        var target: lanes.fake.Fake = .{ .gpa = gpa };
+        defer target.deinit();
+        var clock: lanes.fake.FixedClock = .{};
+        var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+        defer core.deinit();
+        var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = AheadKit.Snaps.bytes, .save = AheadKit.Snaps.save, .restore = AheadKit.Snaps.restore, .drop = AheadKit.Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+        defer store.deinit();
+        var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+        host.cache = &store;
+        host.ahead_on = on;
+        host.ahead_grid = .{ .chunk = 4, .tail = 2 };
+        var warm: Detached = .{ .host = &host };
+        defer warm.box.tokens.deinit(gpa);
+        host.ahead_sink = .{ .ctx = &warm, .event = Detached.event };
+        try host.start();
+        var stopped = false; // (a failed check below still joins the engine thread before what it uses goes)
+        defer if (!stopped) host.stop();
+        const e = host.engine();
+        const t1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+        const t2 = [_]u32{ 2, 7, 1, 8, 2, 8, 1, 8, 2, 8 };
+        var a: Detached = .{ .host = &host };
+        defer a.box.tokens.deinit(gpa);
+        var b: Detached = .{ .host = &host };
+        defer b.box.tokens.deinit(gpa);
+        // two at once (they end in the same round's delivery), then one alone (its step-ahead pass may follow)
+        const r1: Request = .{ .prompt = &t1, .max_tokens = 6, .history_len = 8 };
+        const r2: Request = .{ .prompt = &t2, .max_tokens = 3, .history_len = 8 };
+        try e.submit(1, &r1, .{ .ctx = &a, .event = Detached.event });
+        try e.submit(2, &r2, .{ .ctx = &b, .event = Detached.event });
+        try std.testing.expectEqual(Reason.length, a.box.wait());
+        try std.testing.expectEqual(Reason.length, b.box.wait());
+        var c: Detached = .{ .host = &host };
+        defer c.box.tokens.deinit(gpa);
+        try e.submit(3, &r1, .{ .ctx = &c, .event = Detached.event });
+        try std.testing.expectEqual(Reason.length, c.box.wait());
+        if (on) _ = warm.box.wait();
+        host.stop();
+        stopped = true;
+        for ([_]*Detached{ &a, &b, &c }) |d| {
+            try std.testing.expectEqual(@as(u32, 1), d.ends.load(.acquire));
+            try std.testing.expectEqual(@as(u32, 0), d.listed.load(.acquire));
+        }
+        try std.testing.expectEqual(@as(u32, 0), warm.listed.load(.acquire));
+        try std.testing.expect(!on or warm.ends.load(.acquire) >= 1);
+        try std.testing.expectEqual(on, host.ahead_counts.queued > 0);
+    }
+}
