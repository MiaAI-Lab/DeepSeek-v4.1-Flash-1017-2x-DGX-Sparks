+test "a queued step-ahead pass goes when a request waits behind it (its yield in submit had no room)" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    host.ahead_on = false; // (init reads TF_DS_STEP_AHEAD)
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        tokens: usize = 0,
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .tokens => |x| b.tokens += x.len,
+                .finished => |f| b.done = f.reason,
+                else => {},
+            }
+        }
+        fn wait(b: *@This()) Reason {
+            while (true) {
+                b.mutex.lockUncancelable(std.testing.io);
+                const d = b.done;
+                b.mutex.unlock(std.testing.io);
+                if (d) |r| return r;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+    // the queue submit leaves when it cannot reserve the yielded list: the pass first, a background request behind
+    // it (ahead_on off here, so submit leaves the queue as it is; the engine thread has not started yet)
+    var wbox: Box = .{};
+    const wj = wj: { // (the queue owns it once appended: the host's finish frees it)
+        const toks = try gpa.dupe(u32, &[_]u32{ 3, 1, 4, 1, 5, 9, 2, 6 });
+        errdefer gpa.free(toks);
+        const w = try gpa.create(LaneHost.Warm);
+        errdefer gpa.destroy(w);
+        w.* = .{ .tokens = toks, .from = 0, .at = 4, .request = .{ .prompt = toks, .max_tokens = 1, .drafts = false, .background = true, .history_len = 4 } };
+        const j = try gpa.create(LaneHost.Job);
+        errdefer gpa.destroy(j);
+        j.* = .{ .host = &host, .id = LaneHost.ahead_id_base + 1, .request = &w.request, .sink = .{ .ctx = &wbox, .event = Box.event }, .warm = w };
+        try host.queued.append(gpa, j);
+        break :wj j;
+    };
+    var bbox: Box = .{};
+    const prompt = [_]u32{ 2, 7, 1, 8, 2, 8 };
+    const bg: Request = .{ .prompt = &prompt, .max_tokens = 3, .background = true };
+    const e = host.engine();
+    try e.submit(1, &bg, .{ .ctx = &bbox, .event = Box.event });
+    try std.testing.expectEqual(@as(usize, 2), host.queued.items.len);
+    try std.testing.expect(host.queued.items[0] == wj);
+    try host.start();
+    var stopped = false; // (a failed check below still joins the engine thread before what it uses goes)
+    defer if (!stopped) host.stop();
+    try std.testing.expectEqual(Reason.cancelled, wbox.wait());
+    try std.testing.expectEqual(Reason.length, bbox.wait());
+    host.stop();
+    stopped = true;
+    try std.testing.expectEqual(@as(usize, 0), wbox.tokens);
+    try std.testing.expectEqual(@as(u64, 1), host.ahead_counts.dropped);
+    try std.testing.expectEqual(@as(u64, 0), host.ahead_counts.ran);
