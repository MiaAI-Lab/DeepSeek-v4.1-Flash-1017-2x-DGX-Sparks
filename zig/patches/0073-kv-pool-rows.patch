--- /dev/null
+++ b/zig/src/core/lanes/pool.zig
@@ -0,0 +1,25 @@
+//! A backend's KV pool for /health and /metrics when the pool is NOT cut into parts (family-neutral):
+//! how many rows the pool has, how many live streams and kept prompt states hold, and what is free.
+//! dsv41's TF_DS_KV_SHARD=0 is the case this exists for: the pool is replicated on every rank, so the
+//! shard's per-part counters (kv_parts.zig) have nothing to report, and without this the pool's
+//! occupancy is not published at all. A backend that replicates hands the host a `Source`; the host
+//! reads it on its engine thread (the backend's own thread) and publishes the copy for status readers.
+const std = @import("std");
+
+pub const Stats = struct {
+    rows: u64 = 0, // the pool's positions
+    live: u64 = 0, // rows live streams hold (their reserved extents)
+    kept: u64 = 0, // rows kept prompt states hold outside live extents
+    free: u64 = 0, // rows free
+    streams: u64 = 0, // live streams
+};
+
+pub const Source = struct {
+    ctx: *anyopaque,
+    read: *const fn (ctx: *anyopaque, out: *Stats) void,
+};
+
+test "a pool's rows add up: live plus kept plus free is the whole pool" {
+    const s: Stats = .{ .rows = 100, .live = 30, .kept = 25, .free = 45 };
+    try std.testing.expectEqual(s.rows, s.live + s.kept + s.free);
+}
diff --git a/zig/src/families/dsv41/lanes.zig b/zig/src/families/dsv41/lanes.zig
index 40006aa..ebdecc7 100644
--- a/zig/src/families/dsv41/lanes.zig
+++ b/zig/src/families/dsv41/lanes.zig
@@ -473,6 +473,8 @@ pub const Lanes = struct {
     kv: ?*kv_lanes.Kv = null, // TF_DS_KV_SHARD: the parts' planner (startKv, at open; null: the switch off)
     kv_stats: lanes.kv_parts.Stats = .{}, // the last parts' stats kvPartsFn built (the engine loop reads them every
     kv_stats_at: u64 = 0, //   iteration: rebuilt at most each kv_stats_ns, Model.now; 0: never built)
+    pool_stats: lanes.pool.Stats = .{}, // the last pool snapshot poolFn built (the same loop and cadence; the pool
+    pool_stats_at: u64 = 0, //   replicated, TF_DS_KV_SHARD=0: the parts above have nothing to say then)
     /// The pair's one rank_wire Leader (native.openPair: agreed with rank_identity's full fingerprint before anything
     /// spill- or shard-related crosses), shared by the spill tier and the KV parts; owned here (null: neither is on).
     rw: ?*rank_wire.Leader = null,
@@ -769,6 +771,54 @@ pub const Lanes = struct {
         self.kv_stats = out.*;
     }
 
+    /// The replicated pool's rows for /health and /metrics (native.Loaded.kv_pool: the host reads them on its engine
+    /// thread, in noteLive, every engine-loop iteration). Rebuilt at most each kv_stats_ns: a rebuild walks every
+    /// live extent and kept state and sorts the kept spans (allocating), as the sharded parts' rebuild does.
+    pub fn poolFn(ptr: *anyopaque, out: *lanes.pool.Stats) void {
+        const self = of(ptr);
+        const now = self.m.now();
+        if (self.pool_stats_at != 0 and now -| self.pool_stats_at < kv_stats_ns) {
+            out.* = self.pool_stats;
+            return;
+        }
+        self.pool_stats_at = now;
+        out.* = self.poolSnapshot();
+        self.pool_stats = out.*;
+    }
+
+    /// The pool's rows now: the live streams' extents, the kept states outside them, and the rest free.
+    fn poolSnapshot(self: *Lanes) lanes.pool.Stats {
+        const cap: u64 = @intCast(self.m.pool_cap);
+        var s: lanes.pool.Stats = .{ .rows = cap };
+        var it = self.streams.valueIterator();
+        while (it.next()) |l| {
+            if (l.end > l.base) s.live += @intCast(l.end - l.base);
+            s.streams += 1;
+        }
+        var spans: std.ArrayList([2]usize) = .empty;
+        defer spans.deinit(self.gpa);
+        for (self.snaps.items) |sn| {
+            if (sn.stale or sn.at == 0) continue;
+            var clash = false;
+            var live = self.streams.valueIterator();
+            while (live.next()) |l| {
+                if (sn.base < l.end and l.base < sn.base + sn.at) {
+                    clash = true;
+                    break;
+                }
+            }
+            if (clash) continue; // (rows inside a live extent are that stream's, as the parts' stats count them)
+            spans.append(self.gpa, .{ sn.base, sn.base + sn.at }) catch {
+                s.kept = 0; // (out of memory: report what is certain, never a wrong free count)
+                s.free = cap -| s.live;
+                return s;
+            };
+        }
+        s.kept = @intCast(parts.covered(spans.items, 0, self.m.pool_cap));
+        s.free = cap -| (s.live + s.kept);
+        return s;
+    }
+
     /// How stale /health's parts' stats may be (kvPartsFn).
     const kv_stats_ns: u64 = 250 * std.time.ns_per_ms;
 
