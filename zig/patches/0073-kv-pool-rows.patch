+/// The KV pool's rows when it is replicated rather than cut into parts (dsv41's TF_DS_KV_SHARD=0):
+/// tensorfold:kv_pool_rows, kv_pool_live, kv_pool_kept, kv_pool_free and kv_pool_streams (gauges).
+/// The three blocks are exact rows and sum to kv_pool_rows, as the sharded parts' do.
+pub fn poolFamilies(w: *std.Io.Writer, p: api.PoolStats) !void {
+    try gauge(w, "kv_pool_rows", "gauge", "Positions the KV pool holds.", p.rows);
+    try gauge(w, "kv_pool_live", "gauge", "Rows live streams' extents hold.", p.live);
+    try gauge(w, "kv_pool_kept", "gauge", "Rows kept prompt states hold outside live extents.", p.kept);
+    try gauge(w, "kv_pool_free", "gauge", "Rows of the pool free.", p.free);
+    try gauge(w, "kv_pool_streams", "gauge", "Live streams holding rows in the pool.", p.streams);
+}
+
 fn kindOf(comptime gauges: []const []const u8, comptime name: []const u8) []const u8 {
     @setEvalBranchQuota(100_000);
     for (gauges) |g| if (std.mem.eql(u8, g, name)) return "gauge";
@@ -529,3 +541,26 @@ test "kv shard families: present only with a sharded backend's stats, its counte
         "tensorfold:kv_shard_rank_copy_bytes{rank=\"1\"} 4096\n",
     }) |line| try std.testing.expect(std.mem.indexOf(u8, out2.written(), line) != null);
 }
+
+test "pool families: present only with a replicated pool's rows, every block a gauge" {
+    const gpa = std.testing.allocator;
+    var m: Metrics = .{ .gpa = gpa };
+    var stub: RenderStub = .{};
+    var plain: std.Io.Writer.Allocating = .init(gpa);
+    defer plain.deinit();
+    try m.render(std.testing.io, &plain.writer, stub.engine(), 4096);
+    try std.testing.expect(std.mem.indexOf(u8, plain.written(), "kv_pool") == null);
+    stub.status_value.pool = .{ .rows = 100, .live = 30, .kept = 25, .free = 45, .streams = 2 };
+    var out: std.Io.Writer.Allocating = .init(gpa);
+    defer out.deinit();
+    try m.render(std.testing.io, &out.writer, stub.engine(), 4096);
+    const body = out.written();
+    for ([_][]const u8{
+        "# TYPE tensorfold:kv_pool_rows gauge\n",
+        "tensorfold:kv_pool_rows 100\n",
+        "tensorfold:kv_pool_live 30\n",
+        "tensorfold:kv_pool_kept 25\n",
+        "tensorfold:kv_pool_free 45\n",
+        "tensorfold:kv_pool_streams 2\n",
+    }) |line| try std.testing.expect(std.mem.indexOf(u8, body, line) != null);
+}
