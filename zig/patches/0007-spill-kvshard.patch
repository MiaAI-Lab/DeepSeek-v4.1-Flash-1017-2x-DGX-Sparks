+test "put: short writes and EINTR still write every byte; pages dropped after the fsync, then renamed" {
+    const gpa = testing.allocator;
+    var rb: [256]u8 = undefined;
+    const root = try testRoot(&rb, "put");
+    const dir = try freshDir(gpa, root);
+    defer {
+        _ = c.close(dir);
+        dropDir(gpa, root);
+    }
+    var script: Script = .{ .steps = &.{ .{ .short = 3 }, .intr, .{ .short = 1 }, .intr, .pass } };
+    defer script.events.deinit(gpa);
+    const hooks: Hooks = .{ .ctx = &script, .pwrite = Script.pwrite, .event = Script.event };
+    var w = Writer.init(&hooks, true);
+    const data = "the quick brown fox jumps over the lazy dog";
+    const crc = try w.put(dir, "a.bin", .{ .parts = &.{ data[0..10], data[10..] } });
+    try testing.expectEqual(std.hash.Crc32.hash(data), crc);
+    const back = try readBack(gpa, dir, "a.bin");
+    defer gpa.free(back);
+    try testing.expectEqualStrings(data, back);
+    try testing.expectEqualSlices(Event, &.{ .write, .fsync, .drop_pages, .rename }, script.events.items);
+    try testing.expectEqual(@as(usize, 0), try countTemps(gpa, dir));
+}
+
+test "put: a full disk leaves no temporary file and no target" {
+    const gpa = testing.allocator;
+    var rb: [256]u8 = undefined;
+    const root = try testRoot(&rb, "nospace");
+    const dir = try freshDir(gpa, root);
+    defer {
+        _ = c.close(dir);
+        dropDir(gpa, root);
+    }
+    var script: Script = .{ .steps = &.{ .{ .short = 4 }, .nospace } };
+    defer script.events.deinit(gpa);
+    const hooks: Hooks = .{ .ctx = &script, .pwrite = Script.pwrite };
+    var w = Writer.init(&hooks, false);
+    try testing.expectError(error.NoSpace, w.put(dir, "b.bin", .{ .parts = &.{"0123456789"} }));
+    try testing.expectEqual(@as(usize, 0), try countTemps(gpa, dir));
+    try testing.expectError(error.Missing, statAt(dir, "b.bin"));
+}
+
+test "put: aligned sources, direct where it works, buffered when the file system refuses O_DIRECT" {
+    const gpa = testing.allocator;
+    var rb: [256]u8 = undefined;
+    const root = try testRoot(&rb, "aligned");
+    const dir = try freshDir(gpa, root);
+    defer {
+        _ = c.close(dir);
+        dropDir(gpa, root);
+    }
+    const buf = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), 3 * alignment);
+    defer gpa.free(buf);
+    for (buf, 0..) |*b, i| b.* = @intCast(i % 251);
+    inline for (.{ false, true }) |refuse| {
+        const hooks: Hooks = .{ .no_direct = refuse };
+        var w = Writer.init(&hooks, true);
+        const name = if (refuse) "buffered.blk" else "direct.blk";
+        _ = try w.put(dir, name, .{ .aligned = .{ .buf = buf, .len = 2 * alignment + 100 } });
+        const back = try readBack(gpa, dir, name);
+        defer gpa.free(back);
+        try testing.expectEqualSlices(u8, buf[0 .. 2 * alignment + 100], back);
+        if (refuse and has_direct) try testing.expect(!w.direct.load(.monotonic) and w.direct_refused.load(.monotonic) == 1);
+    }
+}
+
+test "a partial direct write off the 4 KiB grid finishes buffered" {
+    if (!has_direct) return error.SkipZigTest;
+    const gpa = testing.allocator;
+    var rb: [256]u8 = undefined;
+    const root = try testRoot(&rb, "partial");
+    const dir = try freshDir(gpa, root);
+    defer {
+        _ = c.close(dir);
+        dropDir(gpa, root);
+    }
+    const buf = try gpa.alignedAlloc(u8, .fromByteUnits(alignment), 2 * alignment);
+    defer gpa.free(buf);
+    for (buf, 0..) |*b, i| b.* = @intCast(i % 249);
+    var script: Script = .{ .steps = &.{.{ .short = 100 }} };
+    defer script.events.deinit(gpa);
+    const hooks: Hooks = .{ .ctx = &script, .pwrite = Script.pwrite };
+    var w = Writer.init(&hooks, true);
+    // (on a file system without O_DIRECT the open falls back first; either way the bytes are whole)
+    _ = try w.put(dir, "p.blk", .{ .aligned = .{ .buf = buf, .len = alignment + 7 } });
+    const back = try readBack(gpa, dir, "p.blk");
+    defer gpa.free(back);
+    try testing.expectEqualSlices(u8, buf[0 .. alignment + 7], back);
+}
+
+test "owner lock: a second owner is refused while the first holds it" {
+    const gpa = testing.allocator;
+    var rb: [256]u8 = undefined;
+    const root = try testRoot(&rb, "lock");
+    const dir = try freshDir(gpa, root);
+    defer {
+        _ = c.close(dir);
+        dropDir(gpa, root);
+    }
+    var a = try Lock.take(dir);
+    try testing.expectError(error.Busy, Lock.take(dir));
+    a.release();
+    var b = try Lock.take(dir);
+    b.release();
+}
+
+test "directories: a symlink is never followed, by an open or a tree removal" {
+    const gpa = testing.allocator;
+    var rb: [256]u8 = undefined;
+    const root = try testRoot(&rb, "symlink");
+    const dir = try freshDir(gpa, root);
+    defer {
+        _ = c.close(dir);
+        dropDir(gpa, root);
+    }
+    try ensureDirAt(dir, "target");
+    const t = try openDirAt(dir, "target");
+    defer _ = c.close(t);
+    const f = try openAt(t, "keep.me", .{ .ACCMODE = .WRONLY, .CREAT = true, .CLOEXEC = true }, 0o600);
+    _ = c.close(f);
+    try ensureDirAt(dir, "tree");
+    const tr = try openDirAt(dir, "tree");
+    defer _ = c.close(tr);
+    try testing.expect(c.symlinkat("../target", tr, "link") == 0);
+    try testing.expect(c.symlinkat("target", dir, "top") == 0);
+    try testing.expect(isSymlinkAt(dir, "top") and !isSymlinkAt(dir, "target"));
+    if (openDirAt(dir, "top")) |fd| {
+        _ = c.close(fd);
+        return error.TestUnexpectedResult;
+    } else |_| {}
+    removeTree(gpa, dir, "tree");
+    try testing.expect(!isSymlinkAt(tr, "link"));
+    _ = try statAt(t, "keep.me"); // the link's target and its contents are untouched
+}
diff --git a/zig/src/core/spill/mutants.zig b/zig/src/core/spill/mutants.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f063bcf7ec172811069820544979db53ba46285e
--- /dev/null
+++ b/zig/src/core/spill/mutants.zig
@@ -0,0 +1,47 @@
+//! Port of wojo's GLM 0110 `tools/spill_blocks_mutants.sh` (PR #124): each authored fix can be switched back to the
+//! code before it, in test builds only, so the store's tests prove they catch its regression. Outside tests `on`
+//! is comptime false and every mutant branch compiles away.
+const builtin = @import("builtin");
+
+pub const Mutant = enum {
+    none,
+    // the GLM fixes (spill_blocks_mutants.sh), as they apply to a single-rank, GPU-free store
+    tail_staged_later, // the block a keep's end cuts staged later from the source, not captured at the keep
+    loadpart_past_upto, // a step copies past the boundary rank 0 sent (LOADPART's upto ignored)
+    no_upgrade, // ids kept again as a shared prefix leave their stored point unshared
+    upgrade_not_durable, // ... shared in memory only (its manifest not rewritten)
+    waiting_not_flagged, // ... a point still waiting to be written does not take the flag
+    written_no_rewrite, // ... made shared during its own write: the manifest written unshared stays so
+    rewrite_resurrects, // a point dropped during its rewrite gets its manifest back
+    rewrite_not_put, // the rewrite overwrites the manifest in place (no temporary name, fsync, rename)
+    rewrite_no_dir_fsync, // ... without fsyncing the points directory
+    drain_skips_rewrites, // a drain returns before queued metadata rewrites ran
+    lost_is_damage, // a missing name is treated as damaged bytes (every link to them dropped)
+    lost_names_kept, // a missing name is not forgotten
+    damage_not_widened, // damaged bytes drop only the name read, not every name linked to the inode
+    small_files_keep_pages, // a point's small files keep their pages after the fsync
+    pages_dropped_before_fsync, // ... dropped before the fsync (dirty pages are not dropped)
+    hang_no_recycle_in_wait, // a follower's wait for a block does not give back the slots its copies hold
+    budget_each_read, // every restore in flight gets the whole copy budget of a pause
+    budget_same_first, // every pause starts with the same restore
+    read_ahead_charges_preallocate, // preallocated read buffers charged again
+    // the native port's own guards
+    manifest_not_last, // the manifest written before the point's ids and small state
+    scan_keeps_temps, // recovery leaves temporary files
+    recover_no_size_check, // recovery accepts a block of the wrong size
+    dedup_without_sha, // a link made on a CRC match alone
+    guard_cancels_only, // a guard cancels a waiting point instead of staging what fits
+    evict_shared_first, // shared prefixes evicted before conversations
+    floor_ignored, // the free-disk floor never refuses or evicts
+    owner_lock_ignored, // a second owner opens a live store
+    keep_unpinned, // a keep makes room before the point holds references to the blocks it reuses
+    forget_skips_reading, // forget leaves listed a point that names a dropped block while it is being read
+    handover_unreserved, // blocks handed to another write leave their reservation behind
+    recover_drops_on_io, // recovery drops a point (and collects its blocks) on a transient error, not only on damage
+};
+
+pub var current: Mutant = .none;
+
+pub inline fn on(m: Mutant) bool {
+    return builtin.is_test and current == m;
+}
