+/// A stream as placeParts and releaseFn read it.
+fn testStream(id: []const u8, saved: ?*Snap) lanes.Stream {
+    var s: lanes.Stream = undefined;
+    s.id = id;
+    s.reuse = .{ .saved = if (saved) |sn| @ptrCast(sn) else null };
+    s.reuse_failed = false;
+    return s;
+}
