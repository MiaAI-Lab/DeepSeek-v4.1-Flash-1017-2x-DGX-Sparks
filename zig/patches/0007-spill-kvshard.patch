+    fn copyFn(ctx: *anyopaque, _: usize, _: usize, _: usize) anyerror!void {
+        const d: *TestDev = @ptrCast(@alignCast(ctx));
+        d.copies += 1;
+    }
+
+    fn twinFn(ctx: *anyopaque, _: usize, _: bool, _: ?usize) anyerror!void {
+        const d: *TestDev = @ptrCast(@alignCast(ctx));
+        d.binds += 1;
+    }
+};
