+    const sp = try gpa.alloc([2]usize, images.len);
+    defer gpa.free(sp);
+    for (images, sp) |img, *x| x.* = .{ img.at, img.tokens };
+    try model.Model.spill.checkEngramSeq(seq, ids, sp);
+}
