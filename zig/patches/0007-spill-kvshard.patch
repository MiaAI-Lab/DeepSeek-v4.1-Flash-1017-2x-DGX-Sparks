+    var c: Reply = .{};
+    const queued: Request = .{ .prompt = &prompt_b, .max_tokens = 4 };
+    try e.submit(2, &queued, c.sink()); // (one lane: it waits behind A)
+    p.host.pairBroken("rank 1 stopped answering (test)", true);
+    try std.testing.expect(p.host.isBroken());
