+test "xhPlanes and select: xhwo's [group][R][gk] rows of the rows another rank holds, and only those" {
+    const gpa = testing.allocator;
+    const R: usize = 5;
+    const groups: usize = 4;
+    const gk: usize = 24;
+    const x = xhPlanes(R, groups, gk);
+    // element (g, r, k) of xhwo [group][R][gk] fp16 at byte g * plane_bytes + r * row_bytes + 2k
+    for (0..groups) |g| for (0..R) |r| for (0..gk) |k| {
+        try testing.expectEqual((g * R * gk + r * gk + k) * 2, g * x.plane_bytes + r * x.row_bytes + 2 * k);
+    };
+    const n = groups * R * gk * 2;
+    const src = try gpa.alloc(u8, n);
+    defer gpa.free(src);
+    const dst = try gpa.alloc(u8, n);
+    defer gpa.free(dst);
+    var rng = std.Random.DefaultPrng.init(3);
+    rng.random().bytes(src);
+    rng.random().bytes(dst);
+    const before = try gpa.dupe(u8, dst);
+    defer gpa.free(before);
+    const own = [_]i64{ 1, 0, 0, 1, 0 };
+    selectRef(src, dst, &own, 0, x);
+    for (0..groups) |g| for (0..R) |r| {
+        const at = (g * R + r) * gk * 2;
+        const want = if (own[r] == 0) src[at..][0 .. gk * 2] else before[at..][0 .. gk * 2];
+        try testing.expectEqualSlices(u8, want, dst[at..][0 .. gk * 2]);
+    };
+}
+
+test "promptBlock: blocks cover the chunk in order, their offsets the rows'" {
+    const n: usize = 2048;
+    const h: usize = 32;
+    const hd: usize = 512;
+    const kk: usize = 512;
+    const B = blockRows(65536, kk);
+    var r0: usize = 0;
+    var blocks: usize = 0;
+    while (r0 < n) : (r0 += B) {
+        const b = promptBlock(r0, n, B, h, hd, kk);
+        try testing.expectEqual(r0, b.r0);
+        try testing.expect(b.m > 0 and b.m <= B and b.m * kk <= 65536);
+        try testing.expectEqual(r0 * h * hd * 2, b.act);
+        try testing.expectEqual(r0 * 8, b.pos);
+        try testing.expectEqual(r0 * kk * 8, b.idx);
+        try testing.expectEqual(@as(usize, 0), b.act % (16 * h * hd * 2)); // whole 16-row tiles
+        blocks += 1;
+    }
+    try testing.expectEqual(@as(usize, 16), blocks);
+    try testing.expectEqual(@as(usize, 1), promptBlock(2047, n, B, h, hd, kk).m);
+    // the decision: the visible rows when they fit and are fewer than the picks, else the union
+    try testing.expectEqual(PromptFetch.contiguous, promptFetch(60000, 2048, 512, 65536));
+    try testing.expectEqual(PromptFetch.@"union", promptFetch(70000, 2048, 512, 65536)); // past the buffer
+    try testing.expectEqual(PromptFetch.@"union", promptFetch(30000, 1, 512, 65536)); // more rows than the picks
+    try testing.expectEqual(PromptFetch.contiguous, promptFetch(0, 1, 512, 65536));
+    try testing.expectEqual(@as(usize, 2048), unionBlockRows(65536, 2048, 512, 65536));
+    try testing.expectEqual(B, unionBlockRows(65537, 2048, 512, 65536));
+}
+
+/// A prompt chunk of `n` rows from `start` on one ratio-`ratio` extent: the replicated reads of every row against what
+/// the other rank reads by each fetch (contiguous; union whole; union in blocks), byte for byte, in pick order.
+fn promptCase(gpa: std.mem.Allocator, seed: u64, ratio: usize, start: usize, n: usize, kk: usize, fetch_rows: usize) !void {
+    const cb = 32;
+    const sb = 16;
+    var rng = std.Random.DefaultPrng.init(seed);
+    const R = rng.random();
+    const nce = (start + n) / ratio;
+    const plane_rows = nce + pad_rows + 7; // (the owner's view: rows past the visible ones are never read)
+    const codes = try gpa.alloc(u8, plane_rows * cb);
+    defer gpa.free(codes);
+    const scales = try gpa.alloc(u8, plane_rows * sb);
+    defer gpa.free(scales);
+    R.bytes(codes);
+    R.bytes(scales);
+    // the indexer's picks: row i sees (start + i + 1) / ratio entries, -1 where it has fewer than kk (or sprinkled)
+    const idx = try gpa.alloc(i64, n * kk);
+    defer gpa.free(idx);
+    for (0..n) |i| {
+        const vis = (start + i + 1) / ratio;
+        for (0..kk) |j| idx[i * kk + j] = if (vis == 0 or R.uintLessThan(u8, 9) == 0) -1 else @intCast(R.uintLessThan(usize, vis));
+    }
+    const kos = (kk + 15) / 16 * 16;
+    var want: std.ArrayList(u8) = .empty;
+    defer want.deinit(gpa);
+    const wants = try gpa.alloc(usize, n + 1);
+    defer gpa.free(wants);
+    for (0..n) |i| {
+        wants[i] = want.items.len;
+        try attnReads(gpa, codes, scales, cb, sb, 0, idx[i * kk ..][0..kk], &want);
+    }
+    wants[n] = want.items.len;
+    const fc = try gpa.alloc(u8, fetch_rows * cb);
+    defer gpa.free(fc);
+    const fs = try gpa.alloc(u8, fetch_rows * sb);
+    defer gpa.free(fs);
+    // contiguous: rows [0, nce) at the same rows, the picks unchanged
+    if (promptFetch(nce, n, kk, fetch_rows) == .contiguous) {
+        R.bytes(fc);
+        R.bytes(fs);
+        @memcpy(fc[0 .. nce * cb], codes[0 .. nce * cb]);
+        @memcpy(fs[0 .. nce * sb], scales[0 .. nce * sb]);
+        for (0..n) |i| {
+            var got: std.ArrayList(u8) = .empty;
+            defer got.deinit(gpa);
+            try attnReads(gpa, fc, fs, cb, sb, 0, idx[i * kk ..][0..kk], &got);
+            try testing.expectEqualSlices(u8, want.items[wants[i]..wants[i + 1]], got.items);
+        }
+    }
+    // union: whole when it fits, else per block; both ranks count the same, the owner compacts, the other renumbers
+    const cum = try gpa.alloc(i32, @max(nce, 1));
+    defer gpa.free(cum);
+    const out = try gpa.alloc(i64, n * kos);
+    defer gpa.free(out);
+    const total = UnionRef.count(idx, kk, kk, n, nce, cum);
+    var distinct = std.AutoHashMap(i64, void).init(gpa);
+    defer distinct.deinit();
+    for (idx) |v| if (v >= 0) try distinct.put(v, {});
+    try testing.expectEqual(distinct.count(), total);
+    const B = unionBlockRows(total, n, kk, fetch_rows);
+    var r0: usize = 0;
+    var sent: usize = 0;
+    while (r0 < n) : (r0 += B) {
+        const b = promptBlock(r0, n, B, 1, 1, kk);
+        const bidx = idx[r0 * kk ..][0 .. b.m * kk];
+        const c = UnionRef.count(bidx, kk, kk, b.m, nce, cum);
+        try testing.expect(c <= fetch_rows and c <= b.m * kk);
+        R.bytes(fc);
+        R.bytes(fs);
+        UnionRef.compact(codes, scales, cb, sb, cum, nce, fc, fs);
+        UnionRef.renumber(bidx, kk, kk, b.m, cum, nce, out, kos);
+        sent += c;
+        for (0..b.m) |i| {
+            var got: std.ArrayList(u8) = .empty;
+            defer got.deinit(gpa);
+            try attnReads(gpa, fc, fs, cb, sb, 0, out[i * kos ..][0..kos], &got);
+            try testing.expectEqualSlices(u8, want.items[wants[r0 + i]..wants[r0 + i + 1]], got.items);
+            for (kk..kos) |j| try testing.expectEqual(@as(i64, -1), out[i * kos + j]);
+            // renumbered picks keep the replicated order: ascending positions stay ascending
+            for (1..kk) |j| {
+                const p = idx[(r0 + i) * kk + j - 1];
+                const q = idx[(r0 + i) * kk + j];
+                if (p >= 0 and q >= 0) try testing.expectEqual(std.math.order(p, q), std.math.order(out[i * kos + j - 1], out[i * kos + j]));
+            }
+        }
+    }
+    if (B == n) try testing.expectEqual(total, sent);
+    try testing.expect(sent <= n * kk);
+}
+
+test "prompt fetch: contiguous and union copies read the replicated bytes, deduplicated, in pick order" {
+    const gpa = testing.allocator;
+    var seed: u64 = 11;
+    for ([_]usize{ 1, 2 }) |ratio| {
+        // (start, rows, picks, fetch rows): a short prompt (contiguous), a long one (union whole), a union past the
+        // buffer (blocks), a one-row chunk, a ring-mode chunk, odd pick counts
+        const cases = [_][4]usize{
+            .{ 0, 300, 64, 4096 },
+            .{ 6000, 64, 70, 4096 },
+            .{ 6000, 64, 70, 2048 },
+            .{ 50000, 200, 512, 8192 },
+            .{ 20000, 1, 512, 4096 },
+            .{ 9001, 13, 33, 4096 },
+            .{ 1, 3, 16, 4096 },
+        };
+        for (cases) |cs| {
+            try promptCase(gpa, seed, ratio, cs[0], cs[1], cs[2], cs[3]);
+            seed += 1;
+        }
+    }
+}
diff --git a/zig/src/families/dsv41/shard_ops.zig b/zig/src/families/dsv41/shard_ops.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7bb06e8773ab4c22475058408ad604084ce32178
--- /dev/null
+++ b/zig/src/families/dsv41/shard_ops.zig
@@ -0,0 +1,248 @@
+//! Port of wojo's GLM 0118 (PR #152): TF_DS_KV_SHARD's device side beyond the kit, the byte movers in
+//! dsv41_shard.cu (fetch: a round's or prompt block's picked compressed rows packed and renumbered; select: owner
+//! decode's returned rows put in place; the union: a prompt chunk's distinct picks marked, counted, packed and
+//! renumbered), and what one rank's sharded attention carries (KvShard: the geometry, the mode, the kernels). Every
+//! launch moves bytes or integer ids unchanged; the arithmetic stays the kit's.
+const std = @import("std");
+const cuda = @import("cuda");
+const shard = @import("shard.zig");
+const shard_ring = @import("shard_ring.zig");
+const rdma = @import("rdma.zig");
+
+pub const Kernels = struct {
+    module: cuda.Module,
+    fetch_fn: cuda.Function,
+    select_fn: cuda.Function,
+    mark_fn: cuda.Function,
+    sums_fn: cuda.Function,
+    offsets_fn: cuda.Function,
+    scan_fn: cuda.Function,
+    compact_fn: cuda.Function,
+    renumber_fn: cuda.Function,
+    /// The decode exchanges on the RDMA ring (shard_ring.zig): its sized stage and collect. An image built before
+    /// them has neither: that rank then asks for NCCL (round.Round.exchangeSettings), which the ranks' settings
+    /// gather makes every rank's or refuses (KvShardSettingsMismatch) when another rank has them.
+    ring_stage_fn: ?cuda.Function = null,
+    ring_collect_fn: ?cuda.Function = null,
+
+    /// dsv41_shard.cu's image (cuda.kernels.dsv41_shard, or a fatbin's bytes).
+    pub fn load(d: *const cuda.Driver, image: []const u8) !Kernels {
+        if (image.len == 0) return error.NoKernelImages;
+        var m = try cuda.Module.load(d, image);
+        errdefer m.unload();
+        return .{
+            .module = m,
+            .fetch_fn = try m.function("tf_ds_kv_fetch_kernel"),
+            .select_fn = try m.function("tf_ds_select_rows_kernel"),
+            .mark_fn = try m.function("tf_ds_union_mark_kernel"),
+            .sums_fn = try m.function("tf_ds_union_sums_kernel"),
+            .offsets_fn = try m.function("tf_ds_union_offsets_kernel"),
+            .scan_fn = try m.function("tf_ds_union_scan_kernel"),
+            .compact_fn = try m.function("tf_ds_union_compact_kernel"),
+            .renumber_fn = try m.function("tf_ds_union_renumber_kernel"),
+            .ring_stage_fn = m.function("tf_ds_ring_stage_rows") catch null,
+            .ring_collect_fn = m.function("tf_ds_ring_collect_rows") catch null,
+        };
+    }
+
+    /// The sized ring transfer's kernel pair, as rdma.Ring.sendRows / recvRows take it.
+    pub fn ringRows(k: *const Kernels) !rdma.Ring.RowKernels {
+        return .{ .stage = k.ring_stage_fn orelse return error.NoKvShard, .collect = k.ring_collect_fn orelse return error.NoKvShard };
+    }
+
+    pub fn hasRingRows(k: *const Kernels) bool {
+        return k.ring_stage_fn != null and k.ring_collect_fn != null;
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.module.unload();
+        k.* = undefined;
+    }
+};
+
+/// One fetch launch (shard.FetchRef is its host model, and the tests' reference): picks idx [rows, ks] (the first kk
+/// of a row), each row's plane base `sbase` (int64 [rows], 0: none, every row 0) and holding flag `own` (int64 [rows],
+/// 0: none, every row held), the fetched rows' stride dk picks a row, the remapped picks out [rows, kos].
+pub const Fetch = struct {
+    codes: u64 = 0,
+    scales: u64 = 0,
+    cb: usize,
+    sb: usize,
+    idx: u64,
+    ks: usize,
+    kk: usize,
+    rows: usize,
+    sbase: u64 = 0,
+    own: u64 = 0,
+    copy: bool,
+    dcodes: u64 = 0,
+    dscales: u64 = 0,
+    dk: usize,
+    out: u64,
+    kos: usize,
+    how: shard.FetchRef.How,
+};
+
+pub fn fetch(k: *const Kernels, s: cuda.Stream, f: Fetch) !void {
+    if (f.rows == 0 or f.kos == 0) return;
+    if (f.cb % 16 != 0 or f.sb % 16 != 0 or f.kk > f.kos) return error.BadFetch;
+    if (f.copy and (f.codes == 0 or f.dcodes == 0 or (f.codes | f.scales | f.dcodes | f.dscales) % 16 != 0)) return error.BadFetch;
+    var a: cuda.Args = .{};
+    a.add(f.codes);
+    a.add(f.scales);
+    a.add(@as(i64, @intCast(f.cb)));
+    a.add(@as(i64, @intCast(f.sb)));
+    a.add(f.idx);
+    a.add(@as(i64, @intCast(f.ks)));
+    a.add(@as(c_int, @intCast(f.kk)));
+    a.add(f.sbase);
+    a.add(f.own);
+    a.add(@as(c_int, @intFromBool(f.copy)));
+    a.add(f.dcodes);
+    a.add(f.dscales);
+    a.add(@as(i64, @intCast(f.dk)));
+    a.add(f.out);
+    a.add(@as(i64, @intCast(f.kos)));
+    a.add(@as(c_int, @backingInt(f.how)));
+    try cuda.launch.launch(k.fetch_fn, .{ .grid = .{ .x = @intCast(f.rows), .y = @intCast((f.kos + 15) / 16) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+/// dst row r of each of `planes` planes = src row r where sel[r] == want (int64 [rows]); rows of `bytes` bytes,
+/// planes `plane_bytes` apart; every size and pointer whole 16-byte words.
+pub fn select(k: *const Kernels, s: cuda.Stream, src: u64, dst: u64, sel: u64, want: i64, rows: usize, bytes: usize, planes: usize, plane_bytes: usize) !void {
+    if (rows == 0 or planes == 0) return;
+    if ((src | dst | bytes | plane_bytes) % 16 != 0) return error.BadSelect;
+    var a: cuda.Args = .{};
+    a.add(src);
+    a.add(dst);
+    a.add(sel);
+    a.add(want);
+    a.add(@as(i64, @intCast(bytes / 16)));
+    a.add(@as(i64, @intCast(plane_bytes / 16)));
+    try cuda.launch.launch(k.select_fn, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(planes) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+/// The union scan's segments (dsv41_shard.cu's TF_DS_SCAN_SEGS): `sums` holds this many int32 and the count after them.
+pub const scan_segs: usize = 1024;
+
+/// The prompt fetch's union of picks idx [rows, ks] (the first kk a row) below `limit`, as shard.UnionRef counts it:
+/// `cum` (int32 [limit], zeroed by the caller in the stream's order) marked and scanned in place to the inclusive
+/// prefix counts, the count left in `sums` (int32 [scan_segs + 1]) at its last entry for the host to read.
+pub fn unionCount(k: *const Kernels, s: cuda.Stream, idx: u64, ks: usize, kk: usize, rows: usize, cum: u64, limit: usize, sums: u64) !void {
+    if (limit == 0) return error.BadFetch;
+    if (rows > 0 and kk > 0) {
+        var a: cuda.Args = .{};
+        a.add(idx);
+        a.add(@as(i64, @intCast(ks)));
+        a.add(@as(c_int, @intCast(kk)));
+        a.add(cum);
+        a.add(@as(i64, @intCast(limit)));
+        try cuda.launch.launch(k.mark_fn, .{ .grid = .{ .x = @intCast(rows), .y = @intCast((kk + 255) / 256) }, .block = .{ .x = 256 } }, s, &a);
+    }
+    var b: cuda.Args = .{};
+    b.add(cum);
+    b.add(@as(i64, @intCast(limit)));
+    b.add(sums);
+    try cuda.launch.launch(k.sums_fn, .{ .grid = .{ .x = scan_segs / 256 }, .block = .{ .x = 256 } }, s, &b);
+    var o: cuda.Args = .{};
+    o.add(sums);
+    try cuda.launch.launch(k.offsets_fn, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1 } }, s, &o);
+    try cuda.launch.launch(k.scan_fn, .{ .grid = .{ .x = scan_segs / 256 }, .block = .{ .x = 256 } }, s, &b);
+}
+
+/// The owner's copy of the union (shard.UnionRef.compact): each marked plane row t < limit of the extent's view
+/// (codes, scales) into fetched row cum[t] - 1 of dcodes, dscales.
+pub fn unionCompact(k: *const Kernels, s: cuda.Stream, codes: u64, scales: u64, cb: usize, sb: usize, cum: u64, limit: usize, dcodes: u64, dscales: u64) !void {
+    if (limit == 0) return;
+    if (cb % 16 != 0 or sb % 16 != 0 or (codes | scales | dcodes | dscales) % 16 != 0 or codes == 0 or dcodes == 0) return error.BadFetch;
+    var a: cuda.Args = .{};
+    a.add(codes);
+    a.add(scales);
+    a.add(@as(i64, @intCast(cb)));
+    a.add(@as(i64, @intCast(sb)));
+    a.add(cum);
+    a.add(@as(i64, @intCast(limit)));
+    a.add(dcodes);
+    a.add(dscales);
+    try cuda.launch.launch(k.compact_fn, .{ .grid = .{ .x = @intCast((limit + 15) / 16) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+/// The other rank's picks renumbered to the union's rows (shard.UnionRef.renumber): out [rows, kos].
+pub fn unionRenumber(k: *const Kernels, s: cuda.Stream, idx: u64, ks: usize, kk: usize, rows: usize, cum: u64, limit: usize, out: u64, kos: usize) !void {
+    if (rows == 0 or kos == 0) return;
+    if (kk > kos) return error.BadFetch;
+    var a: cuda.Args = .{};
+    a.add(idx);
+    a.add(@as(i64, @intCast(ks)));
+    a.add(@as(c_int, @intCast(kk)));
+    a.add(cum);
+    a.add(@as(i64, @intCast(limit)));
+    a.add(out);
+    a.add(@as(i64, @intCast(kos)));
+    try cuda.launch.launch(k.renumber_fn, .{ .grid = .{ .x = @intCast(rows), .y = @intCast((kos + 255) / 256) }, .block = .{ .x = 256 } }, s, &a);
+}
+
+/// An exchange's segments in the ring kernels' form (16-byte words; shard_ring.Xfer.check has refused anything else).
+pub fn rowSegs(x: shard_ring.Xfer) rdma.Ring.RowSegs {
+    var o: rdma.Ring.RowSegs = .{};
+    for (x.slice(), 0..) |g, i| {
+        o.src[i] = g.src;
+        o.dst[i] = g.dst;
+        o.src16[i] = @intCast(g.src_stride / 16);
+        o.dst16[i] = @intCast(g.dst_stride / 16);
+        o.row16[i] = @intCast(g.row_bytes / 16);
+    }
+    return o;
+}
+
+/// One exchange of a decode round on the RDMA ring: this rank's listed rows sent (`list`: the device address of its
+/// send list, shard_ring.Lists.offset(.., .send) into Round.rlist), or the peer's received at the rows of its receive
+/// list. `cap` the round's rows (the slot and grid bound); `probing` false keeps an early send out of the ring probes.
+pub fn ringSend(k: *const Kernels, ring: *rdma.Ring, s: cuda.Stream, x: shard_ring.Xfer, list: u64, cap: usize, probing: bool) !void {
+    try x.check(cap, ring.s.max_bytes);
+    try ring.sendRows(try k.ringRows(), s, rowSegs(x), @intCast(x.n), list, @intCast(cap), probing);
+}
+
+pub fn ringRecv(k: *const Kernels, ring: *rdma.Ring, s: cuda.Stream, x: shard_ring.Xfer, list: u64, cap: usize, from: u32, probing: bool) !void {
+    try x.check(cap, ring.s.max_bytes);
+    try ring.recvRows(try k.ringRows(), s, rowSegs(x), @intCast(x.n), list, @intCast(cap), from, probing);
+}
+
+/// What one rank's sharded attention carries (prompt.Engine.kv): the parts, the decode mode and the kernels.
+pub const KvShard = struct {
+    sh: shard.Shard,
+    mode: shard.Mode,
+    k: Kernels,
+    // the decode exchanges' transport and auto's cost model (round.Round.useShard: agreed by every rank before the
+    // first round): the RDMA ring when the engine has one and TF_DS_KV_SHARD_RING is not 0, else NCCL
+    use_ring: bool = false,
+    cost: shard_ring.Cost = .{},
+    // owner decode's two 32-head passes on two streams on the ring path (Round.useShard: TF_DS_KV_SHARD_OVERLAP, not
+    // "0"; per rank, it changes no ring order and no byte)
+    overlap: bool = false,
+    // counters (the health/metrics a status line reads; round 2 exports them): prompt fetches (a layer's) and their
+    // rows and bytes, rounds by fetch and by owner decode (each of a round's compressed layers fetches or exchanges once;
+    // counted when the round is issued, graphs or not), carried extents (copyExtent across parts) and their bytes
+    stats: Stats = .{},
+    // (exported on /health and /metrics with the parts' rows: lanes.zig kvPartsFn, core lanes.kv_parts)
+
+    pub const Stats = struct {
+        prompt_fetches: u64 = 0,
+        prompt_rows: u64 = 0, // rows sent (the visible rows, or the union's)
+        prompt_picks: u64 = 0, // the picks they served (rows x picks: what every-pick fetching would have sent)
+        prompt_bytes: u64 = 0,
+        prompt_syncs: u64 = 0, // host reads of a union's count
+        fetch_rounds: u64 = 0,
+        owner_rounds: u64 = 0,
+        carries: u64 = 0,
+        carry_bytes: u64 = 0,
+        // the decode exchanges (shard_ring.zig): rounds whose exchanges rode the RDMA ring (the rest NCCL), auto's
+        // choices, and the rows this rank sent a compressed layer on the ring, summed over the rounds (its send lists:
+        // fetch, the rows only it holds; owner decode, the queries of the rows only the peer holds and the outputs of
+        // the rows only it holds)
+        ring_rounds: u64 = 0,
+        auto_fetch: u64 = 0,
+        auto_owner: u64 = 0,
+        sent_rows: u64 = 0,
+    };
+};
diff --git a/zig/src/families/dsv41/shard_ring.zig b/zig/src/families/dsv41/shard_ring.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7bbd37e4b0c3bfd7a5375b2fd425fd57a79295e2
--- /dev/null
+++ b/zig/src/families/dsv41/shard_ring.zig
@@ -0,0 +1,936 @@
+//! Port of wojo's GLM 0118 (PR #152) follow-up: TF_DS_KV_SHARD's decode exchanges sized to what the other rank needs
+//! and carried by the family's RDMA ring (rdma.zig) instead of NCCL, host half and plans, host-only (std and shard.zig:
+//! `zig test` runs it alone).
+//!
+//! A decode exchange moves whole rows of a round, each row one run of bytes in every one of up to `max_segs` segments
+//! (codes and scales of a fetch; a row's q; a row's rotated wo_a inputs in each group's plane). Which rows a rank sends
+//! and which it receives are explicit lists (`List`), computed on the host each round from the replicated row owners
+//! (`lists`: the same inputs on both ranks), uploaded with the round's glue (`Lists.encode`, one fixed device block,
+//! so captured graphs stay valid) and read by the kernels. The sender's stage kernel packs its send
+//! list's rows' segments one after another into its ring slot (segment s of `n` rows at n x the row bytes of the
+//! segments before it) and publishes the slot's size; the proxy writes exactly those bytes to the peer (split over the
+//! rails as every gather is); the receiver's collect kernel waits for the slot and puts the received rows, in its
+//! receive list's order, at their rows. Rank r's send list of an exchange IS rank 1-r's receive list (`lists`'s tests),
+//! so the two sides agree on order and size without anything but the bytes crossing the wire.
+//!
+//! The three exchanges (one a compressed layer): the fetch (the sender's rows' picked codes and scales from its slot
+//! of the fetch buffer into the peer's slot rows: `fetchXfer`), owner decode's queries (this rank's q of the rows the
+//! peer holds, to the peer's gathered-q rows) and owner decode's outputs (the peer's heads of the rows this rank
+//! holds, straight into the peer's xhwo rows, so no select pass). Each puts the bytes the fixed-size NCCL path put at
+//! the same places for every row the receiver reads (the tests below).
+//!
+//! The ring order of a layer's transfers is fixed per mode (`steps`, checked as round.zig issues them: `Cursor`), every
+//! stage directly followed in ring order by its collect, and rdma.Ring refuses any other ring transfer in between.
+//!
+//! TF_DS_KV_SHARD_DECODE=auto chooses each round between fetch and owner decode from the round's row counts (a cost
+//! model in ns, `Cost`, over the replicated counts: both ranks pick the same and capture the same graphs; the round's
+//! graph key carries the choice). Rounds wider than the split path (`decode_rows`) always fetch: owner decode has no
+//! one-pass variant. While a round runs the split path's bound is the round bound (round.forward sets tri.decode_rows
+//! to TF_DS_ROUND_ROWS), so every decode round takes the split path and auto may pick owner at any of its widths.
+const std = @import("std");
+const shard = @import("shard.zig");
+
+/// Segments a row of one exchange at most (dsv41_shard.cu TF_DS_RING_SEGS; owner decode's outputs take one a wo_a
+/// group).
+pub const max_segs = 8;
+/// Rows one exchange lists at most (dsv41_shard.cu TF_DS_RING_ROWS: the kernels' row list; round.max_rows fits).
+pub const max_rows = 64;
+
+/// One segment of an exchange: a listed row r's `row_bytes` from src + r * src_stride (the sender's) to
+/// dst + r * dst_stride (the receiver's). Every value whole 16-byte words.
+pub const Seg = struct { src: u64 = 0, dst: u64 = 0, row_bytes: usize = 0, src_stride: usize = 0, dst_stride: usize = 0 };
+
+/// An exchange as a rank names it: its segments (src: where this rank's sent rows are; dst: where the rows it
+/// receives go). Which rows: the round's `Lists`.
+pub const Xfer = struct {
+    segs: [max_segs]Seg = @splat(.{}),
+    n: usize = 0,
+
+    pub fn slice(x: *const Xfer) []const Seg {
+        return x.segs[0..x.n];
+    }
+
+    /// A listed row's bytes over every segment.
+    pub fn rowBytes(x: Xfer) usize {
+        var t: usize = 0;
+        for (x.segs[0..x.n]) |s| t += s.row_bytes;
+        return t;
+    }
+
+    /// The most bytes a slot of this exchange holds (`rows` rows listed).
+    pub fn capacity(x: Xfer, rows: usize) usize {
+        return rows * x.rowBytes();
+    }
+
+    /// Refused before any launch: no segment or too many, too many rows, a size or address not in whole 16-byte
+    /// words, a slot that could exceed the ring's.
+    pub fn check(x: Xfer, rows: usize, max_bytes: usize) !void {
+        if (x.n == 0 or x.n > max_segs or rows == 0 or rows > max_rows) return error.BadRingRows;
+        for (x.segs[0..x.n]) |s| if ((s.src | s.dst) % 16 != 0 or (s.row_bytes | s.src_stride | s.dst_stride) % 16 != 0 or s.row_bytes == 0) return error.BadRingRows;
+        if (x.capacity(rows) > max_bytes) return error.TooLarge;
+    }
+};
+
+/// Rows a rank sends or receives in one exchange, in slot order: indices into the segments' row strides.
+pub const List = struct {
+    n: usize = 0,
+    rows: [max_rows]u8 = @splat(0),
+
+    pub fn slice(l: *const List) []const u8 {
+        return l.rows[0..l.n];
+    }
+
+    fn push(l: *List, r: usize) void {
+        l.rows[l.n] = @intCast(r);
+        l.n += 1;
+    }
+
+    pub fn eql(a: List, b: List) bool {
+        return std.mem.eql(u8, a.slice(), b.slice());
+    }
+};
+
+pub const Which = enum(u8) { fetch = 0, q = 1, out = 2 };
+pub const Dir = enum(u8) { send = 0, recv = 1 };
+
+/// A round's lists on one rank, every exchange's both ways. On the device (Round.rlist, uploaded each ring round):
+/// i32 [3 exchanges][2 directions][1 + max_rows]: the count, then the rows.
+pub const Lists = struct {
+    l: [3][2]List = @splat(@splat(.{})),
+
+    pub const stride = 1 + max_rows;
+    pub const words = 3 * 2 * stride;
+    pub const bytes = words * 4;
+
+    pub fn get(ls: *const Lists, w: Which, d: Dir) *const List {
+        return &ls.l[@intFromEnum(w)][@intFromEnum(d)];
+    }
+
+    /// A list's byte offset in the device block.
+    pub fn offset(w: Which, d: Dir) usize {
+        return (@as(usize, @intFromEnum(w)) * 2 + @intFromEnum(d)) * stride * 4;
+    }
+
+    pub fn encode(ls: *const Lists, out: *[words]i32) void {
+        out.* = @splat(0);
+        for (0..3) |w| for (0..2) |d| {
+            const l = &ls.l[w][d];
+            const at = (w * 2 + d) * stride;
+            out[at] = @intCast(l.n);
+            for (l.slice(), 0..) |r, i| out[at + 1 + i] = r;
+        };
+    }
+};
+
+/// A round's rows as both ranks see them (the same on every rank): each row's owner (rows.ownerOf).
+pub const View = struct {
+    owners: []const u32,
+
+    fn checked(v: View) !void {
+        if (v.owners.len > max_rows) return error.BadRingRows;
+        for (v.owners) |o| if (o > 1) return error.BadRingRows; // TP2
+    }
+};
+
+/// A round's row counts: x[r] the rows rank r holds (the rows its exchanges move).
+pub const Counts = struct {
+    x: [2]usize = .{ 0, 0 },
+
+    pub fn rows(c: Counts) usize {
+        return c.x[0] + c.x[1];
+    }
+
+    /// The rows rank r attends with picks (its own extent's).
+    pub fn held(c: Counts, r: usize) usize {
+        return c.x[r];
+    }
+};
+
+pub fn counts(v: View) !Counts {
+    try v.checked();
+    var c: Counts = .{};
+    for (v.owners) |o| c.x[o] += 1;
+    return c;
+}
+
+/// Every exchange's send and receive lists on `rank`.
+pub fn lists(v: View, rank: u32) !Lists {
+    try v.checked();
+    if (rank > 1) return error.BadRingRows;
+    var mine: List = .{}; // rows this rank holds
+    var theirs: List = .{}; // rows the peer holds
+    for (v.owners, 0..) |o, i| {
+        if (o == rank) mine.push(i) else theirs.push(i);
+    }
+    var ls: Lists = .{};
+    const f = @intFromEnum(Which.fetch);
+    const q = @intFromEnum(Which.q);
+    const o = @intFromEnum(Which.out);
+    ls.l[f] = .{ mine, theirs };
+    ls.l[q] = .{ theirs, mine };
+    ls.l[o] = .{ mine, theirs };
+    return ls;
+}
+
+/// Where segment `s` of `n` listed rows starts in the slot (the stage's packing order), and the slot's bytes.
+pub fn segOffset(x: Xfer, n: usize, s: usize) usize {
+    var off: usize = 0;
+    for (x.segs[0..s]) |g| off += n * g.row_bytes;
+    return off;
+}
+
+pub fn slotBytes(x: Xfer, n: usize) usize {
+    return segOffset(x, n, x.n);
+}
+
+/// The host model of dsv41_shard.cu's tf_ds_ring_stage_rows: the slot's bytes as the proxy writes them, from the
+/// sender's memory `mem` (addresses are offsets into it). Returns the size it publishes.
+pub fn stageRef(x: Xfer, mem: []const u8, list: *const List, slot: []u8) usize {
+    const n = list.n;
+    for (x.segs[0..x.n], 0..) |g, s| {
+        const off = segOffset(x, n, s);
+        for (list.slice(), 0..) |r, c| {
+            const from: usize = @intCast(g.src + r * g.src_stride);
+            @memcpy(slot[off + c * g.row_bytes ..][0..g.row_bytes], mem[from..][0..g.row_bytes]);
+        }
+    }
+    return slotBytes(x, n);
+}
+
+/// The host model of tf_ds_ring_collect_rows: the received slot's rows into the receiver's memory at their rows.
+pub fn collectRef(x: Xfer, slot: []const u8, list: *const List, mem: []u8) void {
+    const n = list.n;
+    for (x.segs[0..x.n], 0..) |g, s| {
+        const off = segOffset(x, n, s);
+        for (list.slice(), 0..) |r, c| {
+            const to: usize = @intCast(g.dst + r * g.dst_stride);
+            @memcpy(mem[to..][0..g.row_bytes], slot[off + c * g.row_bytes ..][0..g.row_bytes]);
+        }
+    }
+}
+
+// -- the three decode exchanges -------------------------------------------------------------------------------------
+
+/// The fetch's exchange on rank `rank`: its listed rows' kk picked rows (codes, then scales) from its slot of the
+/// fetch buffers (fc codes, fs scales: [world][R][K] rows of cb, sb bytes, round.fetchDecode) into the peer's slot
+/// rows on the peer. Only the first kk of a row's K are sent (kk <= K).
+pub fn fetchXfer(fc: u64, fs: u64, rank: u32, R: usize, K: usize, kk: usize, cb: usize, sb: usize) Xfer {
+    const me = shard.decodeSlots(rank, R, K, cb, sb);
+    const peer = shard.decodeSlots(1 - rank, R, K, cb, sb);
+    var x: Xfer = .{ .n = 2 };
+    x.segs[0] = .{ .src = fc + me.codes, .dst = fc + peer.codes, .row_bytes = kk * cb, .src_stride = K * cb, .dst_stride = K * cb };
+    x.segs[1] = .{ .src = fs + me.scales, .dst = fs + peer.scales, .row_bytes = kk * sb, .src_stride = K * sb, .dst_stride = K * sb };
+    return x;
+}
+
+/// Owner decode's queries: this rank's q [R][hl][hd] bf16 of the listed rows, into the peer's slot of the gathered
+/// queries (qall [world][R][hl][hd]: rank `rank`'s slot on the peer) at the same rows.
+pub fn qXfer(q: u64, qall: u64, rank: u32, R: usize, hl: usize, hd: usize) Xfer {
+    const row = hl * hd * 2;
+    var x: Xfer = .{ .n = 1 };
+    // the receiver's destination is the sender's slot: on the receiving rank that is its peer's, so name it from the
+    // receiver's side (dst is only read by the receiver: qall + peer * R * row)
+    x.segs[0] = .{ .src = q, .dst = qall + @as(u64, 1 - rank) * R * row, .row_bytes = row, .src_stride = row, .dst_stride = row };
+    return x;
+}
+
+/// Owner decode's outputs: the peer's heads' rotated wo_a inputs of the listed rows (xh_peer, [groups][R][gk] fp16)
+/// straight into the peer's own xhwo rows (the same layout), one segment a group.
+pub fn outXfer(xh_peer: u64, xhwo: u64, R: usize, groups: usize, gk: usize) !Xfer {
+    if (groups == 0 or groups > max_segs) return error.BadRingRows;
+    const x = shard.xhPlanes(R, groups, gk);
+    var o: Xfer = .{ .n = groups };
+    for (0..groups) |g| o.segs[g] = .{ .src = xh_peer + g * x.plane_bytes, .dst = xhwo + g * x.plane_bytes, .row_bytes = x.row_bytes, .src_stride = x.row_bytes, .dst_stride = x.row_bytes };
+    return o;
+}
+
+/// The most rows whose every listed row fits a slot of `max_bytes` (0: none), capped at max_rows.
+pub fn fitRows(row_bytes: usize, max_bytes: usize) usize {
+    if (row_bytes == 0) return 0;
+    return @min(max_rows, max_bytes / row_bytes);
+}
+
+// -- a layer's ring order -------------------------------------------------------------------------------------------
+
+/// One ring transfer of a compressed layer's sharded attention.
+pub const Step = enum(u8) {
+    stage_fetch,
+    collect_fetch,
+    stage_q,
+    collect_q,
+    stage_out,
+    collect_out,
+
+    pub fn which(s: Step) Which {
+        return switch (s) {
+            .stage_fetch, .collect_fetch => .fetch,
+            .stage_q, .collect_q => .q,
+            .stage_out, .collect_out => .out,
+        };
+    }
+
+    pub fn dir(s: Step) Dir {
+        return switch (s) {
+            .stage_fetch, .stage_q, .stage_out => .send,
+            .collect_fetch, .collect_q, .collect_out => .recv,
+        };
+    }
+};
+
+/// The ring transfers a compressed layer issues, in ring order, the same on both ranks: each stage directly followed
+/// by its collect. Owner decode's early query send (at q, or on the shard side stream) moves where the stage is
+/// issued among the layer's other kernels, not its ring order.
+pub fn steps(mode: shard.Mode) []const Step {
+    return switch (mode) {
+        .fetch => &.{ .stage_fetch, .collect_fetch },
+        .owner => &.{ .stage_q, .collect_q, .stage_out, .collect_out },
+        .off, .auto => &.{},
+    };
+}
+
+/// round.zig's check of the ring order as it issues a layer's transfers: `begin` at the layer's first, `take` before
+/// each, `done` at the attention's end. Any other order is ShardRingOrder (before a launch, so neither rank's ring
+/// parts from the other's).
+pub const Cursor = struct {
+    s: []const Step = &.{},
+    i: usize = 0,
+
+    pub fn begin(c: *Cursor, mode: shard.Mode) !void {
+        if (!c.done()) return error.ShardRingOrder;
+        c.* = .{ .s = steps(mode) };
+    }
+
+    pub fn take(c: *Cursor, s: Step) !void {
+        if (c.i >= c.s.len or c.s[c.i] != s) return error.ShardRingOrder;
+        c.i += 1;
+    }
+
+    pub fn done(c: *const Cursor) bool {
+        return c.i == c.s.len;
+    }
+
+    pub fn reset(c: *Cursor) void {
+        c.* = .{};
+    }
+};
+
+// -- auto: fetch or owner decode a round ----------------------------------------------------------------------------
+
+/// A listed row's bytes in each exchange (the model's: kk picks x 288 B; hl x hd x 2; wo_k x 2).
+pub const Sizes = struct { fetch_row: usize, q_row: usize, out_row: usize };
+
+/// What a round's decode exchanges cost beyond the replicated engine's attention, a compressed layer, in ns. The
+/// defaults are estimates, not measurements (~11 us a ring round trip, ~22 GB/s over the dual rails, ~128 GB/s for a
+/// stage or collect copy, a 32-head pass's launches); TF_DS_KV_SHARD_COST sets them, the same on both ranks, from
+/// the TF_DS_CLOCK_MARKS=4 profile at 1, 2, 4 and 8 streams (docs/port/shard-ring.md "Setting the cost model").
+/// - fetch: fixed + a row's flight for the busier sender's rows, plus its stage and collect copies.
+/// - owner: fixed + a row's output flight (the part the own pass does not hide), plus four copies (q and outputs,
+///   staged and collected), plus the second 32-head pass on the busier rank: its launches, a pass term a picked row
+///   (two passes over the held rows against one over every row) and a term a masked row (each pass still runs the
+///   window attention of the rows it masks).
+pub const Cost = struct {
+    fetch_fixed: u32 = 13_000,
+    fetch_row: u32 = 7_000,
+    owner_fixed: u32 = 8_000,
+    owner_row: u32 = 1_600,
+    pass_fixed: u32 = 6_000,
+    pass_row: u32 = 600,
+    mask_row: u32 = 200,
+    copy_fixed: u32 = 2_000,
+    copy_kib: u32 = 8,
+
+    pub const fields = @typeInfo(Cost).@"struct".field_names;
+
+    /// TF_DS_KV_SHARD_COST: nine comma-separated integers in the field order (null or empty: the defaults).
+    pub fn parse(text: ?[]const u8) !Cost {
+        var c: Cost = .{};
+        const t = text orelse return c;
+        if (t.len == 0) return c;
+        var it = std.mem.splitScalar(u8, t, ',');
+        inline for (fields) |f| {
+            const v = it.next() orelse return error.BadKvShardCost;
+            @field(c, f) = std.fmt.parseInt(u32, std.mem.trim(u8, v, " "), 10) catch return error.BadKvShardCost;
+        }
+        if (it.next() != null) return error.BadKvShardCost;
+        return c;
+    }
+
+    fn copies(c: Cost, kernels: u64, bytes: u64) u64 {
+        return kernels * c.copy_fixed + @as(u64, c.copy_kib) * bytes / 1024;
+    }
+
+    /// The fetch's and owner decode's extra ns a compressed layer for a round of these counts.
+    pub fn fetchNs(c: Cost, n: Counts, z: Sizes) u64 {
+        const m = @max(n.x[0], n.x[1]);
+        const moved: u64 = n.x[0] + n.x[1]; // each rank stages its rows and collects the other's
+        return @as(u64, c.fetch_fixed) + @as(u64, c.fetch_row) * m + c.copies(2, moved * z.fetch_row);
+    }
+
+    pub fn ownerNs(c: Cost, n: Counts, z: Sizes) u64 {
+        const m = @max(n.x[0], n.x[1]);
+        const moved: u64 = n.x[0] + n.x[1];
+        const R: i64 = @intCast(n.rows());
+        var pass: i64 = 0;
+        for (0..2) |r| {
+            const h: i64 = @intCast(n.held(r));
+            const p = @as(i64, c.pass_fixed) + @as(i64, c.pass_row) * (2 * h - R) + 2 * @as(i64, c.mask_row) * (R - h);
+            pass = @max(pass, p);
+        }
+        return @as(u64, c.owner_fixed) + @as(u64, c.owner_row) * m + c.copies(4, moved * (z.q_row + z.out_row)) + @as(u64, @intCast(pass));
+    }
+
+    /// The round's decode mode: fetch for a round wider than the split path (`decode_rows`: owner decode has no
+    /// one-pass variant), else owner decode unless the fetch costs less (a tie goes to owner decode). round.forward
+    /// sets the split path's bound (tri.decode_rows) to the round bound (TF_DS_ROUND_ROWS) for the round, so every
+    /// decode round is on the split path and may go owner: the wide-round rule binds only a smaller bound.
+    pub fn choose(c: Cost, n: Counts, z: Sizes, decode_rows: usize) shard.Mode {
+        if (n.rows() > decode_rows) return .fetch;
+        return if (c.fetchNs(n, z) < c.ownerNs(n, z)) .fetch else .owner;
+    }
+};
+
+// -- a round's decision (round.shardRound) ---------------------------------------------------------------------------
+
+/// What round.shardRound decides a round from, every input the same on both ranks: the round's view (owners) and the
+/// settings the ranks agreed at useShard (the switch, auto's cost model, the ring, each mode's fit from the model's
+/// sizes).
+pub const RoundIn = struct {
+    view: View,
+    /// TF_DS_KV_SHARD_DECODE: fetch, owner or auto.
+    mode: shard.Mode,
+    cost: Cost = .{},
+    sizes: Sizes,
+    /// The split path's rows at most (tri.decode_rows while a round runs: the round bound, Engine.round_rows).
+    decode_rows: usize,
+    /// The agreed ring (KvShard.use_ring) with its row-list block allocated (Round.rlist).
+    ring: bool,
+    fit_fetch: usize = 0,
+    fit_owner: usize = 0,
+};
+
+/// A round's decode, as shardRound applies it (Round.smode, sring).
+pub const Decision = struct {
+    /// fetch or owner.
+    mode: shard.Mode,
+    /// The round's exchanges ride the RDMA ring (roundLists then makes its row lists).
+    ring: bool,
+};
+
+/// The round's decode from what every rank holds alike (so both ranks decide the same): the switch's mode or auto's
+/// choice from the view's counts, and the ring iff the round's rows fit a slot of the mode's exchanges.
+pub fn decide(in: RoundIn) !Decision {
+    const R = in.view.owners.len;
+    const n = try counts(in.view);
+    const m: shard.Mode = switch (in.mode) {
+        .fetch, .owner => in.mode,
+        .auto => in.cost.choose(n, in.sizes, in.decode_rows),
+        .off => return error.NoKvShard,
+    };
+    const fit = if (m == .fetch) in.fit_fetch else in.fit_owner;
+    return .{ .mode = m, .ring = in.ring and R <= fit };
+}
+
+/// The ring round's row lists on `rank` (null: the round is not on the ring).
+pub fn roundLists(d: Decision, v: View, rank: u32) !?Lists {
+    if (!d.ring) return null;
+    return try lists(v, rank);
+}
+
+/// The settings both ranks must share before the first round (round.Round.useShard gathers them): whether the
+/// exchanges ride the RDMA ring, and the cost model. `bad` marks a rank whose own settings did not parse.
+pub const Agreed = extern struct {
+    ring: u64,
+    cost: [Cost.fields.len]u64,
+
+    pub const bad = std.math.maxInt(u64);
+
+    pub fn of(ring: bool, cost: anyerror!Cost) Agreed {
+        var a: Agreed = .{ .ring = @intFromBool(ring), .cost = undefined };
+        if (cost) |c| {
+            inline for (Cost.fields, 0..) |f, i| a.cost[i] = @field(c, f);
+        } else |_| {
+            a.ring = bad;
+            a.cost = @splat(bad);
+        }
+        return a;
+    }
+
+    /// Every rank's (gathered in rank order) equal to this one's; a sentinel refuses (KvShardSettingsMismatch on the
+    /// ranks that parsed, their own parse error on the one that did not).
+    pub fn same(mine: Agreed, all: []const Agreed) bool {
+        for (all) |o| if (o.ring == bad or !std.meta.eql(o, mine)) return false;
+        return true;
+    }
+};
