+    defer gpa.destroy(sn);
+    try pumpUntil(ld, 1);
+    const key = format.pointKey(&ids, bt, &.{});
+    try w.waitPresent(key, true);
+    const p = t.vtable.lookup(t.ptr, &want(&ids)) orelse return error.NotFound;
+    const done = pollUntilDone(t, try t.vtable.begin(t.ptr, &p));
