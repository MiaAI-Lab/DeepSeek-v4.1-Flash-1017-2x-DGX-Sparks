+
+test "spill store: the GLM 0110 checks and the native port's own, all pass" {
+    var failed: usize = 0;
+    for (checks) |ch| {
+        ch.f(testing.allocator) catch |e| {
+            std.debug.print("FAIL {s}: {t}\n", .{ ch.name, e });
+            failed += 1;
+        };
+    }
+    try testing.expectEqual(@as(usize, 0), failed);
