+    try p.kv.keep(700, b.id, 8 * C);
+    try p.kv.release(b.id);
+    // 28 blocks in part 1 would stale 700: the hold takes the point's 8 blocks instead, staling nobody
+    const r = try p.kv.restore(902, 28 * C, 8 * C, p1);
