+pub fn testRoot(buf: []u8, tag: []const u8) ![:0]const u8 {
+    const base = if (c.getenv("TF_SPILL_TEST_DIR")) |p| std.mem.span(p) else "/tmp";
+    return std.fmt.bufPrintSentinel(buf, "{s}/tf-spill-{s}-{d}", .{ base, tag, c.getpid() }, 0);
