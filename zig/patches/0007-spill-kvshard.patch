+    /// The own kept state whose conversation `prompt` continues (continued_chat): most recently used first; a later
+    /// entry wins a tie of use. Shared, restored, pictured and forgotten conversations' states are passed over.
+    pub fn continuedChat(s: *const Store, prompt: []const u32) ?*Entry {
+        var best: ?*Entry = null;
+        for (s.entries.items) |c| {
+            if (c.shared or c.restored or c.images or c.group == 0) continue;
+            const root = s.roots.get(c.group) orelse continue;
+            const n = @as(usize, root) + chat_match;
+            if (c.last.len < n or prompt.len < n or c.last[n - 1] != prompt[n - 1] or !std.mem.eql(u32, c.last[0..n], prompt[0..n])) continue;
+            if (best == null or c.used >= best.?.used) best = c;
+        }
+        return best;
+    }
+
+    fn pruneRoots(s: *Store, keep_: u64) void {
+        var gone: std.ArrayList(u64) = .empty;
+        defer gone.deinit(s.gpa);
+        var it = s.roots.keyIterator();
+        while (it.next()) |k| {
+            if (k.* == keep_) continue;
+            const held = for (s.entries.items) |e| {
+                if (e.group == k.*) break true;
+            } else false;
+            if (!held) gone.append(s.gpa, k.*) catch return;
+        }
+        for (gone.items) |k| _ = s.roots.remove(k);
+    }
+
+    /// After a continued request's pass resumed at `cut` of `len` tokens: counted, and a large prefill logged with where
+    /// the prompt left the kept state and what it resumed from (only rank 0 runs the host).
+    pub fn continued(s: *Store, j: Join, cut: u32, len: usize) void {
+        if (!j.continued) return;
+        s.stats.chats_continued += 1;
+        s.stats.chats_continued_prefill_tokens += len -| cut;
+        if (!shouldLog(j, cut, len) or @import("builtin").is_test) return;
+        var buf: [512]u8 = undefined;
+        std.log.info("{s}", .{continuedLine(&buf, j, cut, len)});
+    }
 };
 
+/// Whether `continued` logs a continued request's pass (from `cut` of `len` tokens): its prefill is large.
+pub fn shouldLog(j: Join, cut: u32, len: usize) bool {
+    return j.continued and len -| cut >= chat_log_tokens;
+}
+
+/// continued's log line.
+pub fn continuedLine(buf: []u8, j: Join, cut: u32, len: usize) []const u8 {
+    const source = switch (j.source) {
+        .nothing => "nothing",
+        .shared => "a shared prefix",
+        .other => "a state that is not a turn's own (read back from disk)",
+    };
+    var why_buf: [256]u8 = undefined;
+    const why = (if (j.back < j.prior_len)
+        std.fmt.bufPrint(&why_buf, "it went back to token {d}, before that conversation's newest kept state ({d} tokens)", .{ j.back, j.prior_len })
+    else
+        std.fmt.bufPrint(&why_buf, "its kept state of {d} tokens could not serve it (stale, off the grid or past the replay cut)", .{j.prior_len})) catch "";
+    return std.fmt.bufPrint(buf, "prompt cache: conversation {d}: resumed at {d} of {d} tokens from {s}, prefilling {d}; {s}", .{ j.group, cut, len, source, len -| cut, why }) catch buf[0..0];
+}
+
+/// The tokens two id lists share from the start.
+pub fn commonPrefix(a: []const u32, b: []const u32) usize {
+    return std.mem.indexOfDiff(u32, a, b) orelse @min(a.len, b.len);
+}
+
 /// A line on the engine's log; tests stay quiet (the build runner fails a test that writes to stderr).
 fn note(comptime fmt: []const u8, args: anytype) void {
     if (@import("builtin").is_test) return;
@@ -409,4 +1229,5 @@ fn floorStart(starts: []const u32, at: u32) u32 {
 
 test {
     _ = @import("prompt_cache_test.zig");
+    _ = @import("prompt_cache_tier_test.zig");
 }
diff --git a/zig/src/core/prompt_cache_fake_tier.zig b/zig/src/core/prompt_cache_fake_tier.zig
new file mode 100644
index 0000000000000000000000000000000000000000..094d83cd497464eebd0957e54c4673414de6c419
--- /dev/null
+++ b/zig/src/core/prompt_cache_fake_tier.zig
@@ -0,0 +1,342 @@
+//! An in-memory prompt-cache Tier for tests (no disk, no CUDA; one lock for the engine thread and the test's): writes are queued at keep and published
+//! by `pump`, a restore needs `polls` polls, and every misuse (a job cancelled twice, a poll of a gone job) is recorded.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const Allocator = std.mem.Allocator;
+
+/// How the fake turns a family's state into bytes and back (the family's packing, in round 2).
+pub const Codec = struct {
+    ctx: *anyopaque,
+    pack: *const fn (ctx: *anyopaque, a: Allocator, saved: pc.Saved) anyerror![]u8,
+    unpack: *const fn (ctx: *anyopaque, bytes: []const u8) anyerror!pc.Saved,
+};
+
+pub const FakeTier = struct {
+    gpa: Allocator,
+    codec: Codec,
+    points: std.ArrayList(Pt) = .empty,
+    queue: std.ArrayList(Pending) = .empty,
+    jobs: std.ArrayList(Job) = .empty,
+    next_id: u64 = 1,
+    next_job: u64 = 1,
+    /// Polls a restore takes before it is ready (1: the first).
+    polls: u32 = 1,
+    /// The next restore fails with this error (on its first poll).
+    fail_next: ?anyerror = null,
+    /// The next `refuse` begins are refused with `refuse_err` before anything is reserved (a tier at its capacity:
+    /// dsv41's TooManyRestores, the store's TooMany/NoSlot); `refused` counts them.
+    refuse: u32 = 0,
+    refuse_err: anyerror = error.TooManyRestores,
+    refused: u64 = 0,
+    begins: u64 = 0,
+    /// The next `full` asks of Tier.VTable.full answer true (the tier at its cap before any room is made; `fulls`
+    /// counts the asks).
+    full: u32 = 0,
+    fulls: u64 = 0,
+    /// Shorter states are not written.
+    min_tokens: u32 = 0,
+    /// A flush cannot drain: its queue is left unpublished.
+    stuck: bool = false,
+    /// Lookups ignore `beyond`, `max_at` and `grid` (the store must check the answer itself).
+    lax: bool = false,
+    /// While false every poll stays pending (another thread opens it).
+    gate: std.atomic.Value(bool) = .init(true),
+    c: pc.TierCounts = .{},
+    polled: u64 = 0,
+    cancels: u64 = 0,
+    misuse: u64 = 0, // a cancel or poll of a job that is not pending
+    touched: u64 = 0,
+    released: u64 = 0,
+    shared_marks: u64 = 0,
+    flushed: u64 = 0,
+    /// Ranks whose counters `counts` reports (rank r's `crc_errors` is r, to tell them apart).
+    ranks: u32 = 1,
+    /// The engine thread's calls and the test thread's `put`/`point` (a test adds a point while the host still
+    /// publishes an earlier keep: two appends at once lost one list, a leak the allocator caught now and then).
+    mu: std.Io.Mutex = .init,
+
+    pub const Pt = struct { id: u64, key: []u32, at: u32, group: u64, shared: bool, bytes: []u8, parent: ?u64, fork: u32, size: u64, lineage: []pc.Fork = &.{} };
+    pub const Pending = struct { id: u64, key: []u32, at: u32, group: u64, shared: bool, saved: pc.Saved, parent: ?u64, fork: u32, size: u64, lineage: []pc.Fork };
+    const Job = struct { id: u64, point: u64, left: u32, fail: ?anyerror };
+
+    pub fn deinit(t: *FakeTier) void {
+        for (t.points.items) |p| {
+            t.gpa.free(p.key);
+            t.gpa.free(p.bytes);
+            t.gpa.free(p.lineage);
+        }
+        for (t.queue.items) |q| {
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+        }
+        t.points.deinit(t.gpa);
+        t.queue.deinit(t.gpa);
+        t.jobs.deinit(t.gpa);
+    }
+
+    pub fn tier(t: *FakeTier) pc.Tier {
+        return .{ .ptr = t, .vtable = &.{ .lookup = lookup, .begin = begin, .full = isFull, .poll = poll, .cancel = cancel, .keep = keep, .release = release, .share = share, .touch = touch, .forget = forget, .pump = pump, .busy = busy, .flush = flush, .counts = counts } };
+    }
+
+    fn lock(t: *FakeTier) void {
+        t.mu.lockUncancelable(std.testing.io);
+    }
+
+    fn unlock(t: *FakeTier) void {
+        t.mu.unlock(std.testing.io);
+    }
+
+    fn of(ptr: *anyopaque) *FakeTier {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    /// A published point of `key` (its ids, `at` plus lookahead) whose state packs to `bytes`: its name.
+    pub fn put(t: *FakeTier, key: []const u32, at: u32, bytes: []const u8, size: u64, group: u64, shared: bool) !u64 {
+        t.lock();
+        defer t.unlock();
+        const k = try t.gpa.dupe(u32, key);
+        errdefer t.gpa.free(k);
+        const b = try t.gpa.dupe(u8, bytes);
+        errdefer t.gpa.free(b);
+        const id = t.next_id;
+        try t.points.append(t.gpa, .{ .id = id, .key = k, .at = at, .group = group, .shared = shared, .bytes = b, .parent = null, .fork = 0, .size = size });
+        t.next_id += 1;
+        return id;
+    }
+
+    /// The published point named `id`, if any.
+    pub fn point(t: *FakeTier, id: u64) ?*Pt {
+        t.lock();
+        defer t.unlock();
+        return t.find(id);
+    }
+
+    fn find(t: *FakeTier, id: u64) ?*Pt {
+        for (t.points.items) |*p| if (p.id == id) return p;
+        return null;
+    }
+
+    fn lookup(ptr: *anyopaque, want: *const pc.Want) ?pc.Point {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        var best: ?*Pt = null;
+        for (t.points.items) |*p| {
+            if (p.key.len > want.key.len or !std.mem.eql(u32, p.key, want.key[0..p.key.len])) continue;
+            if (!t.lax and (p.at <= want.beyond or p.at > want.max_at or (want.grid > 0 and p.at % want.grid != 0))) continue;
+            if (best == null or p.at > best.?.at) best = p;
+        }
+        const p = best orelse {
+            t.c.compatible_misses += 1;
+            return null;
+        };
+        return .{ .id = p.id, .at = p.at, .tokens = @intCast(p.key.len), .bytes = p.size, .group = p.group, .shared = p.shared };
+    }
+
+    fn isFull(ptr: *anyopaque) bool {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.fulls += 1;
+        if (t.full == 0) return false;
+        t.full -= 1;
+        return true;
+    }
+
+    fn begin(ptr: *anyopaque, p: *const pc.Point) anyerror!u64 {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.begins += 1;
+        if (t.refuse > 0) {
+            t.refuse -= 1;
+            t.refused += 1;
+            return t.refuse_err;
+        }
+        if (t.find(p.id) == null) {
+            t.c.presence_refused += 1;
+            return error.PointMissing;
+        }
+        const id = t.next_job;
+        t.next_job += 1;
+        try t.jobs.append(t.gpa, .{ .id = id, .point = p.id, .left = @max(t.polls, 1), .fail = t.fail_next });
+        t.fail_next = null;
+        return id;
+    }
+
+    fn job(t: *FakeTier, id: u64) ?usize {
+        for (t.jobs.items, 0..) |j, i| if (j.id == id) return i;
+        return null;
+    }
+
+    fn poll(ptr: *anyopaque, id: u64, _: u64) pc.Poll {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.polled += 1;
+        const i = t.job(id) orelse {
+            t.misuse += 1;
+            return .{ .failed = error.NoSuchJob };
+        };
+        const j = &t.jobs.items[i];
+        if (j.fail) |err| {
+            _ = t.jobs.orderedRemove(i);
+            t.c.read_failed += 1;
+            if (err == error.CrcMismatch) t.c.crc_errors += 1;
+            return .{ .failed = err };
+        }
+        if (!t.gate.load(.acquire)) return .{ .pending = .{ .total = @max(t.polls, 1) } };
+        j.left -= 1;
+        if (j.left > 0) return .{ .pending = .{ .done = @max(t.polls, 1) - j.left, .total = @max(t.polls, 1) } };
+        const pid = j.point;
+        _ = t.jobs.orderedRemove(i);
+        const p = t.find(pid) orelse return .{ .failed = error.PointMissing };
+        const saved = t.codec.unpack(t.codec.ctx, p.bytes) catch |err| return .{ .failed = err };
+        t.c.reads += 1;
+        t.c.read_bytes += p.bytes.len;
+        return .{ .ready = .{ .saved = saved, .bytes = p.size, .lineage = p.lineage } };
+    }
+
+    fn cancel(ptr: *anyopaque, id: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.cancels += 1;
+        const i = t.job(id) orelse {
+            t.misuse += 1;
+            return;
+        };
+        _ = t.jobs.orderedRemove(i);
+    }
+
+    fn keep(ptr: *anyopaque, k: *const pc.Kept) ?u64 {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        if (k.at < t.min_tokens) return null;
+        const key = t.gpa.dupe(u32, k.key) catch return null;
+        const lin = t.gpa.dupe(pc.Fork, k.lineage) catch {
+            t.gpa.free(key);
+            return null;
+        };
+        const id = t.next_id;
+        t.queue.append(t.gpa, .{ .id = id, .key = key, .at = k.at, .group = k.group, .shared = k.shared, .saved = k.saved, .parent = k.parent, .fork = k.fork, .size = k.bytes, .lineage = lin }) catch {
+            t.gpa.free(key);
+            t.gpa.free(lin);
+            return null;
+        };
+        t.next_id += 1;
+        t.c.writes_queued += 1;
+        return id;
+    }
+
+    /// Queued write `i` published (its state packed now).
+    fn publish(t: *FakeTier, i: usize) void {
+        const q = t.queue.orderedRemove(i);
+        const bytes = t.codec.pack(t.codec.ctx, t.gpa, q.saved) catch {
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+            t.c.writes_failed += 1;
+            return;
+        };
+        t.points.append(t.gpa, .{ .id = q.id, .key = q.key, .at = q.at, .group = q.group, .shared = q.shared, .bytes = bytes, .parent = q.parent, .fork = q.fork, .size = q.size, .lineage = q.lineage }) catch {
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+            t.gpa.free(bytes);
+            t.c.writes_failed += 1;
+            return;
+        };
+        t.c.writes_committed += 1;
+        t.c.written_bytes += bytes.len;
+    }
+
+    fn release(ptr: *anyopaque, id: u64, _: pc.Saved) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.released += 1;
+        for (t.queue.items, 0..) |q, i| if (q.id == id) {
+            t.c.forced_staging += 1;
+            return t.publish(i);
+        };
+    }
+
+    fn share(ptr: *anyopaque, id: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.shared_marks += 1;
+        if (t.find(id)) |p| p.shared = true;
+        for (t.queue.items) |*q| if (q.id == id) {
+            q.shared = true;
+        };
+    }
+
+    fn touch(ptr: *anyopaque, _: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.touched += 1;
+    }
+
+    fn forget(ptr: *anyopaque, id: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        for (t.points.items, 0..) |p, i| if (p.id == id) {
+            t.gpa.free(p.key);
+            t.gpa.free(p.bytes);
+            t.gpa.free(p.lineage);
+            _ = t.points.orderedRemove(i);
+            return;
+        };
+    }
+
+    fn pump(ptr: *anyopaque, _: u64) void {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        while (t.queue.items.len > 0) t.publish(0);
+    }
+
+    fn busy(ptr: *anyopaque) bool {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        return t.queue.items.len > 0;
+    }
+
+    fn flush(ptr: *anyopaque, _: u64) u64 {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        t.flushed += 1;
+        if (!t.stuck) {
+            while (t.queue.items.len > 0) t.publish(0); // (pump's, under this lock)
+            return 0;
+        }
+        const left = t.queue.items.len;
+        for (t.queue.items) |q| {
+            t.gpa.free(q.key);
+            t.gpa.free(q.lineage);
+        }
+        t.queue.clearRetainingCapacity();
+        t.c.writes_cancelled += left;
+        return left;
+    }
+
+    fn counts(ptr: *anyopaque, out: []pc.TierCounts) usize {
+        const t = of(ptr);
+        t.lock();
+        defer t.unlock();
+        var c = t.c;
+        c.points = t.points.items.len;
+        c.writes_pending = t.queue.items.len;
+        const n = @min(out.len, t.ranks);
+        for (out[0..n], 0..) |*o, r| {
+            o.* = c;
+            if (r > 0) o.crc_errors = r;
+        }
+        return n;
+    }
+};
diff --git a/zig/src/core/prompt_cache_media_test.zig b/zig/src/core/prompt_cache_media_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d7f9147e697f30ad5ff3941a8989e16f64cd8bca
--- /dev/null
+++ b/zig/src/core/prompt_cache_media_test.zig
@@ -0,0 +1,347 @@
+//! Pictures and the durable tier (spill v2 over recipe 0006's content keys): `mediaKeys`, and what the store and the
+//! lane host hand a tier for a prompt with pictures (Want.images/media at lookup, Kept.media/raw at keep), over the
+//! fake backend and the in-memory tier.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const pc = @import("prompt_cache.zig");
+const ft = @import("prompt_cache_fake_tier.zig");
+const LaneHost = api.LaneHost;
+const Id = api.Id;
+const Event = api.Event;
+const Request = api.Request;
+const Reason = api.Reason;
+const gpa = std.testing.allocator;
+const io = std.testing.io;
+
+fn digestOf(payload: []const u8) [32]u8 {
+    var d: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(payload, &d, .{});
+    return d;
+}
+
+test "mediaKeys: every picture id named by a span and made from its digest, nothing else" {
+    const a = digestOf("a");
+    const b = digestOf("b");
+    var key = [_]u32{ 1, 2, 0, 0, 0, 3, 0, 0, 0, 0, 4 };
+    for (0..3) |j| key[2 + j] = pc.pictureId(&a, @intCast(j));
+    for (0..4) |j| key[6 + j] = pc.pictureId(&b, @intCast(j));
+    const m = [_]pc.Media{ .{ .start = 2, .len = 3, .digest = a }, .{ .start = 6, .len = 4, .digest = b } };
+    try std.testing.expect(pc.mediaKeys(&key, key.len, &m));
+    try std.testing.expect(pc.mediaKeys(&key, 8, &m)); // a cut inside the second picture
+    try std.testing.expect(pc.mediaKeys(&key, 2, &.{})); // a cut before every picture: text
+    try std.testing.expect(!pc.mediaKeys(&key, key.len, m[0..1])); // the second picture unnamed
+    try std.testing.expect(!pc.mediaKeys(&key, key.len, &.{})); // none named
+    try std.testing.expect(!pc.mediaKeys(&key, key.len, &.{ m[1], m[0] })); // out of order
+    try std.testing.expect(!pc.mediaKeys(&key, key.len, &.{ m[0], .{ .start = 4, .len = 2, .digest = b } })); // overlapping
+    try std.testing.expect(!pc.mediaKeys(&key, key.len, &.{ .{ .start = 2, .len = 3, .digest = b }, m[1] })); // another payload
+    try std.testing.expect(!pc.mediaKeys(&key, key.len, &.{ .{ .start = 2, .len = 2, .digest = a }, m[1] })); // a short span
+    try std.testing.expect(!pc.mediaKeys(&key, key.len + 1, &m)); // past the key
+    // a picture id's high bit keeps it off every vocabulary id
+    for (0..1000) |j| try std.testing.expect(pc.pictureId(&a, @intCast(j)) >= pc.picture_ids);
+}
+
+const Box = struct {
+    mutex: std.Io.Mutex = .init,
+    cached: ?u32 = null,
+    done: ?Reason = null,
+
+    fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+        const b: *Box = @ptrCast(@alignCast(ctx));
+        b.mutex.lockUncancelable(io);
+        defer b.mutex.unlock(io);
+        switch (e.*) {
+            .prefilled => |c| b.cached = c,
+            .tokens => {},
+            .finished => |f| b.done = f.reason,
+        }
+    }
+    fn sink(b: *Box) api.Sink {
+        return .{ .ctx = b, .event = event };
+    }
+    fn wait(b: *Box) Reason {
+        while (true) {
+            b.mutex.lockUncancelable(io);
+            const d = b.done;
+            b.mutex.unlock(io);
+            if (d) |r| return r;
+            std.Io.sleep(io, .fromMilliseconds(1), .awake) catch {};
+        }
+    }
+};
+
+/// The in-memory tier, recording what the store hands it for pictures (lookups and keeps), everything else its own.
+const Rec = struct {
+    inner: *ft.FakeTier,
+    mutex: std.Io.Mutex = .init,
+    lookups: u32 = 0,
+    picture_lookups: u32 = 0, // with Want.images
+    want_media: [4]pc.Media = undefined,
+    want_n: usize = 0,
+    keeps: u32 = 0,
+    kept_media: [4]pc.Media = undefined,
+    kept_n: usize = 0,
+    kept_raw: [64]u32 = undefined,
+    kept_raw_n: usize = 0,
+    kept_images: bool = false,
+    /// The real tier's gate (spill_tier): with pictures, a lookup or keep whose media do not name its picture ids misses
+    /// or keeps nothing.
+    strict: bool = false,
+    refused: u32 = 0,
+
+    fn tier(r: *Rec) pc.Tier {
+        return .{ .ptr = r, .vtable = &.{ .lookup = lookup, .begin = begin, .poll = poll, .cancel = cancel, .keep = keep, .release = release, .share = share, .touch = touch, .forget = forget, .pump = pump, .busy = busy, .flush = flush, .counts = counts } };
+    }
+
+    fn of(p: *anyopaque) *Rec {
+        return @ptrCast(@alignCast(p));
+    }
+    fn in(p: *anyopaque) struct { *anyopaque, *const pc.Tier.VTable } {
+        const t = of(p).inner.tier();
+        return .{ t.ptr, t.vtable };
+    }
+    fn begin(p: *anyopaque, point: *const pc.Point) anyerror!u64 {
+        const x = in(p);
+        return x[1].begin(x[0], point);
+    }
+    fn poll(p: *anyopaque, job: u64, budget: u64) pc.Poll {
+        const x = in(p);
+        return x[1].poll(x[0], job, budget);
+    }
+    fn cancel(p: *anyopaque, job: u64) void {
+        const x = in(p);
+        x[1].cancel(x[0], job);
+    }
+    fn release(p: *anyopaque, point: u64, saved: pc.Saved) void {
+        const x = in(p);
+        x[1].release.?(x[0], point, saved);
+    }
+    fn share(p: *anyopaque, point: u64) void {
+        const x = in(p);
+        x[1].share.?(x[0], point);
+    }
+    fn touch(p: *anyopaque, point: u64) void {
+        const x = in(p);
+        x[1].touch.?(x[0], point);
+    }
+    fn forget(p: *anyopaque, point: u64) void {
+        const x = in(p);
+        x[1].forget(x[0], point);
+    }
+    fn pump(p: *anyopaque, budget: u64) void {
+        const x = in(p);
+        x[1].pump.?(x[0], budget);
+    }
+    fn busy(p: *anyopaque) bool {
+        const x = in(p);
+        return x[1].busy.?(x[0]);
+    }
+    fn flush(p: *anyopaque, budget: u64) u64 {
+        const x = in(p);
+        return x[1].flush(x[0], budget);
+    }
+    fn counts(p: *anyopaque, out: []pc.TierCounts) usize {
+        const x = in(p);
+        return x[1].counts(x[0], out);
+    }
+    fn lookup(p: *anyopaque, want: *const pc.Want) ?pc.Point {
+        const r = of(p);
+        r.mutex.lockUncancelable(io);
+        r.lookups += 1;
+        if (want.images) r.picture_lookups += 1;
+        r.want_n = @min(want.media.len, r.want_media.len);
+        @memcpy(r.want_media[0..r.want_n], want.media[0..r.want_n]);
+        const refuse = r.strict and want.images and !pc.mediaKeys(want.key, want.key.len, want.media);
+        if (refuse) r.refused += 1;
+        r.mutex.unlock(io);
+        if (refuse) return null;
+        const x = in(p);
+        return x[1].lookup(x[0], want);
+    }
+    fn keep(p: *anyopaque, kept: *const pc.Kept) ?u64 {
+        const r = of(p);
+        r.mutex.lockUncancelable(io);
+        r.keeps += 1;
+        r.kept_images = kept.images;
+        r.kept_n = @min(kept.media.len, r.kept_media.len);
+        @memcpy(r.kept_media[0..r.kept_n], kept.media[0..r.kept_n]);
+        r.kept_raw_n = @min(kept.raw.len, r.kept_raw.len);
+        @memcpy(r.kept_raw[0..r.kept_raw_n], kept.raw[0..r.kept_raw_n]);
+        const refuse = r.strict and kept.images and !pc.mediaKeys(kept.key, kept.at, kept.media);
+        if (refuse) r.refused += 1;
+        r.mutex.unlock(io);
+        if (refuse) return null;
+        const x = in(p);
+        return x[1].keep(x[0], kept);
+    }
+};
+
+const Rig = struct {
+    cfg: lanes.Config,
+    target: lanes.fake.Fake,
+    clock: lanes.fake.FixedClock = .{},
+    core: lanes.Engine,
+    store: pc.Store,
+    tier: ft.FakeTier,
+    rec: Rec,
+    host: LaneHost,
+
+    fn bytes(_: *anyopaque, at: u32) u64 {
+        return 64 + 4 * @as(u64, at);
+    }
+    fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        return f.save(@ptrCast(@alignCast(owner.?)), at);
+    }
+    fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+        return error.BackendRestores;
+    }
+    fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        f.drop(saved);
+    }
+    fn pack(_: *anyopaque, a: std.mem.Allocator, saved: pc.Saved) anyerror![]u8 {
+        const kept: *std.ArrayList(u32) = @ptrCast(@alignCast(saved));
+        return a.dupe(u8, std.mem.sliceAsBytes(kept.items));
+    }
+    fn unpack(_: *anyopaque, b: []const u8) anyerror!pc.Saved {
+        const kept = try gpa.create(std.ArrayList(u32));
+        kept.* = .empty;
+        const n = b.len / 4;
+        try kept.resize(gpa, n);
+        @memcpy(std.mem.sliceAsBytes(kept.items), b[0 .. n * 4]);
+        return kept;
+    }
+
+    fn create() !*Rig {
+        const r = try gpa.create(Rig);
+        errdefer gpa.destroy(r);
+        r.* = .{ .cfg = undefined, .target = .{ .gpa = gpa }, .core = undefined, .store = undefined, .tier = .{ .gpa = gpa, .codec = .{ .ctx = r, .pack = pack, .unpack = unpack } }, .rec = undefined, .host = undefined };
+        r.rec = .{ .inner = &r.tier };
+        r.cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+        r.core = lanes.Engine.init(gpa, &r.cfg, r.target.backend(), r.clock.clock());
+        r.store = pc.Store.init(gpa, .{ .ptr = &r.target, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+        r.store.setTier(r.rec.tier(), 0);
+        r.host = LaneHost.init(gpa, io, &r.core, .{ .lanes = 2 });
+        r.host.interleave_ns = 0;
+        r.host.cache = &r.store;
+        r.host.configure(.{ .load_ms = 5, .flush_ms = 1000 });
+        try r.host.start();
+        return r;
+    }
+
+    fn destroy(r: *Rig) void {
+        r.host.stop();
+        r.store.deinit();
+        r.tier.deinit();
+        r.core.deinit();
+        r.target.deinit();
+        r.cfg.deinit(gpa);
+        gpa.destroy(r);
+    }
+};
+
+test "a prompt with pictures: its lookups carry the pictures' identities, its keeps their identities and model ids; a disk hit resumes it" {
+    const r = try Rig.create();
+    defer r.destroy();
+    const d = digestOf("a picture's payload");
+    // the picture's three positions hold the placeholder (99) in the prompt; the cache keys them by the picture
+    const prompt = [_]u32{ 3, 1, 99, 99, 99, 5, 9, 2, 6, 5, 7, 7, 4, 4 };
+    var key = prompt;
+    for (0..3) |j| key[2 + j] = pc.pictureId(&d, @intCast(j));
+    const media = [_]pc.Media{.{ .start = 2, .len = 3, .digest = d }};
+    const img = [_]api.Image{.{ .at = 2, .tokens = 3, .bytes = "" }};
+    // a point of 8 tokens on "disk" (its state the prompt's own tokens: the fake backend's state is its history)
+    _ = try r.tier.put(key[0..8], 8, std.mem.sliceAsBytes(prompt[0..8]), 0, 0, false);
+    var b: Box = .{};
+    const req: Request = .{ .prompt = &prompt, .images = &img, .cache_key = &key, .cache_media = &media, .max_tokens = 4, .history_len = 12 };
+    try r.host.engine().submit(1, &req, b.sink());
+    try std.testing.expectEqual(Reason.length, b.wait());
+    try std.testing.expectEqual(@as(?u32, 8), b.cached); // restored, then resumed
+    r.rec.mutex.lockUncancelable(io);
+    defer r.rec.mutex.unlock(io);
+    try std.testing.expect(r.rec.picture_lookups >= 1);
+    try std.testing.expectEqual(@as(usize, 1), r.rec.want_n);
+    try std.testing.expect(r.rec.want_media[0].eql(media[0]));
+    try std.testing.expect(r.rec.keeps >= 1);
+    try std.testing.expect(r.rec.kept_images);
+    try std.testing.expectEqual(@as(usize, 1), r.rec.kept_n);
+    try std.testing.expect(r.rec.kept_media[0].eql(media[0]));
+    try std.testing.expectEqualSlices(u32, &prompt, r.rec.kept_raw[0..r.rec.kept_raw_n]); // the model's ids, not the key
+}
