+/// The broken-pair policy's two bounds (TF_DS_PAIR_BROKEN=exit only), read before anything loads:
+/// TF_DS_PAIR_STALL_MS, a round or prompt chunk busy without progress this long is a break (LaneHost.PairPolicy's
+/// stall_ns: 120000 ms, longer than every rank_wire reply deadline; 0: no stall monitor), and TF_DS_PAIR_DEADLINE_MS,
+/// how long after a break the deadline thread waits for the engine thread before it aborts the collectives
+/// (deadline_ns: 15000 ms; at least 1). Unset: the defaults.
+pub const PairBounds = struct {
+    stall_ns: i96 = api.LaneHost.default_stall_ns,
+    deadline_ns: i96 = api.LaneHost.default_deadline_ns,
+};
+
+pub fn pairBounds(env: *const fn ([:0]const u8) ?[]const u8) !PairBounds {
+    var b: PairBounds = .{};
+    const max_ms: u64 = 24 * 3600 * 1000;
+    if (nonEmpty(env("TF_DS_PAIR_STALL_MS"))) |v| {
+        const ms = std.fmt.parseInt(u64, std.mem.trim(u8, v, " "), 10) catch return error.BadPairBounds;
+        if (ms > max_ms) return error.BadPairBounds;
+        b.stall_ns = @as(i96, ms) * std.time.ns_per_ms;
+    }
+    if (nonEmpty(env("TF_DS_PAIR_DEADLINE_MS"))) |v| {
+        const ms = std.fmt.parseInt(u64, std.mem.trim(u8, v, " "), 10) catch return error.BadPairBounds;
+        if (ms == 0 or ms > max_ms) return error.BadPairBounds;
+        b.deadline_ns = @as(i96, ms) * std.time.ns_per_ms;
+    }
+    return b;
+}
