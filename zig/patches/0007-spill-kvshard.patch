+    try p.ends.waitExit();
+    try std.testing.expectEqual(LaneHost.pair_exit_code, p.ends.code.load(.acquire));
+    try std.testing.expectEqual(@as(u32, 1), p.ends.aborts.load(.acquire));
+    p.host.pairBroken("a second cause", false); // the first cause only
+    p.stop();
