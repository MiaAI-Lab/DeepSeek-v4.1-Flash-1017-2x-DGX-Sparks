+pub fn pairMode(env: *const fn ([:0]const u8) ?[]const u8, spill: bool, sharded: bool) !PairMode {
+    const v = std.mem.trim(u8, nonEmpty(env("TF_DS_PAIR_BROKEN")) orelse return if (spill or sharded) .exit else .degrade, " ");
+    if (std.mem.eql(u8, v, "exit")) return .exit;
+    if (std.mem.eql(u8, v, "degrade")) return .degrade;
+    return error.BadPairBroken;
