+        const sl = decodeSlots(rank, R, K, 256, 32);
+        try testing.expectEqual(fetchBase(rank, R, 0, K) * 256, sl.codes);
+        try testing.expectEqual(fetchBase(rank, R, 0, K) * 32, sl.scales);
