     const room = after.room(model);
     const streams = budget.admit(room, loaded.stream_bytes, o.lanes, o.lanes_fixed) catch |e| {
         problem.* = switch (e) {
@@ -405,6 +413,16 @@ test "this host's /proc/meminfo reads whole and parses (Linux)" {
