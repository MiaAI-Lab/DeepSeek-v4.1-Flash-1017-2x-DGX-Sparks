+        " parameter>\n</" ++ D ++ " invoke>\n</" ++ D ++ " calls>\n<tool_call>{\"name\":\"Read\",\"arguments\":{\"file_path\":\"/etc/hosts\"}}</tool_call>";
+    const whole = wholeMessage(&try bytesRun(a, answer, false));
