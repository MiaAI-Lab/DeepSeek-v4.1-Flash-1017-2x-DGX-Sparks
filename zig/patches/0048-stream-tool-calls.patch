+    for ([_][]const usize{ &.{1}, &.{5}, &.{ 3, 4 } }) |p| {
+        const r = try Read.of(a, &try bytesAsk(a, answer, .{ .cut = true, .pattern = p }));
+        try std.testing.expectEqualStrings("length", r.finish.?);
