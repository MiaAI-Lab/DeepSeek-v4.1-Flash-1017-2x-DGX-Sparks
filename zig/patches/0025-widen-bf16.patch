+/// bf16 -> f32, exact (the loader's .to(torch.float32) of a bf16 tensor: the same bits in the high half, zeros below).
+fn widenBFloat(src: []const u8, out: []u8) void {
+    const n = src.len / 2;
+    for (0..n) |i| {
+        const b = std.mem.readInt(u16, src[2 * i ..][0..2], .little);
+        std.mem.writeInt(u32, out[4 * i ..][0..4], @as(u32, b) << 16, .little);
+    }
+}
+
+test "a bf16 tensor read as f32 widens exactly, as the loader's .to(torch.float32) does" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{ .iterate = true });
+    defer tmp.cleanup();
+    // BF16 [2, 2] (1.0, -2.0, 0.5, 3.0): the high half of each f32's bits, the low half zero
+    const vals = [4]u16{ 0x3F80, 0xC000, 0x3F00, 0x4040 };
+    var body: [8]u8 = undefined;
+    for (vals, 0..) |v, i| std.mem.writeInt(u16, body[2 * i ..][0..2], v, .little);
+    const json = "{\"w.weight\":{\"dtype\":\"BF16\",\"shape\":[2,2],\"data_offsets\":[0,8]}}";
+    var file: std.ArrayList(u8) = .empty;
+    defer file.deinit(a);
+    var len: [8]u8 = undefined;
+    std.mem.writeInt(u64, &len, json.len, .little);
+    try file.appendSlice(a, &len);
+    try file.appendSlice(a, json);
+    try file.appendSlice(a, &body);
+    try tmp.dir.writeFile(io, .{ .sub_path = "model-00001-of-00001.safetensors", .data = file.items });
+    const dir = try std.fs.path.join(a, &.{ ".zig-cache", "tmp", &tmp.sub_path });
+    defer a.free(dir);
+    var sh = try Shards.open(a, io, dir);
+    defer sh.close(io);
+    var out: [16]u8 = undefined;
+    try read(&sh, "w.weight|torch.float32", &out);
+    for (vals, 0..) |v, i| try std.testing.expectEqual(@as(u32, v) << 16, std.mem.readInt(u32, out[4 * i ..][0..4], .little));
+    try std.testing.expectError(error.BadSize, read(&sh, "w.weight|torch.float32", out[0..8]));
+}
