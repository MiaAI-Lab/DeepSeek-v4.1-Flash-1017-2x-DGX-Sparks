@@ -484,6 +491,22 @@ test "pair families: present only with the pair's status, the two counters and t
     }) |line| try std.testing.expect(std.mem.indexOf(u8, body, line) != null);
 }
 
+test "picture families expose tower work and resumed-picture skips" {
+    var out: std.Io.Writer.Allocating = .init(std.testing.allocator);
+    defer out.deinit();
+    try pictureFamilies(&out.writer, .{
+        .vision_tower_runs_total = 3,
+        .pictures_resume_skipped_total = 2,
+        .pictures_rows_sent_total = 1152,
+        .pictures_after_resume_total = 1,
+    });
+    const body = out.written();
+    try std.testing.expect(std.mem.indexOf(u8, body, "tensorfold:vision_tower_runs_total 3\n") != null);
+    try std.testing.expect(std.mem.indexOf(u8, body, "tensorfold:pictures_resume_skipped_total 2\n") != null);
+    try std.testing.expect(std.mem.indexOf(u8, body, "tensorfold:pictures_rows_sent_total 1152\n") != null);
+    try std.testing.expect(std.mem.indexOf(u8, body, "tensorfold:pictures_after_resume_total 1\n") != null);
+}
