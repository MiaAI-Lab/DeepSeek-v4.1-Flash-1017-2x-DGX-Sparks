+++ b/zig/src/core/lanes/picture_stats.zig
@@ -0,0 +1,28 @@
+//! A vision backend's picture counters for /metrics. A backend hands the lane host a `Source`; the host reads it on
+//! its engine thread and publishes a copy for status readers.
+const std = @import("std");
+
+pub const Stats = struct {
+    vision_tower_runs_total: u64 = 0,
+    pictures_resume_skipped_total: u64 = 0,
+    pictures_rows_sent_total: u64 = 0,
+    pictures_after_resume_total: u64 = 0,
+
+    pub const help = .{
+        .vision_tower_runs_total = "Pictures whose embedding rows ran through the vision tower.",
+        .pictures_resume_skipped_total = "Pictures wholly before a resumed prompt pass and already present in its kept state.",
+        .pictures_rows_sent_total = "Picture embedding rows installed on rank 0 and sent to follower ranks.",
+        .pictures_after_resume_total = "Pictures a resumed prompt pass still had to prepare because they straddled or followed its kept state.",
+    };
+};
+
+pub const Source = struct {
+    ctx: *anyopaque,
+    read: *const fn (ctx: *anyopaque, out: *Stats) void,
+};
+
+test "every picture counter has help" {
+    inline for (@typeInfo(Stats).@"struct".field_names) |name| {
+        try std.testing.expect(@field(Stats.help, name).len > 0);
+    }
+}
