From 5d64dab8ff56fbee0c75a20105310fde3e688d38 Mon Sep 17 00:00:00 2001
From: nuk3s <44327449+nuk3s@users.noreply.github.com>
Date: Fri, 30 Oct 2026 02:06:57 +0000
Subject: [PATCH] core: the run loop services parked work between two pieces of
 a prompt pass

With the spill tier on (SPILL_GIB) and a prompt pass in pieces (TF_FILL_CHUNKS), LaneHost keeps `filling` set while
the pass waits for its next piece (the engine's pieces at fbbc971). The run loop asks for parked work's service after
every fillOne (0014), and the service fence (0020, serviceSafe) refuses a service while a pass fills, except from
inside Stream.between. So every loop between two pieces was refused: tensorfold:service_refused went up by one,
the first refusal logged "parked work's service asked for inside a round, a prompt chunk or a CUDA graph capture:
skipped (an engine bug)", and a debug build panicked. Restores, staged writes and deferred retries moved only inside
a piece, from Stream.between, and never during the decode rounds between two pieces.

LaneHost.serviceLoop: while a pass is in pieces, the run loop's service runs only when work is pending, with the
fence's way in open (in_between) and the pass's restore reported first, as Stream.between does. A piece ends in the
state the pass has at Stream.between: dsv41's prefillPart joins its Engram read-ahead and drops the prompt's ids at
a piece's end. With work pending, a piece can now get two services (one from between, one after the piece), each
under the TF_SPILL_LOAD_MS budget.

No switch. Without TF_FILL_CHUNKS, with the spill tier off, or with TF_DS_KV_SHARD=1 (a pass runs whole), nothing
changes.

Test (lane_host_tier_test.zig): a request parks on a restore while another prompt runs in 6 pieces of one chunk
(fill_chunks 1, cut_in 8192). The tier is polled during that pass, service_refused stays 0, and the parked request
then resumes from the restored point with the same tokens. Without the lane_host.zig change the test panics in the
fence.
---
 zig/src/core/lane_host.zig           | 17 +++++++++-
 zig/src/core/lane_host_tier_test.zig | 48 ++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+), 1 deletion(-)

diff --git a/zig/src/core/lane_host.zig b/zig/src/core/lane_host.zig
index a90d26a..a5eaf8d 100644
--- a/zig/src/core/lane_host.zig
+++ b/zig/src/core/lane_host.zig
@@ -958,7 +958,7 @@ pub const LaneHost = struct {
             h.takeCancels();
             while (h.admitOne()) {}
             h.fillOne();
-            if (h.servicing()) h.service(h.tier.service_ns); // restores, staged writes and deferred retries, between rounds and at idle
+            if (h.servicing()) h.serviceLoop(); // restores, staged writes and deferred retries, between rounds and at idle
             if (h.between_err) |e| {
                 h.between_err = null;
                 h.checkFatal(e);
@@ -1177,6 +1177,21 @@ pub const LaneHost = struct {
         h.unlock();
     }
 
+    /// The run loop's service of parked work: between rounds and at idle, and between two pieces of a prompt pass
+    /// (TF_FILL_CHUNKS: `filling` is the job in pieces). A piece ends between two chunks of its pass, in the state the
+    /// pass has at Stream.between (dsv41 joins its Engram read-ahead and drops the prompt's ids at a piece's end, as
+    /// before `between`), so the service runs there as Stream.between runs it: only when work is pending, the pass's
+    /// restore reported first, the fence's way in open for it. Before, every loop while a pass waited for its next
+    /// piece asked for the service and the fence refused it (`service_refused`; a panic in debug builds).
+    fn serviceLoop(h: *LaneHost) void {
+        const job = h.filling orelse return h.service(h.tier.service_ns);
+        if (!h.pending()) return;
+        job.reported(); // (a piece ran: a restore's room may evict the entry its pass resumed)
+        h.in_between = true;
+        defer h.in_between = false;
+        h.service(h.tier.service_ns);
+    }
+
     /// Parked work's service (engine thread): restores progress under one elapsed-time budget shared fairly (each gets
     /// an equal share of what is left, a different one first each time); writes are staged with what remains. Restores
     /// that end wake every request waiting for them; deferred restores whose retry came ask again.
diff --git a/zig/src/core/lane_host_tier_test.zig b/zig/src/core/lane_host_tier_test.zig
index 8f85688..390489f 100644
--- a/zig/src/core/lane_host_tier_test.zig
+++ b/zig/src/core/lane_host_tier_test.zig
@@ -303,6 +303,54 @@ test "restores progress between another request's prompt chunks with the interle
     try b.exact(&t2);
 }
 
+test "restores are serviced between a prompt pass's pieces (TF_FILL_CHUNKS): the service fence lets the run loop in there" {
+    // the fence's refusal is a panic in debug builds (these tests): the run loop asks for the service after each piece
+    const r = try Rig.createWith(.{ .load_ms = 5 }, struct {
+        fn pre(x: *Rig) void {
+            x.core.fill_chunks = 1; // one chunk a piece (TF_FILL_CHUNKS=1); cut_in set: every pass runs in pieces
+            x.core.cut_in = 8192;
+            x.target.prefill_chunks = 6;
+        }
+    }.pre);
+    defer r.destroy();
+    const e = r.host.engine();
+    r.tier.gate.store(false, .release);
+    _ = try r.point(&t2, 8);
+    var b: Box = .{};
+    defer b.deinit();
+    const req: Request = .{ .prompt = &t2, .max_tokens = 6, .history_len = 14 };
+    try e.submit(1, &req, b.sink());
+    try r.until(struct {
+        fn ok(s: api.CacheStats) bool {
+            return s.restore_waits == 1;
+        }
+    }.ok);
+    const Watch = struct {
+        tier: *ft.FakeTier,
+        seen: [6]u64 = @splat(0),
+        fn call(ctx: *anyopaque, s: *lanes.Stream, chunk: usize) void {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            if (s.prompt_len == 12 and chunk < w.seen.len) w.seen[chunk] = w.tier.polled; // (the engine thread's)
+        }
+    };
+    var watch: Watch = .{ .tier = &r.tier };
+    r.target.prefill_hook = Watch.call;
+    r.target.prefill_hook_ctx = &watch;
+    const other = [_]u32{ 8, 6, 7, 5, 3, 0, 9, 2, 1, 4, 4, 4 };
+    var o: Box = .{};
+    defer o.deinit();
+    const oreq: Request = .{ .prompt = &other, .max_tokens = 1 };
+    try e.submit(2, &oreq, o.sink());
+    try std.testing.expectEqual(Reason.length, o.wait());
+    try std.testing.expect(watch.seen[5] > watch.seen[0]); // polled while the pass ran in pieces
+    try std.testing.expectEqual(@as(u64, 0), @atomicLoad(u64, &r.host.service_refused, .monotonic)); // never refused between two pieces
+    r.tier.gate.store(true, .release);
+    try std.testing.expectEqual(Reason.length, b.wait());
+    try std.testing.expectEqual(@as(?u32, 8), b.cached);
+    try b.exact(&t2);
+    try std.testing.expectEqual(@as(u64, 0), @atomicLoad(u64, &r.host.service_refused, .monotonic));
+}
+
 test "shutdown with requests parked on a restore that never ends: they are cancelled, the restore stops once, the tier flushes" {
     const r = try Rig.create(.{ .load_ms = 5 });
     defer r.destroy();
