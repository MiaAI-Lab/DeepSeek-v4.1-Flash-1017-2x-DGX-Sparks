+    try std.testing.expectEqual(Kind.raw_kv, l.smallPlanes()[40].kind);
+    try std.testing.expectEqual(Kind.raw_score, l.smallPlanes()[41].kind);
+    try std.testing.expectEqual(@as(u16, 2), l.smallPlanes()[40].layer);
