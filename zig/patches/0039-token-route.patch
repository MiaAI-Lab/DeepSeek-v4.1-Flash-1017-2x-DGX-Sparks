diff --git a/zig/src/core/lane_host_test.zig b/zig/src/core/lane_host_test.zig
index a8706236..f52f2792 100644
--- a/zig/src/core/lane_host_test.zig
+++ b/zig/src/core/lane_host_test.zig
@@ -507,3 +507,65 @@ test "a short prompt refused for room as it cuts in waits in the queue and then
         try std.testing.expectEqual(@as(usize, 12), order.len);
     }
 }
+
+test "a lane host emits scored when the family leaves logprobs, and none without them" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    try host.start();
+    defer host.stop();
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        done: ?Reason = null,
+        tokens: usize = 0,
+        scored: usize = 0,
+        rounds: usize = 0,
+        round_tokens: usize = 0,
+        mismatch: bool = false,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .tokens => |t| {
+                    b.tokens += t.len;
+                    b.round_tokens = t.len;
+                    b.rounds += 1;
+                },
+                .scored => |s| {
+                    if (s.len != b.round_tokens) b.mismatch = true;
+                    b.scored += s.len;
+                },
+                .finished => |f| b.done = f.reason,
+                else => {},
+            }
+        }
+        fn wait(b: *@This()) void {
+            while (true) {
+                b.mutex.lockUncancelable(std.testing.io);
+                const d = b.done;
+                b.mutex.unlock(std.testing.io);
+                if (d != null) return;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+    const prompt = [_]u32{ 2, 7, 1, 8 };
+    var with_logprobs: Box = .{};
+    var without: Box = .{};
+    const e = host.engine();
+    try e.submit(1, &.{ .prompt = &prompt, .max_tokens = 8, .logprobs = 1 }, .{ .ctx = &with_logprobs, .event = Box.event });
+    try e.submit(2, &.{ .prompt = &prompt, .max_tokens = 8 }, .{ .ctx = &without, .event = Box.event });
+    with_logprobs.wait();
+    without.wait();
+    try std.testing.expect(with_logprobs.rounds > 0);
+    try std.testing.expect(!with_logprobs.mismatch);
+    try std.testing.expectEqual(with_logprobs.tokens, with_logprobs.scored);
+    try std.testing.expectEqual(@as(usize, 0), without.scored);
+}
