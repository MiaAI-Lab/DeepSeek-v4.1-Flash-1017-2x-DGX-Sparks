diff --git a/zig/src/server/tokens_test.zig b/zig/src/server/tokens_test.zig
new file mode 100644
index 00000000..f1201017
--- /dev/null
+++ b/zig/src/server/tokens_test.zig
@@ -0,0 +1,120 @@
+//! T015: /tokenize with messages reports the same history_len and shared_prefixes as the chat route.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json.zig");
+const errors = @import("errors.zig");
+const model_text = @import("model_text.zig");
+const tokens = @import("tokens.zig");
+const Server = @import("server.zig").Server;
+const Value = json.Value;
+
+const TestText = struct {
+    fn text(t: *@This()) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocabSize, .eos_ids = eosIds, .render = render, .template_source = templateSource } };
+    }
+
+    fn encode(_: *anyopaque, a: std.mem.Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const out = try a.alloc(u32, input.len);
+        for (input, out) |byte, *id| id.* = byte;
+        return out;
+    }
+
+    fn decode(_: *anyopaque, a: std.mem.Allocator, ids: []const u32) std.mem.Allocator.Error![]u8 {
+        const decoded = try a.alloc(u8, ids.len);
+        for (ids, decoded) |id, *byte| byte.* = @intCast(id);
+        return decoded;
+    }
+
+    fn tokenId(_: *anyopaque, _: []const u8) ?u32 {
+        return null;
+    }
+
+    fn tokenString(_: *anyopaque, a: std.mem.Allocator, id: u32) std.mem.Allocator.Error![]u8 {
+        return std.fmt.allocPrint(a, "{d}", .{id});
+    }
+
+    fn vocabSize(_: *anyopaque) u32 {
+        return 4096;
+    }
+
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{};
+    }
+
+    fn render(_: *anyopaque, a: std.mem.Allocator, messages: json.Value, options: model_text.RenderOptions, _: *[]const u8) model_text.Error![]u8 {
+        var has_system = false;
+        if (messages == .array) for (messages.array) |m| {
+            const role = m.get("role") orelse continue;
+            if (role == .string and std.mem.eql(u8, role.string, "system")) has_system = true;
+        };
+        if (has_system) {
+            var buf: [3000]u8 = undefined;
+            @memset(&buf, 'x');
+            return a.dupe(u8, &buf);
+        }
+        return a.dupe(u8, if (options.add_generation_prompt) "prompt" else "prom");
+    }
+
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+const FakeEngine = struct {
+    fn engine(e: *@This()) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+
+    fn info(_: *anyopaque) api.Info {
+        return .{};
+    }
+
+    fn submit(_: *anyopaque, _: api.Id, _: *const api.Request, _: api.Sink) api.SubmitError!void {}
+
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+fn body(a: std.mem.Allocator, with_system: bool) !json.Value {
+    const o = try json.newObject(a);
+    const list = try a.alloc(Value, if (with_system) 2 else 1);
+    if (with_system) {
+        const sys = try json.newObject(a);
+        try sys.put(a, "role", .{ .string = "system" });
+        try sys.put(a, "content", .{ .string = "system" });
+        list[0] = .{ .object = sys };
+    }
+    const user = try json.newObject(a);
+    try user.put(a, "role", .{ .string = "user" });
+    try user.put(a, "content", .{ .string = "user" });
+    list[list.len - 1] = .{ .object = user };
+    try o.put(a, "messages", .{ .array = list });
+    return .{ .object = o };
+}
+
+test "/tokenize with messages reports the history length and the shared cuts" {
+    var text: TestText = .{};
+    var engine: FakeEngine = .{};
+    var srv = try Server.init(std.testing.allocator, std.testing.io, engine.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: errors.Cx = .{ .a = arena.allocator() };
+    const r = try tokens.tokenize(srv, &cx, try body(arena.allocator(), true));
+    try std.testing.expectEqual(@as(i64, 2999), r.get("history_len").?.int64().?);
+    try std.testing.expectEqual(@as(usize, 3), r.get("shared_prefixes").?.array.len);
+    const no_system = try tokens.tokenize(srv, &cx, try body(arena.allocator(), false));
+    try std.testing.expectEqual(@as(usize, 0), no_system.get("shared_prefixes").?.array.len);
+}
