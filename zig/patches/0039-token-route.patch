@@ -0,0 +1,162 @@
+//! T005: prompt ids with image placeholders expand through a vision family's prepare, and history_len comes from the request.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json.zig");
+const errors = @import("errors.zig");
+const model_text = @import("model_text.zig");
+const prompt = @import("prompt.zig");
+const chat = @import("chat.zig");
+const Server = @import("server.zig").Server;
+const Cx = errors.Cx;
+const Allocator = std.mem.Allocator;
+
+const TestText = struct {
+    fn text(t: *@This()) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocabSize, .eos_ids = eosIds, .render = render, .template_source = templateSource } };
+    }
+
+    fn encode(_: *anyopaque, a: Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const ids = try a.alloc(u32, input.len);
+        for (input, ids) |byte, *id| id.* = byte;
+        return ids;
+    }
+
+    fn decode(_: *anyopaque, a: Allocator, ids: []const u32) Allocator.Error![]u8 {
+        const decoded = try a.alloc(u8, ids.len);
+        for (ids, decoded) |id, *byte| byte.* = @intCast(id);
+        return decoded;
+    }
+
+    fn tokenId(_: *anyopaque, _: []const u8) ?u32 {
+        return null;
+    }
+
+    fn tokenString(_: *anyopaque, a: Allocator, id: u32) Allocator.Error![]u8 {
+        return std.fmt.allocPrint(a, "{d}", .{id});
+    }
+
+    fn vocabSize(_: *anyopaque) u32 {
+        return 256;
+    }
+
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{};
+    }
+
+    fn render(_: *anyopaque, a: Allocator, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) model_text.Error![]u8 {
+        return a.dupe(u8, "prompt");
+    }
+
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+const Vision = struct {
+    fn vision(v: *@This()) api.Vision {
+        return .{ .ctx = v, .placeholder = "<｜image｜>", .token = 999, .prepare = prepare };
+    }
+
+    fn prepare(_: *anyopaque, a: Allocator, bytes: []const u8, _: *[]const u8) api.Vision.PrepareError!api.Vision.Prepared {
+        return .{ .tokens = 3, .payload = try a.dupe(u8, bytes) };
+    }
+};
+
+const VisionEngine = struct {
+    v: Vision,
+
+    fn engine(e: *@This()) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+
+    fn info(ctx: *anyopaque) api.Info {
+        const e: *VisionEngine = @ptrCast(@alignCast(ctx));
+        return .{ .context_window = 0, .vision = e.v.vision() };
+    }
+
+    fn submit(_: *anyopaque, _: api.Id, _: *const api.Request, _: api.Sink) api.SubmitError!void {}
+
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+fn request(a: Allocator, ids: []const u32, images: []const []const u8, history_len: ?u32) !chat.Input {
+    const f = try json.newObject(a);
+    return .{ .prompt = .{ .ids = ids }, .images = images, .history_len = history_len, .fields = .{ .object = f } };
+}
+
+test "prompt ids with two image placeholders expand each image and keep their positions" {
+    var text: TestText = .{};
+    const vision: Vision = .{};
+    var engine: VisionEngine = .{ .v = vision };
+    var srv = try Server.init(std.testing.allocator, std.testing.io, engine.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    const r = try prompt.prepare(srv, &cx, try request(arena.allocator(), &.{ 10, 999, 11, 999, 12 }, &.{ "a", "b" }, 2), false, null, true);
+    try std.testing.expectEqual(@as(usize, 9), r.ids.len);
+    try std.testing.expectEqualSlices(u32, &.{ 10, 999, 999, 999, 11, 999, 999, 999, 12 }, r.ids);
+    try std.testing.expectEqual(@as(usize, 2), r.images.len);
+    try std.testing.expectEqual(@as(u32, 1), r.images[0].at);
+    try std.testing.expectEqual(@as(u32, 5), r.images[1].at);
+    try std.testing.expectEqual(@as(usize, 4), r.history_len);
+}
+
+test "prompt ids with the wrong number of image placeholders are refused" {
+    var text: TestText = .{};
+    const vision: Vision = .{};
+    var engine: VisionEngine = .{ .v = vision };
+    var srv = try Server.init(std.testing.allocator, std.testing.io, engine.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    // each mismatch on its own: both must be refused, with their own message
+    try std.testing.expectError(error.Refused, prompt.prepare(srv, &cx, try request(arena.allocator(), &.{ 10, 999, 11, 999, 12, 999 }, &.{ "a", "b" }, null), false, null, true));
+    try std.testing.expectEqualStrings("image input: the prompt holds more image placeholders than images", cx.message);
+    cx.message = "";
+    try std.testing.expectError(error.Refused, prompt.prepare(srv, &cx, try request(arena.allocator(), &.{ 10, 999, 11 }, &.{ "a", "b" }, null), false, null, true));
+    try std.testing.expectEqualStrings("image input: the prompt holds fewer image placeholders than images", cx.message);
+}
+
+test "prompt ids' shared_prefixes move past the image spans before them, as history_len does" {
+    var text: TestText = .{};
+    const vision: Vision = .{};
+    var engine: VisionEngine = .{ .v = vision };
+    var srv = try Server.init(std.testing.allocator, std.testing.io, engine.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    var input = try request(arena.allocator(), &.{ 10, 999, 11, 999, 12 }, &.{ "a", "b" }, 2);
+    // a cut before the first picture, one after it, one after both, the end; each picture goes from one id to three
+    input.shared_prefixes = &.{ 1, 2, 4, 5 };
+    const r = try prompt.prepare(srv, &cx, input, false, null, true);
+    try std.testing.expectEqualSlices(u32, &.{ 1, 4, 8, 9 }, r.shared_prefixes);
+    try std.testing.expectEqual(@as(usize, 4), r.history_len);
+    // the caller's cuts are not changed in place
+    try std.testing.expectEqualSlices(u32, &.{ 1, 2, 4, 5 }, input.shared_prefixes);
+}
