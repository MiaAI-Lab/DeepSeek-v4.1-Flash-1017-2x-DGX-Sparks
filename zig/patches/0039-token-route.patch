+}
+
+test "token route validation refuses every field in the contract table" {
+    var text: TestText = .{};
+    var engine: FakeEngine = .{};
+    var srv = try Server.init(std.testing.allocator, std.testing.io, engine.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    try expectReject(srv, a, "[]", null, 400);
+    try expectReject(srv, a, "{}", "token_ids", 400);
+    try expectReject(srv, a, "{\"token_ids\":[]}", "token_ids", 400);
+    try expectReject(srv, a, "{\"token_ids\":[2048]}", "token_ids", 400);
+    try expectReject(srv, a, "{\"token_ids\":[1],\"sampling_params\":{\"n\":2}}", "n", 400);
+    try expectReject(srv, a, "{\"token_ids\":[1],\"output_mode\":\"text\"}", "output_mode", 400);
+    try expectReject(srv, a, "{\"token_ids\":[1],\"features\":{}}", "features", 400);
