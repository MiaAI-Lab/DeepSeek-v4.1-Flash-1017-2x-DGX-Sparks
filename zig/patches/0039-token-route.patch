+test "streaming token reply: a delayed scored event does not lose a round's logprobs" {
+    var text: TestText = .{};
+    var engine: SlowEngine = .{ .rounds = &.{ &.{ 10, 11 }, &.{ 20, 21 } } };
+    defer engine.deinit();
+    var srv = try Server.init(std.testing.allocator, std.testing.io, engine.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const gone: NoGone = .{};
+    const out = try callStream(srv, arena.allocator(), "{\"token_ids\":[1],\"sampling_params\":{\"max_tokens\":100,\"logprobs\":1},\"stream\":true}", gone);
+    var rounds: usize = 0;
+    var lines = std.mem.splitScalar(u8, out, '\n');
+    while (lines.next()) |raw| {
+        const line = std.mem.trim(u8, raw, "\r");
+        if (!std.mem.startsWith(u8, line, "data: ") or std.mem.eql(u8, line[6..], "[DONE]")) continue;
+        const doc = std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), line[6..], .{}) catch continue;
+        const choices = doc.object.get("choices") orelse continue;
+        if (choices.array.items.len == 0) continue;
+        const choice = choices.array.items[0].object;
+        const tids = choice.get("token_ids") orelse continue;
+        const lp = choice.get("logprobs") orelse continue;
+        if (lp == .null) continue;
+        const content = lp.object.get("content").?.array.items;
+        try std.testing.expectEqual(tids.array.items.len, content.len);
+        for (tids.array.items, content) |tid, entry| {
+            try std.testing.expectEqual(tid.integer, entry.object.get("token_id").?.integer);
+        }
+        rounds += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 2), rounds);
+}
