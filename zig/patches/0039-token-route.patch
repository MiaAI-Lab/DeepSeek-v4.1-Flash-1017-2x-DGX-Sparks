diff --git a/zig/tests/server/token_route_smoke.py b/zig/tests/server/token_route_smoke.py
new file mode 100755
index 00000000..0fa8bbde
--- /dev/null
+++ b/zig/tests/server/token_route_smoke.py
@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+"""Smoke checks for POST /inference/v1/generate against a running fake_serve.
+
+Usage: python3 -I zig/tests/server/token_route_smoke.py http://127.0.0.1:PORT
+The server must run with TENSORFOLD_TOKEN_ROUTE=1 and TF_FAKE_TOKENIZER=<tok dir>.
+Each check prints PASS or FAIL; the exit status is 0 only when every check passed.
+"""
+import json
+import os
+import sys
+import urllib.error
+import urllib.request
+
+ARGS = [a for a in sys.argv[1:] if not a.startswith("--")]
+SIN_RUTA = "--sin-ruta" in sys.argv
+BASE = ARGS[0].rstrip("/") if ARGS else "http://127.0.0.1:8080"
+FAILED = 0
+
+
+def check(name, ok, detail=""):
+    global FAILED
+    print(("PASS" if ok else "FAIL") + " " + name + ((": " + detail) if detail else ""))
+    if not ok:
+        FAILED += 1
+
+
+def post(path, body, stream=False):
+    data = json.dumps(body).encode()
+    req = urllib.request.Request(BASE + path, data=data, headers={"Content-Type": "application/json"})
+    try:
+        with urllib.request.urlopen(req, timeout=30) as r:
+            return r.status, r.read().decode("utf-8", "replace")
+    except urllib.error.HTTPError as e:
+        return e.code, e.read().decode("utf-8", "replace")
+
+
+def get(path):
+    try:
+        with urllib.request.urlopen(BASE + path, timeout=30) as r:
+            return r.status, r.read().decode("utf-8", "replace")
+    except urllib.error.HTTPError as e:
+        return e.code, e.read().decode("utf-8", "replace")
+
+
+def record():
+    path = os.environ.get("TF_FAKE_RECORD")
+    if not path:
+        return {}
+    with open(path, "r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+def tokenize(text):
+    status, body = post("/tokenize", {"prompt": text})
+    if status != 200:
+        return None
+    return json.loads(body)["tokens"]
+
+
+def stream_events(body):
+    events = []
+    done = False
+    for line in body.splitlines():
+        if not line.startswith("data: "):
+            continue
+        payload = line[6:]
+        if payload == "[DONE]":
+            done = True
+            continue
+        events.append(json.loads(payload))
+    return events, done
+
+
+def generate(ids, **sampling):
+    body = {"token_ids": ids, "sampling_params": sampling, "stream": True,
+            "stream_options": {"include_usage": True}, "return_token_ids": True}
+    return post("/inference/v1/generate", body)
+
+
+def main():
+    if SIN_RUTA:
+        status, body = post("/inference/v1/generate", {"token_ids": [1], "stream": False})
+        check("sin TENSORFOLD_TOKEN_ROUTE: 404", status == 404, str(status))
+        return 1 if FAILED else 0
+
+    # A first event with usage before any token, then a token event, a final usage event and [DONE].
+    ids = tokenize("@script=rounds3")
+    check("/tokenize returns ids", ids is not None and len(ids) > 0)
+    if ids is None:
+        return 1
+    status, body = generate(ids, max_tokens=100)
+    events, done = stream_events(body)
+    check("stream status 200", status == 200, str(status))
+    check("initial usage event", bool(events) and events[0].get("choices") == [] and "usage" in events[0])
+    token_events = [e for e in events if e.get("choices")]
+    check("one event per engine round", len(token_events) == 2, str(len(token_events)))
+    got = []
+    for e in token_events:
+        got.extend(e["choices"][0]["token_ids"])
+    check("ids in order and no repeats", got == [15, 27, 33, 9, 1], str(got))
+    check("EOS in the last round", token_events and token_events[-1]["choices"][0]["finish_reason"] == "stop")
+    check("prompt_token_ids on the first token event", token_events and token_events[0].get("prompt_token_ids") == ids)
+    check("final event", bool(events) and events[-1].get("choices") == [] and "tensorfold" in events[-1] and events[-1].get("metrics") is None)
+    check("[DONE]", done)
+
+    # stop string in the content.
+    ids = tokenize("@script=stop_text")
+    status, body = generate(ids, max_tokens=100, stop=["STOP"])
+    events, done = stream_events(body)
+    token_events = [e for e in events if e.get("choices")]
+    check("text stop status", status == 200 and done)
+    check("text stop reason", token_events and token_events[-1]["choices"][0].get("stop_reason") == "STOP")
+
+    # max_tokens.
+    ids = tokenize("@script=rounds3")
+    status, body = generate(ids, max_tokens=2)
+    events, done = stream_events(body)
+    token_events = [e for e in events if e.get("choices")]
+    check("length finish", status == 200 and token_events and token_events[-1]["choices"][0].get("finish_reason") == "length")
+
+    # cached tokens from the script.
+    ids = tokenize("@script=cached32")
+    status, body = generate(ids, max_tokens=100)
+    events, done = stream_events(body)
+    check("cached usage", status == 200 and events and events[0]["usage"]["prompt_tokens_details"]["cached_tokens"] == 32)
+
+    # The 400s of the contract, each with its param.
+    cases = [
+        ({"token_ids": []}, "token_ids"),
+        ({"token_ids": [1], "sampling_params": {"n": 2}}, "n"),
+        ({"token_ids": [1], "output_mode": "text"}, "output_mode"),
+        ({"token_ids": [1], "features": {}}, "features"),
+        ({"token_ids": [1], "parse_context": {}}, "parse_context"),
+        ({"token_ids": [1], "kv_transfer_params": {}}, "kv_transfer_params"),
+        ({"token_ids": [1], "ec_transfer_params": {}}, "ec_transfer_params"),
+        ({"token_ids": [1], "cache_salt": "x"}, "cache_salt"),
+        ({"token_ids": [1], "sampling_params": {"logprobs": 1}}, "logprobs"),
+        ({"token_ids": [1], "sampling_params": {"stop": ""}}, "stop"),
+        ({"token_ids": [1], "sampling_params": {"top_k": 0}}, "top_k"),
+        ({"token_ids": [1], "history_len": 2}, "history_len"),
+    ]
+    for body, param in cases:
+        status, reply = post("/inference/v1/generate", dict(body, stream=False))
+        try:
