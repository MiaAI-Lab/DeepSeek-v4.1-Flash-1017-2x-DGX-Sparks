+/// ``fail`` for one field: its name goes into the message (``{s}``) and is the param.
+fn failField(cx: *Reject, comptime message: []const u8, name: []const u8) error{Reject} {
+    const text = std.fmt.allocPrint(cx.a, message, .{name}) catch "invalid request field";
+    return fail(cx, text, name, null);
