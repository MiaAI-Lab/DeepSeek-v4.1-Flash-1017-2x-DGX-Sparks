+const GoneAfter = struct {
+    n: *usize,
+    limit: usize,
+    pub fn check(g: *const @This()) bool {
+        if (g.n.* < g.limit) {
+            g.n.* += 1;
+            return false;
+        }
+        return true;
+    }
+};
