+//! T007: the token route's validation table and one valid request.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json.zig");
+const generate = @import("generate.zig");
+const chat = @import("chat.zig");
+const model_text = @import("model_text.zig");
+const Server = @import("server.zig").Server;
+const NoGone = generate.NoGone;
+const Value = json.Value;
+
+const TestText = struct {
+    fn text(t: *@This()) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocabSize, .eos_ids = eosIds, .render = render, .template_source = templateSource } };
+    }
+
+    fn encode(_: *anyopaque, a: std.mem.Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const out = try a.alloc(u32, input.len);
+        for (input, out) |byte, *id| id.* = byte;
+        return out;
+    }
+
+    fn decode(_: *anyopaque, a: std.mem.Allocator, tokens: []const u32) std.mem.Allocator.Error![]u8 {
+        const decoded = try a.alloc(u8, tokens.len);
+        for (tokens, decoded) |id, *byte| byte.* = @intCast(id);
+        return decoded;
+    }
+
+    fn tokenId(_: *anyopaque, token: []const u8) ?u32 {
+        return if (std.mem.eql(u8, token, "</think>")) 1 else null;
+    }
+
+    fn tokenString(_: *anyopaque, a: std.mem.Allocator, id: u32) std.mem.Allocator.Error![]u8 {
+        return std.fmt.allocPrint(a, "{d}", .{id});
+    }
+
+    fn vocabSize(_: *anyopaque) u32 {
+        return 2048;
+    }
+
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{1};
+    }
+
+    fn render(_: *anyopaque, a: std.mem.Allocator, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) model_text.Error![]u8 {
+        return a.dupe(u8, "prompt");
+    }
+
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+const Vision = struct {
+    fn vision(v: *@This()) api.Vision {
+        return .{ .ctx = v, .placeholder = "<｜image｜>", .token = 999, .prepare = prepare };
+    }
+
+    fn prepare(_: *anyopaque, a: std.mem.Allocator, bytes: []const u8, _: *[]const u8) api.Vision.PrepareError!api.Vision.Prepared {
+        return .{ .tokens = 3, .payload = try a.dupe(u8, bytes) };
+    }
+};
+
+const FakeEngine = struct {
+    v: Vision = .{},
+    rounds: []const []const u32 = &.{},
+    reason: api.Reason = .stop,
+    cached: u32 = 0,
+    context_window: u32 = 65536,
+    cancelled: usize = 0,
+    last: ?api.Request = null,
+    has_vision: bool = true,
+    logprobs: bool = false,
+    top: []const api.TopLogprob = &.{},
+    rank: u32 = 1,
+    logprob: f32 = -0.1,
+
+    fn engine(e: *@This()) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+
+    fn info(ctx: *anyopaque) api.Info {
+        const e: *FakeEngine = @ptrCast(@alignCast(ctx));
+        return .{ .context_window = e.context_window, .vision = if (e.has_vision) e.v.vision() else null, .logprobs = e.logprobs };
+    }
+
+    fn submit(ctx: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *FakeEngine = @ptrCast(@alignCast(ctx));
+        e.last = request.*;
+        sink.event(sink.ctx, id, &.{ .prefilled = e.cached });
+        for (e.rounds) |round| {
+            sink.event(sink.ctx, id, &.{ .tokens = round });
+            if (request.logprobs > 0) {
+                var scored: [64]api.Logprob = undefined;
+                const n = @min(round.len, scored.len);
+                var top_buf: [8]api.TopLogprob = undefined;
+                const tn = @min(e.top.len, top_buf.len);
+                @memcpy(top_buf[0..tn], e.top[0..tn]);
+                for (0..n) |i| scored[i] = .{ .token = round[i], .logprob = e.logprob, .rank = e.rank, .top = top_buf[0..tn] };
+                sink.event(sink.ctx, id, &.{ .scored = scored[0..n] });
+                // the sink must copy: the engine reuses this buffer and trashes it after the event
+                @memset(top_buf[0..tn], .{ .id = 999, .logprob = 123, .rank = 9 });
+            }
+        }
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = e.reason } });
+    }
+
+    fn cancel(ctx: *anyopaque, _: api.Id) void {
+        const e: *FakeEngine = @ptrCast(@alignCast(ctx));
+        e.cancelled += 1;
+    }
+
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+/// Emits tokens first and its scored event after a delay, from its own thread: the mailbox must not publish the
+/// chunk until the round's scored event is there.
+const SlowEngine = struct {
+    rounds: []const []const u32 = &.{},
+    delay_ms: i64 = 60,
+    /// Silence before the first round, as a cold prefill.
+    first_delay_ms: i64 = 0,
+    thread: ?std.Thread = null,
+
+    const Args = struct { e: *SlowEngine, id: api.Id, logprobs: u8, sink: api.Sink };
+
+    fn engine(e: *@This()) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 65536, .logprobs = true };
+    }
+
+    fn submit(ctx: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *SlowEngine = @ptrCast(@alignCast(ctx));
+        e.thread = std.Thread.spawn(.{}, run, .{Args{ .e = e, .id = id, .logprobs = request.logprobs, .sink = sink }}) catch return error.Busy;
+    }
+
+    fn run(args: Args) void {
+        const sink = args.sink;
+        if (args.e.first_delay_ms > 0) std.Io.sleep(std.testing.io, .fromMilliseconds(args.e.first_delay_ms), .awake) catch {};
+        sink.event(sink.ctx, args.id, &.{ .prefilled = 0 });
+        for (args.e.rounds) |round| {
+            sink.event(sink.ctx, args.id, &.{ .tokens = round });
+            std.Io.sleep(std.testing.io, .fromMilliseconds(args.e.delay_ms), .awake) catch {};
+            if (args.logprobs > 0) {
+                var scored: [64]api.Logprob = undefined;
+                const n = @min(round.len, scored.len);
+                for (0..n) |i| scored[i] = .{ .token = round[i], .logprob = -0.1, .rank = 1, .top = &.{} };
+                sink.event(sink.ctx, args.id, &.{ .scored = scored[0..n] });
+            }
+        }
+        sink.event(sink.ctx, args.id, &.{ .finished = .{ .reason = .stop } });
+    }
+
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+
+    fn deinit(e: *@This()) void {
+        if (e.thread) |t| t.join();
+        e.thread = null;
+    }
+};
+
+fn parseBody(a: std.mem.Allocator, text: []const u8) !json.Value {
+    return switch (try json.parse(a, text)) {
+        .ok => |v| v,
+        .err => |m| {
+            _ = m;
+            return error.BadJson;
+        },
+    };
+}
+
+fn expectReject(srv: *Server, a: std.mem.Allocator, body: []const u8, param: ?[]const u8, status: u16) !void {
+    const raw = try parseBody(a, body);
+    var reject: generate.Reject = .{ .a = a, .message = "" };
+    var cx: @import("errors.zig").Cx = .{ .a = a };
+    const got = generate.parse(srv, &cx, &reject, raw) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.Refused => {
+            try std.testing.expectEqual(status, reject.status);
+            try std.testing.expectEqualStrings(param orelse "", reject.param orelse "");
+            return;
+        },
+        error.Reject => {
+            try std.testing.expectEqual(status, reject.status);
+            try std.testing.expectEqualStrings(param orelse "", reject.param orelse "");
+            return;
+        },
+    };
+    _ = got;
+    return error.NotRejected;
+}
+
+fn rejectMessage(srv: *Server, a: std.mem.Allocator, body: []const u8) ![]const u8 {
+    const raw = try parseBody(a, body);
+    var reject: generate.Reject = .{ .a = a, .message = "" };
+    var cx: @import("errors.zig").Cx = .{ .a = a };
+    _ = generate.parse(srv, &cx, &reject, raw) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.Refused, error.Reject => return reject.message,
+    };
+    return error.NotRejected;
+}
+
+test "token route refusals name the field in the message, not a {s} placeholder" {
+    var text: TestText = .{};
+    var engine: FakeEngine = .{};
+    var srv = try Server.init(std.testing.allocator, std.testing.io, engine.engine(), text.text(), .{
+        .served_name = "test-model",
+        .model_ids = &.{"test-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
