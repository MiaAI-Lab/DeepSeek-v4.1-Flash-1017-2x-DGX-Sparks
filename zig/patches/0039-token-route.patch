+    const out = try streamWithSilence(arena.allocator(), 50);
+    const ping = std.mem.indexOf(u8, out, ": ping\n\n") orelse return error.NoPing;
+    const round = std.mem.indexOf(u8, out, "\"token_ids\": [10") orelse return error.NoRound;
+    try std.testing.expect(ping < round);
+    try std.testing.expect(std.mem.indexOf(u8, out, "data: [DONE]") != null);
+    // Control: under the default threshold the same silence sends none.
+    const quiet = try streamWithSilence(arena.allocator(), 25_000);
+    try std.testing.expect(std.mem.indexOf(u8, quiet, ": ping") == null);
+    try std.testing.expect(std.mem.indexOf(u8, quiet, "data: [DONE]") != null);
+}
