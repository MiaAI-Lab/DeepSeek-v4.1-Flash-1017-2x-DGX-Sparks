+fn callPost(srv: *Server, a: std.mem.Allocator, body: []const u8, gone: anytype) ![]const u8 {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const file = try tmp.dir.createFile(std.testing.io, "req", .{ .read = true, .truncate = true });
+    defer file.close(std.testing.io);
+    try file.writeStreamingAll(std.testing.io, body);
+    _ = std.posix.system.lseek(file.handle, 0, 0);
+    var conn = try @import("http_conn.zig").Conn.init(a, file.handle, "");
+    defer conn.deinit();
+    conn.method = "POST";
+    conn.path = "/inference/v1/generate";
+    conn.version = "HTTP/1.1";
+    var len: [24]u8 = undefined;
+    var headers = [_]@import("http_conn.zig").Header{.{ .name = "Content-Length", .value = try std.fmt.bufPrint(&len, "{d}", .{body.len}) }};
+    conn.headers = &headers;
+    generate.postWith(srv, &conn, a, gone);
+    _ = std.posix.system.lseek(file.handle, 0, 0);
+    var out: std.ArrayList(u8) = .empty;
+    var buf: [8192]u8 = undefined;
+    while (true) {
+        const n = std.posix.read(file.handle, &buf) catch 0;
+        if (n == 0) break;
+        try out.appendSlice(a, buf[0..n]);
+    }
+    return out.items;
+}
