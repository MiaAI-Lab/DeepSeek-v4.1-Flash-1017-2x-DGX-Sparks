+    const n = isInt(v) orelse return failField(cx, "{s} must be an integer", name);
+    return n;
+}
+
+/// The request body's token ids, checked against the vocabulary.
+fn tokenIds(srv: *Server, cx: *Reject, body: Value) ![]const u32 {
+    const raw = body.get("token_ids") orelse return fail(cx, "token_ids is required", "token_ids", null);
+    if (raw != .array) return fail(cx, "token_ids must be a list of token ids", "token_ids", null);
+    if (raw.array.len == 0) return fail(cx, "token_ids must not be empty", "token_ids", null);
+    const vocab = srv.text.vocabSize();
+    const out = try cx.a.alloc(u32, raw.array.len);
+    for (raw.array, out) |v, *slot| {
+        const n = isInt(v) orelse return fail(cx, "token_ids must be a list of token ids", "token_ids", null);
+        if (n < 0 or n >= vocab) return fail(cx, "token_ids has an id outside the vocabulary", "token_ids", null);
+        slot.* = @intCast(n);
+    }
+    return out;
+}
+
+/// A data URL's payload (the bytes after its comma), or a refusal.
+fn imageBytes(cx: *Reject, url: []const u8) ![]const u8 {
+    if (!std.mem.startsWith(u8, url, "data:")) return fail(cx, "content_parts url must be a data: URL", "content_parts", null);
+    const comma = std.mem.indexOfScalar(u8, url, ',') orelse return fail(cx, "content_parts url must be a data: URL", "content_parts", null);
+    if (!std.mem.endsWith(u8, url[0..comma], ";base64")) return fail(cx, "content_parts url must be base64", "content_parts", null);
+    const encoded = url[comma + 1 ..];
+    const size = std.base64.standard.Decoder.calcSizeUpperBound(encoded.len) catch return fail(cx, "content_parts url is not valid base64", "content_parts", null);
+    var buf = try cx.a.alloc(u8, size);
+    std.base64.standard.Decoder.decode(buf, encoded) catch return fail(cx, "content_parts url is not valid base64", "content_parts", null);
+    var pad: usize = 0;
+    for (encoded) |ch| {
+        if (ch == '=') pad += 1;
+    }
+    return buf[0 .. size - pad];
+}
+
+pub const Parsed = struct {
+    request_id: []const u8,
+    model: []const u8,
+    token_ids: []const u32,
+    sampling: Value,
+    max_tokens: ?i64,
+    stream: bool,
+    include_usage: bool,
+    continuous_usage_stats: bool,
+    return_token_ids: bool,
+    images: []const []const u8,
+    history_len: ?u32,
+    shared_prefixes: []const u32,
+    stop_token_ids: []const u32,
+    thinking: ?bool,
+    logprobs: ?i64,
+};
+
+pub fn parse(srv: *Server, cx: *errors.Cx, reject: *Reject, body: Value) !Parsed {
+    if (body != .object) return fail(reject, "the request body must be a JSON object", null, null);
+    const raw_tids = body.get("token_ids") orelse return fail(reject, "token_ids is required", "token_ids", null);
+    _ = raw_tids;
+    const tids = try tokenIds(srv, reject, body);
+
+    var sampling = body.get("sampling_params") orelse Value.null;
+    if (sampling == .null) sampling = .{ .object = try json.newObject(cx.a) };
+    if (sampling != .object) return fail(reject, "sampling_params must be a JSON object", "sampling_params", null);
+    _ = fields.stopOptions(cx, sampling) catch |e| switch (e) {
+        error.OutOfMemory => return e,
+        error.Refused => return fail(reject, cx.message, "stop", null),
+    };
+    const parsed_sampling = fields.parseNumbers(cx, sampling) catch |e| switch (e) {
+        error.OutOfMemory => return e,
+        error.Refused => return fail(reject, cx.message, "sampling_params", null),
+    };
+
+    const n = if (sampling.get("n")) |v| blk: {
+        const x = isInt(v) orelse return fail(reject, "n must be 1", "n", null);
+        if (x != 1) return fail(reject, "n must be 1; multiple choices are not supported", "n", null);
+        break :blk x;
+    } else 1;
+    _ = n;
+    if (body.get("output_mode")) |v| {
+        if (v != .string or !std.mem.eql(u8, v.string, "tokens")) return fail(reject, "output_mode must be \"tokens\"", "output_mode", null);
+    }
+    for ([_][]const u8{ "features", "parse_context", "kv_transfer_params", "ec_transfer_params", "cache_salt" }) |name| {
+        if (body.get(name)) |v| if (v != .null) return failField(reject, "{s} is not supported by this endpoint", name);
+    }
+    for ([_][]const u8{ "repetition_penalty", "presence_penalty", "frequency_penalty", "min_tokens", "logit_bias", "bad_words", "allowed_token_ids", "prompt_logprobs" }) |name| {
+        if (sampling.get(name)) |v| {
+            const neutral = if (v == .null) true else if (v == .int) blk: {
+                const t = v.int;
+                break :blk if (std.mem.eql(u8, name, "repetition_penalty")) std.mem.eql(u8, t, "1") else std.mem.eql(u8, t, "0");
+            } else if (v == .float) blk: {
+                const f = v.float;
+                break :blk if (std.mem.eql(u8, name, "repetition_penalty")) f == 1 else f == 0;
+            } else if (v == .array) v.array.len == 0 else if (v == .object) v.object.count() == 0 else false;
+            if (!neutral) return failField(reject, "{s} is not supported by this model", name);
+        }
+    }
+    const logprobs: ?i64 = if (sampling.get("logprobs")) |v| blk: {
+        if (v == .null) break :blk null;
+        const x = isInt(v) orelse return fail(reject, "logprobs must be an integer between 0 and 21, or null", "logprobs", null);
+        if (x < 0 or x > 21) return fail(reject, "logprobs must be an integer between 0 and 21, or null", "logprobs", null);
+        break :blk x;
+    } else null;
+    if (logprobs != null and logprobs.? > 0 and !srv.info.logprobs) return fail(reject, "logprobs are not supported by this model or backend", "logprobs", null);
+    if (sampling.get("top_k")) |v| if (v != .null) {
+        const x = isInt(v) orelse return fail(reject, "top_k must be an integer", "top_k", null);
+        if (x <= 0 or x > 56) return fail(reject, "top_k must be between 1 and 56", "top_k", null);
+    };
+    const max_tokens: ?i64 = if (sampling.get("max_tokens")) |v| blk: {
+        if (v == .null) break :blk null;
+        const x = isInt(v) orelse return fail(reject, "max_tokens must be a positive integer", "max_tokens", null);
+        if (x < 1) return fail(reject, "max_tokens must be a positive integer", "max_tokens", null);
+        break :blk x;
+    } else null;
+
+    const stream = flag(reject, body, "stream") catch |e| return e;
+    var include_usage = false;
+    var continuous_usage_stats = false;
+    if (body.get("stream_options")) |v| {
+        if (v != .object) return fail(reject, "stream_options must be a JSON object", "stream_options", null);
+        if (v.get("include_usage")) |x| {
+            if (x != .bool) return fail(reject, "stream_options.include_usage must be a boolean", "stream_options", null);
+            include_usage = x.bool;
+        }
+        if (v.get("continuous_usage_stats")) |x| {
+            if (x != .bool) return fail(reject, "stream_options.continuous_usage_stats must be a boolean", "stream_options", null);
+            continuous_usage_stats = x.bool;
+        }
+    }
+    const return_token_ids = flag(reject, body, "return_token_ids") catch |e| return e;
+    if (body.get("request_id")) |v| if (v != .string) return fail(reject, "request_id must be a string", "request_id", null);
+    const model = if (body.get("model")) |v| blk: {
+        if (v != .string) return fail(reject, "model must be a string", "model", null);
+        var known_model = false;
+        for (srv.config.model_ids) |known| if (std.mem.eql(u8, known, v.string)) {
+            known_model = true;
+            break;
+        };
+        if (!known_model) {
+            reject.status = 404;
+            reject.typ = "NotFoundError";
+            reject.message = try std.fmt.allocPrint(cx.a, "The model `{s}` does not exist.", .{v.string});
+            return error.Reject;
+        }
+        break :blk v.string;
+    } else srv.config.served_name;
+
+    var images: []const []const u8 = &.{};
+    var marker_count: usize = 0;
+    if (srv.info.vision) |vision| for (tids) |t| if (t == vision.token) {
+        marker_count += 1;
+    };
+    if (body.get("content_parts")) |v| {
+        if (v != .array) return fail(reject, "content_parts must be a list", "content_parts", null);
+        if (srv.info.vision == null) return fail(reject, "this server accepts text only; image, audio and video inputs are unsupported", "content_parts", null);
+        if (v.array.len != marker_count) return fail(reject, if (v.array.len > marker_count) "image input: the prompt holds fewer image placeholders than images" else "image input: the prompt holds more image placeholders than images", "content_parts", null);
+        const list = try cx.a.alloc([]const u8, v.array.len);
+        for (v.array, list) |part, *slot| {
+            if (part != .object) return fail(reject, "content_parts entries must be objects", "content_parts", null);
+            if (!part.typeIs("image_url")) return fail(reject, "content_parts entries must be image_url parts", "content_parts", null);
+            const url = part.strField("url") orelse return fail(reject, "content_parts entries need a url", "content_parts", null);
+            slot.* = try imageBytes(reject, url);
+        }
+        images = list;
+    } else if (marker_count > 0) return fail(reject, "image input: the prompt holds more image placeholders than images", "content_parts", null);
+
+    if (body.get("stop_token_ids")) |_| return fail(reject, "stop_token_ids belongs in sampling_params", "stop_token_ids", null);
+    var stop_ids: []const u32 = &.{};
+    if (sampling.get("stop_token_ids")) |v| {
+        if (v != .array) return fail(reject, "stop_token_ids must be a list of token ids", "stop_token_ids", null);
+        const vocab = srv.text.vocabSize();
+        const list = try cx.a.alloc(u32, v.array.len);
+        for (v.array, list) |x, *slot| {
+            const sid = isInt(x) orelse return fail(reject, "stop_token_ids must be a list of token ids", "stop_token_ids", null);
+            if (sid < 0 or sid >= vocab) return fail(reject, "stop_token_ids has an id outside the vocabulary", "stop_token_ids", null);
+            slot.* = @intCast(sid);
+        }
+        stop_ids = list;
+    }
+    var history_len: ?u32 = null;
+    if (body.get("history_len")) |v| {
+        const x = isInt(v) orelse return fail(reject, "history_len must be an integer", "history_len", null);
+        if (x < 0 or x > tids.len) return fail(reject, "history_len must be at most the length of token_ids", "history_len", null);
+        history_len = @intCast(x);
+    }
+    var shared: []const u32 = &.{};
+    if (body.get("shared_prefixes")) |v| {
+        if (v != .array) return fail(reject, "shared_prefixes must be a list of token ids", "shared_prefixes", null);
+        const list = try cx.a.alloc(u32, v.array.len);
+        var prev_cut: i64 = -1;
+        for (v.array, list) |x, *slot| {
+            const cut = isInt(x) orelse return fail(reject, "shared_prefixes must be a list of token ids", "shared_prefixes", null);
+            if (cut < 512 or cut >= tids.len or cut <= prev_cut) return fail(reject, "shared_prefixes must be ascending cuts of at least 512 and below the prompt", "shared_prefixes", null);
+            prev_cut = cut;
+            slot.* = @intCast(cut);
+        }
+        shared = list;
+    }
+    var thinking: ?bool = null;
+    if (body.get("thinking")) |v| {
+        if (v != .bool) return fail(reject, "thinking must be a boolean", "thinking", null);
+        thinking = v.bool;
+    }
+    if (body.get("thinking_budget")) |v| if (v != .null) {
+        const x = isInt(v) orelse return fail(reject, "thinking_budget must be an integer", "thinking_budget", null);
+        if (x < 0) return fail(reject, "thinking_budget must not be negative", "thinking_budget", null);
+        try parsed_sampling.object.put(cx.a, "thinking_budget", try json.intValue(cx.a, x));
+    };
+    if (body.get("draft")) |v| {
+        if (v != .bool) return fail(reject, "draft must be a boolean", "draft", null);
+        try parsed_sampling.object.put(cx.a, "draft", v);
+    }
+    if (body.get("priority")) |v| switch (v) {
+        .null, .int, .float => {},
+        .string => |s| {
+            if (!std.mem.eql(u8, s, "background")) return fail(reject, "priority must be \"background\"", "priority", null);
+            try parsed_sampling.object.put(cx.a, "priority", v);
+        },
+        else => return fail(reject, "priority must be \"background\"", "priority", null),
+    };
+    if (body.get("reasoning_ended")) |v| _ = v;
+    if (body.get("reasoning_parser_kwargs")) |v| _ = v;
+
+    const rid = if (body.get("request_id")) |v| v.string else blk: {
+        var raw: [16]u8 = undefined;
+        srv.io.random(&raw);
+        const hex = std.fmt.bytesToHex(raw, .lower);
+        break :blk try std.fmt.allocPrint(cx.a, "gen-{s}", .{&hex});
+    };
+    return .{
+        .request_id = rid,
+        .model = model,
+        .token_ids = tids,
+        .sampling = parsed_sampling,
+        .max_tokens = max_tokens,
+        .stream = stream,
+        .include_usage = include_usage,
+        .continuous_usage_stats = continuous_usage_stats,
+        .return_token_ids = return_token_ids,
+        .images = images,
+        .history_len = history_len,
+        .shared_prefixes = shared,
+        .stop_token_ids = stop_ids,
+        .thinking = thinking,
+        .logprobs = logprobs,
+    };
+}
+
+fn sendError(conn: *Conn, a: Allocator, e: Reject) void {
+    const o = json.newObject(a) catch return;
+    o.put(a, "message", .{ .string = e.message }) catch return;
+    o.put(a, "type", .{ .string = e.typ }) catch return;
+    o.put(a, "param", if (e.param) |p| .{ .string = p } else .null) catch return;
+    if (e.code) |c| o.put(a, "code", .{ .string = c }) catch return;
+    const wrapped = json.newObject(a) catch return;
+    wrapped.put(a, "error", .{ .object = o }) catch return;
+    sendValue(conn, a, e.status, .{ .object = wrapped });
+}
+
+pub const NoGone = struct {
+    pub fn check(_: *const @This()) bool {
+        return false;
+    }
+};
+
+/// A failed allocation before any reply went out: the client gets a 500 (best effort, it allocates too), not a closed
+/// connection.
+fn outOfMemory(conn: *Conn, a: Allocator) []const u8 {
+    _ = a;
+    // a constant body: building one could fail the same way
+    conn.sendJson(500, "{\"error\": {\"message\": \"out of memory\", \"type\": \"server_error\", \"param\": null, \"code\": null}}");
+    return "failed";
+}
+
+fn sendValue(conn: *Conn, a: Allocator, code: u16, payload: Value) void {
+    const body = json.stringify(a, payload, .{}) catch return;
+    conn.sendJson(code, body);
+}
+
+fn usageObject(a: Allocator, prompt: usize, completion: usize, cached: u32) !Value {
+    const o = try json.newObject(a);
+    try o.put(a, "prompt_tokens", try json.intValue(a, prompt));
+    try o.put(a, "completion_tokens", try json.intValue(a, completion));
+    try o.put(a, "total_tokens", try json.intValue(a, prompt + completion));
+    const details = try json.newObject(a);
+    try details.put(a, "cached_tokens", try json.intValue(a, cached));
+    try o.put(a, "prompt_tokens_details", .{ .object = details });
+    return .{ .object = o };
+}
+
+fn tokenIdsValue(a: Allocator, ids: []const u32) !Value {
+    const list = try a.alloc(Value, ids.len);
+    for (ids, list) |t, *slot| slot.* = try json.intValue(a, t);
+    return .{ .array = list };
+}
+
+fn tensorfoldObject(a: Allocator, reply: chat.TokenReply) !Value {
+    const o = try json.copyObject(a, reply.runtime.object);
+    const spec = reply.speculative.object;
+    if (spec.get("rounds")) |v| try o.put(a, "rounds", v);
+    if (spec.get("drafted")) |v| try o.put(a, "drafted", v);
+    if (spec.get("accepted")) |v| try o.put(a, "accepted", v);
+    return .{ .object = o };
+}
+
+/// A rank, or null when the logprob was NaN (rank 0, as the data model asks the route to write it).
+fn rankValue(a: Allocator, rank: u32) !Value {
+    return if (rank == 0) .null else try json.intValue(a, rank);
+}
+
+fn logprobsValue(a: Allocator, scored: []const api.Logprob) !Value {
+    const content = try a.alloc(Value, scored.len);
+    for (scored, 0..) |lp, i| {
+        const o = try json.newObject(a);
+        try o.put(a, "token_id", try json.intValue(a, lp.token));
+        try o.put(a, "logprob", .{ .float = lp.logprob });
+        try o.put(a, "rank", try rankValue(a, lp.rank));
+        const ntop = if (lp.top.len <= 64) lp.top.len else 0;
+        const top = try a.alloc(Value, ntop);
+        for (lp.top[0..ntop], 0..) |t, j| {
+            const e = try json.newObject(a);
+            try e.put(a, "token_id", try json.intValue(a, t.id));
+            try e.put(a, "logprob", .{ .float = t.logprob });
+            // the chosen is first and carries its own rank; each alternative carries its position in the same order
+            try e.put(a, "rank", try rankValue(a, if (j == 0) lp.rank else t.rank));
+            top[j] = .{ .object = e };
+        }
+        try o.put(a, "top_logprobs", .{ .array = top });
+        content[i] = .{ .object = o };
+    }
+    const o = try json.newObject(a);
+    try o.put(a, "content", .{ .array = content });
+    return .{ .object = o };
+}
+
+fn stopReasonValue(a: Allocator, stop: ?chat.TokenStop) !Value {
+    const s = stop orelse return .null;
+    return switch (s) {
+        .eos => .null,
+        .token => |t| try json.intValue(a, t),
+        .text => |t| .{ .string = t },
+    };
+}
+
+pub fn wholeReply(srv: *Server, conn: *Conn, a: Allocator, req: Parsed, gone: anytype) ![]const u8 {
+    var cx: errors.Cx = .{ .a = a };
+    const input: chat.Input = .{
+        .prompt = .{ .ids = req.token_ids },
+        .fields = req.sampling,
+        .max_tokens = req.max_tokens,
+        .token_ids = true,
+        .stop_token_ids = req.stop_token_ids,
+        .history_len = req.history_len,
+        .shared_prefixes = req.shared_prefixes,
+        .thinking = req.thinking,
+        .logprobs = @intCast(std.math.clamp(req.logprobs orelse 0, 0, 21)),
+        .images = req.images,
+    };
+    const prepared = chat.prepare(srv, &cx, input, gone) catch |e| {
+        if (e == error.OutOfMemory) return outOfMemory(conn, a);
+        if (e == error.Cancelled) return "cancelled";
+        sendError(conn, a, .{ .a = a, .status = cx.status(), .message = cx.message, .param = if (cx.kind == .context_length) "token_ids" else null, .code = if (cx.kind == .context_length) "context_length_exceeded" else null });
+        return "refused";
+    };
+    const reply = chat.generateTokens(srv, &cx, prepared, null, gone) catch |e| {
+        if (e == error.OutOfMemory) return outOfMemory(conn, a);
+        sendError(conn, a, .{ .a = a, .status = cx.status(), .message = cx.message, .param = null, .code = null });
+        return if (e == error.Cancelled) "cancelled" else "failed";
+    };
+    const o = try json.newObject(a);
+    try o.put(a, "request_id", .{ .string = req.request_id });
+    try o.put(a, "model", .{ .string = req.model });
+    try o.put(a, "created", try json.intValue(a, std.Io.Clock.real.now(srv.io).toSeconds()));
+    try o.put(a, "output_mode", .{ .string = "tokens" });
+    const choice = try json.newObject(a);
+    try choice.put(a, "index", try json.intValue(a, 0));
+    try choice.put(a, "finish_reason", .{ .string = reply.finish_reason });
+    try choice.put(a, "stop_reason", try stopReasonValue(a, reply.stop_reason));
+    try choice.put(a, "token_ids", try tokenIdsValue(a, reply.ids));
+    const lp_json: Value = if (req.logprobs) |n| if (n > 0) blk: {
+        break :blk logprobsValue(a, reply.scored) catch return outOfMemory(conn, a);
+    } else .null else .null;
+    try choice.put(a, "logprobs", lp_json);
+    try choice.put(a, "routed_experts", .null);
+    try choice.put(a, "sampling_mask", .null);
+    try choice.put(a, "weight_versions", .null);
+    const choices = try a.alloc(Value, 1);
+    choices[0] = .{ .object = choice };
+    try o.put(a, "choices", .{ .array = choices });
+    try o.put(a, "usage", try usageObject(a, reply.prompt_tokens, reply.completion_tokens, @intCast(reply.cached_tokens)));
+    try o.put(a, "prompt_logprobs", .null);
+    try o.put(a, "prompt_token_ids", if (req.return_token_ids) try tokenIdsValue(a, prepared.request.prompt) else .null);
+    try o.put(a, "mm_placeholders", .null);
+    try o.put(a, "metrics", .null);
+    try o.put(a, "tensorfold", try tensorfoldObject(a, reply));
+    // a reply that cannot be serialized is an allocation failure like any other: wholeReply's caller sends the 500
+    const body = try json.stringify(a, .{ .object = o }, .{});
+    conn.sendJson(200, body);
+    return "ok";
+}
+
+/// The stream's writer: the initial usage, a data line per round, the final usage and [DONE].
+const Stream = struct {
+    conn: *Conn,
+    a: Allocator,
+    request_id: []const u8,
+    prompt_tokens: usize,
+    include_usage: bool,
+    continuous: bool,
+    return_token_ids: bool,
+    logprobs: bool = false,
+    prompt_token_ids: []const u32,
+    sent: usize = 0,
+    pending_tokens: ?[]const u32 = null,
+    pending_finish: ?[]const u8 = null,
+    pending_stop: ?chat.TokenStop = null,
+    tokens_sent: bool = false,
+    failed: bool = false,
+    cached: u32 = 0,
+
+    fn sink(s: *Stream) chat.TokenSink {
+        return .{ .ctx = s, .call = call, .ready = ready, .scored = scored, .ping = ping, .cached = setCached };
+    }
+
+    /// The prompt's cached tokens, once the engine has reported them: the rounds' continuous usage carries them.
+    fn setCached(ctx: *anyopaque, cached: u32) void {
+        const s: *Stream = @ptrCast(@alignCast(ctx));
+        s.cached = cached;
+    }
+
+    /// An SSE comment, as the text routes send: a client or proxy sees bytes during a long cold prefill.
+    fn ping(ctx: *anyopaque) error{Closed}!void {
+        const s: *Stream = @ptrCast(@alignCast(ctx));
+        if (s.failed) return;
+        return sse.comment(s.conn, "ping");
+    }
+
+    fn scored(ctx: *anyopaque, logprobs: []const api.Logprob) error{Closed}!void {
+        const s: *Stream = @ptrCast(@alignCast(ctx));
+        if (s.failed) return;
+        const tokens = s.pending_tokens orelse return;
+        s.pending_tokens = null;
+        return s.writeRound(tokens, s.pending_finish, s.pending_stop, logprobs);
+    }
+
+    fn ready(ctx: *anyopaque, cached: u32) error{Closed}!void {
+        const s: *Stream = @ptrCast(@alignCast(ctx));
+        if (!s.include_usage) return;
+        const o = json.newObject(s.a) catch return error.Closed;
+        o.put(s.a, "request_id", .{ .string = s.request_id }) catch return error.Closed;
+        o.put(s.a, "output_mode", .{ .string = "tokens" }) catch return error.Closed;
+        const choices = s.a.alloc(Value, 0) catch return error.Closed;
+        o.put(s.a, "choices", .{ .array = choices }) catch return error.Closed;
+        o.put(s.a, "usage", usageObject(s.a, s.prompt_tokens, 0, cached) catch return error.Closed) catch return error.Closed;
+        return sse.data(s.conn, s.a, .{ .object = o });
+    }
+
+    fn call(ctx: *anyopaque, tokens: []const u32, finish_reason: ?[]const u8, stop_reason: ?chat.TokenStop) error{Closed}!void {
+        const s: *Stream = @ptrCast(@alignCast(ctx));
+        if (s.failed) return;
+        if (s.logprobs and tokens.len > 0) {
+            s.pending_tokens = s.a.dupe(u32, tokens) catch return error.Closed;
+            s.pending_finish = finish_reason;
+            s.pending_stop = stop_reason;
+            return;
+        }
+        return s.writeRound(tokens, finish_reason, stop_reason, null);
+    }
+
+    fn writeRound(s: *Stream, tokens: []const u32, finish_reason: ?[]const u8, stop_reason: ?chat.TokenStop, logprobs: ?[]const api.Logprob) error{Closed}!void {
+        const o = json.newObject(s.a) catch return error.Closed;
+        o.put(s.a, "request_id", .{ .string = s.request_id }) catch return error.Closed;
+        o.put(s.a, "output_mode", .{ .string = "tokens" }) catch return error.Closed;
+        const choice = json.newObject(s.a) catch return error.Closed;
+        choice.put(s.a, "index", json.intValue(s.a, 0) catch return error.Closed) catch return error.Closed;
+        choice.put(s.a, "finish_reason", if (finish_reason) |f| .{ .string = f } else .null) catch return error.Closed;
+        choice.put(s.a, "stop_reason", stopReasonValue(s.a, stop_reason) catch return error.Closed) catch return error.Closed;
+        choice.put(s.a, "token_ids", tokenIdsValue(s.a, tokens) catch return error.Closed) catch return error.Closed;
+        const lp_json: Value = if (logprobs) |l| logprobsValue(s.a, l) catch {
+            s.errorLine("out of memory building logprobs") catch {};
+            return error.Closed;
+        } else .null;
+        choice.put(s.a, "logprobs", lp_json) catch return error.Closed;
+        const choices = s.a.alloc(Value, 1) catch return error.Closed;
+        choices[0] = .{ .object = choice };
+        o.put(s.a, "choices", .{ .array = choices }) catch return error.Closed;
+        if (s.return_token_ids and !s.tokens_sent) {
+            o.put(s.a, "prompt_token_ids", tokenIdsValue(s.a, s.prompt_token_ids) catch return error.Closed) catch return error.Closed;
+            s.tokens_sent = true;
+        }
+        s.sent += tokens.len;
+        if (s.continuous) o.put(s.a, "usage", usageObject(s.a, s.prompt_tokens, s.sent, s.cached) catch return error.Closed) catch return error.Closed;
+        return sse.data(s.conn, s.a, .{ .object = o });
+    }
+
+    fn final(s: *Stream, reply: chat.TokenReply) error{Closed}!void {
+        if (s.failed) return;
+        if (s.pending_tokens) |tokens| {
+            s.pending_tokens = null;
+            s.writeRound(tokens, s.pending_finish, s.pending_stop, null) catch return error.Closed;
+        }
+        const o = json.newObject(s.a) catch return error.Closed;
+        o.put(s.a, "request_id", .{ .string = s.request_id }) catch return error.Closed;
+        o.put(s.a, "output_mode", .{ .string = "tokens" }) catch return error.Closed;
+        const choices = s.a.alloc(Value, 0) catch return error.Closed;
+        o.put(s.a, "choices", .{ .array = choices }) catch return error.Closed;
+        o.put(s.a, "usage", usageObject(s.a, reply.prompt_tokens, reply.completion_tokens, @intCast(reply.cached_tokens)) catch return error.Closed) catch return error.Closed;
+        o.put(s.a, "metrics", .null) catch return error.Closed;
+        o.put(s.a, "tensorfold", tensorfoldObject(s.a, reply) catch return error.Closed) catch return error.Closed;
+        try sse.data(s.conn, s.a, .{ .object = o });
+        return sse.done(s.conn);
+    }
+
+    fn errorLine(s: *Stream, message: []const u8) error{Closed}!void {
+        s.failed = true;
+        const e = json.newObject(s.a) catch return error.Closed;
+        e.put(s.a, "message", .{ .string = message }) catch return error.Closed;
+        e.put(s.a, "type", .{ .string = "server_error" }) catch return error.Closed;
+        const o = json.newObject(s.a) catch return error.Closed;
+        o.put(s.a, "error", .{ .object = e }) catch return error.Closed;
+        try sse.data(s.conn, s.a, .{ .object = o });
+        return sse.done(s.conn);
+    }
+};
+
+pub fn streamReply(srv: *Server, conn: *Conn, a: Allocator, req: Parsed, gone: anytype) ![]const u8 {
+    var cx: errors.Cx = .{ .a = a };
+    const input: chat.Input = .{
+        .prompt = .{ .ids = req.token_ids },
+        .fields = req.sampling,
+        .max_tokens = req.max_tokens,
+        .token_ids = true,
+        .stop_token_ids = req.stop_token_ids,
+        .history_len = req.history_len,
+        .shared_prefixes = req.shared_prefixes,
+        .thinking = req.thinking,
+        .logprobs = @intCast(std.math.clamp(req.logprobs orelse 0, 0, 21)),
+        .images = req.images,
+    };
+    const prepared = chat.prepare(srv, &cx, input, gone) catch |e| {
+        if (e == error.OutOfMemory) return outOfMemory(conn, a);
+        if (e == error.Cancelled) return "cancelled";
+        sendError(conn, a, .{ .a = a, .status = cx.status(), .message = cx.message, .param = if (cx.kind == .context_length) "token_ids" else null, .code = if (cx.kind == .context_length) "context_length_exceeded" else null });
+        return "refused";
+    };
+    if (sse.open(conn)) |_| {} else |_| return "failed";
+    var stream = Stream{
+        .conn = conn,
+        .a = a,
+        .request_id = req.request_id,
+        .prompt_tokens = prepared.prompt_len,
+        .include_usage = req.include_usage,
+        .continuous = req.continuous_usage_stats,
+        .return_token_ids = req.return_token_ids,
+        .logprobs = req.logprobs != null and req.logprobs.? > 0,
+        .prompt_token_ids = prepared.request.prompt,
+    };
+    const reply = chat.generateTokens(srv, &cx, prepared, stream.sink(), gone) catch |e| {
+        if (e == error.OutOfMemory) {
+            // the stream is open: an error event and [DONE], as for any other failure
+            if (!stream.failed) stream.errorLine("out of memory") catch {};
+            return "failed";
+        }
+        if (e == error.Cancelled) return "cancelled";
+        if (!stream.failed) stream.errorLine(cx.message) catch {};
+        return "failed";
+    };
+    stream.final(reply) catch |e| return if (e == error.Closed) "cancelled" else "failed";
+    return "ok";
+}
+
+pub fn post(srv: *Server, conn: *Conn, a: Allocator) void {
+    postWith(srv, conn, a, @import("openai.zig").Gone{ .conn = conn });
+}
+
+test "logprobsValue reports an allocation failure instead of dropping to null" {
+    const scored = [_]api.Logprob{.{ .token = 1, .logprob = -0.1, .rank = 1, .top = &.{} }};
+    var failing = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = 0 });
+    try std.testing.expectError(error.OutOfMemory, logprobsValue(failing.allocator(), &scored));
+    try std.testing.expect(failing.has_induced_failure);
+}
+
+pub fn postWith(srv: *Server, conn: *Conn, a: Allocator, gone: anytype) void {
+    var cx: errors.Cx = .{ .a = a };
+    var reject: Reject = .{ .a = a, .message = "" };
+    const body = http_body.readJson(conn, &cx) catch {
+        srv.metrics.noteRoute(srv.io, "refused");
+        return sendError(conn, a, .{ .a = a, .message = cx.message, .param = null });
+    };
+    const req = parse(srv, &cx, &reject, body) catch |e| switch (e) {
+        error.OutOfMemory => return srv.metrics.noteRoute(srv.io, outOfMemory(conn, a)),
+        error.Refused => {
+            srv.metrics.noteRoute(srv.io, "refused");
+            return sendError(conn, a, .{ .a = a, .message = cx.message, .param = null });
+        },
+        error.Reject => {
+            srv.metrics.noteRoute(srv.io, "refused");
+            return sendError(conn, a, reject);
+        },
+    };
+    const result = if (req.stream)
+        streamReply(srv, conn, a, req, gone) catch "failed"
+    else
+        // its errors are allocation failures building the reply, before anything was sent
+        wholeReply(srv, conn, a, req, gone) catch outOfMemory(conn, a);
+    srv.metrics.noteRoute(srv.io, result);
+}
