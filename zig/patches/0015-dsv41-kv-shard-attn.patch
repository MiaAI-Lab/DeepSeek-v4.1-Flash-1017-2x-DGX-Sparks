+    }
+    {
+        // random layouts: a pinned twin never moves, is never given back or overlapped; nothing evicted for nothing
+        var prng: std.Random.DefaultPrng = .init(11);
+        const rnd = prng.random();
+        var bad: usize = 0;
+        var seen: usize = 0;
