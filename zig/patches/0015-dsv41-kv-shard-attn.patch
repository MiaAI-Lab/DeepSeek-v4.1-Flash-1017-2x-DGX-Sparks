diff --git a/zig/src/families/dsv41/comm.zig b/zig/src/families/dsv41/comm.zig
index 6257e8f3c8bcbca386061f0d89031fafbdbba050..597ff0e6e288f317cceb813de7aaf18e2d93face 100644
--- a/zig/src/families/dsv41/comm.zig
+++ b/zig/src/families/dsv41/comm.zig
