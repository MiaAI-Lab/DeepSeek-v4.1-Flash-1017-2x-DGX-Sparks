+        var q = try f.plan(rq(10, 8 * C, null));
+        defer q.deinit(t.gpa);
+        t.check("9 room: still evicts the oldest when a part can (8C: one state)", q.status == .placed and count(&q, .stale) == 1);
+    }
+}
