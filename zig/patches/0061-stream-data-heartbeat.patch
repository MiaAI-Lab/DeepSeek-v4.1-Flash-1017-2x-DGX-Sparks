From 2e4e892fc5adb99c71dbfb39d66b23bb998c2b0d Mon Sep 17 00:00:00 2001
From: "tianxu.zhang" <tianxu.zhang@bytedance.com>
Date: Sat, 7 Nov 2026 22:47:18 +0800
Subject: [PATCH] server: emit data heartbeats after real stream silence

Patch 0032 refreshes its silence clock after every decoded token chunk, even
when filtering writes no bytes to the client. A long hidden envelope can
therefore decode continuously without ever sending a keepalive. Its OpenAI
keepalive is also an SSE comment, which some agent adapters ignore when
advancing their parsed-event idle timer.

Refresh the clock only after a sink write, check it after both idle waits and
decoded chunks, and make the OpenAI keepalive a normal empty
chat.completion.chunk data event. Anthropic keeps its native ping event.
Heartbeats do not change reconstructed text, tool calls, or token accounting.

---
 zig/src/server/anthropic.zig |  2 +-
 zig/src/server/chat.zig      | 42 ++++++++++++++++++++++++++----------
 zig/src/server/openai.zig    | 34 +++++++++++++++++++++++++----
 zig/src/server/root.zig      |  2 ++
 4 files changed, 64 insertions(+), 16 deletions(-)

diff --git a/zig/src/server/anthropic.zig b/zig/src/server/anthropic.zig
index 6fc62239..fd489831 100644
--- a/zig/src/server/anthropic.zig
+++ b/zig/src/server/anthropic.zig
@@ -109,7 +109,7 @@ const Wire = struct {
         return .{ .ctx = w, .vt = &.{ .open = open, .event = event, .reply = whole, .ping = ping } };
     }
 
-    fn ping(ctx: *anyopaque) error{Closed}!void {
+    fn ping(ctx: *anyopaque, _: Value) error{Closed}!void {
         const w: *Wire = @ptrCast(@alignCast(ctx));
         const o = json.newObject(w.reply.a) catch return error.Closed;
         o.put(w.reply.a, "type", .{ .string = "ping" }) catch return error.Closed;
diff --git a/zig/src/server/chat.zig b/zig/src/server/chat.zig
index d0cff1b4..e3f20fb8 100644
--- a/zig/src/server/chat.zig
+++ b/zig/src/server/chat.zig
@@ -48,6 +48,10 @@ pub const Sink = struct {
 /// How long a streaming reply may be silent before a sink that has a ping gets one (a long cold prefill).
 const ping_after_ns: i96 = 25 * std.time.ns_per_s;
 
+fn pingDue(last_out_ns: i96, now_ns: i96) bool {
+    return now_ns - last_out_ns > ping_after_ns;
+}
+
 pub const Reply = struct {
     content: []const u8,
     stop_sequence: ?[]const u8,
@@ -453,6 +457,20 @@ const Generation = struct {
             g.cancel();
             return error.Cancelled;
         };
+        g.last_out_ns = nowNs(g.srv.io);
+    }
+
+    /// Keep a live stream observable while generated bytes are hidden inside a tool-call envelope.
+    fn pingIfSilent(g: *Generation) Failure!void {
+        const sink = g.sink orelse return;
+        const ping = sink.ping orelse return;
+        const now = nowNs(g.srv.io);
+        if (!pingDue(g.last_out_ns, now)) return;
+        ping(sink.ctx) catch {
+            g.cancel();
+            return error.Cancelled;
+        };
+        g.last_out_ns = now;
     }
 
     /// Ends the request and waits for the engine; one it ended unfinished counts as a disconnect, as the Mac scheduler counts it.
@@ -498,20 +516,11 @@ const Generation = struct {
                 return error.Cancelled;
             }
             const tokens = chunk orelse {
-                if (g.sink) |sink| if (sink.ping) |ping| {
-                    const now = nowNs(g.srv.io);
-                    if (now - g.last_out_ns > ping_after_ns) {
-                        ping(sink.ctx) catch {
-                            g.cancel();
-                            return error.Cancelled;
-                        };
-                        g.last_out_ns = now;
-                    }
-                };
+                try g.pingIfSilent();
                 continue;
             };
             if (g.reason == null) try g.commit(tokens);
-            g.last_out_ns = nowNs(g.srv.io);
+            try g.pingIfSilent();
         }
     }
 
@@ -688,3 +697,14 @@ pub fn tokenSha(tokens: []const u32) [12]u8 {
     @memcpy(&out, &hex);
     return out;
 }
+
+test "stream heartbeat cadence follows actual writes" {
+    const started: i96 = 100;
+    try std.testing.expect(!pingDue(started, started + ping_after_ns));
+    const first_ping = started + ping_after_ns + 1;
+    try std.testing.expect(pingDue(started, first_ping));
+    try std.testing.expect(!pingDue(first_ping, first_ping + ping_after_ns));
+    const ordinary_write = first_ping + ping_after_ns - 1;
+    try std.testing.expect(!pingDue(ordinary_write, ordinary_write + ping_after_ns));
+    try std.testing.expect(pingDue(ordinary_write, ordinary_write + ping_after_ns + 1));
+}
diff --git a/zig/src/server/openai.zig b/zig/src/server/openai.zig
index 6bbc649f..a2470d51 100644
--- a/zig/src/server/openai.zig
+++ b/zig/src/server/openai.zig
@@ -36,7 +36,7 @@ pub const Out = struct {
         /// A whole JSON reply.
         reply: *const fn (ctx: *anyopaque, status: u16, payload: Value) void,
         /// A keep-alive the stream sends while nothing else is; optional.
-        ping: ?*const fn (ctx: *anyopaque) error{Closed}!void = null,
+        ping: ?*const fn (ctx: *anyopaque, payload: Value) error{Closed}!void = null,
     };
 };
 
@@ -65,9 +65,9 @@ const ClientOut = struct {
         return sse.open(c.conn);
     }
 
-    fn ping(ctx: *anyopaque) error{Closed}!void {
+    fn ping(ctx: *anyopaque, payload: Value) error{Closed}!void {
         const c: *ClientOut = @ptrCast(@alignCast(ctx));
-        return sse.comment(c.conn, "ping");
+        return sse.data(c.conn, c.a, payload);
     }
 
     fn event(ctx: *anyopaque, payload: ?Value) error{Closed}!void {
@@ -397,7 +397,10 @@ const Run = struct {
 
         fn ping(ctx: *anyopaque) error{Closed}!void {
             const s: *StreamSink = @ptrCast(@alignCast(ctx));
-            if (s.run.out.vt.ping) |p| return p(s.run.out.ctx);
+            if (s.run.out.vt.ping) |p| {
+                const payload = s.run.chunk(null, null) catch return error.Closed;
+                return p(s.run.out.ctx, payload);
+            }
         }
 
         fn call(ctx: *anyopaque, delta: Value) error{Closed}!void {
@@ -563,3 +566,26 @@ const Run = struct {
 fn roleDelta(a: Allocator) Allocator.Error!Value {
     return chat.deltaOf(a, "role", "assistant");
 }
+
+test "OpenAI heartbeat is a normal empty chat completion chunk" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var r: Run = undefined;
+    r.a = a;
+    r.is_chat = true;
+    r.id = "chatcmpl-heartbeat";
+    r.created = 123;
+    r.plan.named = "test-model";
+
+    const payload = try r.chunk(null, null);
+    try std.testing.expectEqualStrings("chatcmpl-heartbeat", payload.get("id").?.string);
+    try std.testing.expectEqualStrings("chat.completion.chunk", payload.get("object").?.string);
+    try std.testing.expectEqualStrings("123", payload.get("created").?.int);
+    try std.testing.expectEqualStrings("test-model", payload.get("model").?.string);
+    const choices = payload.get("choices").?.array;
+    try std.testing.expectEqual(@as(usize, 1), choices.len);
+    try std.testing.expectEqualStrings("0", choices[0].get("index").?.int);
+    try std.testing.expectEqual(@as(usize, 0), choices[0].get("delta").?.object.count());
+    try std.testing.expect(choices[0].get("finish_reason").? == .null);
+}
