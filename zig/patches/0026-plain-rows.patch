+/// beside other streams, or under the draft block (TF_DS_PLAIN_ROWS=0 turns the padding off).
+fn plainRows(e: *const Engine, m: usize) usize {
+    if (e.plain_rows <= m) return m;
+    return @min(e.plain_rows, e.round_rows);
