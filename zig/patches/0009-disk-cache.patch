+/// Rank 1's answer to a disk step: the step's request number, its kind, the state's key, whether it went through,
+/// the bytes of its file and why not.
+pub const Reply = struct {
+    req: u64,
+    op: u8,
+    key: u64,
+    ok: bool,
+    bytes: u64 = 0,
+    err: u32 = 0,
+
+    pub fn encode(r: Reply, out: *[30]u8) []const u8 {
+        std.mem.writeInt(u64, out[0..8], r.req, .little);
+        out[8] = r.op;
+        std.mem.writeInt(u64, out[9..17], r.key, .little);
+        out[17] = @intFromBool(r.ok);
+        std.mem.writeInt(u64, out[18..26], r.bytes, .little);
+        std.mem.writeInt(u32, out[26..30], r.err, .little);
+        return out;
+    }
+
+    pub fn decode(b: []const u8) !Reply {
+        if (b.len != 30) return error.BadReply;
+        return .{ .req = std.mem.readInt(u64, b[0..8], .little), .op = b[8], .key = std.mem.readInt(u64, b[9..17], .little), .ok = b[17] != 0, .bytes = std.mem.readInt(u64, b[18..26], .little), .err = std.mem.readInt(u32, b[26..30], .little) };
+    }
+};
+
+/// Why a disk step failed, as a reply's number (the log names it on both ranks).
+fn errCode(err: anyerror) u32 {
+    return switch (err) {
+        error.DiskMissing => 1,
+        error.DiskCrc => 2,
+        error.DiskIdentity => 3,
+        error.DiskSize, error.DiskFormat, error.DiskShort => 4,
+        error.DiskOpen, error.DiskWrite => 5,
+        error.NoDiskCache, error.BadDiskDir => 6,
+        error.UnknownSnapshot => 7,
+        error.DiskFull, error.LowMemory => 8,
+        else => 9,
+    };
+}
