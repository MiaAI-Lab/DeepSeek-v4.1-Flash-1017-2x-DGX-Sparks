+pub const Kind = enum(u8) { fill_begin = 1, fill_chunk = 2, verify = 3, pass = 4, snap_save = 5, snap_restore = 6, snap_drop = 7, fill_images = 8, done = 9, snap_write = 10, snap_read = 11, snap_forget = 12, snap_sweep = 13 };
