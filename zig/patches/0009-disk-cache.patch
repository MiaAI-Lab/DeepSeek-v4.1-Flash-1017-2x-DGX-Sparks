+/// The tier's root of one of its directories (`root/<identity>`).
+fn rootOf(dir: []const u8) []const u8 {
+    const i = std.mem.lastIndexOfScalar(u8, dir, '/') orelse return dir;
+    return dir[0..i];
+}
+
+/// Whether `name` is an identity directory's name: 16 hex digits.
+fn identityName(name: []const u8) bool {
+    if (name.len != 16) return false;
+    for (name) |ch| if (!std.ascii.isHex(ch)) return false;
+    return true;
+}
+
+/// The identity directories under `root` (at most out.len).
+fn identities(root: []const u8, out: *[64][16]u8) usize {
+    var pb: [1100]u8 = undefined;
+    const d = std.c.opendir(std.fmt.bufPrintSentinel(&pb, "{s}", .{root}, 0) catch return 0) orelse return 0;
+    defer _ = std.c.closedir(d);
+    var n: usize = 0;
+    while (std.c.readdir(d)) |ent| {
+        const name = std.mem.sliceTo(&ent.name, 0);
+        if (ent.type != std.c.DT.DIR or !identityName(name) or n == out.len) continue;
+        out[n] = name[0..16].*;
+        n += 1;
+    }
+    return n;
+}
+
+/// Rank 1: identity directories under `root` other than `current`'s and not among `kept` (16 bytes each) emptied of this
+/// rank's files and removed (one that holds anything else stays). The directories removed.
+fn sweepIdentities(root: []const u8, current: []const u8, kept: []const u8) usize {
+    var ids: [64][16]u8 = undefined;
+    const n = identities(root, &ids);
+    var gone: usize = 0;
+    for (ids[0..n]) |*x| {
+        if (std.mem.endsWith(u8, current, x)) continue;
+        var keep = false;
+        var i: usize = 0;
+        while (i + 16 <= kept.len) : (i += 16) if (std.mem.eql(u8, kept[i..][0..16], x)) {
+            keep = true;
+        };
+        if (keep) continue;
+        var pb: [1100]u8 = undefined;
+        const path = std.fmt.bufPrint(&pb, "{s}/{s}", .{ root, x }) catch continue;
+        if (!realDir(path)) continue;
+        const None = struct {
+            fn no(_: void, _: u64) bool {
+                return false;
+            }
+        };
+        _ = disco.sweep(path, 1, {}, None.no);
+        var zb: [1100]u8 = undefined;
+        if (std.c.rmdir(std.fmt.bufPrintSentinel(&zb, "{s}", .{path}, 0) catch continue) == 0) gone += 1;
+    }
+    return gone;
+}
