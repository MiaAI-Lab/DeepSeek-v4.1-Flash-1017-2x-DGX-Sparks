+
+/// `dir` (one of the tier's, Disk.owns) made when missing and a real directory, not a link to one elsewhere.
+fn realDir(dir: []const u8) bool {
+    makeDir(dir);
+    var pb: [1100]u8 = undefined;
+    const fd = std.c.open(std.fmt.bufPrintSentinel(&pb, "{s}", .{dir}, 0) catch return false, .{ .ACCMODE = .RDONLY, .DIRECTORY = true, .NOFOLLOW = true }, @as(std.c.mode_t, 0));
