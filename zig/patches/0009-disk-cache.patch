+/// `dir` made (mode 0700) when missing; its parent, the tier's root, must exist.
+fn makeDir(dir: []const u8) void {
+    var pb: [1100]u8 = undefined;
+    _ = std.c.mkdir(std.fmt.bufPrintSentinel(&pb, "{s}", .{dir}, 0) catch return, 0o700);
