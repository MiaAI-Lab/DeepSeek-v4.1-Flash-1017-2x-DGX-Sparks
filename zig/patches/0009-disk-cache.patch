+    try std.testing.expectEqual(fresh(&long), f.pass(&s, &long, try s.begin(a, &long, 6, &.{}, &.{}, null)));
+    try std.testing.expectEqual(@as(u64, 1), s.flush(pc.monotonicNs() + std.time.ns_per_s));
+    try std.testing.expectEqual(@as(usize, 1), im.metas.items.len);
+    try std.testing.expectEqual(@as(u64, 0), s.flush(pc.monotonicNs() + std.time.ns_per_s)); // already there
+    // reopened, the index still says so; aged past the limit, the next lookup forgets it
