+}
+
+/// Rank 1's half of state `key` read back: its own part as kept[id] (replacing one there), its rows at [to, to + at).
+fn followRead(gpa: std.mem.Allocator, m: *Model, disk: ?*Disk, kept: *std.AutoHashMapUnmanaged(u64, cuda.DeviceBuffer), id: u64, key: u64, at: usize, to: usize, dir: []const u8) !void {
