+/// A disk step's directory (after its fixed fields).
+fn dirOfFrame(r: *Reader) ![]const u8 {
+    const n = try r.int(u32);
+    if (r.at + n > r.b.len or n == 0 or n > 1024) return error.BadFrame;
+    const d = r.b[r.at..][0..n];
+    r.at += n;
+    return d;
