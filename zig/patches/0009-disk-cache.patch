+    reply_ms: u32 = 10_000, // rank 1's answer to a disk step (a 200K state's half takes ~0.3 s; a stop's flush waits on it)
+    buf: []u8, // disco.piece bytes
+    next_req: u64 = 1,
+    reply: [64]u8 = undefined,
+
+    /// From the environment, or null when the tier is off; `id` is this rank's identity.
+    pub fn fromEnv(gpa: std.mem.Allocator, id: u64) !?Disk {
+        const on = std.c.getenv("TF_DS_DISK_CACHE") orelse return null;
+        if (!std.mem.eql(u8, std.mem.span(on), "1")) return null;
+        var root: []const u8 = if (std.c.getenv("TF_DS_DISK_CACHE_DIR")) |v| std.mem.span(v) else "/var/tmp/dsv41-disk-cache";
+        while (root.len > 1 and root[root.len - 1] == '/') root = root[0 .. root.len - 1]; // a trailing slash is the same directory
+        if (root.len < 2 or root[0] != '/' or std.mem.indexOf(u8, root, "/..") != null) return error.BadDiskDir;
+        return .{
+            .root = root,
+            .identity = id,
+            .cap = try envGib("TF_DS_DISK_CACHE_GIB", 64),
+            .min_free = try envGib("TF_DS_DISK_CACHE_MIN_FREE_GIB", 20),
+            .mem_floor = try envGib("TF_DS_DISK_CACHE_MEM_FLOOR_GIB", 3.5),
+            .min_tokens = @intFromFloat(try envNum("TF_DS_DISK_CACHE_MIN_TOKENS", 8192)),
+            .ttl_s = @intFromFloat(try envNum("TF_DS_DISK_CACHE_TTL_H", 72) * 3600),
+            .flush_s = @intFromFloat(try envNum("TF_DS_DISK_CACHE_FLUSH_S", 60)),
+            .buf = try gpa.alloc(u8, disco.piece),
+        };
+    }
+
+    /// Whether `dir` is a directory of this tier: under the root, one level, nothing that climbs out.
+    pub fn owns(d: *const Disk, dir: []const u8) bool {
+        if (!std.mem.startsWith(u8, dir, d.root) or dir.len <= d.root.len + 1 or dir[d.root.len] != '/') return false;
+        const rest = dir[d.root.len + 1 ..];
+        return std.mem.indexOfScalar(u8, rest, '/') == null and std.mem.indexOfScalar(u8, rest, 0) == null and !std.mem.eql(u8, rest, ".") and !std.mem.eql(u8, rest, "..");
+    }
+
+    /// Room to write `bytes` here: the disk keeps min_free and the host keeps mem_floor.
+    pub fn room(d: *const Disk, dir: []const u8, bytes: u64) !void {
+        if (disco.freeBytes(dir)) |free| if (free < d.min_free + bytes) return error.DiskFull;
+        if (memAvailable()) |avail| if (avail < d.mem_floor + disco.piece) return error.LowMemory;
+    }
+};
+
+fn envNum(name: [:0]const u8, default: f64) !f64 {
+    const v = std.c.getenv(name) orelse return default;
+    return std.fmt.parseFloat(f64, std.mem.span(v)) catch error.BadDiskSetting;
+}
+
+fn envGib(name: [:0]const u8, default: f64) !u64 {
+    return @intFromFloat(try envNum(name, default) * (1 << 30));
+}
+
+/// Unix seconds now.
+fn unixNow() i64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(std.c.CLOCK.REALTIME, &ts);
+    return @intCast(ts.sec);
+}
+
+/// /proc/meminfo's MemAvailable in bytes (null: unreadable).
+fn memAvailable() ?u64 {
+    const fd = std.c.open("/proc/meminfo", .{ .ACCMODE = .RDONLY }, @as(std.c.mode_t, 0));
+    if (fd < 0) return null;
+    defer _ = std.c.close(fd);
+    var buf: [4096]u8 = undefined;
+    const n = std.c.read(fd, &buf, buf.len);
+    if (n <= 0) return null;
+    const text = buf[0..@intCast(n)];
+    const at = std.mem.indexOf(u8, text, "MemAvailable:") orelse return null;
+    var it = std.mem.tokenizeAny(u8, text[at + "MemAvailable:".len ..], " \n");
+    const kb = std.fmt.parseInt(u64, it.next() orelse return null, 10) catch return null;
+    return kb * 1024;
+}
+
+/// What a kept state's bytes on this rank depend on beyond its tokens: the format, the split, a state's layout, this
+/// executable's bytes and the size of the rank's weights file: a file of another build or other weights never reads back.
+pub fn diskIdentity(m: *const Model) !u64 {
+    var h = std.hash.Wyhash.init(0xd541);
+    const weights_size = std.c.lseek(m.cache_file.handle, 0, std.c.SEEK.END);
+    if (weights_size < 0) return error.NoIdentity;
+    for ([_]u64{ disco.format, m.rank, m.world, m.snapBytes(), try m.rowBytes(model.chunk_rows), model.chunk_rows, @intCast(weights_size) }) |x| h.update(std.mem.asBytes(&x));
+    const exe = std.c.open("/proc/self/exe", .{ .ACCMODE = .RDONLY }, @as(std.c.mode_t, 0));
+    if (exe < 0) return error.NoIdentity;
+    defer _ = std.c.close(exe);
+    var buf: [256 << 10]u8 = undefined;
+    while (true) {
+        const n = std.c.read(exe, &buf, buf.len);
+        if (n < 0) return error.NoIdentity;
+        if (n == 0) break;
+        h.update(buf[0..@intCast(n)]);
+    }
+    return h.final();
+}
 
