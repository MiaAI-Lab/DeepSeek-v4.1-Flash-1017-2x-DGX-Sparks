diff --git a/zig/src/families/dsv41/disco.zig b/zig/src/families/dsv41/disco.zig
new file mode 100644
index 0000000..dacdb49
--- /dev/null
+++ b/zig/src/families/dsv41/disco.zig
@@ -0,0 +1,529 @@
+//! Kept prompt states on disk (TF_DS_DISK_CACHE): each rank's half of a state in a file of its own,
+//! `<dir>/<key>.r<rank>.ds41kv`. A file is written whole and atomically (a .tmp, fsync, rename, the directory fsynced)
+//! and read back only when its head matches (format, rank, identity, key, position, sizes, the file's length) and every
+//! 8 MiB of its body passes its CRC-32. The body is the slot's own part (Model.snapCopy's order), then the compressed
+//! rows of every kv-source layer and plane (Model.rowSpans' order); rank 0's file also carries the state's tokens, so an
+//! index can be rebuilt from the files. Bytes cross between the device and the file through one host buffer, a piece at
+//! a time: a state never sits whole in host memory.
+const std = @import("std");
+
+pub const magic = [8]u8{ 'D', 'S', '4', '1', 'K', 'V', 0, 1 };
+pub const format: u32 = 1;
+/// The bytes one CRC-32 covers.
+pub const block: usize = 8 << 20;
+/// The host buffer a copy moves through (the engine's; tests pass smaller ones).
+pub const piece: usize = 32 << 20;
+pub const suffix = ".ds41kv";
+
+pub const Head = extern struct {
+    magic: [8]u8 = magic,
+    format: u32 = format,
+    rank: u32,
+    identity: u64,
+    key: u64,
+    at: u64,
+    own: u64, // the slot's own part, bytes
+    rows: u64, // the compressed rows, bytes (every layer and plane)
+    tokens: u64, // the state's tokens in this file (rank 0's: the index can be rebuilt from them)
+    written: i64, // unix seconds
+};
+
+/// A run of device bytes, in the file's order.
+pub const Span = struct { ptr: u64, len: usize };
+
+/// How bytes cross between the device and the host (CUDA in the engine, plain memory in tests); each call is complete
+/// when it returns.
+pub const Mover = struct {
+    ctx: *anyopaque,
+    down: *const fn (ctx: *anyopaque, dst: []u8, src: u64) anyerror!void,
+    up: *const fn (ctx: *anyopaque, dst: u64, src: []const u8) anyerror!void,
+};
+
+/// What a file must say to be read back.
+pub const Want = struct { rank: u32, identity: u64, key: u64, at: u64, own: u64, rows: u64 };
+
+/// `dir`/<key>.r<rank>.ds41kv
+pub fn path(buf: []u8, dir: []const u8, key: u64, rank: u32) ![:0]u8 {
+    return std.fmt.bufPrintSentinel(buf, "{s}/{x:0>16}.r{d}" ++ suffix, .{ dir, key, rank }, 0);
+}
+
+fn total(spans: []const Span) u64 {
+    var n: u64 = 0;
+    for (spans) |s| n += s.len;
+    return n;
+}
+
+fn blocks(bytes: u64) u64 {
+    return (bytes + block - 1) / block;
+}
+
+/// The file's length for a head: head, tokens, own part, rows, then the two CRC lists.
+pub fn length(h: Head) u64 {
+    return @sizeOf(Head) + 4 * h.tokens + h.own + h.rows + 4 * (blocks(h.own) + blocks(h.rows));
+}
+
+/// CRC-32 of each `block` bytes of a section, fed in any pieces.
+const Sums = struct {
+    list: std.ArrayList(u32) = .empty,
+    crc: std.hash.Crc32 = .init(),
+    filled: usize = 0,
+
+    fn feed(s: *Sums, gpa: std.mem.Allocator, bytes: []const u8) !void {
+        var b = bytes;
+        while (b.len > 0) {
+            const n = @min(b.len, block - s.filled);
+            s.crc.update(b[0..n]);
+            s.filled += n;
+            b = b[n..];
+            if (s.filled == block) try s.close(gpa);
+        }
+    }
+
+    fn close(s: *Sums, gpa: std.mem.Allocator) !void {
+        if (s.filled == 0) return;
+        try s.list.append(gpa, s.crc.final());
+        s.crc = .init();
+        s.filled = 0;
+    }
+
+    fn deinit(s: *Sums, gpa: std.mem.Allocator) void {
+        s.list.deinit(gpa);
+    }
+};
+
+/// The same, checked against a section's stored list as the bytes come.
+const Check = struct {
+    want: []const u32,
+    next: usize = 0,
+    crc: std.hash.Crc32 = .init(),
+    filled: usize = 0,
+
+    fn feed(c: *Check, bytes: []const u8) !void {
+        var b = bytes;
+        while (b.len > 0) {
+            const n = @min(b.len, block - c.filled);
+            c.crc.update(b[0..n]);
+            c.filled += n;
+            b = b[n..];
+            if (c.filled == block) try c.close();
+        }
+    }
+
+    fn close(c: *Check) !void {
+        if (c.filled == 0) return;
+        if (c.next >= c.want.len or c.want[c.next] != c.crc.final()) return error.DiskCrc;
+        c.next += 1;
+        c.crc = .init();
+        c.filled = 0;
+    }
+
+    fn end(c: *Check) !void {
+        try c.close();
+        if (c.next != c.want.len) return error.DiskCrc;
+    }
+};
+
+fn writeAll(fd: c_int, bytes: []const u8) !void {
+    var done: usize = 0;
+    while (done < bytes.len) {
+        const n = std.c.write(fd, bytes.ptr + done, bytes.len - done);
+        if (n < 0 and std.c.errno(n) == .INTR) continue;
+        if (n <= 0) return error.DiskWrite;
+        done += @intCast(n);
+    }
+}
+
+fn readAt(fd: c_int, dest: []u8, at: u64) !void {
+    var done: usize = 0;
+    while (done < dest.len) {
+        const n = std.c.pread(fd, dest.ptr + done, dest.len - done, @intCast(at + done));
+        if (n < 0 and std.c.errno(n) == .INTR) continue;
+        if (n <= 0) return error.DiskShort;
+        done += @intCast(n);
+    }
+}
+
+/// `dir` fsynced: a rename in it survives a power cut.
+pub fn syncDir(dir: []const u8) void {
+    var buf: [1100]u8 = undefined;
+    const fd = std.c.open(std.fmt.bufPrintSentinel(&buf, "{s}", .{dir}, 0) catch return, .{ .ACCMODE = .RDONLY, .DIRECTORY = true }, @as(std.c.mode_t, 0));
+    if (fd < 0) return;
+    _ = std.c.fsync(fd);
+    _ = std.c.close(fd);
+}
+
+/// What to write: one rank's half of state `key` at `at` tokens.
+pub const Out = struct {
+    dir: []const u8,
+    rank: u32,
+    identity: u64,
+    key: u64,
+    at: u64,
+    tokens: []const u32 = &.{},
+    own: []const Span,
+    rows: []const Span,
+    written: i64 = 0,
+};
+
+/// One rank's half written to its file (replacing one there): the file's bytes. On any error nothing is left behind.
+pub fn write(gpa: std.mem.Allocator, o: Out, mv: Mover, buf: []u8) !u64 {
+    var pb: [1100]u8 = undefined;
+    var tb: [1110]u8 = undefined;
+    const final = try path(&pb, o.dir, o.key, o.rank);
+    const tmp = try std.fmt.bufPrintSentinel(&tb, "{s}.tmp", .{final}, 0);
+    const fd = std.c.open(tmp, .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true, .NOFOLLOW = true }, @as(std.c.mode_t, 0o600));
+    if (fd < 0) return error.DiskOpen;
+    var open_ = true;
+    errdefer {
+        if (open_) _ = std.c.close(fd);
+        _ = std.c.unlink(tmp);
+    }
+    const head: Head = .{ .rank = o.rank, .identity = o.identity, .key = o.key, .at = o.at, .own = total(o.own), .rows = total(o.rows), .tokens = o.tokens.len, .written = o.written };
+    try writeAll(fd, std.mem.asBytes(&head));
+    try writeAll(fd, std.mem.sliceAsBytes(o.tokens));
+    var own: Sums = .{};
+    defer own.deinit(gpa);
+    var rows: Sums = .{};
+    defer rows.deinit(gpa);
+    for ([_]struct { []const Span, *Sums }{ .{ o.own, &own }, .{ o.rows, &rows } }) |sec| {
+        for (sec[0]) |sp| {
+            var off: usize = 0;
+            while (off < sp.len) {
+                const n = @min(buf.len, sp.len - off);
+                try mv.down(mv.ctx, buf[0..n], sp.ptr + off);
+                try sec[1].feed(gpa, buf[0..n]);
+                try writeAll(fd, buf[0..n]);
+                off += n;
+            }
+        }
+        try sec[1].close(gpa);
+    }
+    try writeAll(fd, std.mem.sliceAsBytes(own.list.items));
+    try writeAll(fd, std.mem.sliceAsBytes(rows.list.items));
+    if (std.c.fsync(fd) != 0) return error.DiskWrite;
+    open_ = false;
+    if (std.c.close(fd) != 0) return error.DiskWrite;
+    if (std.c.rename(tmp, final) != 0) return error.DiskWrite;
+    syncDir(o.dir);
+    return length(head);
+}
+
+/// A file opened for reading: its head and its CRC lists, checked against what the caller wants.
+pub const File = struct {
+    fd: c_int,
+    head: Head,
+    own_sums: []u32,
+    rows_sums: []u32,
+
+    pub fn close(f: *File, gpa: std.mem.Allocator) void {
+        _ = std.c.close(f.fd);
+        gpa.free(f.own_sums);
+        gpa.free(f.rows_sums);
+        f.* = undefined;
+    }
+
+    fn bodyAt(f: *const File) u64 {
+        return @sizeOf(Head) + 4 * f.head.tokens;
+    }
+
+    /// The state's tokens (rank 0's file), into new memory.
+    pub fn tokens(f: *const File, gpa: std.mem.Allocator) ![]u32 {
+        const t = try gpa.alloc(u32, @intCast(f.head.tokens));
+        errdefer gpa.free(t);
+        try readAt(f.fd, std.mem.sliceAsBytes(t), @sizeOf(Head));
+        return t;
+    }
+
+    /// The own part into `spans` (their total must be the head's), checked block by block.
+    pub fn readOwn(f: *const File, spans: []const Span, mv: Mover, buf: []u8) !void {
+        if (total(spans) != f.head.own) return error.DiskSize;
+        try f.section(f.bodyAt(), spans, f.own_sums, mv, buf);
+    }
+
+    /// The compressed rows into `spans` (their total must be the head's), checked block by block.
+    pub fn readRows(f: *const File, spans: []const Span, mv: Mover, buf: []u8) !void {
+        if (total(spans) != f.head.rows) return error.DiskSize;
+        try f.section(f.bodyAt() + f.head.own, spans, f.rows_sums, mv, buf);
+    }
+
+    fn section(f: *const File, at: u64, spans: []const Span, sums: []const u32, mv: Mover, buf: []u8) !void {
+        var c: Check = .{ .want = sums };
+        var pos = at;
+        for (spans) |sp| {
+            var off: usize = 0;
+            while (off < sp.len) {
+                const n = @min(buf.len, sp.len - off);
+                try readAt(f.fd, buf[0..n], pos);
+                try c.feed(buf[0..n]);
+                try mv.up(mv.ctx, sp.ptr + off, buf[0..n]);
+                off += n;
+                pos += n;
+            }
+        }
+        try c.end();
+    }
+};
+
+/// The file of `want`'s state under `dir`, its head checked (format, rank, identity, key, position, sizes, the
+/// file's length) and its CRC lists read; error.DiskMissing when there is none.
+pub fn open(gpa: std.mem.Allocator, dir: []const u8, want: Want) !File {
+    var pb: [1100]u8 = undefined;
+    const fd = std.c.open(try path(&pb, dir, want.key, want.rank), .{ .ACCMODE = .RDONLY, .NOFOLLOW = true }, @as(std.c.mode_t, 0));
+    if (fd < 0) return error.DiskMissing;
+    errdefer _ = std.c.close(fd);
+    var h: Head = undefined;
+    readAt(fd, std.mem.asBytes(&h), 0) catch return error.DiskFormat;
+    if (!std.mem.eql(u8, &h.magic, &magic) or h.format != format) return error.DiskFormat;
+    if (h.rank != want.rank or h.identity != want.identity or h.key != want.key) return error.DiskIdentity;
+    if (h.at != want.at or h.own != want.own or h.rows != want.rows or h.tokens > 1 << 24) return error.DiskSize;
+    const end = std.c.lseek(fd, 0, std.c.SEEK.END);
+    if (end < 0 or @as(u64, @intCast(end)) != length(h)) return error.DiskSize;
+    const n_own: usize = @intCast(blocks(h.own));
+    const n_rows: usize = @intCast(blocks(h.rows));
+    const own_sums = try gpa.alloc(u32, n_own);
+    errdefer gpa.free(own_sums);
+    const rows_sums = try gpa.alloc(u32, n_rows);
+    errdefer gpa.free(rows_sums);
+    const sums_at = length(h) - 4 * (n_own + n_rows);
+    try readAt(fd, std.mem.sliceAsBytes(own_sums), sums_at);
+    try readAt(fd, std.mem.sliceAsBytes(rows_sums), sums_at + 4 * n_own);
+    return .{ .fd = fd, .head = h, .own_sums = own_sums, .rows_sums = rows_sums };
+}
+
+/// A file's head and tokens without knowing its position or sizes (an index rebuilt from the files): only a whole file
+/// of this format, rank and identity, whose name holds its key. Its body is checked when it is read back.
+pub fn peek(gpa: std.mem.Allocator, dir: []const u8, key: u64, rank: u32, identity: u64) !struct { head: Head, tokens: []u32 } {
+    var pb: [1100]u8 = undefined;
+    const fd = std.c.open(try path(&pb, dir, key, rank), .{ .ACCMODE = .RDONLY, .NOFOLLOW = true }, @as(std.c.mode_t, 0));
+    if (fd < 0) return error.DiskMissing;
+    defer _ = std.c.close(fd);
+    var h: Head = undefined;
+    readAt(fd, std.mem.asBytes(&h), 0) catch return error.DiskFormat;
+    if (!std.mem.eql(u8, &h.magic, &magic) or h.format != format) return error.DiskFormat;
+    if (h.rank != rank or h.identity != identity or h.key != key) return error.DiskIdentity;
+    if (h.tokens == 0 or h.tokens > 1 << 24) return error.DiskSize;
+    const end = std.c.lseek(fd, 0, std.c.SEEK.END);
+    if (end < 0 or @as(u64, @intCast(end)) != length(h)) return error.DiskSize;
+    const t = try gpa.alloc(u32, @intCast(h.tokens));
+    errdefer gpa.free(t);
+    try readAt(fd, std.mem.sliceAsBytes(t), @sizeOf(Head));
+    return .{ .head = h, .tokens = t };
+}
+
+/// State `key`'s file of `rank` under `dir` removed (missing: nothing to do).
+pub fn remove(dir: []const u8, key: u64, rank: u32) void {
+    var pb: [1100]u8 = undefined;
+    _ = std.c.unlink(path(&pb, dir, key, rank) catch return);
+}
+
+/// The key a state file's name holds, when `name` is `<16 hex>.r<rank>.ds41kv` (of this rank).
+pub fn keyOfName(name: []const u8, rank: u32) ?u64 {
+    var tail: [32]u8 = undefined;
+    const t = std.fmt.bufPrint(&tail, ".r{d}" ++ suffix, .{rank}) catch return null;
+    if (name.len != 16 + t.len or !std.mem.endsWith(u8, name, t)) return null;
+    return std.fmt.parseInt(u64, name[0..16], 16) catch null;
+}
+
+/// This rank's files under `dir` that `keep` refuses removed, and every leftover .tmp: the files removed.
+pub fn sweep(dir: []const u8, rank: u32, ctx: anytype, comptime keep: fn (@TypeOf(ctx), u64) bool) usize {
+    var buf: [1100]u8 = undefined;
+    const d = std.c.opendir(std.fmt.bufPrintSentinel(&buf, "{s}", .{dir}, 0) catch return 0) orelse return 0;
+    defer _ = std.c.closedir(d);
+    var gone: usize = 0;
+    while (std.c.readdir(d)) |ent| {
+        const name = std.mem.sliceTo(&ent.name, 0);
+        const drop = if (std.mem.endsWith(u8, name, suffix ++ ".tmp"))
+            true
+        else if (keyOfName(name, rank)) |k| !keep(ctx, k) else false;
+        if (!drop) continue;
+        var p: [1400]u8 = undefined;
+        if (std.c.unlink(std.fmt.bufPrintSentinel(&p, "{s}/{s}", .{ dir, name }, 0) catch continue) == 0) gone += 1;
+    }
+    return gone;
+}
+
+extern "c" fn statvfs(file: [*:0]const u8, buf: *[32]u64) c_int;
+
+/// The bytes free for an unprivileged writer on `dir`'s filesystem (null: unknown).
+pub fn freeBytes(dir: []const u8) ?u64 {
+    var pb: [1100]u8 = undefined;
+    var st: [32]u64 = @splat(0); // glibc's struct statvfs on 64-bit Linux: f_bsize, f_frsize, f_blocks, f_bfree, f_bavail, ...
+    if (statvfs(std.fmt.bufPrintSentinel(&pb, "{s}", .{dir}, 0) catch return null, &st) != 0) return null;
+    return st[1] * st[4];
+}
+
+extern "c" fn truncate(file: [*:0]const u8, len: i64) c_int;
+
+// -- tests: host memory as the device ------------------------------------------------------------------------------
+
+const Plain = struct {
+    fn down(_: *anyopaque, dst: []u8, src: u64) anyerror!void {
+        @memcpy(dst, @as([*]const u8, @ptrFromInt(src))[0..dst.len]);
+    }
+    fn up(_: *anyopaque, dst: u64, src: []const u8) anyerror!void {
+        @memcpy(@as([*]u8, @ptrFromInt(dst))[0..src.len], src);
+    }
+    var none: u8 = 0;
+    const mover: Mover = .{ .ctx = &none, .down = down, .up = up };
+};
+
+fn scratch(buf: []u8, tag: []const u8) ![]const u8 {
+    const d = try std.fmt.bufPrint(buf, "/tmp/tf-disco-{s}-{d}", .{ tag, std.c.getpid() });
+    var z: [300]u8 = undefined;
+    _ = std.c.mkdir(try std.fmt.bufPrintSentinel(&z, "{s}", .{d}, 0), 0o700);
+    return d;
+}
+
+fn rmDir(dir: []const u8) void {
+    _ = sweep(dir, 0, {}, struct {
+        fn no(_: void, _: u64) bool {
+            return false;
+        }
+    }.no);
+    _ = sweep(dir, 1, {}, struct {
+        fn no(_: void, _: u64) bool {
+            return false;
+        }
+    }.no);
+    var z: [300]u8 = undefined;
+    _ = std.c.rmdir(std.fmt.bufPrintSentinel(&z, "{s}", .{dir}, 0) catch return);
+}
+
+fn spansOf(parts: []const []u8, out: []Span) []Span {
+    for (parts, 0..) |p, i| out[i] = .{ .ptr = @intFromPtr(p.ptr), .len = p.len };
+    return out[0..parts.len];
+}
+
+test "a state's half reads back byte for byte, across pieces and CRC blocks" {
+    const gpa = std.testing.allocator;
+    var db: [256]u8 = undefined;
+    const dir = try scratch(&db, "trip");
+    defer rmDir(dir);
+    var prng = std.Random.DefaultPrng.init(41);
+    const r = prng.random();
+    // own part: 3 runs; rows: 4 runs, together past two CRC blocks, none a multiple of the piece
+    const sizes_own = [_]usize{ 1000, block + 17, 333 };
+    const sizes_rows = [_]usize{ 5, block - 3, 4097, block / 2 + 1 };
+    var own: [3][]u8 = undefined;
+    var rows: [4][]u8 = undefined;
+    for (&own, sizes_own) |*p, n| {
+        p.* = try gpa.alloc(u8, n);
+        r.bytes(p.*);
+    }
+    defer for (own) |p| gpa.free(p);
+    for (&rows, sizes_rows) |*p, n| {
+        p.* = try gpa.alloc(u8, n);
+        r.bytes(p.*);
+    }
+    defer for (rows) |p| gpa.free(p);
+    var so: [3]Span = undefined;
+    var sr: [4]Span = undefined;
+    const buf = try gpa.alloc(u8, 3 << 20);
+    defer gpa.free(buf);
+    const toks = [_]u32{ 7, 8, 9, 10 };
+    const bytes = try write(gpa, .{ .dir = dir, .rank = 0, .identity = 5, .key = 0xabc, .at = 4096, .tokens = &toks, .own = spansOf(&own, &so), .rows = spansOf(&rows, &sr) }, Plain.mover, buf);
+    // read into fresh memory and compare
+    var own2: [3][]u8 = undefined;
+    var rows2: [4][]u8 = undefined;
+    for (&own2, sizes_own) |*p, n| p.* = try gpa.alloc(u8, n);
+    defer for (own2) |p| gpa.free(p);
+    for (&rows2, sizes_rows) |*p, n| p.* = try gpa.alloc(u8, n);
+    defer for (rows2) |p| gpa.free(p);
+    var so2: [3]Span = undefined;
+    var sr2: [4]Span = undefined;
+    const own_total = total(spansOf(&own, &so));
+    const rows_total = total(spansOf(&rows, &sr));
+    var f = try open(gpa, dir, .{ .rank = 0, .identity = 5, .key = 0xabc, .at = 4096, .own = own_total, .rows = rows_total });
+    defer f.close(gpa);
+    try std.testing.expectEqual(length(f.head), bytes);
+    const t = try f.tokens(gpa);
+    defer gpa.free(t);
+    try std.testing.expectEqualSlices(u32, &toks, t);
+    const seen = try peek(gpa, dir, 0xabc, 0, 5);
+    defer gpa.free(seen.tokens);
+    try std.testing.expectEqual(@as(u64, 4096), seen.head.at);
+    try std.testing.expectEqualSlices(u32, &toks, seen.tokens);
+    try f.readOwn(spansOf(&own2, &so2), Plain.mover, buf[0..1 << 20]);
+    try f.readRows(spansOf(&rows2, &sr2), Plain.mover, buf);
+    for (own, own2) |a, b| try std.testing.expectEqualSlices(u8, a, b);
+    for (rows, rows2) |a, b| try std.testing.expectEqualSlices(u8, a, b);
+}
+
+test "a damaged, foreign, truncated or half-written file never reads back" {
+    const gpa = std.testing.allocator;
+    var db: [256]u8 = undefined;
+    const dir = try scratch(&db, "bad");
+    defer rmDir(dir);
+    var a: [3000]u8 = undefined;
+    const b = try gpa.alloc(u8, block + 100); // (on the heap: a test thread's stack is smaller than two blocks)
+    defer gpa.free(b);
+    for (&a, 0..) |*x, i| x.* = @truncate(i * 7);
+    for (b, 0..) |*x, i| x.* = @truncate(i * 13);
+    const own = [_]Span{.{ .ptr = @intFromPtr(&a), .len = a.len }};
+    const rows = [_]Span{.{ .ptr = @intFromPtr(b.ptr), .len = b.len }};
+    var buf: [1 << 16]u8 = undefined;
+    const want: Want = .{ .rank = 1, .identity = 9, .key = 3, .at = 2048, .own = a.len, .rows = b.len };
+    _ = try write(gpa, .{ .dir = dir, .rank = 1, .identity = 9, .key = 3, .at = 2048, .own = &own, .rows = &rows }, Plain.mover, &buf);
+    // another identity, another rank, another position: refused by the head
+    try std.testing.expectError(error.DiskIdentity, open(gpa, dir, .{ .rank = 1, .identity = 10, .key = 3, .at = 2048, .own = a.len, .rows = b.len }));
+    try std.testing.expectError(error.DiskMissing, open(gpa, dir, .{ .rank = 0, .identity = 9, .key = 3, .at = 2048, .own = a.len, .rows = b.len }));
+    try std.testing.expectError(error.DiskSize, open(gpa, dir, .{ .rank = 1, .identity = 9, .key = 3, .at = 4096, .own = a.len, .rows = b.len }));
+    // one byte of the rows flipped: the head passes, the rows' CRC does not
+    var pb: [1100]u8 = undefined;
+    const p = try path(&pb, dir, 3, 1);
+    {
+        const fd = std.c.open(p, .{ .ACCMODE = .RDWR }, @as(std.c.mode_t, 0));
+        try std.testing.expect(fd >= 0);
+        defer _ = std.c.close(fd);
+        const off: i64 = @intCast(@sizeOf(Head) + a.len + block + 50);
+        var x: [1]u8 = undefined;
+        try readAt(fd, &x, @intCast(off));
+        x[0] ^= 0xff;
+        try std.testing.expectEqual(@as(isize, 1), std.c.pwrite(fd, &x, 1, off));
+    }
+    var a2: [3000]u8 = undefined;
+    const b2 = try gpa.alloc(u8, block + 100);
+    defer gpa.free(b2);
+    const own2 = [_]Span{.{ .ptr = @intFromPtr(&a2), .len = a2.len }};
+    const rows2 = [_]Span{.{ .ptr = @intFromPtr(b2.ptr), .len = b2.len }};
+    {
+        var f = try open(gpa, dir, want);
+        defer f.close(gpa);
+        try f.readOwn(&own2, Plain.mover, &buf); // the own part is intact
+        try std.testing.expectError(error.DiskCrc, f.readRows(&rows2, Plain.mover, &buf));
+    }
+    // truncated: refused by its length
+    const full = blk: {
+        var f = try open(gpa, dir, want);
+        defer f.close(gpa);
+        break :blk length(f.head);
+    };
+    try std.testing.expectEqual(@as(c_int, 0), truncate(p, @intCast(full - 1)));
+    try std.testing.expectError(error.DiskSize, open(gpa, dir, want));
+    // a leftover .tmp and a file no index holds are swept; a kept one stays
+    _ = try write(gpa, .{ .dir = dir, .rank = 1, .identity = 9, .key = 4, .at = 2048, .own = &own, .rows = &rows }, Plain.mover, &buf);
+    var tb: [1200]u8 = undefined;
+    const tmp = try std.fmt.bufPrintSentinel(&tb, "{s}.tmp", .{try path(&pb, dir, 5, 1)}, 0);
+    const fd = std.c.open(tmp, .{ .ACCMODE = .WRONLY, .CREAT = true }, @as(std.c.mode_t, 0o600));
+    _ = std.c.close(fd);
+    // the rebuild's view of a file: its head and tokens; a file without tokens (rank 1's) or of another identity is passed over
+    try std.testing.expectError(error.DiskSize, peek(gpa, dir, 4, 1, 9));
+    try std.testing.expectError(error.DiskIdentity, peek(gpa, dir, 4, 1, 10));
+    const Keep = struct {
+        fn four(_: void, k: u64) bool {
+            return k == 4;
+        }
+    };
+    try std.testing.expectEqual(@as(usize, 2), sweep(dir, 1, {}, Keep.four)); // key 3's file and the .tmp
+    var f4 = try open(gpa, dir, .{ .rank = 1, .identity = 9, .key = 4, .at = 2048, .own = a.len, .rows = b.len });
+    f4.close(gpa);
+}
+
+test "file names hold their key and rank" {
+    var pb: [100]u8 = undefined;
+    const p = try path(&pb, "/d", 0x1f, 1);
+    try std.testing.expectEqualStrings("/d/000000000000001f.r1.ds41kv", p);
+    try std.testing.expectEqual(@as(?u64, 0x1f), keyOfName(p[3..], 1));
+    try std.testing.expectEqual(@as(?u64, null), keyOfName(p[3..], 0));
+    try std.testing.expectEqual(@as(?u64, null), keyOfName("index", 0));
+}
