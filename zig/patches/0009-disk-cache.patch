+    const root = try spillRoot(&rb, "flush");
+    defer rmTree(root);
+    var im = try imprint.Imprint.open(gpa, root, 3, 1 << 30);
+    defer im.deinit();
+    var f: Fake = .{ .gpa = gpa };
