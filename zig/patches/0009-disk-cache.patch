+    /// true when all went through; false when one did not, or none came within reply_ms.
+    fn awaitReplies(self: *Lanes, req: u64, key: u64) bool {
+        const d = &self.disk.?;
+        var all = true;
+        for (self.m.followers()) |lk| {
+            const l = lk orelse continue;
+            while (true) {
+                const maybe = l.recvWithin(&d.reply, d.reply_ms) catch |err| {
+                    std.log.err("dsv41: rank 1's disk answer: {s}", .{@errorName(err)});
+                    return false;
