diff --git a/zig/src/server/dsml_stream_test.zig b/zig/src/server/dsml_stream_test.zig
index f4ca00d..a400b0e 100644
--- a/zig/src/server/dsml_stream_test.zig
+++ b/zig/src/server/dsml_stream_test.zig
@@ -2120,3 +2120,126 @@ test "over HTTP, prose with leading whitespace, then a DSML call cut by max_toke
     }
 }
 
+
+const output_diagnostics = @import("output_diagnostics.zig");
+
+/// `v` without what changes from one request to the next (ids, times); `warning` drops the diagnostic's field as well.
+fn diagScrub(a: Allocator, v: json.Value, warning: bool) !json.Value {
+    switch (v) {
+        .array => |items| {
+            const out = try a.alloc(json.Value, items.len);
+            for (items, out) |x, *y| y.* = try diagScrub(a, x, warning);
+            return .{ .array = out };
+        },
+        .object => |o| {
+            const out = try json.newObject(a);
+            for (o.keys(), o.values()) |k, x| {
+                const drop = [_][]const u8{ "id", "created", "created_at", "completed_at", "call_id", "item_id", "response_id", "system_fingerprint", "tokens_per_second", "seconds", "prefill_seconds", "time_to_first_token" };
+                if (for (drop) |d| {
+                    if (std.mem.eql(u8, k, d)) break true;
+                } else false) continue;
+                if (warning and std.mem.eql(u8, k, "tool_parse_warning")) continue;
+                try out.put(a, k, try diagScrub(a, x, warning));
+            }
+            return .{ .object = out };
+        },
+        else => return v,
+    }
+}
+
+/// A response's status line and its events (or its whole body), each scrubbed and on its own line.
+fn diagWire(a: Allocator, wire: []const u8, warning: bool) ![]const u8 {
+    var out: std.ArrayList(u8) = .empty;
+    const body = wire[(std.mem.indexOf(u8, wire, "\r\n\r\n") orelse return error.NoBody) + 4 ..];
+    try out.appendSlice(a, wire[0 .. std.mem.indexOf(u8, wire, "\r\n").?]);
+    try out.append(a, '\n');
+    var lines = std.mem.splitScalar(u8, body, '\n');
+    while (lines.next()) |raw| {
+        const line = std.mem.trimEnd(u8, raw, "\r");
+        if (line.len == 0) continue;
+        const data = if (std.mem.startsWith(u8, line, "data: ")) line[6..] else line;
+        if (data.len > 0 and data[0] == '{') {
+            if (json.parse(a, data) catch null) |p| if (p == .ok) {
+                try out.appendSlice(a, try json.stringify(a, try diagScrub(a, p.ok, warning), .{ .ascii = false, .compact = true }));
+                try out.append(a, '\n');
+                continue;
+            };
+        }
+        if (std.fmt.parseInt(usize, line, 16)) |_| continue else |_| {}
+        try out.appendSlice(a, line);
+        try out.append(a, '\n');
+    }
+    return out.items;
+}
+
+// Patch 0067 (0043 of the 4-Spark recipe): a reply made only of DSML closing tags, with tools offered, gets
+// tensorfold.tool_parse_warning on the chat and Responses routes (the whole reply and the stream's last event); Messages
+// carries no runtime stamps. Diagnostic only: with it and without it every route's reply is the same, byte for byte
+// once ids and times are set aside, in live and hold mode, whole and streamed, thinking on and off.
+test "orphan DSML closers with tools: the warning on chat and Responses, and every reply as without the diagnostic, cut by max_tokens or not" {
+    if (builtin.os.tag != .linux) return error.SkipZigTest;
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    defer output_diagnostics.test_off = false;
+    const close = "</" ++ BD ++ " calls>";
+    // warn_thinking: the warning with thinking on, where the answer is the text after the think block (no Harmony split)
+    const Case = struct { answer: []const u8, warn: bool, warn_thinking: ?bool = null };
+    const cases = [_]Case{
+        .{ .answer = close, .warn = true },
+        .{ .answer = " \n" ++ close ++ "\t" ++ close ++ "\r\n", .warn = true },
+        .{ .answer = "</" ++ BD ++ " parameter></" ++ BD ++ " invoke></" ++ BD ++ " calls>", .warn = true },
+        .{ .answer = "</" ++ BD ++ "parameter></" ++ BD ++ "invoke></" ++ BD ++ "tool_calls>", .warn = true },
+        .{ .answer = "Example: " ++ close, .warn = false },
+        .{ .answer = close ++ " suffix", .warn = false },
+        .{ .answer = "```\n" ++ close ++ "\n```", .warn = false },
+        .{ .answer = "OK", .warn = false },
+        .{ .answer = comptime (b_open ++ bInvoke("Read", bParam("file_path", "/a")) ++ b_close), .warn = false },
+        .{ .answer = "Writing it.<" ++ BD ++ " calls><" ++ BD ++ " invoke name=\"Write\"><" ++ BD ++ " parameter name=\"content\">x" ++ close ++ "y", .warn = false },
+        // thinking off, the finish reads Harmony channels: the final channel holds only closers, or there is none
+        .{ .answer = "<|channel|>final<|message|>" ++ close, .warn = true, .warn_thinking = false },
+        .{ .answer = "<|channel|>analysis<|message|>x<|end|><|start|>assistant<|channel|>final<|message|>" ++ close ++ "<|return|>", .warn = true, .warn_thinking = false },
+        .{ .answer = "<|channel|>analysis<|message|>" ++ close ++ "<|end|>", .warn = false },
+    };
+    const schema = "{\"type\":\"object\",\"properties\":{\"file_path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}}}";
+    const user = "\"messages\":[{\"role\":\"user\",\"content\":\"x\"}]";
+    for ([_]tool_streaming.Mode{ .live, .hold }) |mode| for ([_]bool{ false, true }) |thinking| {
+        var bs: ByteServer = .{ .mode = mode };
+        try bs.init(thinking);
+        defer bs.deinit();
+        for (cases) |case| for ([_]bool{ true, false }) |with_tools| for ([_]bool{ false, true }) |cut| {
+            const answer = if (thinking) try std.mem.concat(a, u8, &.{ "r</think>", case.answer }) else case.answer;
+            const warn = if (thinking) case.warn_thinking orelse case.warn else case.warn;
+            const ids = try a.alloc(u32, answer.len);
+            for (answer, ids) |c, *id| id.* = c;
+            bs.backend.ids = ids;
+            bs.backend.cut = cut; // ended by max_tokens (length) or by the end token
+            const chat_tools = if (with_tools) ",\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"Read\",\"parameters\":" ++ schema ++ "}},{\"type\":\"function\",\"function\":{\"name\":\"Write\",\"parameters\":" ++ schema ++ "}}]" else "";
+            const msg_tools = if (with_tools) ",\"tools\":[{\"name\":\"Read\",\"input_schema\":" ++ schema ++ "},{\"name\":\"Write\",\"input_schema\":" ++ schema ++ "}]" else "";
+            const resp_tools = if (with_tools) ",\"tools\":[{\"type\":\"function\",\"name\":\"Read\",\"parameters\":" ++ schema ++ "},{\"type\":\"function\",\"name\":\"Write\",\"parameters\":" ++ schema ++ "}]" else "";
+            const routes = [_]struct { path: []const u8, body: []const u8, stamps: bool }{
+                .{ .path = "/v1/chat/completions", .body = try std.mem.concat(a, u8, &.{ "{\"model\":\"test-model\",\"max_tokens\":4096,", user, chat_tools, "}" }), .stamps = true },
+                .{ .path = "/v1/responses", .body = try std.mem.concat(a, u8, &.{ "{\"model\":\"test-model\",\"max_output_tokens\":4096,\"input\":\"x\"", resp_tools, "}" }), .stamps = true },
+                .{ .path = "/v1/messages", .body = try std.mem.concat(a, u8, &.{ "{\"model\":\"test-model\",\"max_tokens\":4096,", user, msg_tools, "}" }), .stamps = false },
+            };
+            for (routes) |r| for ([_]?usize{ null, 1, answer.len }) |round| {
+                bs.backend.pattern = &.{round orelse answer.len};
+                const body = try withStream(a, r.body, round != null);
+                output_diagnostics.test_off = true;
+                const off = try wirePost(a, bs.srv, r.path, body);
+                output_diagnostics.test_off = false;
+                const on = try wirePost(a, bs.srv, r.path, body);
+                const flagged = std.mem.indexOf(u8, on, "orphan_dsml_closers") != null;
+                std.testing.expectEqual(warn and with_tools and r.stamps, flagged) catch |e| {
+                    std.debug.print("{s} mode {s} thinking {} tools {} cut {} round {any}: {f}\n", .{ r.path, @tagName(mode), thinking, with_tools, cut, round, std.zig.fmtString(case.answer) });
+                    return e;
+                };
+                try std.testing.expect(std.mem.indexOf(u8, off, "tool_parse_warning") == null);
+                std.testing.expectEqualStrings(try diagWire(a, off, false), try diagWire(a, on, true)) catch |e| {
+                    std.debug.print("{s} mode {s} thinking {} cut {} round {any}: {f}\n", .{ r.path, @tagName(mode), thinking, cut, round, std.zig.fmtString(case.answer) });
+                    return e;
+                };
+            };
+        };
+    };
+}
diff --git a/zig/src/server/output_diagnostics.zig b/zig/src/server/output_diagnostics.zig
new file mode 100644
index 0000000..b47fc46
--- /dev/null
+++ b/zig/src/server/output_diagnostics.zig
@@ -0,0 +1,38 @@
+//! Conservative output diagnostics. A warning never repairs or reclassifies content.
+const std = @import("std");
+
+pub const ToolWarning = enum { orphan_dsml_closers };
+
+/// Tests only: the route runs as without the diagnostic, to compare its replies byte for byte.
+pub var test_off = false;
+
+/// Recognize only a whole answer made of known closing tags and ASCII whitespace.
+/// Prose, quotes, JSON, code fences, openers and partial/unknown tags remain ordinary text.
+/// The caller limits this check to answers with active tools outside the JSON channel.
+pub fn toolWarning(answer: []const u8) ?ToolWarning {
+    const blanks = " \t\r\n";
+    const closers = [_][]const u8{
+        "</\u{ff5c}DSML\u{ff5c} parameter>",
+        "</\u{ff5c}DSML\u{ff5c} invoke>",
+        "</\u{ff5c}DSML\u{ff5c} calls>",
+        "</\u{ff5c}DSML\u{ff5c}parameter>",
+        "</\u{ff5c}DSML\u{ff5c}invoke>",
+        "</\u{ff5c}DSML\u{ff5c}tool_calls>",
+    };
+    var rest = std.mem.trim(u8, answer, blanks);
+    if (rest.len == 0) return null;
+    while (rest.len > 0) {
+        const n = for (closers) |tag| {
+            if (std.mem.startsWith(u8, rest, tag)) break tag.len;
+        } else return null;
+        rest = std.mem.trimStart(u8, rest[n..], blanks);
+    }
+    return .orphan_dsml_closers;
+}
+
+test "output diagnostic is limited to complete orphan closing tags" {
+    const close = "</\u{ff5c}DSML\u{ff5c} calls>";
+    try std.testing.expectEqual(ToolWarning.orphan_dsml_closers, toolWarning(" \n" ++ close ++ "\t" ++ close ++ "\r").?);
+    try std.testing.expectEqual(ToolWarning.orphan_dsml_closers, toolWarning("</\u{ff5c}DSML\u{ff5c}parameter></\u{ff5c}DSML\u{ff5c}invoke></\u{ff5c}DSML\u{ff5c}tool_calls>").?);
+    for ([_][]const u8{ "", " \t", "\"" ++ close ++ "\"", "```\n" ++ close ++ "\n```", "Example: " ++ close, close ++ " suffix", "{\"example\":\"" ++ close ++ "\"}", "<\u{ff5c}DSML\u{ff5c} calls>" ++ close, "</\u{ff5c}DSML\u{ff5c}  calls>", "</\u{ff5c}DSML\u{ff5c} calls" }) |text| try std.testing.expect(toolWarning(text) == null);
+}
