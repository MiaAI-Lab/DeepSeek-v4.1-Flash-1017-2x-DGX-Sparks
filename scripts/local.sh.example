# Copy to scripts/local.sh (not in git) and fill in this setup's values; scripts/config.sh reads it first.
WORKER=user@192.0.2.2          # ssh target of the second Spark (key-based: ssh-copy-id user@192.0.2.2)
# FABRIC_PEER=192.0.2.12       # the worker's CX7 address, when WORKER is reached over another network
# NFS_SERVER=192.0.2.1         # the head's address the worker mounts the checkpoint from (default: its address on the link)
# HF_CACHE=/models/hf          # this Spark's Hugging Face cache, if it is not ~/.cache/huggingface (it needs ~505 GB free)
# WORKER_ENGRAM_DIR='$HOME/.cache/dsv41-tensorfold/engram-1bae0e10'     # on the worker: Engram's tables (~203 GB)
# WORKER_CACHE_DIR='$HOME/.cache/dsv41-tensorfold/rank-cache-c178a012'  # on the worker: rank 1's weight file (~106 GB)
# MEMGUARD_GIB=2.5            # memguard's floor (GiB of MemAvailable), held MEMGUARD_HOLD_S=4 s before a kill; MEMGUARD_HARD_GIB=1 kills at once. README, Memory and safety
# MODEL_ID=Mia-AiLab/DeepSeek-V4.1-Flash-1017-EAQ-v1-2.9-bpw   # a checkpoint already in your cache under the repo's earlier name (the repo was renamed to ...-EXL3-EAQ-v1-2.9-bpw;
# MODEL_REVISION=<40-hex commit in that folder>                # the Hub redirects the old name). Set both to what ~/.cache/huggingface/hub holds, or main's default (the renamed repo @ 6d54be4f, 196 GiB) is downloaded
# ABLIT=0                     # 1: matching Keys overlay on Mia EAQ 2.9 bpw; needs your HF token AND access below
# HF_TOKEN=hf_...              # HF read token (or use hf auth login on the head); never commit your token
# ABLIT=1 requires access: https://huggingface.co/drowzeys/keys-DeepSeek-V4.1-Flash-1017-Abliterated
# The ported engine features (docs/PORT-RECIPE.md, README "Spill v2 and KV sharding"): OFF by default (the recipe as
# before the port). Turn them on here: SPILL_GIB=64 KV_SHARD=1 is what the pair was validated with (POOL left empty is
# then derived from CONTEXT: 2,101,248 at the 1M window). Set here, a spill folder that fails its checks on either
# Spark refuses the start.
# SPILL_GIB=64                # spill v2: kept prompt states on each Spark's own NVMe, up to this many GiB a Spark (0: off)
# SPILL_DIR=/home/user/.cache/dsv41-tensorfold-spill   # rank 0's spill folder (default: beside HF_CACHE; never inside it,
#                             # never on NFS or under an archive folder); created by start.sh as you, mounted at /spill
# WORKER_SPILL_DIR='$HOME/.cache/dsv41-tensorfold-spill'  # rank 1's on the worker (default: SPILL_DIR)
# SPILL_FLOOR_GIB=50          # free disk the tier leaves on that file system
# SPILL_QUOTA_GIB=16          # one conversation's share of SPILL_GIB before its old turns and forks go (0: none)
# KV_SHARD=1                  # each conversation's compressed KV once, on its owner Spark (0: off)
# POOL=2101248                # total pool positions (zig/patches/0008); with KV_SHARD=1, empty: two owner parts of a CONTEXT
#                             # window each, derived; the same POOL costs about half the KV memory a Spark sharded
# KV_SHARD_DECODE=fetch       # fetch (reference) or owner (owner-computed decode); empty: the engine's default
